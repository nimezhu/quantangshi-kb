{"vol_name": "卷四百七十一", "poems": {"p01": {"key": "471-01", "title": "五雜組", "author": "雍裕之", "canonical": "雍裕之", "lines": ["五雜組，刺繡窠。", "往復還，織錦梭。", "不得已，戍交河。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "471-02"}, "p02": {"key": "471-02", "title": "剪綵花", "author": "雍裕之", "canonical": "雍裕之", "lines": ["敢競桃李色，自呈刀尺功。", "蝶猶迷剪翠，人豈辨裁紅。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-01", "next": "471-03"}, "p03": {"key": "471-03", "title": "春晦送客", "author": "雍裕之", "canonical": "雍裕之", "lines": ["野酌亂無巡，送君兼送春。", "明年春色至，莫作未歸人。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-02", "next": "471-04"}, "p04": {"key": "471-04", "title": "自君之出矣", "author": "雍裕之", "canonical": "雍裕之", "lines": ["自君之出矣，寶鏡為誰明。", "思君如隴水，長聞嗚咽聲。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-03", "next": "471-05"}, "p05": {"key": "471-05", "title": "四氣", "author": "雍裕之", "canonical": "雍裕之", "lines": ["春禽猶競囀，夏木忽交陰。", "稍覺秋山遠，俄驚冬霰深。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-04", "next": "471-06"}, "p06": {"key": "471-06", "title": "四色", "author": "雍裕之", "canonical": "雍裕之", "lines": ["壺中冰始結，盤上露初圓。", "何意瑤池雪，欲奪鶴毛鮮。", "道士牛已至，仙家鳥亦來。", "骨為神不朽，眼向故人開。", "勞魴蓮渚內，汗馬火旗間。", "平生血誠盡，不獨左輪殷。", "已見池盡墨，誰言突不黔。", "漆身恩未報，貂裘弊豈嫌。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "471-05", "next": "471-07"}, "p07": {"key": "471-07", "title": "大言", "author": "雍裕之", "canonical": "雍裕之", "lines": ["四溟杯淥醑，五嶽髻青螺。", "揮汗曾成雨，畫地亦成河。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-06", "next": "471-08"}, "p08": {"key": "471-08", "title": "細言", "author": "雍裕之", "canonical": "雍裕之", "lines": ["蚊眉自可托，蝸角豈勞爭。", "欲效絲毫力，誰知螻蟻誠。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-07", "next": "471-09"}, "p09": {"key": "471-09", "title": "山中桂", "author": "雍裕之", "canonical": "雍裕之", "lines": ["八樹拂丹霄，四時青不凋。", "秋風何處起，先嫋最長條。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-08", "next": "471-10"}, "p10": {"key": "471-10", "title": "蘆花", "author": "雍裕之", "canonical": "雍裕之", "lines": ["夾岸複連沙，枝枝搖浪花。", "月明渾似雪，無處認漁家。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-09", "next": "471-11"}, "p11": {"key": "471-11", "title": "江邊柳", "author": "雍裕之", "canonical": "雍裕之", "lines": ["嫋嫋古堤邊，青青一樹煙。", "若為絲不斷，留取系郎船。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-10", "next": "471-12"}, "p12": {"key": "471-12", "title": "江上山", "author": "雍裕之", "canonical": "雍裕之", "lines": ["綺霞明赤岸，錦纜繞丹枝。", "楚客正愁絕，西風且莫吹。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-11", "next": "471-13"}, "p13": {"key": "471-13", "title": "遊絲", "author": "雍裕之", "canonical": "雍裕之", "lines": ["遊絲何所似，應最似春心。", "一向風前亂，千條不可尋。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-12", "next": "471-14"}, "p14": {"key": "471-14", "title": "柳絮", "author": "雍裕之", "canonical": "雍裕之", "lines": ["無風才到地，有風還滿空。", "緣渠偏似雪，莫近鬢毛生。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-13", "next": "471-15"}, "p15": {"key": "471-15", "title": "殘鶯", "author": "雍裕之", "canonical": "雍裕之", "lines": ["花闌鶯亦懶，不語似含情。", "何言百囀舌，唯餘一兩聲。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-14", "next": "471-16"}, "p16": {"key": "471-16", "title": "早蟬", "author": "雍裕之", "canonical": "雍裕之", "lines": ["一聲清溽暑，幾處促流年。", "志士心偏苦，初聞獨泫然。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-15", "next": "471-17"}, "p17": {"key": "471-17", "title": "秋蛩", "author": "雍裕之", "canonical": "雍裕之", "lines": ["雨絕蒼苔地，月斜青草階。", "蛩鳴誰不怨，況是正離懷。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-16", "next": "471-18"}, "p18": {"key": "471-18", "title": "江上聞猿", "author": "雍裕之", "canonical": "雍裕之", "lines": ["楓岸月斜明，猿啼旅夢驚。", "愁多腸易斷，不待第三聲。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-17", "next": "471-19"}, "p19": {"key": "471-19", "title": "折柳贈行人", "author": "雍裕之", "canonical": "雍裕之", "lines": ["那言柳亂垂，盡日任風吹。", "欲識千條恨，和煙折一枝。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-18", "next": "471-20"}, "p20": {"key": "471-20", "title": "題蒲葵扇", "author": "雍裕之", "canonical": "雍裕之", "lines": ["傾心曾向日，在手幸搖風。", "羨爾逢提握，知名自謝公。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-19", "next": "471-21"}, "p21": {"key": "471-21", "title": "贈苦行僧", "author": "雍裕之", "canonical": "雍裕之", "lines": ["幽深紅葉寺，清淨白毫僧。", "古殿長鳴磬，低頭禮晝燈。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-20", "next": "471-22"}, "p22": {"key": "471-22", "title": "兩頭纖纖", "author": "雍裕之", "canonical": "雍裕之", "lines": ["兩頭纖纖八字眉，半白半黑燈影帷。", "腷腷[膊膊]曉禽飛，磊磊落落秋果垂。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "471-21", "next": "471-23"}, "p23": {"key": "471-23", "title": "了語", "author": "雍裕之", "canonical": "雍裕之", "lines": ["掃卻煙塵寇初剿，深水高林放魚鳥。", "雞人唱絕殘漏曉，仙樂拍終天悄悄。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-22", "next": "471-24"}, "p24": {"key": "471-24", "title": "不了語", "author": "雍裕之", "canonical": "雍裕之", "lines": ["浮名世利知多少，朝市喧喧塵擾擾。", "車馬交馳往復來，鐘鼓相催天又曉。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-23", "next": "471-25"}, "p25": {"key": "471-25", "title": "聽彈沈湘", "author": "雍裕之", "canonical": "雍裕之", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E8%B4%BE%E8%B0%8A.html\">賈誼</a>投文吊<a class=\"ent ent-person\" href=\"../entities/person_%E5%B1%88%E5%B9%B3.html\">屈平</a>，瑤琴能寫此時情。", "秋風一奏沈湘曲，流水千年作恨聲。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-24", "next": "471-26"}, "p26": {"key": "471-26", "title": "豪家夏冰詠", "author": "雍裕之", "canonical": "雍裕之", "lines": ["金錯銀盤貯賜冰，清光如聳玉山棱。", "無論塵客閑停扇，直到消時不見蠅。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-25", "next": "471-27"}, "p27": {"key": "471-27", "title": "宿棣華館聞雁", "author": "雍裕之", "canonical": "雍裕之", "lines": ["不堪旅宿棣花館，況有離群鴻雁聲。", "一點秋燈殘影下，不知寒夢幾回驚。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-26", "next": "471-28"}, "p28": {"key": "471-28", "title": "農家望晴", "author": "雍裕之", "canonical": "雍裕之", "lines": ["嘗聞秦地西風雨，為問西風早晚回。", "白髮老農如鶴立，麥場高處望雲開。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-27", "next": "471-29"}, "p29": {"key": "471-29", "title": "宮人斜", "author": "雍裕之", "canonical": "雍裕之", "lines": ["幾多紅粉委黃泥，野鳥如歌又似啼。", "應有春魂化為燕，年來飛入未央棲。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-28", "next": "471-30"}, "p30": {"key": "471-30", "title": "曲江池上", "author": "雍裕之", "canonical": "雍裕之", "lines": ["殷勤春在<a class=\"ent ent-place\" href=\"../entities/place_%E6%9B%B2%E6%B1%9F.html\">曲江</a>頭，全藉群仙占勝遊。", "何必三山待鸞鶴，年年此地是瀛洲。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "471-29", "next": null}}}