{"vol_name": "卷八百七十三", "poems": {"p01": {"key": "873-01", "title": "題洛陽縣壁", "author": "李兼", "canonical": "李兼", "lines": ["猾吏畏服，縣妖破膽。", "好錄政聲，聞於御覽。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "873-02"}, "p02": {"key": "873-02", "title": "題書卷後語", "author": "杜兼", "canonical": "杜兼", "lines": ["倩俸寫來手自校，汝曹讀之知聖道，墜之鬻之為不孝。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "873-01", "next": "873-03"}, "p03": {"key": "873-03", "title": "題李陽冰玉箸篆詞", "author": "舒元輿", "canonical": "舒元輿", "lines": ["斯去千年，冰生唐時。", "冰複去矣，後來者誰？", "後千年有人，誰能待之。", "後千年無人，篆止於斯。", "嗚呼主人，為吾寶之。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-02", "next": "873-04"}, "p04": {"key": "873-04", "title": "判誤書紙背", "author": "裴諝", "canonical": "裴諝", "lines": ["這畔似那畔，那畔似這畔。", "我也不辭與你判，笑殺門前著靴漢。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-03", "next": "873-05"}, "p05": {"key": "873-05", "title": "又判爭貓兒狀", "author": "裴諝", "canonical": "裴諝", "lines": ["貓兒不識主，傍家搦老鼠。", "兩家不須爭，將來與裴諝。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "873-04", "next": "873-06"}, "p06": {"key": "873-06", "title": "斷僧通狀", "author": "李翱", "canonical": "李翱", "lines": ["上歲童子，二十受戒。", "君王不朝，父母不拜。", "口稱貧道，有錢放債。", "量決十下，牒出東界。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-05", "next": "873-07"}, "p07": {"key": "873-07", "title": "判僧雲晏五人聚賭喧諍語", "author": "韓滉", "canonical": "韓滉", "lines": ["正法何曾執貝，空門不積餘財。", "白日既能賭博，通宵必醉尊罍。", "強說天堂難到，又言地獄長開。", "竝付江神收管，波中便是泉臺。"], "form": "六言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "873-06", "next": "873-08"}, "p08": {"key": "873-08", "title": "判道士黃山隱", "author": "皇甫大夫", "canonical": "皇甫大夫", "lines": ["道士黃山隱，輕人複重財。", "<a class=\"ent ent-place\" href=\"../entities/place_%E5%A4%AA%E5%B1%B1.html\">太山</a>將比甑，<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%9C%E6%B5%B7.html\">東海</a>只容杯。", "綠綬藏雲帔，烏巾換鹿胎。", "黃泉六個鬼，今夜待君來。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "873-07", "next": "873-09"}, "p09": {"key": "873-09", "title": "碾驢鞍判", "author": "羅紹威", "canonical": "羅紹威", "lines": ["鄴城大道甚寬，何故駕車碾鞍？", "領韝驢漢子科決，待駕車漢子喜歡。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-08", "next": "873-10"}, "p10": {"key": "873-10", "title": "批州符", "author": "蕭結", "canonical": "蕭結", "lines": ["秧開五葉，蠶長三眠。", "人皆忙迫，劃甚閑船。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-09", "next": "873-11"}, "p11": {"key": "873-11", "title": "判部民訴主簿牒", "author": "王魯", "canonical": "王魯", "lines": ["汝雖打草，吾已驚蛇。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-10", "next": "873-12"}, "p12": {"key": "873-12", "title": "戲為冥吏判", "author": "伶人", "canonical": "伶人", "lines": ["焦湖百里，一任作獺。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-11", "next": "873-13"}, "p13": {"key": "873-13", "title": "自狀", "author": "張翱", "canonical": "張翱", "lines": ["有張翱兮，寓止<a class=\"ent ent-place\" href=\"../entities/place_%E6%B7%AE%E9%98%B4.html\">淮陰</a>。", "來綺席兮，放恣胸襟。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-12", "next": "873-14"}, "p14": {"key": "873-14", "title": "刺左右膊詩", "author": "趙武建", "canonical": "趙武建", "lines": ["野鴨灘頭宿，朝朝被鶻梢。", "忽驚飛入水，留命到今朝。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "873-13", "next": "873-15"}, "p15": {"key": "873-15", "title": "刺左臂膊詩", "author": "宋元素", "canonical": "宋元素", "lines": ["昔日已前家未貧，苦將錢物結交親。", "如今失路尋知己，行盡關山無一人。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "873-14", "next": "873-16"}, "p16": {"key": "873-16", "title": "刺左右膊句", "author": "張幹", "canonical": "張干", "lines": ["生不怕京兆尹，死不畏閻羅王。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "873-15", "next": null}}}