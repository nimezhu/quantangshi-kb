{"vol_name": "卷三十一", "poems": {"p01": {"key": "031-01", "title": "五郊樂章：黃帝宮音", "author": "魏征", "canonical": "魏征", "lines": ["黃中正位，含章居貞。", "既長六律，兼和五聲。", "畢陳萬舞，乃薦斯牲。", "神其下降，永祚休平。"], "form": "四言", "t300": null, "src": "yuding", "prev": null, "next": "031-02"}, "p02": {"key": "031-02", "title": "五郊樂章：肅和", "author": "魏征", "canonical": "魏征", "lines": ["眇眇方輿，蒼蒼圜蓋。", "至哉樞紐，宅中圖大。", "氣調四序，風和萬籟。", "祚我明德，時雍道泰。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-01", "next": "031-03"}, "p03": {"key": "031-03", "title": "五郊樂章：雍和", "author": "魏征", "canonical": "魏征", "lines": ["金懸夕肆，玉俎朝陳。", "饗薦黃道，芬流紫辰。", "乃誠乃敬，載享載禋。", "崇薦斯在，惟皇是賓。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-02", "next": "031-04"}, "p04": {"key": "031-04", "title": "五郊樂章：舒和", "author": "魏征", "canonical": "魏征", "lines": ["禦征乘宮出郊甸，安歌率舞遞將迎。", "自有雲門符帝賞，猶持雷鼓答天成。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "031-03", "next": "031-05"}, "p05": {"key": "031-05", "title": "五郊樂章：青帝角音", "author": "魏征", "canonical": "魏征", "lines": ["鶴雲旦起，鳥星昏集。", "律候新風，陽開初蟄。", "<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>可饗，行潦斯挹。", "錫以無疆，烝人乃粒。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-04", "next": "031-06"}, "p06": {"key": "031-06", "title": "五郊樂章：肅和", "author": "魏征", "canonical": "魏征", "lines": ["玄鳥司春，蒼龍登歲。", "節物變柳，光風轉蕙。", "瑤席降神，朱弦饗帝。", "誠備祝嘏，禮殫珪幣。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-05", "next": "031-07"}, "p07": {"key": "031-07", "title": "五郊樂章：雍和", "author": "魏征", "canonical": "魏征", "lines": ["大樂稀音，至誠簡禮。", "文物棣棣，聲名濟濟。", "六變有成，三登無體。", "乃眷豐絜，恩覃愷悌。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-06", "next": "031-08"}, "p08": {"key": "031-08", "title": "五郊樂章：舒和", "author": "魏征", "canonical": "魏征", "lines": ["笙歌鑰舞屬年韶，鷺鼓鳧鐘展時豫。", "調露初迎綺春節，承雲遽踐蒼霄馭。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "031-07", "next": "031-09"}, "p09": {"key": "031-09", "title": "五郊樂章：赤帝征音", "author": "魏征", "canonical": "魏征", "lines": ["青陽告謝，朱明戒序。", "咸長是祈，敬陳椒醑。", "博碩斯薦，笙鏞備舉。", "庶盡肅恭，非馨稷黍。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-08", "next": "031-10"}, "p10": {"key": "031-10", "title": "五郊樂章：肅和", "author": "魏征", "canonical": "魏征", "lines": ["離位克明，火中宵見。", "峰雲暮起，景風晨扇。", "木槿初榮，含桃可薦。", "芬馥百品，鏗鏘三變。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-09", "next": "031-11"}, "p11": {"key": "031-11", "title": "五郊樂章：雍和", "author": "魏征", "canonical": "魏征", "lines": ["昭昭丹陸，帟帟炎方。", "禮陳牲幣，樂備篪簧。", "瓊羞溢俎，玉𨣧浮觴。", "恭惟正直，歆此馨香。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-10", "next": "031-12"}, "p12": {"key": "031-12", "title": "五郊樂章：舒和", "author": "魏征", "canonical": "魏征", "lines": ["千里溫風飄降羽，十枝炎景媵朱幹。", "陳觴薦俎歌三獻，拊石摐金會七盤。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "031-11", "next": "031-13"}, "p13": {"key": "031-13", "title": "五郊樂章：白帝商音", "author": "魏征", "canonical": "魏征", "lines": ["白藏應節，天高氣清。", "歲功既阜，庶類收成。", "萬方靜謐，九土和平。", "馨香是薦，受祚聰明。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-12", "next": "031-14"}, "p14": {"key": "031-14", "title": "五郊樂章：肅和", "author": "魏征", "canonical": "魏征", "lines": ["金行在節，素靈居正。", "氣肅霜嚴，林凋草勁。", "豺祭隼擊，潦收川鏡。", "九谷已登，萬箱流詠。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-13", "next": "031-15"}, "p15": {"key": "031-15", "title": "五郊樂章：雍和", "author": "魏征", "canonical": "魏征", "lines": ["律應西成，氣躔南呂。", "珪幣咸列，笙竽備舉。", "苾苾蘭羞，芬芬桂醑。", "式資宴貺，用調霜序。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-14", "next": "031-16"}, "p16": {"key": "031-16", "title": "五郊樂章：舒和", "author": "魏征", "canonical": "魏征", "lines": ["璿儀氣爽驚緹鑰，玉呂灰飛含素商。", "鳴鞞奏管芳羞薦，會舞安歌葆眊揚。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "031-15", "next": "031-17"}, "p17": {"key": "031-17", "title": "五郊樂章：黑帝羽音", "author": "魏征", "canonical": "魏征", "lines": ["嚴冬季月，星回風厲。", "享祀報功，方祚來歲。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-16", "next": "031-18"}, "p18": {"key": "031-18", "title": "五郊樂章：肅和", "author": "魏征", "canonical": "魏征", "lines": ["律周玉管，星回金度。", "次極陽烏，紀窮陰兔。", "火林散雪，陽泉凝冱。", "八蠟已登，三農息務。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-17", "next": "031-19"}, "p19": {"key": "031-19", "title": "五郊樂章：雍和", "author": "魏征", "canonical": "魏征", "lines": ["陽月斯紀，應鐘在候。", "載絜牲牷，爰登俎豆。", "既高既遠，無聲無臭。", "靜言格思，惟神保佑。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-18", "next": "031-20"}, "p20": {"key": "031-20", "title": "五郊樂章：舒和", "author": "魏征", "canonical": "魏征", "lines": ["執鑰持羽初終曲，朱幹玉戚始分行。", "七德九功咸已暢，明靈降福具穰穰。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "031-19", "next": "031-21"}, "p21": {"key": "031-21", "title": "享太廟樂章：永和", "author": "魏征", "canonical": "魏征", "lines": ["於穆烈祖，弘此丕基。", "永言配命，子孫保之。", "百神既洽，萬國在茲。", "是用孝享，神其格思。", "肅肅清祀，烝烝孝思。", "薦享昭備，虔恭在茲。", "雍歌撤俎，祝嘏陳辭。", "用光武志，永固鴻基。"], "form": "四言", "t300": null, "src": "poet.tang", "prev": "031-20", "next": "031-22"}, "p22": {"key": "031-22", "title": "享太廟樂章：肅和", "author": "魏征", "canonical": "魏征", "lines": ["大哉<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>，允茲明聖。", "格於上下，聿遵誠敬。", "嘉樂斯登，鳴球以詠。", "神其降止，式隆景命。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-21", "next": "031-23"}, "p23": {"key": "031-23", "title": "享太廟樂章：雍和", "author": "魏征", "canonical": "魏征", "lines": ["崇茲享祀，誠敬兼至。", "樂以感靈，禮以昭事。", "粢盛咸絜，牲牷孔備。", "永言孝思，庶幾不匱。", "於穆清廟，聿脩嚴祀。", "四縣載陳，三獻斯止。", "籩豆撤薦，人祗介祉。", "神惟格思，錫祚不已。"], "form": "四言", "t300": null, "src": "poet.tang", "prev": "031-22", "next": "031-24"}, "p24": {"key": "031-24", "title": "享太廟樂章：長髮舞", "author": "魏征", "canonical": "魏征", "lines": ["浚哲惟唐，長髮其祥。", "帝命斯佑，王業克昌。", "配天載德，就日重光。", "本枝百代，申錫無疆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-23", "next": "031-25"}, "p25": {"key": "031-25", "title": "享太廟樂章：大基舞", "author": "魏征", "canonical": "魏征", "lines": ["猗與祖業，皇矣帝先。", "剪商德厚，封唐慶延。", "在姬猶稷，方晉逾宣。", "基我鼎運，於斯萬年。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-24", "next": "031-26"}, "p26": {"key": "031-26", "title": "享太廟樂章：大成舞", "author": "魏征", "canonical": "魏征", "lines": ["周<a class=\"ent ent-person\" href=\"../entities/person_%E7%A9%86%E7%8E%8B.html\">穆王</a>季，晉美帝文。", "明明盛德，穆穆齊芬。", "藏用四履，屈道參分。", "鏗鏘鐘石，載紀鴻勳。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-25", "next": "031-27"}, "p27": {"key": "031-27", "title": "享太廟樂章：大明舞", "author": "魏征", "canonical": "魏征", "lines": ["五紀更運，三正逓升。", "勛華既沒，禹湯勃興。", "神武命代，靈睠是膺。", "望雲彰德，察緯告徵。", "上紐天維，下安地軸。", "徵師涿野，萬國咸服。", "偃伯靈臺，九官允穆。", "殊域委贐，懷生介福。", "大禮既飾，大樂已和。", "黑章擾囿，赤字浮河。", "功宣載籍，德被詠歌。", "克昌厥後，百祿是荷。"], "form": "四言", "t300": null, "src": "poet.tang", "prev": "031-26", "next": "031-28"}, "p28": {"key": "031-28", "title": "享太廟樂章：壽和", "author": "魏征", "canonical": "魏征", "lines": ["八音斯奏，三獻畢陳。", "寶祚惟永，暉光日新。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-27", "next": "031-29"}, "p29": {"key": "031-29", "title": "享太廟樂章：舒和", "author": "魏征", "canonical": "魏征", "lines": ["聖敬通神光七廟，靈心薦祚和萬方。", "嚴禋克配鴻基遠，明德惟馨鳳曆昌。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "031-28", "next": "031-30"}, "p30": {"key": "031-30", "title": "享太廟樂章：雍和", "author": "魏征", "canonical": "魏征", "lines": ["于穆清廟，聿修嚴祀。", "四縣載陳，三獻斯止。", "籩豆撤薦，人祇介祉。", "神惟格思，錫祚不已。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-29", "next": "031-31"}, "p31": {"key": "031-31", "title": "享太廟樂章：永和", "author": "魏征", "canonical": "魏征", "lines": ["肅肅清祀，烝烝孝思。", "薦享昭備，虔恭在茲。", "雍歌撤俎，祝嘏陳辭。", "用光武志，永固鴻基。"], "form": "四言", "t300": null, "src": "yuding", "prev": "031-30", "next": "031-32"}, "p32": {"key": "031-32", "title": "賦西漢", "author": "魏征", "canonical": "魏征", "lines": ["受降臨軹道，爭長趣<a class=\"ent ent-place\" href=\"../entities/place_%E9%B8%BF%E9%97%A8.html\">鴻門</a>。", "驅傳渭橋上，觀兵細柳屯。", "夜宴經柏谷，朝游出杜原。", "終藉叔孫禮，方知皇帝尊。"], "form": "五律", "t300": null, "src": "yuding", "prev": "031-31", "next": "031-33"}, "p33": {"key": "031-33", "title": "暮秋言懷", "author": "魏征", "canonical": "魏征", "lines": ["首夏別京輔，杪秋滯<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%89%E6%B2%B3.html\">三河</a>。", "沉沉蓬萊閣，日夕鄉思多。", "霜剪涼階蕙，風捎幽渚荷。", "歲芳坐淪歇，感此式微歌。"], "form": "五律", "t300": null, "src": "yuding", "prev": "031-32", "next": "031-34"}, "p34": {"key": "031-34", "title": "述懷", "author": "魏征", "canonical": "魏征", "lines": ["中原初逐鹿，投筆事戎軒。", "縱橫計不就，慷慨志猶存。", "杖策謁天子，驅馬出關門。", "請纓系南粵，憑軾下東藩。", "郁紆陟高岫，出沒望<a class=\"ent ent-place\" href=\"../entities/place_%E5%B9%B3%E5%8E%9F.html\">平原</a>。", "古木鳴寒鳥，空山啼夜猿。", "既傷千里目，還驚九折魂。", "豈不憚艱險，深懷國士恩。", "<a class=\"ent ent-person\" href=\"../entities/person_%E5%AD%A3%E5%B8%83.html\">季布</a>無二諾，侯嬴重一言。", "人生感意氣，功名誰複論。"], "form": "五言排律", "t300": null, "src": "yuding", "prev": "031-33", "next": "031-35"}, "p35": {"key": "031-35", "title": "奉和正日臨朝應詔", "author": "魏征", "canonical": "魏征", "lines": ["百靈侍軒後，萬國會塗山。", "豈如今睿哲，邁古獨光前。", "聲教溢四海，朝宗引百川。", "鏘洋鳴玉佩，灼爍耀金蟬。", "淑景輝雕輦，高旌揚翠煙。", "庭實超王會，廣樂盛鈞天。", "既欣東日戶，複詠南風篇。", "願奉光華慶，從斯億萬年。"], "form": "五言排律", "t300": null, "src": "yuding", "prev": "031-34", "next": null}}}