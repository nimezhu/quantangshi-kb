{"vol_name": "卷一十二", "poems": {"p01": {"key": "012-01", "title": "郊廟歌辭：祭方丘樂章：順和", "author": "不詳", "canonical": "不詳", "lines": ["萬方資以化，交泰屬升平。", "易從業惟簡，得一道斯寧。", "具儀光玉帛，送舞變咸英。", "黍稷良非貴，明德信惟馨。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "012-02"}, "p02": {"key": "012-02", "title": "郊廟歌辭：祭方丘樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["至矣坤德，皇哉地祇。", "<a class=\"ent ent-time\" href=\"../entities/time_%E5%BC%80%E5%85%83.html\">開元</a>統紐，合大承規。", "九宮肅列，六典相儀。", "永言配命，長保無虧。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-01", "next": "012-03"}, "p03": {"key": "012-03", "title": "郊廟歌辭：祭方丘樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["柔而能方，直而能敬。", "載厚以德，大亨以正。", "有滌斯牷，有馨斯盛。", "介茲<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E7%A6%8F.html\">景福</a>，祚我休慶。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-02", "next": "012-04"}, "p04": {"key": "012-04", "title": "郊廟歌辭：祭方丘樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["玉幣牲牷分薦享，羽旄幹戚遞成容。", "一德惟寧兩儀泰，三才保合四時邕。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-03", "next": "012-05"}, "p05": {"key": "012-05", "title": "郊廟歌辭：祭方丘樂章：順和", "author": "不詳", "canonical": "不詳", "lines": ["陰祇協贊，厚載方貞。", "牲幣具舉，簫管備成。", "其禮惟肅，其德惟明。", "神之聽矣，式鑒虔誠。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-04", "next": "012-06"}, "p06": {"key": "012-06", "title": "郊廟歌辭：武后大享拜洛樂章：昭和", "author": "不詳", "canonical": "不詳", "lines": ["九玄眷命，三聖基隆。", "奉承先旨，明臺畢功。", "宗祀展敬，冀表深衷。", "永昌帝業，式播淳風。", "舒陰致養，合大資生。", "德以恆固，功由<a class=\"ent ent-time\" href=\"../entities/time_%E6%B0%B8%E8%B4%9E.html\">永貞</a>。", "升歌薦序，垂幣翹誠。", "虹開玉照，鳳引金聲。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-05", "next": "012-07"}, "p07": {"key": "012-07", "title": "郊廟歌辭：武后大享拜洛樂章：致和", "author": "不詳", "canonical": "不詳", "lines": ["神功不測兮運陰陽，包藏萬宇兮孕八荒。", "天符既出兮帝業昌，願臨明祀兮降禎祥。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-06", "next": "012-08"}, "p08": {"key": "012-08", "title": "郊廟歌辭：武后大享拜洛樂章：咸和", "author": "不詳", "canonical": "不詳", "lines": ["坎澤祠容備舉，坤壇祭典爰申。", "靈睠遙行祕躅，嘉貺荐委殊珍。", "肅禮恭禋載展，翹襟邈志逾殷。", "方期交際懸應。"], "form": "六言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-07", "next": "012-09"}, "p09": {"key": "012-09", "title": "郊廟歌辭：武后大享拜洛樂章：九和", "author": "不詳", "canonical": "不詳", "lines": ["祗荷坤德，欽若干靈。", "慚惕罔置，興居匪寧。", "恭崇禮則，肅奉儀形。", "惟憑展敬，敢薦非馨。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-08", "next": "012-10"}, "p10": {"key": "012-10", "title": "郊廟歌辭：武后大享拜洛樂章：顯和", "author": "不詳", "canonical": "不詳", "lines": ["菲躬承睿顧，薄德忝坤儀。", "乾乾遵後命，翼翼奉先規。", "撫俗勤雖切，還淳化尚虧。", "未能弘至道，何以契明祇。", "顧德有慙虛菲，明祇屢降禎符。", "汜水初呈祕象，溫洛薦表昌圖。", "玄澤流恩載洽，丹襟荷渥增愉。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-09", "next": "012-11"}, "p11": {"key": "012-11", "title": "郊廟歌辭：武后大享拜洛樂章：顯和", "author": "不詳", "canonical": "不詳", "lines": ["菲躬承睿顧，薄德忝坤儀。", "乾乾遵後命，翼翼奉先規。", "撫俗勤雖切，還淳化尚虧。", "未能弘至道，何以契明祇。", "顧德有慙虛菲，明祇屢降禎符。", "汜水初呈祕象，溫洛薦表昌圖。", "玄澤流恩載洽，丹襟荷渥增愉。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-10", "next": "012-12"}, "p12": {"key": "012-12", "title": "郊廟歌辭：武后大享拜洛樂章：昭和", "author": "不詳", "canonical": "不詳", "lines": ["九玄眷命，三聖基隆。", "奉承先旨，明臺畢功。", "宗祀展敬，冀表深衷。", "永昌帝業，式播淳風。", "舒陰致養，合大資生。", "德以恆固，功由<a class=\"ent ent-time\" href=\"../entities/time_%E6%B0%B8%E8%B4%9E.html\">永貞</a>。", "升歌薦序，垂幣翹誠。", "虹開玉照，鳳引金聲。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-11", "next": "012-13"}, "p13": {"key": "012-13", "title": "郊廟歌辭：武后大享拜洛樂章：敬和", "author": "不詳", "canonical": "不詳", "lines": ["蘭俎既升，蘋羞可薦。", "金石載設，咸英已變。", "林澤斯總，山川是遍。", "敢用敷誠，實惟忘倦。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-12", "next": "012-14"}, "p14": {"key": "012-14", "title": "郊廟歌辭：武后大享拜洛樂章：齊和", "author": "不詳", "canonical": "不詳", "lines": ["沈潛演貺分三極，廣大凝禎總萬方。", "既薦羽旌文化啟，還呈幹戚武威揚。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-13", "next": "012-15"}, "p15": {"key": "012-15", "title": "郊廟歌辭：武后大享拜洛樂章：德和", "author": "不詳", "canonical": "不詳", "lines": ["夕惕司龍契，晨兢當鳳扆。", "崇儒習舊規，偃伯循先旨。", "絕壤飛冠蓋，遐區麗山水。", "幸承三聖餘，忻屬千年始。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "012-14", "next": "012-16"}, "p16": {"key": "012-16", "title": "郊廟歌辭：武后大享拜洛樂章：禋和", "author": "不詳", "canonical": "不詳", "lines": ["百禮崇容，千官肅事。", "靈降無兆，神凝有粹。", "奠享咸周，威儀畢備。", "奏夏登列，歌雍徹肆。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-15", "next": "012-17"}, "p17": {"key": "012-17", "title": "郊廟歌辭：武后大享拜洛樂章：通和", "author": "不詳", "canonical": "不詳", "lines": ["皇皇靈眷，穆穆神心。", "暫動凝質，還歸積陰。", "功玄樞紐，理寂高深。", "銜恩佩德，聳志翹襟。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-16", "next": "012-18"}, "p18": {"key": "012-18", "title": "郊廟歌辭：武后大享拜洛樂章：歸和", "author": "不詳", "canonical": "不詳", "lines": ["言旋雲洞兮躡煙途，永寧中宇兮安下都。", "包涵動植兮順榮枯，長貽寶貺兮贊璿圖。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-17", "next": "012-19"}, "p19": {"key": "012-19", "title": "郊廟歌辭：武后大享拜洛樂章：又歸和", "author": "不詳", "canonical": "不詳", "lines": ["調雲闋兮神座興，驂雲駕兮儼將升。", "騰絳霄兮垂景佑，翹丹懇兮荷休征。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-18", "next": "012-20"}, "p20": {"key": "012-20", "title": "郊廟歌辭：祭方丘樂章：順和", "author": "不詳", "canonical": "不詳", "lines": ["坤厚載物，德柔垂祉。", "九域咸雍，四溟爲紀。", "敬因良節，虔修陰祀。", "廣樂式張，靈其降止。", "樂備金石，禮光尊俎。", "大享爰終，洪休是舉。", "雨零感節，雲飛應序。", "纓紱載辭，皇靈具舉。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-19", "next": "012-21"}, "p21": {"key": "012-21", "title": "郊廟歌辭：祭方丘樂章：金奏", "author": "不詳", "canonical": "不詳", "lines": ["坤元<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>，品物資生。", "神凝博厚，道協高明。", "列鎮五嶽，環流四瀛。", "于何不載，萬寶斯成。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-20", "next": "012-22"}, "p22": {"key": "012-22", "title": "郊廟歌辭：祭方丘樂章：順和", "author": "不詳", "canonical": "不詳", "lines": ["坤厚載物，德柔垂祉。", "九域咸雍，四溟爲紀。", "敬因良節，虔修陰祀。", "廣樂式張，靈其降止。", "樂備金石，禮光尊俎。", "大享爰終，洪休是舉。", "雨零感節，雲飛應序。", "纓紱載辭，皇靈具舉。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-21", "next": "012-23"}, "p23": {"key": "012-23", "title": "郊廟歌辭：祭汾陰樂章：順和", "author": "韓思複", "canonical": "韓思复", "lines": ["大樂和暢，殷薦明神。", "一降通感，八變必臻。", "有求斯應，無德不親。", "降靈醉止，休征萬人。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-22", "next": "012-24"}, "p24": {"key": "012-24", "title": "郊廟歌辭：祭汾陰樂章：太簇角", "author": "盧從願", "canonical": "盧從願", "lines": ["坤元載物，陽樂發生。", "播殖資始，品匯<a class=\"ent ent-time\" href=\"../entities/time_%E5%92%B8%E4%BA%A8.html\">咸亨</a>。", "列俎棋布，方壇砥平。", "神歆禋祀，後德惟明。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-23", "next": "012-25"}, "p25": {"key": "012-25", "title": "郊廟歌辭：祭汾陰樂章：姑洗征", "author": "劉晃", "canonical": "劉晃", "lines": ["大君出震，有事郊禋。", "齋戒既肅，馨香畢陳。", "樂和禮備，候暖風春。", "恭惟降福，實賴明神。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-24", "next": "012-26"}, "p26": {"key": "012-26", "title": "郊廟歌辭：祭汾陰樂章：南呂羽", "author": "韓休", "canonical": "韓休", "lines": ["于穆浚哲，維清緝熙。", "肅事昭配，永言孝思。", "滌濯靜嘉，馨香在茲。", "神之聽之，用受福厘。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-25", "next": "012-27"}, "p27": {"key": "012-27", "title": "郊廟歌辭：祭汾陰樂章：太和", "author": "王晙", "canonical": "王晙", "lines": ["于穆聖皇，六葉重光。", "<a class=\"ent ent-place\" href=\"../entities/place_%E5%A4%AA%E5%8E%9F.html\">太原</a>刻頌，後土疏場。", "寶鼎呈符，歊雲孕祥。", "禮樂備矣，降福穰穰。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-26", "next": "012-28"}, "p28": {"key": "012-28", "title": "郊廟歌辭：祭汾陰樂章：肅和", "author": "崔玄童", "canonical": "崔玄童", "lines": ["聿修嚴配，展事禋宗。", "祥符寶鼎，禮備黃琮。", "[祝]詞以信，明德惟聰。", "介茲<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E7%A6%8F.html\">景福</a>，永永無窮。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-27", "next": "012-29"}, "p29": {"key": "012-29", "title": "郊廟歌辭：祭汾陰樂章：雍和", "author": "賈曾", "canonical": "賈曾", "lines": ["蠲我饎餴，絜我膋薌。", "有豆孔碩，為羞既臧。", "至誠無昧，精意惟芳。", "神其醉止，欣欣樂康。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-28", "next": "012-30"}, "p30": {"key": "012-30", "title": "郊廟歌辭：祭汾陰樂章：壽和", "author": "蘇頲", "canonical": "蘇頲", "lines": ["禮物斯具，樂章乃陳。", "誰其作主，皇考聖真。", "對越在天，聖明佐神。", "窅然汾上，厚澤如春。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-29", "next": "012-31"}, "p31": {"key": "012-31", "title": "郊廟歌辭：祭汾陰樂章：舒和", "author": "何鸞", "canonical": "何鸞", "lines": ["樂奏雲闋，禮章載虔。", "禋宗於地，昭假於天。", "惟馨薦矣，既醉歆焉。", "神之降福，永永萬年。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-30", "next": "012-32"}, "p32": {"key": "012-32", "title": "郊廟歌辭：祭汾陰樂章：凱安", "author": "蔣挺", "canonical": "蔣挺", "lines": ["維歲之吉，維辰之良。", "聖君紱冕，肅事壇場。", "大禮已備，大樂斯[張]。", "神其醉止，降福無疆。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-31", "next": "012-33"}, "p33": {"key": "012-33", "title": "郊廟歌辭：祭汾陰樂章：順和", "author": "源光裕", "canonical": "源光裕", "lines": ["方丘既膳，嘉饗載謐。", "齊敬畢誠，陶匏貴質。", "秀畢豐薦，芳俎盈實。", "永永福流，其升如日。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-32", "next": "012-34"}, "p34": {"key": "012-34", "title": "郊廟歌辭：禪社首樂章：順和", "author": "不詳", "canonical": "不詳", "lines": ["至哉含柔德，萬物資以生。", "常順稱厚載，流謙通變盈。", "聖心事能察，增廣陳厥誠。", "黃祇僾如在，泰折俟<a class=\"ent ent-time\" href=\"../entities/time_%E5%92%B8%E4%BA%A8.html\">咸亨</a>。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "012-33", "next": "012-35"}, "p35": {"key": "012-35", "title": "郊廟歌辭：禪社首樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["肅我成命，于昭黃祇。", "裘冕而祀，陟降在斯。", "五音克備，八音聿施。", "緝熙肆靖，厥心匪離。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-34", "next": "012-36"}, "p36": {"key": "012-36", "title": "郊廟歌辭：禪社首樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["黃祇是祗，我其夙夜。", "寅畏誠絜，匪遑寧舍。", "禮以琮玉，薦厥茅藉。", "念茲降康，胡寧克暇。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-35", "next": "012-37"}, "p37": {"key": "012-37", "title": "郊廟歌辭：禪社首樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["夙夜宥密，不敢寧宴。", "五齊既陳，八音在縣。", "粢盛以潔，房俎斯薦。", "惟德惟馨，尚茲克遍。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-36", "next": "012-38"}, "p38": {"key": "012-38", "title": "郊廟歌辭：禪社首樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["惟以明發，有懷載殷。", "樂盈而反，禮順其禋。", "立清以獻，薦欲是親。", "于穆不已，裒對斯臻。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-37", "next": "012-39"}, "p39": {"key": "012-39", "title": "郊廟歌辭：禪社首樂章：福和", "author": "不詳", "canonical": "不詳", "lines": ["穆穆天子，告成岱宗。", "大裘如濡，執珽有顒。", "樂以平志，禮以和容。", "上帝臨我，雲胡肅邕。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-38", "next": "012-40"}, "p40": {"key": "012-40", "title": "郊廟歌辭：禪社首樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["昭昭有唐，天俾萬國。", "列祖應命，四宗順則。", "申錫無疆，宗我同德。", "曾孫繼序，享神配極。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-39", "next": "012-41"}, "p41": {"key": "012-41", "title": "郊廟歌辭：禪社首樂章：靈具醉", "author": "不詳", "canonical": "不詳", "lines": ["靈具醉，杳熙熙。", "靈將往，眇禗禗。", "顧明德，吐正辭。", "爛遺光，流禎祺。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-40", "next": "012-42"}, "p42": {"key": "012-42", "title": "郊廟歌辭：祭神州樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["大矣坤儀，至哉神縣。", "包含日域，牢籠月竁。", "露絜三清，風調六變。", "皇祇介祉，式歆恭薦。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-41", "next": "012-43"}, "p43": {"key": "012-43", "title": "郊廟歌辭：祭神州樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["泰折嚴享，陰郊展敬。", "禮以導神，樂以和性。", "黝牲在列，黃琮俯映。", "九土既平，萬邦貽慶。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-42", "next": "012-44"}, "p44": {"key": "012-44", "title": "郊廟歌辭：祭神州樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["坤道降祥和庶品，靈心載德厚群生。", "水土既調三極泰，文武畢備九區平。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-43", "next": "012-45"}, "p45": {"key": "012-45", "title": "郊廟歌辭：祭神州樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["黃輿厚載，赤寰歸德。", "含育九區，保安萬國。", "誠敬無怠，禋祀有則。", "樂以迎神，其儀不忒。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-44", "next": "012-46"}, "p46": {"key": "012-46", "title": "郊廟歌辭：祭神州樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["神州陰祀，洪恩廣濟。", "草樹沾和，飛沉沐惠。", "禮修鼎俎，奠歆瑤幣。", "送樂有章，靈軒其逝。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-45", "next": "012-47"}, "p47": {"key": "012-47", "title": "郊廟歌辭：祭太社樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["後土凝德，神功協契。", "九域底平，兩儀交際。", "戊期應序，陰墉展幣。", "靈車少留，俯歆樽桂。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-46", "next": "012-48"}, "p48": {"key": "012-48", "title": "郊廟歌辭：祭太社樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["美報崇本，嚴恭展事。", "受露疏壇，承風啟地。", "絜粢登俎，醇犧入饋。", "介福遠流，群生畢遂。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-47", "next": "012-49"}, "p49": {"key": "012-49", "title": "郊廟歌辭：祭太社樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["神道發生敷九稼，陰極乘仁暢八埏。", "緯武經文隆景化，登祥薦祉啟豐年。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-48", "next": "012-50"}, "p50": {"key": "012-50", "title": "郊廟歌辭：祭太社樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["烈山有子，後土有臣。", "播種百穀，濟育兆人。", "春官緝禮，宗伯司禋。", "戊為吉日，迎享茲辰。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-49", "next": "012-51"}, "p51": {"key": "012-51", "title": "郊廟歌辭：祭太社樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["吉祥式就，酬功載畢。", "親地尊天，禮文經術。", "貺征令序，福流初日。", "神馭爰歸，祠官其出。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-50", "next": "012-52"}, "p52": {"key": "012-52", "title": "郊廟歌辭：蠟百神樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["序迫歲陰，日躔星紀。", "爰稽茂典，聿崇清祀。", "綺幣霞舒，瑞珪虹起。", "百禩垂裕，萬靈薦祉。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-51", "next": "012-53"}, "p53": {"key": "012-53", "title": "郊廟歌辭：蠟百神樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["緹鑰勁序，玄英晚候。", "姬蠟開儀，豳歌入奏。", "蕙馥雕俎，蘭芬玉酎。", "大享明祇，永綏多佑。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-52", "next": "012-54"}, "p54": {"key": "012-54", "title": "郊廟歌辭：蠟百神樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["經緯兩儀文化洽，削平方域武功成。", "瑤弦自樂乾坤泰，玉戚長歡區宇寧。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-53", "next": "012-55"}, "p55": {"key": "012-55", "title": "郊廟歌辭：蠟百神樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["八蠟開祭，萬物合祀。", "上極天維，下窮坤紀。", "鼎俎流芬，樽彝薦美。", "有靈有祇，咸希來止。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-54", "next": "012-56"}, "p56": {"key": "012-56", "title": "郊廟歌辭：蠟百神樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["十旬歡洽，一日祠終。", "澄彝拂俎，報德酬功。", "慮虔容肅，禮縟儀豐。", "神其降祉，整馭隨風。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-55", "next": "012-57"}, "p57": {"key": "012-57", "title": "郊廟歌辭：享先農樂章：咸和", "author": "不詳", "canonical": "不詳", "lines": ["粒食伊始，農之所先。", "古今攸賴，是曰人天。", "耕斯帝籍，播厥公田。", "式崇明祀，神其福焉。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-56", "next": "012-58"}, "p58": {"key": "012-58", "title": "郊廟歌辭：享先農樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["樽彝既列，瑚簋方薦。", "歌工載登，幣禮斯奠。", "肅肅享祀，顒顒纓弁。", "神之聽之，福流寰縣。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-57", "next": "012-59"}, "p59": {"key": "012-59", "title": "郊廟歌辭：享先農樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["前夕視牲，質明奉俎。", "沐芳整弁，其儀式序。", "盛禮畢陳，嘉樂備舉。", "歆我懿德，非馨稷黍。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-58", "next": "012-60"}, "p60": {"key": "012-60", "title": "郊廟歌辭：享先農樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["羽鑰低昂文綴已，幹戚蹈厲武行初。", "望歲祈農神所聽，延祥介福豈雲虛。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-59", "next": "012-61"}, "p61": {"key": "012-61", "title": "郊廟歌辭：享先農樂章：咸和", "author": "不詳", "canonical": "不詳", "lines": ["三推禮就，萬庾祈凝。", "夤賓志遠，藨袞惟興。", "降歆肅薦，垂佑祗膺。", "送神有樂，神其上升。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-60", "next": "012-62"}, "p62": {"key": "012-62", "title": "郊廟歌辭：享先蠶樂章：永和", "author": "不詳", "canonical": "不詳", "lines": ["芳春開令序，韶苑暢和風。", "惟靈申廣佑，利物表神功。", "綺會周天宇，黼黻藻寰中。", "庶幾承慶節，歆奠下帷宮。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "012-61", "next": "012-63"}, "p63": {"key": "012-63", "title": "郊廟歌辭：享先蠶樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["明靈光<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>，深功掩百神。", "祥源應節啟，福緒逐年新。", "萬宇承恩覆，七廟佇恭禋。", "于茲申至懇，方期遠慶臻。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "012-62", "next": "012-64"}, "p64": {"key": "012-64", "title": "郊廟歌辭：享先蠶樂章：展敬", "author": "不詳", "canonical": "不詳", "lines": ["霞莊列寶衛，雲集動和聲。", "金卮薦綺席，玉幣委芳庭。", "因心罄丹款，先己勵蒼生。", "所冀延明福，于茲享至誠。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "012-63", "next": "012-65"}, "p65": {"key": "012-65", "title": "郊廟歌辭：享先蠶樂章：絜誠", "author": "不詳", "canonical": "不詳", "lines": ["桂筵開玉俎，蘭圃薦瓊芳。", "八音調鳳曆，三獻奉鸞觴。", "絜粢申大享，庭宇冀降祥。", "神其覃有慶，契福永無疆。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "012-64", "next": "012-66"}, "p66": {"key": "012-66", "title": "郊廟歌辭：享先蠶樂章：昭慶", "author": "不詳", "canonical": "不詳", "lines": ["仙壇禮既畢，神駕儼將升。", "佇屬深祥起，方期庶績凝。", "虔誠資宇內，務本勖黎蒸。", "靈心昭備享，率土洽休征。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "012-65", "next": "012-67"}, "p67": {"key": "012-67", "title": "郊廟歌辭：釋奠文宣王樂章：誠和", "author": "不詳", "canonical": "不詳", "lines": ["聖道日用，神幾不測。", "金石以陳，弦歌載陟。", "爰釋其菜，匪馨於稷。", "來顧來享，是宗是極。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-66", "next": "012-68"}, "p68": {"key": "012-68", "title": "郊廟歌辭：釋奠文宣王樂章：承和", "author": "不詳", "canonical": "不詳", "lines": ["萬國以貞光上嗣，三善茂德表重輪。", "視膳寢門尊要道，高辟崇賢引正人。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-67", "next": "012-69"}, "p69": {"key": "012-69", "title": "郊廟歌辭：釋奠文宣王樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["粵惟上聖，有縱自天。", "傍周萬物，俯應千年。", "舊章允著，嘉贄孔虔。", "王化茲首，儒風是宣。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-68", "next": "012-70"}, "p70": {"key": "012-70", "title": "郊廟歌辭：釋奠文宣王樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["堂獻瑤篚，庭敷璆縣。", "禮備其容，樂和其變。", "肅肅親享，雍雍執奠。", "明德惟馨，蘋蘩可薦。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-69", "next": "012-71"}, "p71": {"key": "012-71", "title": "郊廟歌辭：釋奠文宣王樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["隼集龜開昭聖烈，龍蹲鳳跱肅神儀。", "尊儒敬業宏圖闡，緯武經文盛德施。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "012-70", "next": "012-72"}, "p72": {"key": "012-72", "title": "郊廟歌辭：享孔子廟樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["通吳表聖，問老探真。", "三千弟子，五百賢人。", "億齡規法，萬載嗣禋。", "潔誠以祭，奏樂迎神。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-71", "next": "012-73"}, "p73": {"key": "012-73", "title": "郊廟歌辭：享孔子廟樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["醴溢犧象，羞陳俎豆。", "魯壁類聞，泗川如覯。", "裏校覃福，胄筵承佑。", "雅樂清音，送神具奏。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-72", "next": "012-74"}, "p74": {"key": "012-74", "title": "郊廟歌辭：釋奠武成王樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["蔔畋不從，兆發非熊。", "乃傾荒政，爰佐一戎。", "盛烈載垂，命祀惟崇。", "日練上戊，宿嚴閟宮。", "迎奏嘉至，感而遂通。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-73", "next": "012-75"}, "p75": {"key": "012-75", "title": "郊廟歌辭：釋奠武成王樂章：奠幣登歌", "author": "不詳", "canonical": "不詳", "lines": ["管磬升，膻薌集。", "上公進，嘉幣執。", "信以通，僾如及。", "恢帝功，錫後邑。", "四維張，百度立。", "綿億載，邈難挹。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-74", "next": "012-76"}, "p76": {"key": "012-76", "title": "郊廟歌辭：釋奠武成王樂章：迎俎酌獻", "author": "不詳", "canonical": "不詳", "lines": ["五齊潔，九牢碩。", "梡橛循，罍斝滌。", "進具物，揚鴻績。", "和奏發，高靈寂。", "虔告終，繁祉錫。", "昭秩祀，永無易。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-75", "next": "012-77"}, "p77": {"key": "012-77", "title": "郊廟歌辭：釋奠武成王樂章：亞獻終獻", "author": "不詳", "canonical": "不詳", "lines": ["貳觴以獻，三變其終。", "顧此非馨，尚達斯衷。", "茅縮可致，"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-76", "next": "012-78"}, "p78": {"key": "012-78", "title": "郊廟歌辭：釋奠武成王樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["明祀方終，備樂斯闋。", "黝纁就瘞，豆籩告撤。", "肸蚃尚餘，光<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E4%BA%91.html\">景雲</a>滅。", "返歸虛極，神心則悅。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "012-77", "next": "012-79"}, "p79": {"key": "012-79", "title": "郊廟歌辭：享龍池樂章：第一章", "author": "姚崇", "canonical": "姚崇", "lines": ["恭聞帝里生靈沼，應報明君鼎業新。", "既協翠泉光寶命，還符白水出真人。", "此時舜海潛龍躍，此地堯河帶馬巡。", "獨有前池一小雁，叨承舊惠入天津。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-78", "next": "012-80"}, "p80": {"key": "012-80", "title": "郊廟歌辭：享龍池樂章：第二章", "author": "蔡孚", "canonical": "蔡孚", "lines": ["帝宅王家大道邊，神馬龍龜涌聖泉。", "昔日昔時經此地，看來看去漸成川。", "歌臺舞榭宜正月，柳岸梅洲勝往年。", "莫言波上春雲少，祗爲從龍直上天。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-79", "next": "012-81"}, "p81": {"key": "012-81", "title": "郊廟歌辭：享龍池樂章：第三章", "author": "沈佺期", "canonical": "沈佺期", "lines": ["龍池躍龍龍已飛，龍德[光]天天不違。", "池開天漢分黃道，龍向天門入紫微。", "邸第樓臺多氣色，君王鳧雁有光輝。", "爲報寰中百川水，來朝此地莫東歸。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-80", "next": "012-82"}, "p82": {"key": "012-82", "title": "郊廟歌辭：享龍池樂章：第四章", "author": "盧懷慎", "canonical": "盧懷慎", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E4%BB%A3%E9%82%B8.html\">代邸</a>東南龍躍泉，清漪碧浪遠浮天。", "樓臺影就波中出，日月光疑鏡裏懸。", "雁沼回流成舜海，龜書薦祉應堯年。", "大川既濟慙爲檝，報德空思奉細涓。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-81", "next": "012-83"}, "p83": {"key": "012-83", "title": "郊廟歌辭：享龍池樂章：第五章", "author": "姜皎", "canonical": "姜皎", "lines": ["龍池初出此龍山，常經此地謁龍顏。", "日日芙蓉生夏水，年年楊柳變春灣。", "堯壇寶匣餘煙霧，舜海漁舟尚往還。", "願似飄颻五雲影，從來從去九天間。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-82", "next": "012-84"}, "p84": {"key": "012-84", "title": "郊廟歌辭：享龍池樂章：第六章", "author": "崔日用", "canonical": "崔日用", "lines": ["龍興白水漢興符，聖主時乘運斗樞。", "岸上丰茸五花樹，波中的皪千金珠。", "操環昔聞迎夏啓，發匣先來瑞有虞。", "風色雲光隨隱見，赤雲神化象江湖。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-83", "next": "012-85"}, "p85": {"key": "012-85", "title": "郊廟歌辭：享龍池樂章：第七章", "author": "蘇頲", "canonical": "蘇頲", "lines": ["西京鳳邸躍龍泉，佳氣休光鎮在天。", "軒后霧圖今已得，<a class=\"ent ent-person\" href=\"../entities/person_%E7%A7%A6%E7%8E%8B.html\">秦王</a>水劒昔常傳。", "恩魚不似<a class=\"ent ent-nation\" href=\"../entities/nation_%E6%98%86%E6%98%8E.html\">昆明</a>釣，瑞鶴長如太液仙。", "願侍巡游同舊里，更聞簫鼓濟樓船。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-84", "next": "012-86"}, "p86": {"key": "012-86", "title": "郊廟歌辭：享龍池樂章：第八章", "author": "李乂", "canonical": "李乂", "lines": ["星分邑里四人居，水洊源流萬頃餘。", "魏國君王稱象處，晉家藩邸化龍初。", "青蒲暫似遊梁馬，綠藻還疑宴鎬魚。", "自有神靈滋液地，年年雲物史官書。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-85", "next": "012-87"}, "p87": {"key": "012-87", "title": "郊廟歌辭：享龍池樂章：第九章", "author": "薑晞", "canonical": "薑晞", "lines": ["靈沼縈回邸第前，浴日涵天寫曙天。", "始見龍台升鳳闕，", "欲化帝圖從此受，正同河變一千年。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "012-86", "next": "012-88"}, "p88": {"key": "012-88", "title": "郊廟歌辭：享龍池樂章：第十章", "author": "裴璀", "canonical": "裴璀", "lines": ["乾坤啓聖吐龍泉，泉水年年勝一年。", "始看魚躍方成海，即覩龍飛利在天。", "洲渚遙將銀漢接，樓臺直與紫微連。", "休氣榮光常不散，懸知此地是神仙。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "012-87", "next": null}}}