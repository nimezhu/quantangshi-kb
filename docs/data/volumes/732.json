{"vol_name": "卷七百三十二", "poems": {"p01": {"key": "732-01", "title": "感巫州薺菜", "author": "高力士", "canonical": "高力士", "lines": ["兩京作斤賣，五溪無人采。", "夷夏雖有殊，氣味都不改。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "732-02"}, "p02": {"key": "732-02", "title": "句", "author": "高力士", "canonical": "高力士", "lines": ["煙熏眼落膜，瘴染面朱虞。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "732-01", "next": "732-03"}, "p03": {"key": "732-03", "title": "使至灊山", "author": "王越賓", "canonical": "王越賓", "lines": ["碧塢煙霞晝未開，遊人到處盡裴回。", "憑誰借問岩前叟，曾托吾皇一夢來。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-02", "next": "732-04"}, "p04": {"key": "732-04", "title": "和武相公中秋夜西蜀錦樓望月得清字", "author": "王良會", "canonical": "王良會", "lines": ["德星搖此夜，珥耳滿重城。", "杳靄煙氛色，飄颻砧杵聲。", "令行秋氣爽，樂感素風輕。", "共賞千年聖，長歌四海清。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "732-03", "next": "732-05"}, "p05": {"key": "732-05", "title": "星回節遊避風台與清平官賦", "author": "南詔驃信", "canonical": "南詔驃信", "lines": ["避風善闡台，極目見藤越。", "悲哉古與今，依然煙與月。", "自我居震旦，翊衛類夔契。", "伊昔頸皇運，艱難仰忠烈。", "不覺歲雲暮，感極星回節。", "元昶同一心，子孫堪貽厥。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "732-04", "next": "732-06"}, "p06": {"key": "732-06", "title": "星回節避風台驃信命賦", "author": "趙叔達", "canonical": "趙叔達", "lines": ["法駕避星回，波羅毗勇猜。", "河潤冰難合，地暖梅先開。", "下令俚柔洽，獻賝弄棟來。", "願將不才質，千載侍遊台。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "732-05", "next": "732-07"}, "p07": {"key": "732-07", "title": "途中詩", "author": "楊奇鯤", "canonical": "楊奇鯤", "lines": ["<span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span>，<span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span>。", "風裏浪花吹更白，雨<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%AD%E5%B1%B1.html\">中山</a>色洗還青。", "海鷗聚處窗前見，林狖啼時枕上聽。", "此際自然無限趣，王程不敢暫留停。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "732-06", "next": "732-08"}, "p08": {"key": "732-08", "title": "聽妓洞雲歌", "author": "布燮", "canonical": "布燮", "lines": ["嵇叔夜，鼓琴飲酒無閑暇。", "若使當時聞此歌，拋擲<a class=\"ent ent-place\" href=\"../entities/place_%E5%B9%BF%E9%99%B5.html\">廣陵</a>都不藉。", "劉伯倫，虛生浪死過青春。", "一飲一碩猶自醉，無人爲爾卜深塵。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "732-07", "next": "732-09"}, "p09": {"key": "732-09", "title": "思鄉作", "author": "布燮", "canonical": "布燮", "lines": ["瀘北行人絕，雲南信未還。", "庭前花不掃，門外柳誰攀。", "坐久銷銀燭，愁多減玉顏。", "懸心秋夜月，萬里照關山。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "732-08", "next": "732-10"}, "p10": {"key": "732-10", "title": "銜命還國作", "author": "朝衡", "canonical": "朝衡", "lines": ["銜命將辭國，非才忝侍臣。", "天中戀明主，海外憶慈親。", "伏奏違金闕，騑驂去玉津。", "蓬萊鄉路遠，若木故園林。", "西望懷恩日，東歸感義辰。", "平生一寶劍，留贈結交人。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "732-09", "next": "732-11"}, "p11": {"key": "732-11", "title": "繡袈裟衣緣", "author": "長屋", "canonical": "長屋", "lines": ["山川異域，風月同天。", "寄諸佛子，共結來緣。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "732-10", "next": "732-12"}, "p12": {"key": "732-12", "title": "憤怨詩", "author": "王巨仁", "canonical": "王巨仁", "lines": ["於公慟哭三年旱，鄒衍含愁五月霜。", "今我幽愁還似古，皇天無語但蒼蒼。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-11", "next": "732-13"}, "p13": {"key": "732-13", "title": "立木海上刻詩", "author": "李贊華", "canonical": "李贊華", "lines": ["小山壓大山，大山全無力。", "羞見故鄉人，從此投外國。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-12", "next": "732-14"}, "p14": {"key": "732-14", "title": "戲語", "author": "成輔端", "canonical": "成輔端", "lines": ["秦地城池二百年，何期如此賤田園。", "一頃麥苗碩伍米，三間堂屋二千錢。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-13", "next": "732-15"}, "p15": {"key": "732-15", "title": "萬壽寺歌詞", "author": "張隱", "canonical": "張隱", "lines": ["位乖燮理致傷殘，四面牆匡不忍看。", "正是花時堪下淚，相公何必更追歡。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-14", "next": "732-16"}, "p16": {"key": "732-16", "title": "迎孫刺史", "author": "朱元", "canonical": "朱元", "lines": ["昔日郎君今刺史，朱元依舊守朱門。", "今朝竹馬諸童子，儘是當時竹馬孫。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-15", "next": "732-17"}, "p17": {"key": "732-17", "title": "臨刑詩", "author": "陳璠", "canonical": "陳璠", "lines": ["積玉堆金官又崇，禍來倏忽變成空。", "五年榮貴今何在，不異南柯一夢中。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-16", "next": "732-18"}, "p18": {"key": "732-18", "title": "詩", "author": "捧劍僕", "canonical": "捧劍僕", "lines": ["青鳥銜葡萄，飛上金井欄。", "美人恐驚去，不敢捲簾看。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-17", "next": "732-19"}, "p19": {"key": "732-19", "title": "題牡丹", "author": "捧劍僕", "canonical": "捧劍僕", "lines": ["一種芳菲出後庭，卻輸桃李得佳名。", "誰能為向天人說，從此移根近太清。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "732-18", "next": "732-20"}, "p20": {"key": "732-20", "title": "將竄留詩", "author": "捧劍僕", "canonical": "捧劍僕", "lines": ["珍重郭四郎，臨行不得別。", "曉漏動離心，輕車冒殘雪。", "欲出主人門，零涕暗嗚咽。", "萬里隔關山，一心思漢月。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "732-19", "next": null}}}