{"vol_name": "卷五百七十九", "poems": {"p01": {"key": "579-01", "title": "車駕西遊因而有作", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["宣曲長楊瑞氣凝，<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%8A%E6%9E%97.html\">上林</a>狐兔待秋鷹。", "誰將詞賦陪雕輦，寂寞<a class=\"ent ent-person\" href=\"../entities/person_%E7%9B%B8%E5%A6%82.html\">相如</a>臥茂林。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "579-02"}, "p02": {"key": "579-02", "title": "傷溫德彝", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["昔年戎虜犯榆關，一敗龍城匹馬還。", "侯印不聞封<a class=\"ent ent-person\" href=\"../entities/person_%E6%9D%8E%E5%B9%BF.html\">李廣</a>，他人丘壟似天山。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-01", "next": "579-03"}, "p03": {"key": "579-03", "title": "贈少年", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["江海相逢客恨多，秋風葉下<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9E%E5%BA%AD.html\">洞庭</a>波。", "酒酣夜別<a class=\"ent ent-place\" href=\"../entities/place_%E6%B7%AE%E9%98%B4.html\">淮陰</a>市，月照高樓一曲歌。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-02", "next": "579-04"}, "p04": {"key": "579-04", "title": "贈鄭征君家匡山首春與丞相贊皇公游止", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["一拋蘭棹逐燕鴻，曾向江湖識謝公。", "每到朱門還悵望，故山多在畫屏中。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-03", "next": "579-05"}, "p05": {"key": "579-05", "title": "夏中病痁作", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["山鬼揚威正氣愁，便辭珍簟襲狐裘。", "西窗一夕悲人事，團扇無情不待秋。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-04", "next": "579-06"}, "p06": {"key": "579-06", "title": "題友人居", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["盡日松堂看畫圖，綺疏岑寂似清都。", "若教煙水無鷗鳥，張翰何由到<a class=\"ent ent-place\" href=\"../entities/place_%E4%BA%94%E6%B9%96.html\">五湖</a>。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-05", "next": "579-07"}, "p07": {"key": "579-07", "title": "題李相公敕賜錦屏風", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["豐沛曾為社稷臣，賜書名畫墨猶新。", "幾人同保山河誓，猶自棲棲九陌塵。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-06", "next": "579-08"}, "p08": {"key": "579-08", "title": "蔡中郎墳", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["古墳零落野花春，聞說中郎有後身。", "今日愛才非昔日，莫拋心力作詞人。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-07", "next": "579-09"}, "p09": {"key": "579-09", "title": "元處士池上", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["蓼穗菱叢思蟪蛄，水螢江鳥滿煙蒲。", "愁紅一片風前落，池上秋波似<a class=\"ent ent-place\" href=\"../entities/place_%E4%BA%94%E6%B9%96.html\">五湖</a>。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-08", "next": "579-10"}, "p10": {"key": "579-10", "title": "華陰韋氏林亭", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["自有林亭不得閒，陌塵宮樹是非間。", "<a class=\"ent ent-place\" href=\"../entities/place_%E7%BB%88%E5%8D%97.html\">終南</a>長在茅簷外，別向人間看<a class=\"ent ent-place\" href=\"../entities/place_%E5%8D%8E%E5%B1%B1.html\">華山</a>。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-09", "next": "579-11"}, "p11": {"key": "579-11", "title": "寄裴生乞釣鉤", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["一隨菱棹謁王侯，深愧移文負釣舟。", "今日太湖風色好，卻將詩句乞魚鉤。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-10", "next": "579-12"}, "p12": {"key": "579-12", "title": "長安春晚二首", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E6%9B%B2%E6%B1%9F.html\">曲江</a>春半日遲遲，正是王孫悵望時。", "杏花落盡不歸去，江上東風吹柳絲。", "四方無事太平年，萬象鮮明禁火前。", "九重細雨惹春色，輕染龍池楊柳煙。"], "form": "七律", "t300": null, "src": "yuding", "pilot": false, "prev": "579-11", "next": "579-13"}, "p13": {"key": "579-13", "title": "三月十八日雪中作", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["芍藥薔薇語早梅，不知誰是豔陽才。", "今朝領得春風意，不復饒君雪裏開。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-12", "next": "579-14"}, "p14": {"key": "579-14", "title": "咸陽值雨", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E5%92%B8%E9%98%B3.html\">咸陽</a>橋上雨如懸，萬點空蒙隔釣船。", "還似<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9E%E5%BA%AD.html\">洞庭</a>春水色，曉雲將入岳陽天。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-13", "next": "579-15"}, "p15": {"key": "579-15", "title": "彈箏人", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["<a class=\"ent ent-time\" href=\"../entities/time_%E5%A4%A9%E5%AE%9D.html\">天寶</a>年中事玉皇，曾將新曲教甯王。", "鈿蟬金雁今零落，一曲伊州淚萬行。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-14", "next": "579-16"}, "p16": {"key": "579-16", "title": "瑤瑟怨", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["冰簟銀床夢不成，碧天如水夜雲輕。", "雁聲遠過<a class=\"ent ent-place\" data-note=\"雁声远过\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>去，<span class=\"ent ent-place\" data-note=\"仙人十二楼\">十二樓</span>中月自明。"], "form": "七絕", "t300": ["离别", "七言绝句", "闺怨"], "src": "yuding", "pilot": true, "prev": "579-15", "next": "579-17"}, "p17": {"key": "579-17", "title": "題端正樹", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["路傍佳樹碧雲愁，曾侍金輿幸驛樓。", "草木榮枯似人事，綠陰寂寞漢陵秋。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-16", "next": "579-18"}, "p18": {"key": "579-18", "title": "渭上題三首", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["呂公榮達子陵歸，萬古煙波繞釣磯。", "橋上一通名利跡，至今江鳥背人飛。", "目極雲霄思浩然，風帆一片水連天。", "輕橈便是東歸路，不肯忘機作釣船。", "煙水何曾息世機，暫時相向亦依依。", "所嗟白首磻溪叟，一下漁舟更不歸。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "579-17", "next": "579-19"}, "p19": {"key": "579-19", "title": "經故翰林袁學士居", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["劍逐驚波玉委塵，謝安門下更何人。", "西州城外花千樹，儘是羊曇醉後春。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-18", "next": "579-20"}, "p20": {"key": "579-20", "title": "題城南杜邠公林亭", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["卓氏壚前金線柳，隋家堤畔錦帆風。", "貪為兩地分霖雨，不見池蓮照水紅。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-19", "next": "579-21"}, "p21": {"key": "579-21", "title": "夜看牡丹", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["高低深淺一闌紅，把火殷勤繞露叢。", "希逸近來成懶病，不能容易向春風。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-20", "next": "579-22"}, "p22": {"key": "579-22", "title": "宿城南亡友別墅", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["水流花落歎浮生，又伴遊人宿杜城。", "還似昔年殘夢裏，透簾斜月獨聞鶯。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-21", "next": "579-23"}, "p23": {"key": "579-23", "title": "過分水嶺", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["溪水無情似有情，入山三日得同行。", "嶺頭便是分頭處，惜別潺湲一夜聲。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-22", "next": "579-24"}, "p24": {"key": "579-24", "title": "鄠杜郊居", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["槿籬芳援近樵家，壟麥青青一徑斜。", "寂寞遊人<a class=\"ent ent-time\" href=\"../entities/time_%E5%AF%92%E9%A3%9F.html\">寒食</a>後，夜來風雨送梨花。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-23", "next": "579-25"}, "p25": {"key": "579-25", "title": "題河中紫極宮", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["昔年曾伴玉真遊，每到仙宮即是秋。", "曼倩不歸花落盡，滿叢煙露月當樓。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-24", "next": "579-26"}, "p26": {"key": "579-26", "title": "四皓", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E5%95%86%E4%BA%8E.html\">商於</a>甪裏便成功，一寸沉機萬古同。", "但得戚姬甘定分，不應真有紫芝翁。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-25", "next": "579-27"}, "p27": {"key": "579-27", "title": "贈張煉師", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["丹溪藥盡變金骨，清洛月寒吹玉笙。", "他日隱居無訪處，碧桃花發水縱橫。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "579-26", "next": null}}}