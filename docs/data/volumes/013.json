{"vol_name": "卷一十三", "poems": {"p01": {"key": "013-01", "title": "郊廟歌辭：享太廟樂章：永和", "author": "不詳", "canonical": "不詳", "lines": ["于穆烈祖，弘此丕基。", "永言配命，子孫保之。", "百神既洽，萬國在茲。", "是用孝享，神其格思。"], "form": "四言", "t300": null, "src": "yuding", "prev": null, "next": "013-02"}, "p02": {"key": "013-02", "title": "郊廟歌辭：享太廟樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["大哉<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>，允茲明聖。", "格於上下，聿遵誠敬。", "嘉樂斯登，鳴球以詠。", "神其降止，式隆景命。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-01", "next": "013-03"}, "p03": {"key": "013-03", "title": "郊廟歌辭：享太廟樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["崇茲享祀，誠敬兼至。", "樂以感靈，禮以昭事。", "粢盛咸絜，牲牷孔備。", "永言孝思，庶幾不匱。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-02", "next": "013-04"}, "p04": {"key": "013-04", "title": "郊廟歌辭：享太廟樂章：長髮舞", "author": "不詳", "canonical": "不詳", "lines": ["睿哲維唐，長髮其祥。", "帝命斯佑，王業克昌。", "配天載德，就日重光。", "本支百代，申錫無疆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-03", "next": "013-05"}, "p05": {"key": "013-05", "title": "郊廟歌辭：享太廟樂章：大基舞", "author": "不詳", "canonical": "不詳", "lines": ["猗與祖業，皇矣帝先。", "翦商德厚，封唐慶延。", "在姬猶稷，方晉喻宣。", "基我鼎運，于萬斯年。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-04", "next": "013-06"}, "p06": {"key": "013-06", "title": "郊廟歌辭：享太廟樂章：大成舞", "author": "不詳", "canonical": "不詳", "lines": ["周稱<a class=\"ent ent-person\" href=\"../entities/person_%E7%8E%8B%E5%AD%A3.html\">王季</a>，晉美帝文。", "明明盛德，穆穆齊芬。", "藏用四履，屈道三分。", "鏗鏘鐘石，載紀鴻勳。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-05", "next": "013-07"}, "p07": {"key": "013-07", "title": "郊廟歌辭：享太廟樂章：大明舞", "author": "不詳", "canonical": "不詳", "lines": ["五紀更運，三正遞升。", "勳華既沒，禹湯勃興。", "神武命代，靈眷是膺。", "望雲彰德，察緯告征。", "上紐天維，下安地軸。", "征師涿野，萬國咸服。", "偃伯靈台，九官允穆。", "殊域委贐，懷生介福。", "大禮既飾，大樂已和。", "黑章擾囿，赤字浮河。", "功宣載籍，德被詠歌。", "克昌厥後，百祿是荷。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-06", "next": "013-08"}, "p08": {"key": "013-08", "title": "郊廟歌辭：享太廟樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["八音斯奏，三獻畢陳。", "寶祚惟永，暉光日新。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-07", "next": "013-09"}, "p09": {"key": "013-09", "title": "郊廟歌辭：享太廟樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["聖敬通神光七廟，靈心薦祚和萬方。", "嚴禋克配鴻基遠，明德惟馨鳳曆昌。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "013-08", "next": "013-10"}, "p10": {"key": "013-10", "title": "郊廟歌辭：享太廟樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["于穆清廟，聿修嚴祀。", "四縣載陳，三獻斯止。", "籩豆徹薦，人祇介祉。", "神維格思，錫祚不已。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-09", "next": "013-11"}, "p11": {"key": "013-11", "title": "郊廟歌辭：享太廟樂章：永和", "author": "不詳", "canonical": "不詳", "lines": ["肅肅清祀，烝烝孝思。", "薦享昭備，虔恭在茲。", "雍歌徹俎，祝嘏陳辭。", "用光武志，永固鴻基。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-10", "next": "013-12"}, "p12": {"key": "013-12", "title": "郊廟歌辭：享太廟樂章：崇德舞", "author": "不詳", "canonical": "不詳", "lines": ["五運改蔔，千齡啟聖。", "彤雲曉聚，黃星夜映。", "葉闡珠囊，基開玉鏡。", "下臨萬宇，上齊七政。", "霧開三象，塵清九服。", "海溓星暉，遠安邇肅。", "天地交泰，華夷輯睦。", "翔泳歸仁，中外禔福。", "績逾黜夏，勳高翦商。", "武陳七德，刑設三章。", "祥禽巢閣，仁獸游梁。", "卜年惟永，<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E7%A6%8F.html\">景福</a>無疆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-11", "next": "013-13"}, "p13": {"key": "013-13", "title": "郊廟歌辭：享太廟樂章：鈞天舞", "author": "不詳", "canonical": "不詳", "lines": ["承天撫籙，纂聖登皇。", "遐清萬宇，仰協三光。", "功成日用，道濟時康。", "璿圖載永，<a class=\"ent ent-time\" href=\"../entities/time_%E5%AE%9D%E5%8E%86.html\">寶曆</a>斯昌。", "日月揚暉，煙雲爛色。", "河岳修貢，神祇效職。", "舜風攸偃，堯曦先就。", "睿感通寰，孝思浹宙。", "奉揚先德，虔遵曩狩。", "展義天扃，飛英雲岫。", "化逸王表，神凝帝先。", "乘雲厭俗，馭日登玄。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-12", "next": "013-14"}, "p14": {"key": "013-14", "title": "郊廟歌辭：享太廟樂章：太和舞", "author": "不詳", "canonical": "不詳", "lines": ["廣樂既備，嘉薦既新。", "述先惟德，孝饗惟親。", "七獻具舉，五齊畢陳。", "錫茲祚福，于萬斯春。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-13", "next": "013-15"}, "p15": {"key": "013-15", "title": "郊廟歌辭：享太廟樂章：景雲舞", "author": "不詳", "canonical": "不詳", "lines": ["惟睿作聖，惟聖登皇。", "精感耀魄，時膺<a class=\"ent ent-time\" href=\"../entities/time_%E4%BC%9A%E6%98%8C.html\">會昌</a>。", "舜慚大孝，堯推讓王。", "能事斯極，振古誰方。", "文明履運，車書同軌。", "巍巍赫赫，盡善盡美。", "衢室凝旒，大庭端扆。", "釋負之寄，事光復子。", "脫屣高天，登遐上玄。", "龍湖超忽，象野芊綿。", "遊衣複道，薦果初年。", "新廟奕奕，明德配天。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-14", "next": "013-16"}, "p16": {"key": "013-16", "title": "郊廟歌辭：享太廟樂章：光大舞", "author": "不詳", "canonical": "不詳", "lines": ["大業龍祉，徽音駿尊。", "潛居皇德，赫嗣天昆。", "展儀宗祖，重誠孝孫。", "春秋無極，享奏存存。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-15", "next": "013-17"}, "p17": {"key": "013-17", "title": "郊廟歌辭：享太廟樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["七廟觀德，百靈攸仰。", "俗荷財成，物資含養。", "道光執契，化籠提象。", "肅肅雍雍，神其來饗。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-16", "next": "013-18"}, "p18": {"key": "013-18", "title": "郊廟歌辭：享太廟樂章：金奏", "author": "不詳", "canonical": "不詳", "lines": ["肅肅清廟，巍巍盛唐。", "配天立極，累聖重光。", "樂和管磬，禮備烝嘗。", "永惟來格，降福無疆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-17", "next": "013-19"}, "p19": {"key": "013-19", "title": "郊廟歌辭：享太廟樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["五聲備奏，三獻終祠。", "車移鳳輦，旆轉虹旗。", "禮周籩豆，誠效虔祗。", "皇靈徙蹕，簪紳拜辭。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-18", "next": "013-20"}, "p20": {"key": "013-20", "title": "郊廟歌辭：武后享清廟樂章十首：第一", "author": "不詳", "canonical": "不詳", "lines": ["建清廟，贊玄功。", "擇吉日，展禋宗。", "樂已變，禮方崇。", "望神駕，降仙宮。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "013-19", "next": "013-21"}, "p21": {"key": "013-21", "title": "郊廟歌辭：武后享清廟樂章十首：第二", "author": "不詳", "canonical": "不詳", "lines": ["隆周創業，寶命惟新。", "敬宗茂典，爰表虔禋。", "聲明已備，文物斯陳。", "肅容如在，懇志方申。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-20", "next": "013-22"}, "p22": {"key": "013-22", "title": "郊廟歌辭：武后享清廟樂章十首：第三登歌", "author": "不詳", "canonical": "不詳", "lines": ["肅敷大禮，上謁尊靈。", "敬[陳]筐幣，載表丹誠。"], "form": "雜言", "t300": null, "src": "poet.tang", "prev": "013-21", "next": "013-23"}, "p23": {"key": "013-23", "title": "郊廟歌辭：武后享清廟樂章十首：第四迎神", "author": "不詳", "canonical": "不詳", "lines": ["敬奠蘋藻，式罄虔襟。", "潔誠斯展，佇降靈歆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-22", "next": "013-24"}, "p24": {"key": "013-24", "title": "郊廟歌辭：武后享清廟樂章十首：第五飲福", "author": "不詳", "canonical": "不詳", "lines": ["爰陳玉醴，式奠瓊漿。", "靈心有穆，介福無疆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-23", "next": "013-25"}, "p25": {"key": "013-25", "title": "郊廟歌辭：武后享清廟樂章十首：第六送文舞", "author": "不詳", "canonical": "不詳", "lines": ["帝圖草創，皇業初開。", "功高佐命，業贊雲雷。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-24", "next": "013-26"}, "p26": {"key": "013-26", "title": "郊廟歌辭：武后享清廟樂章十首：第七迎武舞", "author": "不詳", "canonical": "不詳", "lines": ["赫赫玄功被穹壤，皇皇<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>洽生靈。", "開基撥亂妖氛廓，佐命宣威海內清。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "013-25", "next": "013-27"}, "p27": {"key": "013-27", "title": "郊廟歌辭：武后享清廟樂章十首：第八武舞作", "author": "不詳", "canonical": "不詳", "lines": ["荷恩承顧托，執契恭臨撫。", "廟略靜邊荒，天兵耀神武。"], "form": "五絕", "t300": null, "src": "yuding", "prev": "013-26", "next": "013-28"}, "p28": {"key": "013-28", "title": "郊廟歌辭：武后享清廟樂章十首：第九徹俎", "author": "不詳", "canonical": "不詳", "lines": ["登歌已闋，獻禮方周。", "欽承<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E7%A6%8F.html\">景福</a>，肅奉鴻休。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-27", "next": "013-29"}, "p29": {"key": "013-29", "title": "郊廟歌辭：武后享清廟樂章十首：第十送神", "author": "不詳", "canonical": "不詳", "lines": ["大禮言畢，仙衛將歸。", "莫申丹懇，空瞻紫微。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-28", "next": "013-30"}, "p30": {"key": "013-30", "title": "郊廟歌辭：享太廟樂章：嚴和", "author": "不詳", "canonical": "不詳", "lines": ["肅肅清廟，赫赫玄猷。", "功高萬古，化奄十洲。", "中興丕業，上荷天休。", "祗奉先構，禮備懷柔。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-29", "next": "013-31"}, "p31": {"key": "013-31", "title": "郊廟歌辭：享太廟樂章：升和", "author": "不詳", "canonical": "不詳", "lines": ["顧惟菲薄，纂曆應期。", "中外同軌，<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%A4%B7%E7%8B%84.html\">夷狄</a>來思。", "樂用崇德，禮以陳詞。", "夕惕若厲，欽奉弘基。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-30", "next": "013-32"}, "p32": {"key": "013-32", "title": "郊廟歌辭：享太廟樂章：虔和", "author": "不詳", "canonical": "不詳", "lines": ["禮標薦鬯，肅事祠庭。", "敬申如在，敢托非馨。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-31", "next": "013-33"}, "p33": {"key": "013-33", "title": "郊廟歌辭：享太廟樂章：歆和", "author": "不詳", "canonical": "不詳", "lines": ["崇禋已備，粢盛聿修。", "潔誠斯展，鐘石方遒。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-32", "next": "013-34"}, "p34": {"key": "013-34", "title": "郊廟歌辭：享太廟樂章：承光舞", "author": "不詳", "canonical": "不詳", "lines": ["金相載穆，玉裕重輝。", "養德清禁，承光紫微。", "幹宮候色，震象增威。", "監國方永，賓天不歸。", "孝友自衷，溫文性與。", "龍樓正啟，鶴駕斯舉。", "丹扆流念，鴻名式序。", "中興考室，永陳彝俎。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-33", "next": "013-35"}, "p35": {"key": "013-35", "title": "郊廟歌辭：享太廟樂章：延和", "author": "不詳", "canonical": "不詳", "lines": ["巍巍累聖，穆穆重光。", "奄有區夏，祚啟隆唐。", "百蠻飲澤，萬國來王。", "本枝億載，鼎祚逾長。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-34", "next": "013-36"}, "p36": {"key": "013-36", "title": "郊廟歌辭：享太廟樂章：同和", "author": "不詳", "canonical": "不詳", "lines": ["惟聖配天敷盛禮，惟天為大闡洪名。", "恭禋展敬光先德，蘋藻申虔表志誠。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "013-35", "next": "013-37"}, "p37": {"key": "013-37", "title": "郊廟歌辭：享太廟樂章：寧和", "author": "不詳", "canonical": "不詳", "lines": ["炎馭失天綱，土德承天命。", "英猷被寰宇，懿躅隆邦政。", "七德已綏邊，九夷咸底定。", "景化覃遐邇，深仁洽翔泳。"], "form": "五律", "t300": null, "src": "yuding", "prev": "013-36", "next": "013-38"}, "p38": {"key": "013-38", "title": "郊廟歌辭：享太廟樂章：恭和", "author": "不詳", "canonical": "不詳", "lines": ["禮週三獻，樂闋九成。", "肅承靈福，悚惕兼盈。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-37", "next": "013-39"}, "p39": {"key": "013-39", "title": "郊廟歌辭：享太廟樂章：通和", "author": "不詳", "canonical": "不詳", "lines": ["祠容既畢，仙座爰興。", "停停鳳舉，靄靄雲升。", "長隆寶運，永錫休征。", "福覃貽厥，恩被黎蒸。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-38", "next": "013-40"}, "p40": {"key": "013-40", "title": "郊廟歌辭：享太廟樂章：昭和", "author": "不詳", "canonical": "不詳", "lines": ["道洽二儀交泰，時休四宇和平。", "環佩肅於庭實，鐘石揚乎頌聲。"], "form": "六言", "t300": null, "src": "yuding", "prev": "013-39", "next": "013-41"}, "p41": {"key": "013-41", "title": "郊廟歌辭：享太廟樂章：誠敬", "author": "不詳", "canonical": "不詳", "lines": ["顧惟菲質，忝位椒宮。", "虔奉蘋藻，肅事神宗。", "敢申誠絜，庶罄深衷。", "睟容有裕，靈享無窮。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-40", "next": "013-42"}, "p42": {"key": "013-42", "title": "郊廟歌辭：享太廟樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["月禮已周，雲和將變。", "爰獻其醑，載遷其奠。", "明德逾隆，非馨是薦。", "澤沾動植，仁覃宇縣。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-41", "next": "013-43"}, "p43": {"key": "013-43", "title": "郊廟歌辭：享太廟樂章：昭感", "author": "不詳", "canonical": "不詳", "lines": ["鏗鏘韶濩，肅穆神容。", "洪規赫赫，祠典雍雍。", "已週三獻，將乘六龍。", "虔誠有托，懇志無從。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-42", "next": "013-44"}, "p44": {"key": "013-44", "title": "郊廟歌辭：享太廟樂章：永和三章", "author": "不詳", "canonical": "不詳", "lines": ["肅九室，諧八音。", "歌皇慕，動神心。", "禮宿設，樂妙尋。", "聲明備，祼奠臨。", "律迓氣，音入玄。", "依玉幾，禦黼筵。", "聆愾息，僾周旋。", "九韶遍，百福傳。", "信工祝，永頌聲。", "來祖考，聽和平。", "相百辟，貢九瀛。", "神休委，帝孝成。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "013-43", "next": "013-45"}, "p45": {"key": "013-45", "title": "郊廟歌辭：享太廟樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["時文聖後，清廟肅邕。", "致誠勤薦，在貌思恭。", "玉節肆夏，金鏘五鐘。", "繩繩雲步，穆穆天容。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-44", "next": "013-46"}, "p46": {"key": "013-46", "title": "郊廟歌辭：享太廟樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["天子享孝，工歌溥將。", "躬祼鬱鬯，乃焚膋薌。", "臭以達陰，聲以求陽。", "奉時烝嘗，永代不忘。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-45", "next": "013-47"}, "p47": {"key": "013-47", "title": "郊廟歌辭：享太廟樂章：雍和二章", "author": "不詳", "canonical": "不詳", "lines": ["在滌嘉豢，麗碑敬牲。", "角握之牡，色純之騂。", "火傳陽燧，水溉陰精。", "<a class=\"ent ent-person\" href=\"../entities/person_%E5%A4%AA%E5%85%AC.html\">太公</a>胖俎，傅說和羹。", "俎豆有馥，粢盛絜豐。", "亦有和羹，既戒既平。", "鼓鐘管磬，肅唱和鳴。", "皇皇後祖，來我思成。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-46", "next": "013-48"}, "p48": {"key": "013-48", "title": "郊廟歌辭：享太廟樂章：文舞", "author": "不詳", "canonical": "不詳", "lines": ["聖謨九德，真言五千。", "慶集昌胄，符開帝先。", "高文杖鉞，克配彼天。", "三宗握鏡，六合渙然。", "帝其承祀，率禮罔愆。", "圖書霧出，日月清懸。", "舞形德類，詠諗功傳。", "黃龍蜿蟺，彩雲蹁躚。", "五行氣順，八佾風宣。", "介此百祿，於皇萬年。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-47", "next": "013-49"}, "p49": {"key": "013-49", "title": "郊廟歌辭：享太廟樂章：光大舞", "author": "不詳", "canonical": "不詳", "lines": ["肅肅藝祖，滔滔浚源。", "有雄玉劍，作鎮金門。", "玄王貽緒，<a class=\"ent ent-person\" href=\"../entities/person_%E5%90%8E%E7%A8%B7.html\">後稷</a>謀孫。", "肇禋九廟，四海來尊。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-48", "next": "013-50"}, "p50": {"key": "013-50", "title": "郊廟歌辭：享太廟樂章：長髮舞", "author": "不詳", "canonical": "不詳", "lines": ["具禮崇德，備樂承風。", "魏推幢主，周贈司空。", "不行而至，無成有終。", "神興王業，天歸帝功。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-49", "next": "013-51"}, "p51": {"key": "013-51", "title": "郊廟歌辭：享太廟樂章：大政舞", "author": "不詳", "canonical": "不詳", "lines": ["於赫元命，權輿帝文。", "天齊八柱，地半三分。", "宗廟觀德，笙鏞樂勳。", "封唐之兆，成天下君。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-50", "next": "013-52"}, "p52": {"key": "013-52", "title": "郊廟歌辭：享太廟樂章：大成舞", "author": "不詳", "canonical": "不詳", "lines": ["帝舞季曆，龍聖生昌。", "後歌有蟜，胎炎孕黃。", "天地合德，日月齊光。", "肅雍孝享，祚我萬方。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-51", "next": "013-53"}, "p53": {"key": "013-53", "title": "郊廟歌辭：享太廟樂章：大明舞", "author": "不詳", "canonical": "不詳", "lines": ["赤精亂德，四海困窮。", "黃旗舉義，三靈會同。", "旱望春雨，雲披大風。", "溥天來祭，高祖之功。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-52", "next": "013-54"}, "p54": {"key": "013-54", "title": "郊廟歌辭：享太廟樂章：崇德舞", "author": "不詳", "canonical": "不詳", "lines": ["皇合一德，朝宗百神。", "削平天地，大拯生人。", "上帝配食，<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%8D%95%E4%BA%8E.html\">單于</a>入臣。", "戎歌陳舞，曄曄震震。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-53", "next": "013-55"}, "p55": {"key": "013-55", "title": "郊廟歌辭：享太廟樂章：鈞天舞", "author": "不詳", "canonical": "不詳", "lines": ["高皇邁道，端拱無為。", "化懷獯鬻，兵賦句驪。", "禮尊封禪，樂盛來儀。", "合位媧後，同稱伏羲。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-54", "next": "013-56"}, "p56": {"key": "013-56", "title": "郊廟歌辭：享太廟樂章：大和舞", "author": "不詳", "canonical": "不詳", "lines": ["退居江水，鬱起丹陵。", "禮物還舊，朝章中興。", "龍圖友及，駿命恭膺。", "鳴球香瓚，大糦是承。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-55", "next": "013-57"}, "p57": {"key": "013-57", "title": "郊廟歌辭：享太廟樂章：景雲舞", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E4%BA%91.html\">景雲</a>霏爛，告我帝符。", "噫帝沖德，與天為徒。", "笙鏞遙遠，俎豆虛無。", "春秋孝獻，回復此都。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-56", "next": "013-58"}, "p58": {"key": "013-58", "title": "郊廟歌辭：享太廟樂章：福和", "author": "不詳", "canonical": "不詳", "lines": ["備禮用樂，崇親致尊。", "誠通慈降，敬徹愛存。", "獻懷稱壽，"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-57", "next": "013-59"}, "p59": {"key": "013-59", "title": "郊廟歌辭：享太廟樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["六鐘翕協六變成，八佾徜徉八風生。", "樂九韶兮人神感，美七德兮天地清。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "013-58", "next": "013-60"}, "p60": {"key": "013-60", "title": "郊廟歌辭：享太廟樂章：凱安四章", "author": "不詳", "canonical": "不詳", "lines": ["瑟彼瑤爵，亞惟上公。", "室如屏氣，門不容躬。", "禮殷其本，樂執其中。", "聖皇永慕，天地幽通。", "禮匝三獻，樂遍九成。", "降循軒陛，仰欷皇情。", "福與仁合，德因孝明。", "百年神畏，四海風行。", "總總幹戚，填填鼓鐘。", "奮揚爭氣，坐作為容。", "離若鷙鳥，合如戰龍。", "萬方觀德，肅肅雍雍。", "烈祖順三靈，文宗威四海。", "黃鉞誅群盜，朱旗掃多罪。", "戢兵天下安，約法人心改。", "大哉幹羽意，長見風雲在。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "013-59", "next": "013-61"}, "p61": {"key": "013-61", "title": "郊廟歌辭：享太廟樂章：登歌", "author": "不詳", "canonical": "不詳", "lines": ["止笙磬，撤豆籩。", "廓無響，窅入玄。", "主在室，神在天。", "情餘慕，禮罔愆。", "喜黍稷，屢豐年。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "013-60", "next": "013-62"}, "p62": {"key": "013-62", "title": "郊廟歌辭：享太廟樂章：永和", "author": "不詳", "canonical": "不詳", "lines": ["眇嘉樂，授靈爽。", "感若來，思如往。", "休氣散，回風上。", "返寂寞，還惚恍。", "懷靈駕，結空想。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "013-61", "next": "013-63"}, "p63": {"key": "013-63", "title": "郊廟歌辭：享太廟樂章：廣運舞", "author": "郭子儀", "canonical": "郭子儀", "lines": ["于赫皇祖，昭明有融。", "惟文之德，惟武之功。", "河海靜謐，車書混同。", "虔恭孝饗，穆穆玄風。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-62", "next": "013-64"}, "p64": {"key": "013-64", "title": "郊廟歌辭：享太廟樂章：惟新舞", "author": "劉晏", "canonical": "劉晏", "lines": ["漢祚惟永，神功中興。", "風驅氛祲，天覆黎蒸。", "三光再朗，庶績其凝。", "重熙累洽，景命是膺。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-63", "next": "013-65"}, "p65": {"key": "013-65", "title": "郊廟歌辭：享太廟樂章：保大舞", "author": "郭子儀", "canonical": "郭子儀", "lines": ["于穆文考，聖神昭章。", "肅勺群慝，含光遠方。", "萬物茂遂，九夷賓王。", "愔愔雲韶，德音不忘。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-64", "next": "013-66"}, "p66": {"key": "013-66", "title": "郊廟歌辭：享太廟樂章：文明舞", "author": "鄭餘慶", "canonical": "鄭餘慶", "lines": ["開邸除暴，時邁勳尊。", "三元告命，四極駿奔。", "金枝翠葉，輝燭瑤琨。", "象德億載，貽慶湯孫。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-65", "next": "013-67"}, "p67": {"key": "013-67", "title": "郊廟歌辭：享太廟樂章：大順舞", "author": "鄭絪", "canonical": "鄭絪", "lines": ["于穆時文，受天明命。", "允恭玄默，化成理定。", "出震嗣德，應幹傳聖。", "猗歟緝熙，千億流慶。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-66", "next": "013-68"}, "p68": {"key": "013-68", "title": "郊廟歌辭：享太廟樂章：象德舞", "author": "段文昌", "canonical": "段文昌", "lines": ["肅肅清廟，登顯<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>。", "澤周八荒，兵定四極。", "生物咸遂，群盜滅息。", "明聖欽承，子孫千億。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-67", "next": "013-69"}, "p69": {"key": "013-69", "title": "郊廟歌辭：享太廟樂章：和甯舞", "author": "牛僧孺", "canonical": "牛僧孺", "lines": ["湜湜頎頎，融昭德輝。", "不紐不舒，貫成九圍。", "武烈文經，敷施當宜。", "纂堯付啟，億萬熙熙。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-68", "next": "013-70"}, "p70": {"key": "013-70", "title": "郊廟歌辭：享太廟樂章：大定舞", "author": "李回", "canonical": "李回", "lines": ["受天明命，敷佑下土。", "化時以儉，衛文以武。", "氛消夷夏，俗臻往古。", "億萬斯年，形於律呂。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-69", "next": "013-71"}, "p71": {"key": "013-71", "title": "郊廟歌辭：享太廟樂章：宣宗室舞", "author": "夏侯孜", "canonical": "夏侯孜", "lines": ["於鑠令主，聖祚重昌。", "興起教義，申明典章。", "俗尚素樸，人皆樂康。", "積德可報，流慶無疆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-70", "next": "013-72"}, "p72": {"key": "013-72", "title": "郊廟歌辭：享太廟樂章：懿宗室舞", "author": "蕭仿", "canonical": "蕭仿", "lines": ["聖祚無疆，慶傳樂章。", "金枝繁茂，玉葉延長。", "海瀆常晏，波濤不揚。", "汪汪美化，垂范今王。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-71", "next": "013-73"}, "p73": {"key": "013-73", "title": "郊廟歌辭：享太廟樂章：咸甯舞", "author": "不詳", "canonical": "不詳", "lines": ["於鑠丕嗣，惟帝之光。", "羽鑰象德，金石薦祥。", "聖系無極，景命永昌。", "神降上哲，維天配長。"], "form": "四言", "t300": null, "src": "yuding", "prev": "013-72", "next": null}}}