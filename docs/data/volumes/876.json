{"vol_name": "卷八百七十六", "poems": {"p01": {"key": "876-01", "title": "二賀詩", "author": "不詳", "canonical": "不詳", "lines": ["學行可師賀德基，文質彬彬賀德仁。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "876-02"}, "p02": {"key": "876-02", "title": "四王語", "author": "不詳", "canonical": "不詳", "lines": ["甯向儋崖振白，不事江滕蔣虢。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-01", "next": "876-03"}, "p03": {"key": "876-03", "title": "時人為屈突語", "author": "不詳", "canonical": "不詳", "lines": ["寧食三鬥艾，不見屈突蓋。", "寧服三鬥蔥，不逢屈突通。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "876-02", "next": "876-04"}, "p04": {"key": "876-04", "title": "楊刺史語", "author": "不詳", "canonical": "不詳", "lines": ["甯食三鬥蒜，不逢楊德幹。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-03", "next": "876-05"}, "p05": {"key": "876-05", "title": "萬年人語", "author": "不詳", "canonical": "不詳", "lines": ["寧飲三鬥塵，無逢權懷恩。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-04", "next": "876-06"}, "p06": {"key": "876-06", "title": "贊皇人語", "author": "不詳", "canonical": "不詳", "lines": ["太沖無兄，孝端無弟。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-05", "next": "876-07"}, "p07": {"key": "876-07", "title": "高宗時語", "author": "不詳", "canonical": "不詳", "lines": ["左相宣威沙漠，右相馳譽丹青。", "三館學生放散，五台令史經明。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-06", "next": "876-08"}, "p08": {"key": "876-08", "title": "時人為李義甫語", "author": "不詳", "canonical": "不詳", "lines": ["今日巨唐年，還誅四凶族。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-07", "next": "876-09"}, "p09": {"key": "876-09", "title": "洛州語", "author": "不詳", "canonical": "不詳", "lines": ["洛州有前賈後張，可敵京兆三王。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-08", "next": "876-10"}, "p10": {"key": "876-10", "title": "江淮間語", "author": "不詳", "canonical": "不詳", "lines": ["貴如許郝，富若田彭。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-09", "next": "876-11"}, "p11": {"key": "876-11", "title": "河北語", "author": "不詳", "canonical": "不詳", "lines": ["唯此兩何，殺人最多。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-10", "next": "876-12"}, "p12": {"key": "876-12", "title": "李昭德為王弘義語", "author": "不詳", "canonical": "不詳", "lines": ["昔聞蒼鷹獄吏，今見白兔禦史。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-11", "next": "876-13"}, "p13": {"key": "876-13", "title": "京洛語", "author": "不詳", "canonical": "不詳", "lines": ["衣裳好，儀貌惡。", "不姓許，即姓郝。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-12", "next": "876-14"}, "p14": {"key": "876-14", "title": "台中語", "author": "不詳", "canonical": "不詳", "lines": ["侯知一不伏致仕，張悰自請起復。", "高筠不肯作孝，張栖貞情願遭憂。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "876-13", "next": "876-15"}, "p15": {"key": "876-15", "title": "吏人語", "author": "不詳", "canonical": "不詳", "lines": ["不畏侯卿杖，惟畏尹卿筆。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-14", "next": "876-16"}, "p16": {"key": "876-16", "title": "選人語", "author": "不詳", "canonical": "不詳", "lines": ["有錢石上好，無錢劉下好，士大夫張下好。", "碩學師劉子，儒生用與言。", "今年柿子並遭霜，為語石榴須早摘。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-15", "next": "876-17"}, "p17": {"key": "876-17", "title": "韋氏語", "author": "不詳", "canonical": "不詳", "lines": ["大郎罷相，小郎拜相。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-16", "next": "876-18"}, "p18": {"key": "876-18", "title": "益州人吏語", "author": "不詳", "canonical": "不詳", "lines": ["錄事意，與天通，益州司馬折威風。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-17", "next": "876-19"}, "p19": {"key": "876-19", "title": "天授中語", "author": "不詳", "canonical": "不詳", "lines": ["遇徐杜者必生，遇來侯者必死。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-18", "next": "876-20"}, "p20": {"key": "876-20", "title": "時人為鄒昉語", "author": "不詳", "canonical": "不詳", "lines": ["蕭佺駙馬子，鄒昉駱駝兒。", "非關道德合，只為錢相知。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "876-19", "next": "876-21"}, "p21": {"key": "876-21", "title": "題張昌儀門語", "author": "不詳", "canonical": "不詳", "lines": ["一兩絲能得幾時絡。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-20", "next": "876-22"}, "p22": {"key": "876-22", "title": "時人號李知遠語", "author": "不詳", "canonical": "不詳", "lines": ["李下無蹊。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-21", "next": "876-23"}, "p23": {"key": "876-23", "title": "又號李乂語", "author": "不詳", "canonical": "不詳", "lines": ["李下無蹊徑。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-22", "next": "876-24"}, "p24": {"key": "876-24", "title": "竇僕射語", "author": "不詳", "canonical": "不詳", "lines": ["竇僕射，前為韋氏國㸙，後作公主邑丞。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-23", "next": "876-25"}, "p25": {"key": "876-25", "title": "時人為崔無詖語", "author": "不詳", "canonical": "不詳", "lines": ["皇后嫁女，天子娶婦。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-24", "next": "876-26"}, "p26": {"key": "876-26", "title": "神龍中語", "author": "不詳", "canonical": "不詳", "lines": ["崔冉鄭，亂時政。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-25", "next": "876-27"}, "p27": {"key": "876-27", "title": "斜封官語", "author": "不詳", "canonical": "不詳", "lines": ["姚宋為相，邪不如正。", "太平用事，正不如邪。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-26", "next": "876-28"}, "p28": {"key": "876-28", "title": "李處鬱語", "author": "不詳", "canonical": "不詳", "lines": ["飧若入咽，百無一全。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-27", "next": "876-29"}, "p29": {"key": "876-29", "title": "景雲初語", "author": "不詳", "canonical": "不詳", "lines": ["前有裴馬，後有盧李。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-28", "next": "876-30"}, "p30": {"key": "876-30", "title": "先天時京中語", "author": "不詳", "canonical": "不詳", "lines": ["姜師度一心看地，傅孝忠兩眼相天。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-29", "next": "876-31"}, "p31": {"key": "876-31", "title": "時人號王丘、崔沔語", "author": "不詳", "canonical": "不詳", "lines": ["丘山岌岌連天峻，沔水澄澄澈底清。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-30", "next": "876-32"}, "p32": {"key": "876-32", "title": "吏部過官語", "author": "不詳", "canonical": "不詳", "lines": ["麟之口，光庭手。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-31", "next": "876-33"}, "p33": {"key": "876-33", "title": "郇公廚語", "author": "不詳", "canonical": "不詳", "lines": ["人欲不飯筋骨舒，夤緣須入郇公廚。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-32", "next": "876-34"}, "p34": {"key": "876-34", "title": "四俊語", "author": "不詳", "canonical": "不詳", "lines": ["令君四俊，苗呂崔員。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-33", "next": "876-35"}, "p35": {"key": "876-35", "title": "八友語", "author": "不詳", "canonical": "不詳", "lines": ["殷顏柳陸，李蕭邵趙。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-34", "next": "876-36"}, "p36": {"key": "876-36", "title": "羅吉口號", "author": "不詳", "canonical": "不詳", "lines": ["羅鉗吉網。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-35", "next": "876-37"}, "p37": {"key": "876-37", "title": "裏閭詛語", "author": "不詳", "canonical": "不詳", "lines": ["若違教，值三豹。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-36", "next": "876-38"}, "p38": {"key": "876-38", "title": "陝州語", "author": "不詳", "canonical": "不詳", "lines": ["不須賽神明，不必求巫祝。", "爾莫犯盧公，立便有禍福。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "876-37", "next": "876-39"}, "p39": {"key": "876-39", "title": "真源邑語", "author": "不詳", "canonical": "不詳", "lines": ["南金口，明府手。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-38", "next": "876-40"}, "p40": {"key": "876-40", "title": "稱二王語", "author": "不詳", "canonical": "不詳", "lines": ["朝廷左相筆，天下右丞詩。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-39", "next": "876-41"}, "p41": {"key": "876-41", "title": "代宗朝京師語", "author": "不詳", "canonical": "不詳", "lines": ["常無分別元好錢，賢者愚，愚者賢。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-40", "next": "876-42"}, "p42": {"key": "876-42", "title": "戲諫司語", "author": "不詳", "canonical": "不詳", "lines": ["韓諫議雖分左右，歸拾遺莫辨存亡。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-41", "next": "876-43"}, "p43": {"key": "876-43", "title": "裴度語", "author": "不詳", "canonical": "不詳", "lines": ["雞豬魚蒜，逢著則吃。", "生老病死，時至則行。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-42", "next": "876-44"}, "p44": {"key": "876-44", "title": "魏博語", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>天子，魏府牙軍。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-43", "next": "876-45"}, "p45": {"key": "876-45", "title": "寶曆宮中語", "author": "不詳", "canonical": "不詳", "lines": ["寶帳香重重，一雙紅芙蓉。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-44", "next": "876-46"}, "p46": {"key": "876-46", "title": "京師人號牛楊語", "author": "不詳", "canonical": "不詳", "lines": ["太牢筆，少牢口，東西南北何處走。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-45", "next": "876-47"}, "p47": {"key": "876-47", "title": "又號牛李", "author": "不詳", "canonical": "不詳", "lines": ["門生故吏，不牛則李。。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-46", "next": "876-48"}, "p48": {"key": "876-48", "title": "荊南語", "author": "不詳", "canonical": "不詳", "lines": ["旱不苦，禱而雨。", "雨不愁，公出遊。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-47", "next": "876-49"}, "p49": {"key": "876-49", "title": "鄭仁表自語", "author": "不詳", "canonical": "不詳", "lines": ["天瑞有五色雲，人瑞有鄭仁表。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-48", "next": "876-50"}, "p50": {"key": "876-50", "title": "湖蘇二郡語", "author": "不詳", "canonical": "不詳", "lines": ["湖接兩頭，蘇聯三尾。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-49", "next": "876-51"}, "p51": {"key": "876-51", "title": "廣明初都人語", "author": "不詳", "canonical": "不詳", "lines": ["黃賊打黑賊。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-50", "next": "876-52"}, "p52": {"key": "876-52", "title": "吏部舊語", "author": "不詳", "canonical": "不詳", "lines": ["長名以前，選人屬侍郎。", "長名以後，侍郎屬選人。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-51", "next": "876-53"}, "p53": {"key": "876-53", "title": "省中語", "author": "不詳", "canonical": "不詳", "lines": ["後行祠屯，不博中行都門；中行禮部，不博前行駕庫。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-52", "next": "876-54"}, "p54": {"key": "876-54", "title": "郎吏語", "author": "不詳", "canonical": "不詳", "lines": ["司門水部，入省不數。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-53", "next": "876-55"}, "p55": {"key": "876-55", "title": "諫院台省語", "author": "不詳", "canonical": "不詳", "lines": ["遺補相惜，禦史相憎，郎官相輕。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-54", "next": "876-56"}, "p56": {"key": "876-56", "title": "禦史台語", "author": "不詳", "canonical": "不詳", "lines": ["事長如事端。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-55", "next": "876-57"}, "p57": {"key": "876-57", "title": "京兆府語", "author": "不詳", "canonical": "不詳", "lines": ["不立兩縣令，不坐兩少尹。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-56", "next": "876-58"}, "p58": {"key": "876-58", "title": "翰林諫議語", "author": "不詳", "canonical": "不詳", "lines": ["饒道鬥上坡去，亦須卻下坡來。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-57", "next": "876-59"}, "p59": {"key": "876-59", "title": "舉子語", "author": "不詳", "canonical": "不詳", "lines": ["槐花黃，舉子忙。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-58", "next": "876-60"}, "p60": {"key": "876-60", "title": "明經進士語", "author": "不詳", "canonical": "不詳", "lines": ["三十老明經，五十少進士。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-59", "next": "876-61"}, "p61": {"key": "876-61", "title": "雜帖語", "author": "不詳", "canonical": "不詳", "lines": ["常雜鮑帖。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-60", "next": "876-62"}, "p62": {"key": "876-62", "title": "閩人語", "author": "不詳", "canonical": "不詳", "lines": ["歐陽獨步，藻蘊橫行。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-61", "next": "876-63"}, "p63": {"key": "876-63", "title": "舉場語", "author": "不詳", "canonical": "不詳", "lines": ["欲入舉場，先問蘇張。", "蘇張猶可，三楊殺我。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-62", "next": "876-64"}, "p64": {"key": "876-64", "title": "大中後進士語", "author": "不詳", "canonical": "不詳", "lines": ["欲得命通，問瑝嵎都雍。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-63", "next": "876-65"}, "p65": {"key": "876-65", "title": "大中時語", "author": "不詳", "canonical": "不詳", "lines": ["鄭楊段薛，炙手可熱。", "欲得命通，魯紹瑰蒙。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-64", "next": "876-66"}, "p66": {"key": "876-66", "title": "選舉人語", "author": "不詳", "canonical": "不詳", "lines": ["王凝裴瓚，舍弟安潛。", "朝中無呼字，知聞廳裏，絕脫鞾賓客。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "876-65", "next": "876-67"}, "p67": {"key": "876-67", "title": "科目舉人語", "author": "不詳", "canonical": "不詳", "lines": ["未見王竇，徒勞漫走。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-66", "next": "876-68"}, "p68": {"key": "876-68", "title": "戲杜審權語", "author": "不詳", "canonical": "不詳", "lines": ["座主審權，門生處權。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-67", "next": "876-69"}, "p69": {"key": "876-69", "title": "崔沆放榜時人語", "author": "不詳", "canonical": "不詳", "lines": ["座主門生，沆瀣一家。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-68", "next": "876-70"}, "p70": {"key": "876-70", "title": "唐末五代人語", "author": "不詳", "canonical": "不詳", "lines": ["及第不必讀書，作官何須事業。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-69", "next": "876-71"}, "p71": {"key": "876-71", "title": "號沈宋語", "author": "不詳", "canonical": "不詳", "lines": ["蘇李居前，沈宋比肩。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-70", "next": "876-72"}, "p72": {"key": "876-72", "title": "號錢郎語", "author": "不詳", "canonical": "不詳", "lines": ["前有沈宋，後有錢郎。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-71", "next": "876-73"}, "p73": {"key": "876-73", "title": "潘何詩賦語", "author": "不詳", "canonical": "不詳", "lines": ["潘緯十年吟古鏡，何涓一夜賦<a class=\"ent ent-place\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-72", "next": "876-74"}, "p74": {"key": "876-74", "title": "魏薛草書語", "author": "不詳", "canonical": "不詳", "lines": ["前有虞褚，後有薛魏。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-73", "next": "876-75"}, "p75": {"key": "876-75", "title": "薛稷書語", "author": "不詳", "canonical": "不詳", "lines": ["買褚得薛不落節。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-74", "next": "876-76"}, "p76": {"key": "876-76", "title": "時人為劉畢語", "author": "不詳", "canonical": "不詳", "lines": ["劉郎中松樹孤標，畢庶子松根絕妙。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-75", "next": "876-77"}, "p77": {"key": "876-77", "title": "時人為黃筌語", "author": "不詳", "canonical": "不詳", "lines": ["黃筌畫鶴，薛稷減價。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-76", "next": "876-78"}, "p78": {"key": "876-78", "title": "時人為楊惠之語", "author": "不詳", "canonical": "不詳", "lines": ["道子畫，惠之塑，奪得僧繇神筆路。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-77", "next": "876-79"}, "p79": {"key": "876-79", "title": "道傑語", "author": "不詳", "canonical": "不詳", "lines": ["大頭傑，難殺人。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-78", "next": "876-80"}, "p80": {"key": "876-80", "title": "馬周疏引俚語", "author": "不詳", "canonical": "不詳", "lines": ["貧不學儉，富不學奢。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-79", "next": "876-81"}, "p81": {"key": "876-81", "title": "杜甫引俚語", "author": "不詳", "canonical": "不詳", "lines": ["城南韋杜，去天尺五。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-80", "next": "876-82"}, "p82": {"key": "876-82", "title": "《孫光憲瑣言》引古語", "author": "不詳", "canonical": "不詳", "lines": ["乘船走馬，去死一分。", "好事不出門，惡事行千里。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-81", "next": "876-83"}, "p83": {"key": "876-83", "title": "杜重威引俚語", "author": "不詳", "canonical": "不詳", "lines": ["逢賊得命，更望複子。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-82", "next": "876-84"}, "p84": {"key": "876-84", "title": "建安語", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E9%BE%99%E9%97%A8.html\">龍門</a>一半在閩川。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-83", "next": "876-85"}, "p85": {"key": "876-85", "title": "江陵語", "author": "不詳", "canonical": "不詳", "lines": ["琵琶多於飯甑，措大多於鯽魚。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-84", "next": "876-86"}, "p86": {"key": "876-86", "title": "汾晉間語", "author": "不詳", "canonical": "不詳", "lines": ["欲作千箱主，問取黃金母。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-85", "next": "876-87"}, "p87": {"key": "876-87", "title": "秦中兒童語", "author": "不詳", "canonical": "不詳", "lines": ["顛當牢守門，蠮螉寇汝無處奔。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-86", "next": "876-88"}, "p88": {"key": "876-88", "title": "滄洲語", "author": "不詳", "canonical": "不詳", "lines": ["不戴金蓮花，不得到仙家。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-87", "next": "876-89"}, "p89": {"key": "876-89", "title": "《段成式酉陽雜俎》引古語", "author": "不詳", "canonical": "不詳", "lines": ["三守庚申三屍伏，七守庚申七尺滅。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "876-88", "next": "876-90"}, "p90": {"key": "876-90", "title": "佛書引語", "author": "不詳", "canonical": "不詳", "lines": ["停囚長智。", "赤腳人趁兔，著靴人吃肉。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "876-89", "next": null}}}