{"vol_name": "卷一百四十三", "poems": {"p01": {"key": "143-01", "title": "朝來曲", "author": "王昌齡", "canonical": "王昌齡", "lines": ["月昃鳴珂動，花連繡戶春。", "盤龍玉台鏡，唯待畫眉人。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "143-02"}, "p02": {"key": "143-02", "title": "從軍行", "author": "王昌齡", "canonical": "王昌齡", "lines": ["大將軍出戰，白日暗榆關。", "三面黃金甲，<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%8D%95%E4%BA%8E.html\">單于</a>破膽還。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-01", "next": "143-03"}, "p03": {"key": "143-03", "title": "答武陵田太守", "author": "王昌齡", "canonical": "王昌齡", "lines": ["仗劍行千里，微軀感一言。", "曾為<a class=\"ent ent-place\" href=\"../entities/place_%E5%A4%A7%E6%A2%81.html\">大樑</a>客，不負<a class=\"ent ent-person\" href=\"../entities/person_%E4%BF%A1%E9%99%B5.html\">信陵</a>恩。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-02", "next": "143-04"}, "p04": {"key": "143-04", "title": "題灞池二首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["腰鐮欲何之，東園刈秋韭。", "世事不復論，悲歌和樵叟。", "開門望長川，薄暮見漁者。", "借問白頭翁，垂綸幾年也。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "143-03", "next": "143-05"}, "p05": {"key": "143-05", "title": "題僧房", "author": "王昌齡", "canonical": "王昌齡", "lines": ["棕櫚花滿院，苔蘚入閒房。", "彼此名言絕，空中聞異香。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-04", "next": "143-06"}, "p06": {"key": "143-06", "title": "擊磬老人", "author": "王昌齡", "canonical": "王昌齡", "lines": ["雙峰褐衣久，一磬白眉長。", "誰識野人意，徒看春草芳。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-05", "next": "143-07"}, "p07": {"key": "143-07", "title": "送胡大", "author": "王昌齡", "canonical": "王昌齡", "lines": ["荊門不堪別，況乃<a class=\"ent ent-place\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>秋。", "何處遙望君，江邊明月樓。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-06", "next": "143-08"}, "p08": {"key": "143-08", "title": "送郭司倉", "author": "王昌齡", "canonical": "王昌齡", "lines": ["映門淮水綠，留騎主人心。", "明月隨良掾，春潮夜夜深。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-07", "next": "143-09"}, "p09": {"key": "143-09", "title": "送李十五", "author": "王昌齡", "canonical": "王昌齡", "lines": ["怨別秦楚深，江<a class=\"ent ent-time\" href=\"../entities/time_%E4%B8%AD%E7%A7%8B.html\">中秋</a>雲起。", "天長杳無隔，月影在寒水。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-08", "next": "143-10"}, "p10": {"key": "143-10", "title": "送張四", "author": "王昌齡", "canonical": "王昌齡", "lines": ["楓林已愁暮，楚水複堪悲。", "別後冷山月，清猿無斷時。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-09", "next": "143-11"}, "p11": {"key": "143-11", "title": "武陵田太守席送司馬盧溪", "author": "王昌齡", "canonical": "王昌齡", "lines": ["諸侯分楚郡，飲餞五溪春。", "山水清暉遠，俱憐一逐臣。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-10", "next": "143-12"}, "p12": {"key": "143-12", "title": "送譚八之桂林", "author": "王昌齡", "canonical": "王昌齡", "lines": ["客心仍在楚，江館複臨湘。", "別意猿鳥外，天寒桂水長。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-11", "next": "143-13"}, "p13": {"key": "143-13", "title": "送劉十五之郡", "author": "王昌齡", "canonical": "王昌齡", "lines": ["平明江霧寒，客馬江上發。", "扁舟事<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9B%E9%98%B3.html\">洛陽</a>，窅窅含楚月。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-12", "next": "143-14"}, "p14": {"key": "143-14", "title": "從軍行七首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["烽火城西百尺樓，黃昏獨上海風秋。", "更吹羌笛關山月，無那金閨萬里愁。", "琵琶起舞換新聲，總是關山舊別情。", "撩亂邊愁聽不盡，高高秋月照長城。", "關城榆葉早疏黃，日暮雲沙古戰場。", "表請回軍掩塵骨，莫教兵士哭龍荒。", "青海長雲暗雪山，孤城遙望<a class=\"ent ent-place\" href=\"../entities/place_%E7%8E%89%E9%97%A8%E5%85%B3.html\">玉門關</a>。", "黃沙百戰穿金甲，不破樓蘭終不還。", "大漠風塵日色昏，紅旗半卷出轅門。", "前軍夜戰洮<a class=\"ent ent-place\" href=\"../entities/place_%E6%B2%B3%E5%8C%97.html\">河北</a>，已報生擒吐谷渾。", "胡瓶落膊紫薄汗，碎葉城西秋月團。", "明敕星馳封寶劍，辭君一夜取樓蘭。", "玉門山嶂幾千重，山北山南總是烽。", "人依遠戍須看火，馬踏深山不見蹤。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "143-13", "next": "143-15"}, "p15": {"key": "143-15", "title": "出塞二首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["<span class=\"ent ent-nation\" data-note=\"秦汉互文：明月与关古今如一\">秦</span>時明月<span class=\"ent ent-nation\" data-note=\"秦汉互文\">漢</span>時關，萬里長征人未還。", "但使<span class=\"ent ent-person\" data-note=\"指汉飞将军李广（一说卫青龙城之捷）\">龍城飛將</span>在，不教<span class=\"ent ent-nation\" data-note=\"北方游牧部族\">胡</span>馬度<span class=\"ent ent-place\" data-note=\"漠南屏障，胡骑南下必越之山\">陰山</span>。", "騮馬新跨白玉鞍，戰罷沙場月色寒。", "城頭鐵鼓聲猶振，匣裏金刀血未幹。"], "form": "七律", "t300": ["战争", "写景", "忧国忧民", "爱国", "乐府", "山", "边塞"], "src": "yuding", "pilot": true, "prev": "143-14", "next": "143-16"}, "p16": {"key": "143-16", "title": "採蓮曲二首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["吳姬越豔<a class=\"ent ent-person\" href=\"../entities/person_%E6%A5%9A%E7%8E%8B.html\">楚王</a>妃，爭弄蓮舟水濕衣。", "來時浦口花迎入，采罷江頭月送歸。", "荷葉羅裙一色裁，芙蓉向臉兩邊開。", "亂入池中看不見，聞歌始覺有人來。"], "form": "七律", "t300": null, "src": "yuding", "pilot": false, "prev": "143-15", "next": "143-17"}, "p17": {"key": "143-17", "title": "殿前曲二首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["貴人妝梳殿前催，香風吹入殿后來。", "仗引笙歌<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%A4%A7%E5%AE%9B.html\">大宛</a>馬，白蓮花發照池台。", "胡部笙歌西殿頭，梨園弟子和<a class=\"ent ent-place\" href=\"../entities/place_%E5%87%89%E5%B7%9E.html\">涼州</a>。", "新聲一段高樓月，聖主千秋樂未休。"], "form": "七律", "t300": null, "src": "yuding", "pilot": false, "prev": "143-16", "next": "143-18"}, "p18": {"key": "143-18", "title": "春宮曲", "author": "王昌齡", "canonical": "王昌齡", "lines": ["昨夜風開露井桃，<a class=\"ent ent-place\" data-note=\"未央前殿\" href=\"../entities/place_%E6%9C%AA%E5%A4%AE%E5%AE%AB.html\">未央</a>前殿月輪高。", "<a class=\"ent ent-place\" data-note=\"平阳公主家歌女卫子夫承宠典\" href=\"../entities/place_%E5%B9%B3%E9%98%B3.html\">平陽</a>歌舞新承寵，簾外春寒賜錦袍。"], "form": "七絕", "t300": ["七言绝句", "宫怨", "女子"], "src": "yuding", "pilot": true, "prev": "143-17", "next": "143-19"}, "p19": {"key": "143-19", "title": "西宮春怨", "author": "王昌齡", "canonical": "王昌齡", "lines": ["西宮夜靜百花香，欲卷珠簾春恨長。", "斜抱雲和深見月，朦朧樹色隱昭陽。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-18", "next": "143-20"}, "p20": {"key": "143-20", "title": "西宮秋怨", "author": "王昌齡", "canonical": "王昌齡", "lines": ["芙蓉不及美人妝，水殿風來珠翠香。", "誰分含啼掩秋扇，空懸明月待君王。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-19", "next": "143-21"}, "p21": {"key": "143-21", "title": "長信秋詞五首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["金井梧桐秋葉黃，珠簾不捲夜來霜。", "熏籠玉枕無顏色，臥聽南宮清漏長。", "高殿秋砧響夜闌，霜深猶憶御衣寒。", "銀燈青瑣裁縫歇，還向金城明主看。", "奉帚平明金殿開，且將團扇暫裴回。", "玉顏不及寒鴉色，猶帶[昭]陽日影來。", "真成薄命久尋思，夢見君王覺後疑。", "火照西宮知夜飲，分明複道奉恩時。", "長信宮<a class=\"ent ent-time\" href=\"../entities/time_%E4%B8%AD%E7%A7%8B.html\">中秋</a>月明，昭陽殿下擣衣聲。", "白露堂中細草跡，紅羅帳裏不勝情。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "143-20", "next": "143-22"}, "p22": {"key": "143-22", "title": "青樓曲二首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["白馬金鞍從武皇，旌旗十萬宿長楊。", "樓頭小婦鳴箏坐，遙見飛塵入建章。", "馳道楊花滿禦溝，紅妝縵綰上青樓。", "金章紫綬千餘騎，夫婿朝回初拜侯。"], "form": "七律", "t300": null, "src": "yuding", "pilot": false, "prev": "143-21", "next": "143-23"}, "p23": {"key": "143-23", "title": "青樓怨", "author": "王昌齡", "canonical": "王昌齡", "lines": ["香幃風動花入樓，高調鳴箏緩夜愁。", "腸斷關山不解說，依依殘月下簾鉤。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-22", "next": "143-24"}, "p24": {"key": "143-24", "title": "浣紗女", "author": "王昌齡", "canonical": "王昌齡", "lines": ["錢塘江畔是誰家，江上女兒全勝花。", "<a class=\"ent ent-person\" href=\"../entities/person_%E5%90%B4%E7%8E%8B.html\">吳王</a>在時不得出，今日公然來浣紗。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-23", "next": "143-25"}, "p25": {"key": "143-25", "title": "閨怨", "author": "王昌齡", "canonical": "王昌齡", "lines": ["閨中少婦不曾愁，春日凝妝上翠樓。", "忽見陌頭楊柳色，悔教夫婿覓封侯。"], "form": "七絕", "t300": ["妇女", "春天", "七言绝句", "闺怨"], "src": "yuding", "pilot": true, "prev": "143-24", "next": "143-26"}, "p26": {"key": "143-26", "title": "甘泉歌", "author": "王昌齡", "canonical": "王昌齡", "lines": ["乘輿執玉已登壇，細草沾衣春殿寒。", "昨夜雲生拜初月，萬年甘露水晶盤。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-25", "next": "143-27"}, "p27": {"key": "143-27", "title": "蕭駙馬宅花燭", "author": "王昌齡", "canonical": "王昌齡", "lines": ["青鸞飛入合歡宮，紫鳳銜花出禁中。", "可憐今夜千門裏，銀漢星回一道通。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-26", "next": "143-28"}, "p28": {"key": "143-28", "title": "觀獵", "author": "王昌齡", "canonical": "王昌齡", "lines": ["角鷹初下秋草稀，鐵驄拋鞚去如飛。", "少年獵得<a class=\"ent ent-place\" href=\"../entities/place_%E5%B9%B3%E5%8E%9F.html\">平原</a>兔，馬後橫捎意氣歸。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-27", "next": "143-29"}, "p29": {"key": "143-29", "title": "寄穆侍禦出幽州", "author": "王昌齡", "canonical": "王昌齡", "lines": ["一從恩譴度<a class=\"ent ent-place\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>，<a class=\"ent ent-place\" href=\"../entities/place_%E5%A1%9E%E5%8C%97.html\">塞北</a><a class=\"ent ent-place\" href=\"../entities/place_%E6%B1%9F%E5%8D%97.html\">江南</a>萬里長。", "莫道薊門書信少，雁飛猶得到衡陽。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-28", "next": "143-30"}, "p30": {"key": "143-30", "title": "寄陶副使", "author": "王昌齡", "canonical": "王昌齡", "lines": ["聞道將軍破海門，如何遠謫渡湘沅。", "春來明主封西嶽，自有還君紫綬恩。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-29", "next": "143-31"}, "p31": {"key": "143-31", "title": "至南陵答皇甫岳", "author": "王昌齡", "canonical": "王昌齡", "lines": ["與君同病複漂淪，昨夜<a class=\"ent ent-place\" href=\"../entities/place_%E5%AE%A3%E5%9F%8E.html\">宣城</a>別故人。", "明主恩深非歲久，長江還共五溪濱。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-30", "next": "143-32"}, "p32": {"key": "143-32", "title": "西江寄越弟", "author": "王昌齡", "canonical": "王昌齡", "lines": ["南浦逢君嶺外還，沅溪更遠<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9E%E5%BA%AD.html\">洞庭</a>山。", "堯時恩澤如春雨，夢裏相逢同入關。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-31", "next": "143-33"}, "p33": {"key": "143-33", "title": "李四倉曹宅夜飲", "author": "王昌齡", "canonical": "王昌齡", "lines": ["霜天留後故情歡，銀燭金爐夜不寒。", "欲問吳江別來意，青山明月夢中看。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-32", "next": "143-34"}, "p34": {"key": "143-34", "title": "宴春源", "author": "王昌齡", "canonical": "王昌齡", "lines": ["源向春城花幾重，江明深翠引諸峰。", "與君醉失松溪路，山館寥寥傳暝鐘。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-33", "next": "143-35"}, "p35": {"key": "143-35", "title": "龍標野宴", "author": "王昌齡", "canonical": "王昌齡", "lines": ["沅溪夏晚足涼風，春酒相攜就竹叢。", "莫道弦歌愁遠謫，青山明月不曾空。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-34", "next": "143-36"}, "p36": {"key": "143-36", "title": "聽流人水調子", "author": "王昌齡", "canonical": "王昌齡", "lines": ["孤舟微月對楓林，分付鳴箏與客心。", "嶺色千重萬重雨，斷弦收與淚痕深。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-35", "next": "143-37"}, "p37": {"key": "143-37", "title": "梁苑", "author": "王昌齡", "canonical": "王昌齡", "lines": ["梁園秋竹古時煙，城外風悲欲暮天。", "萬乘旌旗何處在，平臺賓客有誰憐。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-36", "next": "143-38"}, "p38": {"key": "143-38", "title": "武陵龍興觀黃道士房問易因題", "author": "王昌齡", "canonical": "王昌齡", "lines": ["齋心問易太陽宮，八卦真形一氣中。", "仙老言餘鶴飛去，玉清壇上雨濛濛。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-37", "next": "143-39"}, "p39": {"key": "143-39", "title": "送魏二", "author": "王昌齡", "canonical": "王昌齡", "lines": ["醉別江樓橘柚香，江風引雨入舟涼。", "憶君遙在<a class=\"ent ent-place\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>月，愁聽清猿夢裏長。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-38", "next": "143-40"}, "p40": {"key": "143-40", "title": "別李浦之京", "author": "王昌齡", "canonical": "王昌齡", "lines": ["故園今在灞陵西，江畔逢君醉不迷。", "小弟鄰莊尚漁獵，一封書寄數行啼。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-39", "next": "143-41"}, "p41": {"key": "143-41", "title": "送狄宗亨", "author": "王昌齡", "canonical": "王昌齡", "lines": ["秋在水清山暮蟬，<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9B%E9%98%B3.html\">洛陽</a>樹色鳴皋煙。", "送君歸去愁不盡，又惜空度涼風天。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-40", "next": "143-42"}, "p42": {"key": "143-42", "title": "送薛大赴安陸", "author": "王昌齡", "canonical": "王昌齡", "lines": ["津頭雲雨暗湘山，遷客離憂楚地顏。", "遙送扁舟安陸郡，天邊何處穆陵關。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-41", "next": "143-43"}, "p43": {"key": "143-43", "title": "芙蓉樓送辛漸二首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["寒雨連天夜入湖，平明送客<span class=\"ent ent-place\" data-note=\"楚地之山\">楚山</span>孤。", "<a class=\"ent ent-place\" data-note=\"亲友所在\" href=\"../entities/place_%E6%B4%9B%E9%98%B3.html\">洛陽</a>親友如相問，一片冰心在玉壺。", "<span class=\"ent ent-place\" data-note=\"润州丹阳\">丹陽</span>城南秋海陰，<span class=\"ent ent-place\" data-note=\"地名 · 精标\">丹陽</span>城北楚雲深。", "高樓送客不能醉，寂寂寒江明月心。"], "form": "七律", "t300": ["写雨", "抒情", "送别", "七言绝句", "雨", "六年级下册", "小学古诗"], "src": "yuding", "pilot": true, "prev": "143-42", "next": "143-44"}, "p44": {"key": "143-44", "title": "重別李評事", "author": "王昌齡", "canonical": "王昌齡", "lines": ["莫道秋江離別難，舟船明日是<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>。", "吳姬緩舞留君醉，隨意青楓白露寒。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-43", "next": "143-45"}, "p45": {"key": "143-45", "title": "別陶副使歸南海", "author": "王昌齡", "canonical": "王昌齡", "lines": ["<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%8D%97%E8%B6%8A.html\">南越</a>歸人夢海樓，<a class=\"ent ent-place\" href=\"../entities/place_%E5%B9%BF%E9%99%B5.html\">廣陵</a>新月海亭秋。", "寶刀留贈長相憶，當取戈船萬戶侯。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-44", "next": "143-46"}, "p46": {"key": "143-46", "title": "送人歸江夏", "author": "王昌齡", "canonical": "王昌齡", "lines": ["寒江綠水楚雲深，莫道離憂遷遠心。", "曉夕雙帆歸鄂渚，愁將孤月夢中尋。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-45", "next": "143-47"}, "p47": {"key": "143-47", "title": "送李五", "author": "王昌齡", "canonical": "王昌齡", "lines": ["玉碗金罍傾送君，江西日入起黃雲。", "扁舟乘月暫來去，誰道滄浪吳楚分。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-46", "next": "143-48"}, "p48": {"key": "143-48", "title": "送十五舅", "author": "王昌齡", "canonical": "王昌齡", "lines": ["深林秋水近日空，歸棹演漾清陰中。", "夕浦離觴意何已，草根寒露悲鳴蟲。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-47", "next": "143-49"}, "p49": {"key": "143-49", "title": "留別郭八", "author": "王昌齡", "canonical": "王昌齡", "lines": ["長亭駐馬未能前，井邑蒼茫含暮煙。", "醉別何須更惆悵，回頭不語但垂鞭。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-48", "next": "143-50"}, "p50": {"key": "143-50", "title": "送竇七", "author": "王昌齡", "canonical": "王昌齡", "lines": ["清江月色傍林秋，波上熒熒望一舟。", "鄂渚輕帆須早發，江邊明月為君留。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-49", "next": "143-51"}, "p51": {"key": "143-51", "title": "巴陵送李十二", "author": "王昌齡", "canonical": "王昌齡", "lines": ["搖曳巴陵洲渚分，清江傳語便風聞。", "山長不見秋城色，日暮蒹葭空水雲。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-50", "next": "143-52"}, "p52": {"key": "143-52", "title": "送裴圖南", "author": "王昌齡", "canonical": "王昌齡", "lines": ["黃河渡頭歸問津，離家幾日茱萸新。", "漫道閨中飛破鏡，猶看陌上別行人。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-51", "next": "143-53"}, "p53": {"key": "143-53", "title": "留別司馬太守", "author": "王昌齡", "canonical": "王昌齡", "lines": ["辰陽太守念王孫，遠謫沅溪何可論。", "黃鶴青雲當一舉，明珠吐著報君恩。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-52", "next": "143-54"}, "p54": {"key": "143-54", "title": "盧溪主人", "author": "王昌齡", "canonical": "王昌齡", "lines": ["武陵溪口駐扁舟，溪水隨君向北流。", "行到荊門上三峽，莫將孤月對猿愁。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-53", "next": "143-55"}, "p55": {"key": "143-55", "title": "送程六", "author": "王昌齡", "canonical": "王昌齡", "lines": ["冬夜傷離在五溪，青魚雪落鱠橙齏。", "武岡前路看斜月，片片舟中雲向西。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-54", "next": "143-56"}, "p56": {"key": "143-56", "title": "送朱越", "author": "王昌齡", "canonical": "王昌齡", "lines": ["遠別舟中蔣山暮，君行舉首燕城路。", "薊門秋月隱黃雲，期向<a class=\"ent ent-place\" href=\"../entities/place_%E9%87%91%E9%99%B5.html\">金陵</a>醉江樹。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-55", "next": "143-57"}, "p57": {"key": "143-57", "title": "別辛漸", "author": "王昌齡", "canonical": "王昌齡", "lines": ["別館蕭條風雨寒，扁舟月色渡江看。", "酒酣不識關西道，卻望春江雲尚殘。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-56", "next": "143-58"}, "p58": {"key": "143-58", "title": "送柴侍禦", "author": "王昌齡", "canonical": "王昌齡", "lines": ["流水通波接武岡，送君不覺有離傷。", "青山一道同雲雨，明月何曾是兩鄉。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-57", "next": "143-59"}, "p59": {"key": "143-59", "title": "送萬大歸長沙", "author": "王昌齡", "canonical": "王昌齡", "lines": ["桂陽秋水<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E6%B2%99.html\">長沙</a>縣，楚竹離聲為君變。", "青山隱隱孤舟微，白鶴雙飛忽相見。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-58", "next": "143-60"}, "p60": {"key": "143-60", "title": "送吳十九往沅陵", "author": "王昌齡", "canonical": "王昌齡", "lines": ["沅江流水到辰陽，溪口逢君驛路長。", "遠謫誰知望雷雨，明年春水共還鄉。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-59", "next": "143-61"}, "p61": {"key": "143-61", "title": "別皇甫五", "author": "王昌齡", "canonical": "王昌齡", "lines": ["漵浦潭陽隔楚山，離尊不用起愁顏。", "明祠靈響期昭應，天澤俱從此路還。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-60", "next": "143-62"}, "p62": {"key": "143-62", "title": "送崔參軍往龍溪", "author": "王昌齡", "canonical": "王昌齡", "lines": ["龍溪只在龍標上，秋月孤山兩相向。", "譴謫離心是丈夫，鴻恩共待春江漲。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-61", "next": "143-63"}, "p63": {"key": "143-63", "title": "送鄭判官", "author": "王昌齡", "canonical": "王昌齡", "lines": ["東楚吳山驛樹微，軺車銜命奉恩輝。", "英僚攜出新豐酒，半道遙看驄馬歸。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-62", "next": "143-64"}, "p64": {"key": "143-64", "title": "送姚司法歸吳", "author": "王昌齡", "canonical": "王昌齡", "lines": ["吳掾留觴楚郡心，<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9E%E5%BA%AD.html\">洞庭</a>秋雨海門陰。", "但令意遠扁舟近，不道滄江百丈深。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-63", "next": "143-65"}, "p65": {"key": "143-65", "title": "送高三之桂林", "author": "王昌齡", "canonical": "王昌齡", "lines": ["留君夜飲對<a class=\"ent ent-place\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>，從此歸舟客夢長。", "嶺上梅花侵雪暗，歸時還拂桂花香。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-64", "next": "143-66"}, "p66": {"key": "143-66", "title": "旅望", "author": "王昌齡", "canonical": "王昌齡", "lines": ["白花原頭望<a class=\"ent ent-place\" href=\"../entities/place_%E4%BA%AC%E5%B8%88.html\">京師</a>，黃河水流無盡時。", "窮秋曠野行人絕，馬首東來知是誰。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-65", "next": "143-67"}, "p67": {"key": "143-67", "title": "題朱煉師山房", "author": "王昌齡", "canonical": "王昌齡", "lines": ["叩齒焚香出世塵，齋壇鳴磬步虛人。", "百花仙醞能留客，一飯胡麻度幾春。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-66", "next": "143-68"}, "p68": {"key": "143-68", "title": "武陵開元觀黃煉師院三首", "author": "王昌齡", "canonical": "王昌齡", "lines": ["松間白髮黃尊師，童子燒香禹步時。", "欲訪桃源入溪路，忽聞雞犬使人疑。", "先賢盛說桃花源，塵忝何堪武陵郡。", "聞道秦時避地人，至今不與人通問。", "山觀空虛清靜門，從官役吏擾塵喧。", "暫因問俗到真境，便欲投誠依道源。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "143-67", "next": "143-69"}, "p69": {"key": "143-69", "title": "河上老人歌", "author": "王昌齡", "canonical": "王昌齡", "lines": ["河上老人坐古槎，合丹只用青蓮花。", "至今八十如四十，口道滄溟是我家。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-68", "next": "143-70"}, "p70": {"key": "143-70", "title": "春怨", "author": "王昌齡", "canonical": "王昌齡", "lines": ["音書杜絕白狼西，桃李無顏黃鳥啼。", "寒雁春深歸去盡，出門腸斷草萋萋。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "143-69", "next": "143-71"}, "p71": {"key": "143-71", "title": "句", "author": "王昌齡", "canonical": "王昌齡", "lines": ["朝薦抱良策，獨倚江城樓。", "昨從<a class=\"ent ent-place\" href=\"../entities/place_%E9%87%91%E9%99%B5.html\">金陵</a>邑，遠謫沅溪濱。", "娟魄已三孕。", "駕幸溫泉日，嚴霜子月初。", "長亭酒未醒，千里風動地。", "蒼荻寒滄江，石頭岸邊飲。", "天仗森森練雪凝，身騎鐵驄自臂鷹。", "與君遠相知，不道雲海深。", "得罪由己招，本性易然諾。", "黃葉亂秋雨，空齋愁暮心。", "通經彼上人，無迹任勤苦。", "楓橋延海岸，客帆歸富春。", "寒江映村林，亭上納高潔。", "陵藪寒蒼茫，登城遂懷古。", "孤煙曳長林，春水聊一望。", "河口餞南客，進帆清江水。", "遷客又相送，風悲蟬更號。", "微雨隨雲收，濛濛傍山去。", "海客時獨飛，永然滄洲意。", "日夕辨靈藥，空山松桂香。", "墟落有懷縣，長煙溪樹邊。", "青桂花未吐，江中獨鳴琴。", "還家望炎海，楚葉下秋水。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "143-70", "next": null}}}