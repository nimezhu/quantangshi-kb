{"vol_name": "卷八十五", "poems": {"p01": {"key": "085-01", "title": "唐封泰山樂章：豫和六首", "author": "張說", "canonical": "張說", "lines": ["挹泰壇，紫泰清。", "受天命，報天成。", "竦皇心，薦樂聲。", "志上達，歌下迎。", "億上帝，臨下庭。", "騎日月，陪列星。", "嘉視信，大糦馨。", "澹神心，醉皇靈。", "相百辟，貢八荒。", "九歌敘，萬舞翔。", "肅振振，鏗皇皇。", "帝欣欣，福穰穰。", "高在上，道光明。", "物資始，德難名。", "承眷命，牧蒼生。", "寰宇謐，泰階平。", "天道無親，至誠與鄰。", "山川遍禮，宮征惟新。", "玉帛非盛，聰明會真。", "正斯一德，通乎百神。", "享帝享親，維孝維聖。", "緝熙懿德，敷揚成命。", "華夷志同，笙鏞禮盛。", "明靈降止，感此誠敬。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "085-02"}, "p02": {"key": "085-02", "title": "唐封泰山樂章：太和", "author": "張說", "canonical": "張說", "lines": ["孝敬中發，和容外彰。", "騰華照宇，如升太陽。", "貞璧就奠，玄靈垂光。", "禮樂具舉，濟濟洋洋。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-01", "next": "085-03"}, "p03": {"key": "085-03", "title": "唐封泰山樂章：肅和", "author": "張說", "canonical": "張說", "lines": ["奠祖配天，承天享帝。", "百靈咸秩，四海來祭。", "植我蒼璧，布我玄制。", "華日裴回，神煙容裔。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-02", "next": "085-04"}, "p04": {"key": "085-04", "title": "唐封泰山樂章：雍和", "author": "張說", "canonical": "張說", "lines": ["俎豆有馥，粢盛絜豐。", "亦有和羹，既戒既平。", "鼓鐘管磬，肅唱和鳴。", "皇皇我祖，來我思成。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-03", "next": "085-05"}, "p05": {"key": "085-05", "title": "唐封泰山樂章：壽和", "author": "張說", "canonical": "張說", "lines": ["烝烝我后，享獻惟寅。", "躬酌鬱鬯，跪奠明神。", "孝莫孝乎，配上帝親。", "敬莫敬乎，教天下臣。", "皇祖嚴配，配享皇天。", "皇皇降嘏，天子萬年。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "085-04", "next": "085-06"}, "p06": {"key": "085-06", "title": "唐封泰山樂章：壽和", "author": "張說", "canonical": "張說", "lines": ["烝烝我后，享獻惟寅。", "躬酌鬱鬯，跪奠明神。", "孝莫孝乎，配上帝親。", "敬莫敬乎，教天下臣。", "皇祖嚴配，配享皇天。", "皇皇降嘏，天子萬年。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "085-05", "next": "085-07"}, "p07": {"key": "085-07", "title": "唐封泰山樂章：舒和", "author": "張說", "canonical": "張說", "lines": ["六鐘翕協六變成，八佾徜徉八風生。", "樂九[韶]兮[人神]感，美七德兮天地清。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "085-06", "next": "085-08"}, "p08": {"key": "085-08", "title": "唐封泰山樂章：凱和", "author": "張說", "canonical": "張說", "lines": ["烈祖順三靈，文宗威四海。", "黃鉞誅群盜，朱旗掃多罪。", "戢兵天下安，約法人心改。", "大哉幹羽意，常見風雲在。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "085-07", "next": "085-09"}, "p09": {"key": "085-09", "title": "唐封泰山樂章：豫和", "author": "張說", "canonical": "張說", "lines": ["禮樂終，[煙]燎上。", "懷靈惠，結皇想。", "歸風疾，回風爽。", "百[福]來，衆神往。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "085-08", "next": "085-10"}, "p10": {"key": "085-10", "title": "唐享太廟樂章：永和三首", "author": "張說", "canonical": "張說", "lines": ["肅九室，諧八音。", "歌皇慕，動神心。", "禮宿設，樂妙尋。", "聲明備，祼奠臨。", "律迓氣，音入玄。", "依玉幾，禦黼筵。", "聆愾息，僾周旋。", "九韶遍，百福傳。", "信工祝，永頌聲。", "來祖考，聽和平。", "相百辟，貢九瀛。", "神休委，帝孝成。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-09", "next": "085-11"}, "p11": {"key": "085-11", "title": "唐享太廟樂章：太和", "author": "張說", "canonical": "張說", "lines": ["時文聖後，清廟肅邕。", "致誠勤薦，在貌思恭。", "玉節肆夏，金鏘五鐘。", "繩繩雲步，穆穆天容。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-10", "next": "085-12"}, "p12": {"key": "085-12", "title": "唐享太廟樂章：肅和", "author": "張說", "canonical": "張說", "lines": ["天子享孝，工歌溥將。", "射祼鬱鬯，乃焚膋薌。", "臭以達旨，聲以求陽。", "奉時烝嘗，永代不忘。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-11", "next": "085-13"}, "p13": {"key": "085-13", "title": "唐享太廟樂章：雍和二首", "author": "張說", "canonical": "張說", "lines": ["在滌嘉豢，麗碑敬牲。", "角握之牝，色純之騂。", "火傳陽燧，水溉陰精。", "<a class=\"ent ent-person\" href=\"../entities/person_%E5%A4%AA%E5%85%AC.html\">太公</a>胖俎，傅說和羹。", "俎豆有馥，齊盛潔豐。", "亦有和羹，既戒既平。", "鼓鐘管磬，肅唱和鳴。", "皇皇後祖，來我思成。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-12", "next": "085-14"}, "p14": {"key": "085-14", "title": "唐享太廟樂章：文舞", "author": "張說", "canonical": "張說", "lines": ["聖謨九德，真言五千。", "慶集昌胄，符開帝先。", "高文杖鉞，克配彼天。", "三宗握鏡，六合渙燃。", "帝其承祀，率禮罔愆。", "圖書霧出，日月清懸。", "舞形德類，詠諗功傳。", "黃龍蜿蟺，彩雲蹁躚。", "五行氣順，八佾風宣。", "介此百祿，於皇萬年。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "085-13", "next": "085-15"}, "p15": {"key": "085-15", "title": "唐享太廟樂章：光大舞", "author": "張說", "canonical": "張說", "lines": ["肅肅藝祖，滔滔浚源。", "有雄玉劍，作鎮金門。", "玄王貽緒，<a class=\"ent ent-person\" href=\"../entities/person_%E5%90%8E%E7%A8%B7.html\">後稷</a>謀孫。", "肇禋九廟，四海來尊。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-14", "next": "085-16"}, "p16": {"key": "085-16", "title": "唐享太廟樂章：長髮舞", "author": "張說", "canonical": "張說", "lines": ["具禮崇德，備樂承風。", "魏推幢主，周贈司空。", "不行而至，無成有終。", "神興王業，天歸帝功。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-15", "next": "085-17"}, "p17": {"key": "085-17", "title": "唐享太廟樂章：大政舞", "author": "張說", "canonical": "張說", "lines": ["於赫元命，權輿帝文。", "天齊八柱，地半三分。", "宗廟觀德，笙鏞樂勳。", "封唐之兆，成天下君。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-16", "next": "085-18"}, "p18": {"key": "085-18", "title": "唐享太廟樂章：大成舞", "author": "張說", "canonical": "張說", "lines": ["帝舞季曆，龍聖生昌。", "後歌有蟜，胎炎孕黃。", "天地合德，日月齊光。", "肅雍孝享，祚我萬方。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-17", "next": "085-19"}, "p19": {"key": "085-19", "title": "唐享太廟樂章：大明舞", "author": "張說", "canonical": "張說", "lines": ["赤精亂德，四海困窮。", "黃旗舉義，三靈會同。", "早望春雨，雲披大風。", "溥天來祭，高祖之功。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-18", "next": "085-20"}, "p20": {"key": "085-20", "title": "唐享太廟樂章：崇德舞", "author": "張說", "canonical": "張說", "lines": ["皇合一德，朝宗百神。", "削平天地，大拯生人。", "上帝配食，<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%8D%95%E4%BA%8E.html\">單于</a>入臣。", "戎歌陳武，曄曄震震。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-19", "next": "085-21"}, "p21": {"key": "085-21", "title": "唐享太廟樂章：鈞天舞", "author": "張說", "canonical": "張說", "lines": ["高皇邁道，端拱無爲。", "化懷獯鬻，兵[戢]句驪。", "禮尊封禪，樂盤來儀。", "合位媧后，同稱伏羲。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "085-20", "next": "085-22"}, "p22": {"key": "085-22", "title": "唐享太廟樂章：大和舞", "author": "張說", "canonical": "張說", "lines": ["退居江水，鬱起丹陵。", "禮物還舊，朝章中興。", "龍圖友及，駿命恭膺。", "鳴球香瓚，大糦是承。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-21", "next": "085-23"}, "p23": {"key": "085-23", "title": "唐享太廟樂章：景雲舞", "author": "張說", "canonical": "張說", "lines": ["<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E4%BA%91.html\">景雲</a>霏爛，告我帝符。", "噫帝沖德，與天為徒。", "笙鏞遙遠，俎豆虛無。", "春秋孝獻，回復此都。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-22", "next": "085-24"}, "p24": {"key": "085-24", "title": "唐享太廟樂章：福和", "author": "張說", "canonical": "張說", "lines": ["備禮用樂，崇親致尊。", "誠通慈降，敬徹愛存。", "獻懷稱壽，啐感承恩。", "皇帝孝德，子孫千億。", "大包天域，長亙不極。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "085-23", "next": "085-25"}, "p25": {"key": "085-25", "title": "唐享太廟樂章：舒和", "author": "張說", "canonical": "張說", "lines": ["六鐘翕協六變成，八佾徜徉八風生。", "樂九韶兮人神感，美七德兮天地清。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "085-24", "next": "085-26"}, "p26": {"key": "085-26", "title": "唐享太廟樂章：凱安三首", "author": "張說", "canonical": "張說", "lines": ["瑟彼瑤爵，亞維上公。", "室如屏氣，門不容躬。", "禮殷其本，樂執其中。", "聖皇永慕，天地幽通。", "禮匝三獻，樂徧九成。", "降循軒陛，仰欷皇情。", "福與仁合，德因孝明。", "百年神畏，四海風行。", "總總干戚，填填鼓鐘。", "奮揚增氣，坐作爲容。", "離若鷙鳥，合如戰龍。", "萬方觀德，肅肅邕邕。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "085-25", "next": "085-27"}, "p27": {"key": "085-27", "title": "唐享太廟樂章：登歌", "author": "張說", "canonical": "張說", "lines": ["止笙磬，撤豆籩。", "廓無響，窅入玄。", "主在室，神在天。", "情餘慕，禮罔愆。", "喜黍稷，屢豐年。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-26", "next": "085-28"}, "p28": {"key": "085-28", "title": "唐享太廟樂章：永和", "author": "張說", "canonical": "張說", "lines": ["眇嘉樂，授靈爽。", "感若來，思如往。", "休氣散，回風上。", "返寂寞，還惚恍。", "懷靈駕，結空想。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "085-27", "next": null}}}