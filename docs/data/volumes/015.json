{"vol_name": "卷一十五", "poems": {"p01": {"key": "015-01", "title": "郊廟歌辭：讓皇帝廟樂章：迎神", "author": "李舒", "canonical": "李舒", "lines": ["皇矣天宗，德先<a class=\"ent ent-person\" href=\"../entities/person_%E7%8E%8B%E5%AD%A3.html\">王季</a>。", "因心則友，克讓以位。", "爰命有司，式遵前志。", "神其降靈，昭饗祀事。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "015-02"}, "p02": {"key": "015-02", "title": "郊廟歌辭：讓皇帝廟樂章：奠幣", "author": "李舒", "canonical": "李舒", "lines": ["惟帝時若，去而上仙。", "祀用商舞，樂備宮懸。", "白璧加薦，玄纁告虔。", "子孫拜後，承茲吉蠲。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-01", "next": "015-03"}, "p03": {"key": "015-03", "title": "郊廟歌辭：讓皇帝廟樂章：迎俎", "author": "李舒", "canonical": "李舒", "lines": ["祀盛體薦，禮協粢盛。", "方周假廟，用魯純牲。", "捧徹祗敬，擊拊和鳴。", "受厘歸胙，既戒而平。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-02", "next": "015-04"}, "p04": {"key": "015-04", "title": "郊廟歌辭：讓皇帝廟樂章：酌獻", "author": "李舒", "canonical": "李舒", "lines": ["八音具舉，三壽既盥。", "潔茲宗彝，瑟彼圭瓚。", "蘭肴重錯，椒醑飄散。", "降胙維城，永為藩翰。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-03", "next": "015-05"}, "p05": {"key": "015-05", "title": "郊廟歌辭：讓皇帝廟樂章：亞獻終獻", "author": "李舒", "canonical": "李舒", "lines": ["秩禮有序，和音既同。", "九儀不忒，三揖將終。", "孝感藩後，相維辟公。", "四時之典，永永無窮。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-04", "next": "015-06"}, "p06": {"key": "015-06", "title": "郊廟歌辭：讓皇帝廟樂章：送神", "author": "李舒", "canonical": "李舒", "lines": ["奠獻已事，昏昕載分。", "風搖雨散，靈衛絪縕。", "龍駕帝服，上騰五雲。", "泮宮複閟，寂寞無聞。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-05", "next": "015-07"}, "p07": {"key": "015-07", "title": "郊廟歌辭：享隱太子廟樂章：誠和", "author": "不詳", "canonical": "不詳", "lines": ["道閟鶴關，運纏鳩裏。", "門集大命，俾歆嘉祀。", "禮亞六瑚，誠殫二簋。", "有誠顒若，神斯戾止。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-06", "next": "015-08"}, "p08": {"key": "015-08", "title": "郊廟歌辭：享隱太子廟樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["歲肇春宗，幹開震長。", "瑤山既寂，戾園斯享。", "玉肅其事，物昭其象。", "弦誦成風，笙歌合響。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-07", "next": "015-09"}, "p09": {"key": "015-09", "title": "郊廟歌辭：享隱太子廟樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["明典肅陳，神居邃啟。", "春伯聯事，秋官相禮。", "有來雍雍，登歌濟濟。", "緬維主鬯，庶歆芳醴。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-08", "next": "015-10"}, "p10": {"key": "015-10", "title": "郊廟歌辭：享隱太子廟樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["三縣已判歌鐘列，六佾將開羽戚分。", "尚想燕飛來蔽日，終疑鶴影降淩雲。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-09", "next": "015-11"}, "p11": {"key": "015-11", "title": "郊廟歌辭：享隱太子廟樂章：凱安", "author": "不詳", "canonical": "不詳", "lines": ["天步昔將開，商郊初欲踐。", "撫戎金陣廓，貳極瑤圖闡。", "雞戟遂崇儀，龍樓期好善。", "弄兵隳震業，啟聖隆嗣典。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-10", "next": "015-12"}, "p12": {"key": "015-12", "title": "郊廟歌辭：隱太子廟樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["蒼震有位，黃離蔽明。", "江充禍結，戾據災成。", "銜冤昔痛，贈典今榮。", "享靈有秩，奉樂以迎。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-11", "next": "015-13"}, "p13": {"key": "015-13", "title": "郊廟歌辭：隱太子廟樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["皇情悼往，祀議增設。", "鐘鼓鏗鏘，羽旄昭晰。", "掌禮雲備，司筵告徹。", "樂以送神，靈其鑒闋。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-12", "next": "015-14"}, "p14": {"key": "015-14", "title": "郊廟歌辭：享章懷太子廟樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["副君昭象，道應黃離。", "銅樓備德，玉裕成規。", "仙氣靄靄，靈從師師。", "前驅戾止，控鶴來儀。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-13", "next": "015-15"}, "p15": {"key": "015-15", "title": "郊廟歌辭：享章懷太子廟樂章：登歌酌鬯", "author": "不詳", "canonical": "不詳", "lines": ["忠孝本著，羽翼先成。", "寢門昭德，馳道為程。", "幣帛有典，容衛無聲。", "司存既肅，廟享惟清。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-14", "next": "015-16"}, "p16": {"key": "015-16", "title": "郊廟歌辭：享章懷太子廟樂章：迎俎酌獻", "author": "不詳", "canonical": "不詳", "lines": ["通三錫胤，明兩承英。", "<a class=\"ent ent-place\" href=\"../entities/place_%E5%A4%AA%E5%B1%B1.html\">太山</a>比赫，伊水聞笙。", "宗祧是寄，禮樂其亨。", "嘉辰薦俎，以發聲明。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-15", "next": "015-17"}, "p17": {"key": "015-17", "title": "郊廟歌辭：享章懷太子廟樂章：送文舞迎武舞", "author": "不詳", "canonical": "不詳", "lines": ["羽鑰崇文禮以畢，幹戚奮武事將行。", "用舍繇來其有致，壯志宣威樂太平。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-16", "next": "015-18"}, "p18": {"key": "015-18", "title": "郊廟歌辭：享章懷太子廟樂章：武舞作", "author": "不詳", "canonical": "不詳", "lines": ["綠林熾炎曆，黃虞格有苗。", "沙塵驚塞外，帷幄命嫖姚。", "七德干戈止，三邊雲霧消。", "寶祚長無極，歌舞盛今朝。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-17", "next": "015-19"}, "p19": {"key": "015-19", "title": "郊廟歌辭：享懿德太子廟樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["甲觀昭祥，畫堂升位。", "禮絕群後，望尊儲貳。", "啟誦慚德，莊丕掩粹。", "伊浦鳳翔，緱峰鶴至。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-18", "next": "015-20"}, "p20": {"key": "015-20", "title": "郊廟歌辭：享懿德太子廟樂章：登歌酌鬯", "author": "不詳", "canonical": "不詳", "lines": ["譽闡元儲，寄崇明兩。", "玉裕雖晦，銅樓可想。", "弦誦輟音，笙歌罷響。", "幣帛言設，禮容無爽。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-19", "next": "015-21"}, "p21": {"key": "015-21", "title": "郊廟歌辭：享懿德太子廟樂章：迎俎酌獻", "author": "不詳", "canonical": "不詳", "lines": ["雍雍盛典，肅肅靈祠。", "賓天有聖，對日無期。", "飄颻羽服，掣曳雲旗。", "眷言主鬯，心乎愴茲。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-20", "next": "015-22"}, "p22": {"key": "015-22", "title": "郊廟歌辭：享懿德太子廟樂章：送文舞迎武舞", "author": "不詳", "canonical": "不詳", "lines": ["八音協奏陳金石，六佾分行整禮容。", "滄溟赴海還稱少，素月開輪即是重。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-21", "next": "015-23"}, "p23": {"key": "015-23", "title": "郊廟歌辭：享懿德太子廟樂章：武舞作", "author": "不詳", "canonical": "不詳", "lines": ["隋季昔雲終，唐年初啟聖。", "纂戎將禁暴，崇儒更敷政。", "威略靜三邊，仁恩覃萬姓。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "015-22", "next": "015-24"}, "p24": {"key": "015-24", "title": "郊廟歌辭：享節湣太子廟樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["儲後望崇，元良寄切。", "寢門是仰，馳道不絕。", "仙袂雲會，靈旗電晰。", "煌煌而來，禮物攸設。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-23", "next": "015-25"}, "p25": {"key": "015-25", "title": "郊廟歌辭：享節湣太子廟樂章：登歌酌鬯", "author": "不詳", "canonical": "不詳", "lines": ["灼灼重明，仰承元首。", "既賢且哲，惟孝與友。", "惟孝雖遙，靈規不朽。", "禮因誠致，備絜玄酒。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-24", "next": "015-26"}, "p26": {"key": "015-26", "title": "郊廟歌辭：享節湣太子廟樂章：迎俎酌獻", "author": "不詳", "canonical": "不詳", "lines": ["嘉薦有典，至誠莫騫。", "畫梁雲亙，雕俎星連。", "樂器周列，禮容備宣。", "依稀如在，若未賓天。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-25", "next": "015-27"}, "p27": {"key": "015-27", "title": "郊廟歌辭：享節湣太子廟樂章：送文舞出迎武舞入", "author": "不詳", "canonical": "不詳", "lines": ["邕邕闡化憑文德，赫赫宣威藉武功。", "既執羽旄先拂吹，還持玉戚更揮空。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-26", "next": "015-28"}, "p28": {"key": "015-28", "title": "郊廟歌辭：享節湣太子廟樂章：武舞作", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-time\" href=\"../entities/time_%E6%AD%A6%E5%BE%B7.html\">武德</a>諒雍雍，由來掃寇戎。", "劍光揮作電，旗影列成虹。", "霧廓三邊靜，波澄四海同。", "睿圖今已盛，相共舞皇風。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-27", "next": "015-29"}, "p29": {"key": "015-29", "title": "郊廟歌辭：享文敬太子廟樂章：請神", "author": "許孟容", "canonical": "許孟容", "lines": ["觴牢具品，管磬有節。", "祝道夤恭，神儀昭晰。", "桐圭早貴，象輅追設。", "聲達樂成，降歆豐潔。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-28", "next": "015-30"}, "p30": {"key": "015-30", "title": "郊廟歌辭：享文敬太子廟樂章：登歌", "author": "陳京", "canonical": "陳京", "lines": ["歌以德發，聲以樂貴。", "樂善名存，追仙禮異。", "鸞旌拱修，鳳鳴合吹。", "神聽皇慈，仲月皆至。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-29", "next": "015-31"}, "p31": {"key": "015-31", "title": "郊廟歌辭：享文敬太子廟樂章：迎俎酌獻", "author": "馮伉", "canonical": "馮伉", "lines": ["撰日瞻景，誠陳樂張。", "禮容秩秩，羽舞煌煌。", "肅將滌濯，祗薦芬芳。", "永錫繁祉，思深饗嘗。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-30", "next": "015-32"}, "p32": {"key": "015-32", "title": "郊廟歌辭：享文敬太子廟樂章：送文舞迎武舞", "author": "不詳", "canonical": "不詳", "lines": ["幹旄羽鑰相虧蔽，一進一退殊行綴。", "昔獻三雍盛禮容，今陳六佾崇儀制。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-31", "next": "015-33"}, "p33": {"key": "015-33", "title": "郊廟歌辭：享文敬太子廟樂章：亞獻終獻", "author": "崔邠", "canonical": "崔邠", "lines": ["醴齊泛尊彝，軒縣動幹戚。", "入室僾如在，升階虔所曆。", "奮疾合威容，定利舒皦繹。", "方崇廟貌禮，永被君恩錫。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-32", "next": "015-34"}, "p34": {"key": "015-34", "title": "郊廟歌辭：享文敬太子廟樂章：送神", "author": "崔邠", "canonical": "崔邠", "lines": ["三獻具舉，九旗將旋。", "追勞表德，罷享賓天。", "風引仙管，堂虛畫筵。", "芳馨常在，瞻望悠然。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-33", "next": "015-35"}, "p35": {"key": "015-35", "title": "郊廟歌辭：享惠昭太子廟樂章：請神", "author": "歸登", "canonical": "歸登", "lines": ["嘉薦既陳，祀事孔明。", "閑歌在堂，萬舞在庭。", "外則盡物，內則盡誠。", "鳳笙如聞，歌其潔精。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-34", "next": "015-36"}, "p36": {"key": "015-36", "title": "郊廟歌辭：享惠昭太子廟樂章：登歌", "author": "杜羔", "canonical": "杜羔", "lines": ["因心克孝，位震遺芬。", "賓天道茂，軫懷氣分。", "發祗乃祀，咳歎如聞。", "二歌斯升，以詠德熏。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-35", "next": "015-37"}, "p37": {"key": "015-37", "title": "郊廟歌辭：享惠昭太子廟樂章：迎俎酌獻", "author": "李逢吉", "canonical": "李逢吉", "lines": ["既潔酒醴，聿陳熟腥。", "肅將震念，昭格儲靈。", "展矣禮典，熏然德馨。", "愔愔管磬，亦具是聽。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-36", "next": "015-38"}, "p38": {"key": "015-38", "title": "郊廟歌辭：享惠昭太子廟樂章：送文舞出迎武舞入", "author": "孟簡", "canonical": "孟簡", "lines": ["喧喧金石容既缺，肅肅羽駕就行列。", "緱山遺響昔所聞，廟庭進旅今攸設。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-37", "next": "015-39"}, "p39": {"key": "015-39", "title": "郊廟歌辭：享惠昭太子廟樂章：亞獻終獻", "author": "裴度", "canonical": "裴度", "lines": ["重輪始發祥，齒胄方興學。", "冥然升紫府，鏗爾薦清樂。", "奠斝致馨香，在庭紛羽鑰。", "禮成神既醉，仿佛緱山鶴。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-38", "next": "015-40"}, "p40": {"key": "015-40", "title": "郊廟歌辭：享惠昭太子廟樂章：送神", "author": "王涯", "canonical": "王涯", "lines": ["威儀畢陳，備樂將闋。", "苞茅酒縮，膋蕭香徹。", "宮臣展事，肅雍在列。", "迎精送往，厥鑒昭晰。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-39", "next": "015-41"}, "p41": {"key": "015-41", "title": "《郊廟歌辭：武后崇先廟樂章", "author": "不詳", "canonical": "不詳", "lines": ["先德謙撝冠昔，嚴規節素超今。", "奉國忠誠每竭，承家至孝純深。", "追崇懼乖尊意，顯號恐玷徽音。", "既迫王公屢請，方乃俯遂羣心。", "有限無由展敬，奠醑每闕親斟。", "大禮虔申典冊，蘋藻敬薦翹襟。"], "form": "六言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "015-40", "next": "015-42"}, "p42": {"key": "015-42", "title": "郊廟歌辭：褒德廟樂章：昭德", "author": "不詳", "canonical": "不詳", "lines": ["道赫梧宮，悲盈蒿裏。", "爰賜徽烈，載敷嘉祀。", "享洽四時，規陳二簋。", "靈應昭格，神其戾止。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-41", "next": "015-43"}, "p43": {"key": "015-43", "title": "郊廟歌辭：褒德廟樂章：進德", "author": "不詳", "canonical": "不詳", "lines": ["塗山懿戚，媯汭崇姻。", "祠筵肇啟，祭典方申。", "禮以備物，樂以感神。", "用隆敦敘，載穆彝倫。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-42", "next": "015-44"}, "p44": {"key": "015-44", "title": "郊廟歌辭：褒德廟樂章：褒德", "author": "不詳", "canonical": "不詳", "lines": ["家著累仁，門昭積善。", "瑤篚既列，金縣式展。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "015-43", "next": "015-45"}, "p45": {"key": "015-45", "title": "郊廟歌辭：褒德廟樂章：武舞作", "author": "不詳", "canonical": "不詳", "lines": ["昭昭竹殿開，奕奕蘭宮啟。", "懿範隆丹掖，殊榮辟朱邸。", "六佾薦徽容，三簋陳芳醴。", "萬石覃貽厥，分珪崇祖禰。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-44", "next": "015-46"}, "p46": {"key": "015-46", "title": "郊廟歌辭：褒德廟樂章：彰德", "author": "不詳", "canonical": "不詳", "lines": ["名隆五嶽，秩映三台。", "嚴祠已備，[睟]影方迴。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "015-45", "next": "015-47"}, "p47": {"key": "015-47", "title": "舞曲歌辭：功成慶善樂舞詞", "author": "不詳", "canonical": "不詳", "lines": ["壽丘惟舊跡，酆邑乃前基。", "粵餘承累聖，懸弧亦在茲。", "弱齡逢運改，提劍郁匡時。", "指麾八荒定，懷柔萬國夷。", "梯山盛入款，駕海亦來思。", "<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%8D%95%E4%BA%8E.html\">單于</a>陪武帳，日逐衛文㮰。", "端扆朝四岳，無為任百司。", "霜節明秋景，輕冰結水湄。", "芸黃遍原隰，禾穎積京坻。", "共樂還譙宴，歡此大風詩。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-46", "next": "015-48"}, "p48": {"key": "015-48", "title": "舞曲歌辭：中和樂舞詞", "author": "不詳", "canonical": "不詳", "lines": ["芳歲肇佳節，物華當仲春。", "乾坤既昭泰，煙景含氤氳。", "德淺荷玄貺，樂成思治人。", "前庭列鐘鼓，廣殿延群臣。", "八卦隨舞意，五音轉曲新。", "顧非咸池奏，庶協南風熏。", "式宴禮所重，浹歡情必均。", "同和諒在茲，萬國希可親。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-47", "next": "015-49"}, "p49": {"key": "015-49", "title": "舞曲歌辭：凱樂歌辭：破陣樂", "author": "不詳", "canonical": "不詳", "lines": ["受律辭元首，相將討叛臣。", "咸歌破陣樂，共賞太平人。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-48", "next": "015-50"}, "p50": {"key": "015-50", "title": "舞曲歌辭：凱樂歌辭：應聖期", "author": "不詳", "canonical": "不詳", "lines": ["聖德期昌運，雍熙萬宇清。", "乾坤資化育，海嶽共休明。", "辟土欣耕稼，銷戈遂偃兵。", "殊方歌帝澤，執贄駕升平。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "015-49", "next": "015-51"}, "p51": {"key": "015-51", "title": "舞曲歌辭：凱樂歌辭：賀聖歡", "author": "不詳", "canonical": "不詳", "lines": ["四海皇風被，千年德水清。", "戎衣更不著，今日告功成。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-50", "next": "015-52"}, "p52": {"key": "015-52", "title": "舞曲歌辭：凱樂歌辭：君臣同慶樂", "author": "不詳", "canonical": "不詳", "lines": ["主聖開昌曆，臣忠奉大猷。", "君看偃革後，便是太平秋。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "015-51", "next": null}}}