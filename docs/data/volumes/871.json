{"vol_name": "卷八百七十一", "poems": {"p01": {"key": "871-01", "title": "與王仙客互嘲", "author": "甘洽", "canonical": "甘洽", "lines": ["王，計爾應姓田。", "為你面撥獺，抽卻你兩邊。", "<span class=\"lianju-author\" title=\"联句作者\">甘洽</span>", "甘，計爾應姓丹。", "為你頭不曲，回腳向上安。", "<span class=\"lianju-author\" title=\"联句作者\">仙客</span>"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "871-02"}, "p02": {"key": "871-02", "title": "題濠州高塘館", "author": "閻敬愛", "canonical": "閻敬愛", "lines": ["借問<a class=\"ent ent-person\" href=\"../entities/person_%E8%A5%84%E7%8E%8B.html\">襄王</a>安在哉，山川此地勝陽臺。", "今宵寓宿高塘館，神女何曾入夢來。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "871-01", "next": "871-03"}, "p03": {"key": "871-03", "title": "題敬愛詩後", "author": "李和風", "canonical": "李和風", "lines": ["高唐不是這高塘，淮畔荊南各異方。", "若向此中求薦枕，參差笑殺楚<a class=\"ent ent-person\" href=\"../entities/person_%E8%A5%84%E7%8E%8B.html\">襄王</a>。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "871-02", "next": "871-04"}, "p04": {"key": "871-04", "title": "答日休皮字詩", "author": "歸氏子", "canonical": "歸氏子", "lines": ["八片尖裁浪作球，火中燖了水中揉。", "一包閒氣如長在，惹踢招拳卒未休。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "871-03", "next": "871-05"}, "p05": {"key": "871-05", "title": "謔池亳二州賓佐兼寄宣武軍掌書記李晝", "author": "張魯封", "canonical": "張魯封", "lines": ["杜叟學仙輕蕙質，韋公事佛畏青娥。", "樂營卻是閒人管，兩地風情日漸多。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "871-04", "next": "871-06"}, "p06": {"key": "871-06", "title": "戲酬張魯封", "author": "李晝", "canonical": "李晝", "lines": ["秋浦亞卿顏叔子，譙都中憲老桑門。", "如今柳巷通車馬，唯恐他時立棘垣。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "871-05", "next": "871-07"}, "p07": {"key": "871-07", "title": "即事", "author": "楊鸞", "canonical": "楊鸞", "lines": ["白日蒼蠅滿飯盤，夜間蚊子又成團。", "每到更深人靜後，定來頭上咬楊鸞。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "871-06", "next": "871-08"}, "p08": {"key": "871-08", "title": "嘲周顓", "author": "座客", "canonical": "座客", "lines": ["龍津掉尾十年勞，聲價當時鬥月高。", "惟有紅妝回舞手，似持霜刀向猿猱。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "871-07", "next": "871-09"}, "p09": {"key": "871-09", "title": "和座客", "author": "周顓", "canonical": "周顓", "lines": ["十載文場敢憚勞，宋都回鶂為風高。", "今朝甘被花枝笑，任道尊前愛縛猱。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "871-08", "next": "871-10"}, "p10": {"key": "871-10", "title": "答或人", "author": "張鷟", "canonical": "張鷟", "lines": ["寧可且將朱唇飲酒，誰能逐你黑齒常之。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "871-09", "next": "871-11"}, "p11": {"key": "871-11", "title": "嘲崔嘏", "author": "施肩吾", "canonical": "施肩吾", "lines": ["二十九人及第，五十七眼看花。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "871-10", "next": "871-12"}, "p12": {"key": "871-12", "title": "嶺南詩句", "author": "蘇芸", "canonical": "蘇芸", "lines": ["郭裏多榕樹，街中足使君。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "871-11", "next": "871-13"}, "p13": {"key": "871-13", "title": "諧詩逸句", "author": "包賀", "canonical": "包賀", "lines": ["霧是山巾子，船為水靸鞋。", "棹搖船掠鬢，風動水槌胸。", "苦竹筍抽青橛子，石榴樹掛小瓶兒。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "871-12", "next": "871-14"}, "p14": {"key": "871-14", "title": "題洞庭湖", "author": "蔡押衙", "canonical": "蔡押衙", "lines": ["可憐<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9E%E5%BA%AD.html\">洞庭</a>湖，恰到三冬無髭須。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "871-13", "next": "871-15"}, "p15": {"key": "871-15", "title": "戲令狐相", "author": "溫庭筠", "canonical": "溫庭筠", "lines": ["自從元老登庸後，天下諸胡悉帶鈴。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "871-14", "next": "871-16"}, "p16": {"key": "871-16", "title": "與羅隱互謔", "author": "顧雲", "canonical": "顧雲", "lines": ["青蠅被扇扇離席，<span class=\"lianju-author\" title=\"联句作者\">顧雲</span>", "白澤遭釘釘在門。", "<span class=\"lianju-author\" title=\"联句作者\">羅隱</span>"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "871-15", "next": "871-17"}, "p17": {"key": "871-17", "title": "引自落便宜句", "author": "孫光憲", "canonical": "孫光憲", "lines": ["窗下有時留客宿，室中無事伴僧眠。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "871-16", "next": "871-18"}, "p18": {"key": "871-18", "title": "嘲廩丘令丞", "author": "商則", "canonical": "商則", "lines": ["令丞俱動手，縣尉止回身。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "871-17", "next": "871-19"}, "p19": {"key": "871-19", "title": "題漢祖廟", "author": "羅穎", "canonical": "羅穎", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E9%A1%B9%E7%BE%BD.html\">項羽</a>英雄猶不懼，可憐容得辟陽侯。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "871-18", "next": "871-20"}, "p20": {"key": "871-20", "title": "自賦催妝詩", "author": "陳嶠", "canonical": "陳嶠", "lines": ["彭祖尚聞年八百，陳郎猶是小孩兒。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "871-19", "next": "871-21"}, "p21": {"key": "871-21", "title": "戲為舉子對句", "author": "何承裕", "canonical": "何承裕", "lines": ["曉來犬吠張三婦，日暮猿啼呂四妻。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "871-20", "next": "871-22"}, "p22": {"key": "871-22", "title": "答弟婦歇後語", "author": "李濤", "canonical": "李濤", "lines": ["慚無竇建，愧作梁山。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "871-21", "next": "871-23"}, "p23": {"key": "871-23", "title": "與釋惠江互謔", "author": "程紫霄", "canonical": "程紫霄", "lines": ["僧錄琵琶腿，<span class=\"lianju-author\" title=\"联句作者\">程紫霄</span>", "先生觱栗頭。", "<span class=\"lianju-author\" title=\"联句作者\">釋惠江</span>"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "871-22", "next": "871-24"}, "p24": {"key": "871-24", "title": "與李榮互謔", "author": "僧法軌", "canonical": "僧法軌", "lines": ["姓李應須禮，言榮又不榮。", "<span class=\"lianju-author\" title=\"联句作者\">僧法軌</span>", "身長三尺半，頭毛猶未生。", "<span class=\"lianju-author\" title=\"联句作者\">李榮</span>"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "871-23", "next": null}}}