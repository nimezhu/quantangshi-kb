{"vol_name": "卷二", "poems": {"p01": {"key": "002-01", "title": "太子納妃太平公主出降", "author": "李治", "canonical": "李治", "lines": ["龍樓光曙景，魯館啟朝扉。", "豔日濃妝影，低星降婺輝。", "玉庭浮瑞色，銀榜藻祥徽。", "雲轉花縈蓋，霞飄葉綴旗。", "雕軒回翠陌，寶駕歸丹殿。", "鳴珠佩曉衣，鏤璧輪開扇。", "華冠列綺筵，蘭醑申芳宴。", "環階鳳樂陳，玳席珍羞薦。", "蝶舞袖香新，歌分落素塵。", "歡凝歡懿戚，慶葉慶初姻。", "暑闌炎氣息，涼早吹疏頻。", "方期六合泰，共賞萬年春。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "002-02"}, "p02": {"key": "002-02", "title": "七夕宴懸圃二首", "author": "李治", "canonical": "李治", "lines": ["羽蓋飛天漢，鳳駕越層巒。", "俱歎三秋阻，共敘一宵歡。", "璜虧夜月落，靨碎曉星殘。", "誰能重操杼，纖手濯清瀾。", "霓裳轉雲路，鳳駕儼天潢。", "虧星凋夜靨，殘月落朝璜。", "促歡今夕促，長離別後長。", "輕梭聊駐織，掩淚獨悲傷。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-01", "next": "002-03"}, "p03": {"key": "002-03", "title": "過溫湯", "author": "李治", "canonical": "李治", "lines": ["溫渚停仙蹕，豐郊駐曉旌。", "路曲回輪影，岩虛傳漏聲。", "暖溜驚湍駛，寒空碧霧輕。", "林黃疏葉下，野白曙霜明。", "眺聽良無已，煙霞斷續生。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-02", "next": "002-04"}, "p04": {"key": "002-04", "title": "九月九日", "author": "李治", "canonical": "李治", "lines": ["端居臨玉扆，初律啟金商。", "鳳闕澄秋色，龍闈引夕涼。", "野淨山氣斂，林疏風露長。", "砌蘭虧半影，岩桂發全香。", "滿蓋荷凋翠，圓花菊散黃。", "揮鞭爭電烈，飛羽亂星光。", "柳空穿石碎，弦虛側月張。", "怯猿啼落岫，驚雁斷分行。", "斜輪低夕景，歸旆擁通莊。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-03", "next": "002-05"}, "p05": {"key": "002-05", "title": "謁慈恩寺題奘法師房", "author": "李治", "canonical": "李治", "lines": ["停軒觀福殿，遊目眺皇畿。", "法輪含日轉，花蓋接雲飛。", "翠煙香綺閣，丹霞光寶衣。", "幡虹遙合彩，定水迥分暉。", "蕭然登十地，自得會三歸。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-04", "next": "002-06"}, "p06": {"key": "002-06", "title": "謁大慈恩寺", "author": "李治", "canonical": "李治", "lines": ["日宮開萬仞，月殿聳千尋。", "花蓋飛團影，幡虹曳曲陰。", "綺霞遙籠帳，叢珠細網林。", "寥廓煙雲表，超然物外心。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-05", "next": "002-07"}, "p07": {"key": "002-07", "title": "守歲", "author": "李治", "canonical": "李治", "lines": ["今宵冬律盡，來朝麗景新。", "花餘凝地雪，條含暖吹分。", "綬吐芽猶嫩，冰<span class=\"lacuna\" title=\"底本阙字\">□</span>已鏤津。", "薄紅梅色冷，淺綠柳輕春。", "送迎交兩節，暄寒變一辰。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-06", "next": "002-08"}, "p08": {"key": "002-08", "title": "咸亨殿宴近臣諸親柏梁體", "author": "李治", "canonical": "李治", "lines": ["屏欲除奢政返淳。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "002-07", "next": "002-09"}, "p09": {"key": "002-09", "title": "九月九日幸臨渭亭登高得秋字", "author": "李顯", "canonical": "李顯", "lines": ["九日正乘秋，三杯興已周。", "泛桂迎尊滿，吹花向酒浮。", "長房萸早熟，彭澤菊初收。", "何藉龍沙上，方得恣淹留。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-08", "next": "002-10"}, "p10": {"key": "002-10", "title": "登驪山高頂寓目", "author": "李顯", "canonical": "李顯", "lines": ["四郊秦漢國，八水帝王都。", "閶闔雄裏閈，城闕壯規模。", "貫渭稱天邑，含岐實奧區。", "金門披玉館，因此識皇圖。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-09", "next": "002-11"}, "p11": {"key": "002-11", "title": "幸秦始皇陵", "author": "李顯", "canonical": "李顯", "lines": ["眷言君失德，驪邑想秦餘。", "政煩方改篆，愚俗乃焚書。", "<a class=\"ent ent-place\" href=\"../entities/place_%E9%98%BF%E6%88%BF.html\">阿房</a>久已滅，閣道遂成墟。", "欲厭東南氣，翻傷掩鮑車。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-10", "next": "002-12"}, "p12": {"key": "002-12", "title": "立春日遊苑迎春", "author": "李顯", "canonical": "李顯", "lines": ["神皋福地<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%89%E7%A7%A6.html\">三秦</a>邑，玉台金闕九仙家。", "寒光猶戀<a class=\"ent ent-place\" href=\"../entities/place_%E7%94%98%E6%B3%89.html\">甘泉</a>樹，", "淑景偏臨建始花。", "彩蝶黃鶯未歌舞，梅香柳色已矜誇。", "迎春正啟流霞席，暫囑曦輪勿遽斜。"], "form": "七律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-11", "next": "002-13"}, "p13": {"key": "002-13", "title": "十月誕辰內殿宴群臣效柏梁體聯句", "author": "李顯", "canonical": "李顯", "lines": ["潤色鴻業寄賢才，<span class=\"lianju-author\" title=\"联句作者\">李顯</span>", "叨居右弼愧鹽梅。", "<span class=\"lianju-author\" title=\"联句作者\">李嶠</span>", "運籌帷幄荷時來，<span class=\"lianju-author\" title=\"联句作者\">宗楚客</span>", "職掌圖籍濫蓬萊。", "<span class=\"lianju-author\" title=\"联句作者\">劉憲</span>", "兩司謬忝謝鐘裴，<span class=\"lianju-author\" title=\"联句作者\">崔湜</span>", "禮樂銓管效涓埃。", "<span class=\"lianju-author\" title=\"联句作者\">鄭愔</span>", "陳師振旅清九垓，<span class=\"lianju-author\" title=\"联句作者\">趙彥昭</span>", "欣承顧問侍天杯。", "<span class=\"lianju-author\" title=\"联句作者\">李適</span>", "銜恩獻壽柏梁台，<span class=\"lianju-author\" title=\"联句作者\">蘇頲</span>", "黃縑青簡奉康哉。", "<span class=\"lianju-author\" title=\"联句作者\">盧藏用</span>", "鯫生侍從忝王枚，<span class=\"lianju-author\" title=\"联句作者\">李乂</span>", "右掖司言實不才。", "<span class=\"lianju-author\" title=\"联句作者\">馬懷素</span>", "宗伯秩禮天地開，<span class=\"lianju-author\" title=\"联句作者\">薛稷</span>", "帝歌難續仰昭回。", "<span class=\"lianju-author\" title=\"联句作者\">宋之問</span>", "微臣捧日變寒灰，<span class=\"lianju-author\" title=\"联句作者\">陸景初</span>", "遠慚班左愧遊陪。", "<span class=\"lianju-author\" title=\"联句作者\">上官婕妤</span>"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "002-12", "next": "002-14"}, "p14": {"key": "002-14", "title": "景龍四年正月五日移仗蓬萊宮御大明殿會吐蕃騎馬之戲因重爲柏梁體聯句", "author": "李顯", "canonical": "李顯", "lines": ["大明禦宇臨萬方，<span class=\"lianju-author\" title=\"联句作者\">李顯</span>", "顧慚內政翊陶唐。", "<span class=\"lianju-author\" title=\"联句作者\">皇后</span>", "鸞鳴鳳舞向<a class=\"ent ent-place\" href=\"../entities/place_%E5%B9%B3%E9%98%B3.html\">平陽</a>，<span class=\"lianju-author\" title=\"联句作者\">長寧公主</span>", "秦樓魯館沐恩光。", "<span class=\"lianju-author\" title=\"联句作者\">安樂公主</span>", "無心為子輒求郎，——太<a class=\"ent ent-person\" href=\"../entities/person_%E5%B9%B3%E5%85%AC.html\">平公</a>主", "雄才七步謝<a class=\"ent ent-person\" href=\"../entities/person_%E9%99%88%E7%8E%8B.html\">陳王</a>。", "<span class=\"lianju-author\" title=\"联句作者\">溫王重茂</span>", "當熊讓輦愧前芳，<span class=\"lianju-author\" title=\"联句作者\">上官昭容</span>", "再司銓筦恩可忘。", "<span class=\"lianju-author\" title=\"联句作者\">崔湜</span>", "文江學海思濟航，<span class=\"lianju-author\" title=\"联句作者\">鄭愔</span>", "萬邦考績臣所詳。", "<span class=\"lianju-author\" title=\"联句作者\">武平一</span>", "著作不休出中腸，<span class=\"lianju-author\" title=\"联句作者\">閻朝隱</span>", "權豪屏跡肅嚴霜。", "<span class=\"lianju-author\" title=\"联句作者\">竇從一</span>", "鑄鼎開嶽造明堂，<span class=\"lianju-author\" title=\"联句作者\">宗晉卿</span>", "玉醴由來獻壽觴。", "<span class=\"lianju-author\" title=\"联句作者\">明悉獵</span>"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "002-13", "next": "002-15"}, "p15": {"key": "002-15", "title": "石淙", "author": "李顯", "canonical": "李顯", "lines": ["三陽本是標靈紀，二室由來獨擅名。", "霞衣霞錦千般狀，", "雲峰雲岫百重生。", "水炫珠光遇泉客，岩懸石鏡厭山精。", "永願乾坤符睿算，長居膝下屬歡情。"], "form": "七律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-14", "next": "002-16"}, "p16": {"key": "002-16", "title": "石淙", "author": "李旦", "canonical": "李旦", "lines": ["奇峰嶾嶙箕山北，秀崿岧嶢嵩鎮南。", "地首地肺何曾擬，", "天目天臺倍覺慚。", "樹影蒙蘢鄣疊岫，波深洶湧落懸潭。", "<span class=\"lacuna\" title=\"底本阙字\">□</span>願紫宸居得一，永欣丹扆禦通三。"], "form": "七律", "t300": null, "src": "yuding", "pilot": false, "prev": "002-15", "next": null}}}