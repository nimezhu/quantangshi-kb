{"vol_name": "卷八百八十", "poems": {"p01": {"key": "880-01", "title": "城陽公主卜繇", "author": "不詳", "canonical": "不詳", "lines": ["二火皆食，始同榮，末同戚。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "880-02"}, "p02": {"key": "880-02", "title": "馮存澄為明皇占", "author": "不詳", "canonical": "不詳", "lines": ["合因斬關，鑄印乘軒。", "始當果斷，終得嗣天。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-01", "next": "880-03"}, "p03": {"key": "880-03", "title": "錢知微卜賣天津橋", "author": "不詳", "canonical": "不詳", "lines": ["兩頭點土，中心虛懸。", "人足踏跋，不肯下錢。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-02", "next": "880-04"}, "p04": {"key": "880-04", "title": "王山人為李衛公按冥", "author": "不詳", "canonical": "不詳", "lines": ["位極人臣，壽六十四。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-03", "next": "880-05"}, "p05": {"key": "880-05", "title": "鐘傳客占曆日包橘", "author": "不詳", "canonical": "不詳", "lines": ["太歲當頭坐，諸神不敢當。", "其中有一物，常帶<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9E%E5%BA%AD.html\">洞庭</a>香。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "880-04", "next": "880-06"}, "p06": {"key": "880-06", "title": "馬重績占隨卦繇辭", "author": "不詳", "canonical": "不詳", "lines": ["南瞻析木，木不自續。", "虛而動之，動隨其覆。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-05", "next": "880-07"}, "p07": {"key": "880-07", "title": "方龜精為錢元懿蔔詞", "author": "不詳", "canonical": "不詳", "lines": ["太乙接天河，金華寶貝多。", "郡侯六十六，別處不經過。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "880-06", "next": "880-08"}, "p08": {"key": "880-08", "title": "葉簡占失牛", "author": "不詳", "canonical": "不詳", "lines": ["占失牛，已被家邊載上州。", "欲知賊姓一斤求，欲知賊名十干頭。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "880-07", "next": "880-09"}, "p09": {"key": "880-09", "title": "又射覆橘子", "author": "不詳", "canonical": "不詳", "lines": ["圓似珠，色如丹。", "儻能擘破同分吃，爭不慚愧<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9E%E5%BA%AD.html\">洞庭</a>山。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-08", "next": "880-10"}, "p10": {"key": "880-10", "title": "射覆巾子", "author": "不詳", "canonical": "不詳", "lines": ["近來好裹束，各自競尖新。", "秤無三五兩，因何號一斤。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "880-09", "next": "880-11"}, "p11": {"key": "880-11", "title": "射覆二雞子", "author": "不詳", "canonical": "不詳", "lines": ["此物不難知，一雄兼一雌。", "誰將打破看，方明混沌時。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "880-10", "next": "880-12"}, "p12": {"key": "880-12", "title": "天沖星占", "author": "不詳", "canonical": "不詳", "lines": ["天沖抱極泣帝前，血濁霧下天下冤。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "880-11", "next": "880-13"}, "p13": {"key": "880-13", "title": "占月語", "author": "不詳", "canonical": "不詳", "lines": ["月如彎弓，少雨多風。", "月如仰瓦，不求自下。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-12", "next": "880-14"}, "p14": {"key": "880-14", "title": "占雨", "author": "不詳", "canonical": "不詳", "lines": ["幹星照濕土，明日依舊雨。", "雲行西，星照泥。", "朝霞不出門，暮霞行千里。", "天將雨，鳩逐婦。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-13", "next": "880-15"}, "p15": {"key": "880-15", "title": "占四時甲子雨", "author": "不詳", "canonical": "不詳", "lines": ["春雨甲子，赤地千里。", "夏雨甲子，乘船入市。", "秋雨甲子，禾頭生耳。", "冬雨甲子，牛羊凍死。", "鵲巢下地，其年大水。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "880-14", "next": "880-16"}, "p16": {"key": "880-16", "title": "占年", "author": "不詳", "canonical": "不詳", "lines": ["要見麥，見三白。", "正月三白，田公笑赫赫。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-15", "next": "880-17"}, "p17": {"key": "880-17", "title": "樹稼諺", "author": "不詳", "canonical": "不詳", "lines": ["樹稼，達官怕。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-16", "next": "880-18"}, "p18": {"key": "880-18", "title": "相書語", "author": "不詳", "canonical": "不詳", "lines": ["目有四白，五夫守宅。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-17", "next": "880-19"}, "p19": {"key": "880-19", "title": "葬書語", "author": "不詳", "canonical": "不詳", "lines": ["葬壓龍角，其棺必斫。", "朱雀和鳴，子孫盛榮。", "朱雀悲哀，棺中見灰。", "安龍頭，枕龍角。", "不三年，自消鑠。", "安龍頭，枕龍耳。", "不三年，萬乘至。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-18", "next": "880-20"}, "p20": {"key": "880-20", "title": "陰陽書語", "author": "不詳", "canonical": "不詳", "lines": ["喬木先枯，眾子必孤。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "880-19", "next": "880-21"}, "p21": {"key": "880-21", "title": "本草采萍時日歌", "author": "不詳", "canonical": "不詳", "lines": ["不在山，不在岸，采我之時七月半。", "選甚癱風與緩風，些小微風都不算。", "豆淋酒內下三丸，鐵幞頭上也出汗。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "880-20", "next": "880-22"}, "p22": {"key": "880-22", "title": "和劑方補骨脂丸方詩", "author": "不詳", "canonical": "不詳", "lines": ["三年時節向邊隅，人信方知藥力殊。", "奪得春光來在手，青娥休笑白髭須。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "880-21", "next": "880-23"}, "p23": {"key": "880-23", "title": "李廷珪藏墨訣", "author": "不詳", "canonical": "不詳", "lines": ["贈爾烏玉玦，泉清研須潔。", "避暑懸葛囊，臨風度梅月。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "880-22", "next": null}}}