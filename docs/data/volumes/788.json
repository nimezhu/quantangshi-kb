{"vol_name": "卷七百八十八", "poems": {"p01": {"key": "788-01", "title": "改九子山為九華山聯句", "author": "李白", "canonical": "李白", "lines": ["妙有分二氣，靈山開九華。", "<span class=\"lianju-author\" title=\"联句作者\">李白</span>", "層標遏遲日，半壁明朝霞。", "<span class=\"lianju-author\" title=\"联句作者\">高霽</span>", "積雪曜陰壑，飛流噴陽崖。", "<span class=\"lianju-author\" title=\"联句作者\">韋權輿</span>", "青瑩玉樹色，縹緲羽人家。", "<span class=\"lianju-author\" title=\"联句作者\">李白</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": null, "next": "788-02"}, "p02": {"key": "788-02", "title": "夏夜李尚書筵送宇文石首赴縣聯句", "author": "杜甫", "canonical": "杜甫", "lines": ["愛客尚書貴，之官宅相賢。", "<span class=\"lianju-author\" title=\"联句作者\">杜甫</span>", "酒香傾坐側，帆影駐江邊。", "<span class=\"lianju-author\" title=\"联句作者\">李之芳</span>", "翟表郎官瑞，鳧看令宰仙。", "<span class=\"lianju-author\" title=\"联句作者\">崔彧</span>", "雨稀雲葉斷，夜久燭花偏。", "<span class=\"lianju-author\" title=\"联句作者\">杜甫</span>", "數語欹紗帽，高文擲彩箋。", "<span class=\"lianju-author\" title=\"联句作者\">李之芳</span>", "興饒行處樂，離惜醉中眠。", "<span class=\"lianju-author\" title=\"联句作者\">崔彧</span>", "單父長多暇，河陽實少年。", "<span class=\"lianju-author\" title=\"联句作者\">杜甫</span>", "客居逢自出，為別幾淒然。", "<span class=\"lianju-author\" title=\"联句作者\">李之芳</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-01", "next": "788-03"}, "p03": {"key": "788-03", "title": "登峴山觀李左相石尊聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["李公登飲處，因石為窪尊。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "人事歲年改，峴山今古存。", "<span class=\"lianju-author\" title=\"联句作者\">劉全白</span>", "榛蕪掩前跡，苔蘚餘舊痕。", "<span class=\"lianju-author\" title=\"联句作者\">裴循</span>", "叔子尚遺德，山公此回軒。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>", "維舟陪高興，感昔情彌敦。", "<span class=\"lianju-author\" title=\"联句作者\">吳筠</span>", "藹藹賢哲事，依依離別言。", "<span class=\"lianju-author\" title=\"联句作者\">強蒙</span>", "嶇嶔橫道周，迢遞連山根。", "<span class=\"lianju-author\" title=\"联句作者\">範縉</span>", "餘烈曖林野，眾芳揖蘭蓀。", "<span class=\"lianju-author\" title=\"联句作者\">王純</span>", "德暉映岩足，勝賞延高原。", "<span class=\"lianju-author\" title=\"联句作者\">魏理</span>", "遠水明匹練，因晴見吳門。", "<span class=\"lianju-author\" title=\"联句作者\">王修甫</span>", "陪游追盛美，揆德欣討論。", "<span class=\"lianju-author\" title=\"联句作者\">顏峴</span>", "器有成形用，功資造化元。", "<span class=\"lianju-author\" title=\"联句作者\">左輔元</span>", "流霞方泔淡，別鶴遽翩翻。", "<span class=\"lianju-author\" title=\"联句作者\">劉茂</span>", "舊規傾逸賞，新興麗初暾。", "<span class=\"lianju-author\" title=\"联句作者\">顏渾</span>", "醉後接㒿倒，歸時騶騎喧。", "<span class=\"lianju-author\" title=\"联句作者\">楊德元</span>", "遲回向遺跡，離別益傷魂。", "<span class=\"lianju-author\" title=\"联句作者\">韋介</span>", "覽事古興屬，送人歸思繁。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "懷賢久徂謝，贈遠空攀援。", "<span class=\"lianju-author\" title=\"联句作者\">崔弘</span>", "八座欽懿躅，高名播幹抻。", "<span class=\"lianju-author\" title=\"联句作者\">史仲宣</span>", "松深引閒步，葛弱供險捫。", "<span class=\"lianju-author\" title=\"联句作者\">陸羽</span>", "花氣酒中馥，雲華衣上屯。", "<span class=\"lianju-author\" title=\"联句作者\">權器</span>", "森沈列湖樹，牢落望效園。", "<span class=\"lianju-author\" title=\"联句作者\">陸士修</span>", "白日半岩岫，清風滿丘樊。", "<span class=\"lianju-author\" title=\"联句作者\">裴幼清</span>", "旌麾間翠幄，簫鼓來朱轓。", "<span class=\"lianju-author\" title=\"联句作者\">柳淡</span>", "閑路躡雲影，清心澄水源。", "<span class=\"lianju-author\" title=\"联句作者\">釋塵外</span>", "萍連浦中嶼，竹繞山下村。", "<span class=\"lianju-author\" title=\"联句作者\">顏顓</span>", "景落全溪暗，煙凝半嶺昏。", "<span class=\"lianju-author\" title=\"联句作者\">顏須</span>", "去日往如複，換年涼代溫。", "<span class=\"lianju-author\" title=\"联句作者\">顏頊</span>", "登臨繼風騷，義激舊府恩。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-02", "next": "788-04"}, "p04": {"key": "788-04", "title": "水堂送諸文士戲贈潘丞聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["居人未可散，上客須留著。", "莫唱阿嚲回，應雲夜半樂。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "詩教刻燭賦，酒任連盤酌。", "從他白眼看，終戀青山郭。", "<span class=\"lianju-author\" title=\"联句作者\">潘述</span>", "林棲非姓許，寺住那名約。", "會異永和年，才同建安作。", "<span class=\"lianju-author\" title=\"联句作者\">陸羽</span>", "何煩問更漏，但遣催弦索。", "共說長句能，皆言早歸惡。", "<span class=\"lianju-author\" title=\"联句作者\">權器</span>", "那知殊出處，還得同笑謔。", "雅韻雖暫歡，禪心肯拋卻。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "一宿同高會，幾人歸下若。", "簾開北陸風，燭焯南枝鵲。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "文場苦叨竊，釣渚甘漂泊。", "弱質幸見容，菲才誠重諾。", "<span class=\"lianju-author\" title=\"联句作者\">潘述</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-03", "next": "788-05"}, "p05": {"key": "788-05", "title": "與耿湋水亭詠風聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["清風何處起，拂檻複縈洲。", "<span class=\"lianju-author\" title=\"联句作者\">裴幼清</span>", "回入飄華幕，輕來疊晚流。", "<span class=\"lianju-author\" title=\"联句作者\">楊憑</span>", "桃竹今已展，羽翣且從收。", "<span class=\"lianju-author\" title=\"联句作者\">楊凝</span>", "經竹吹彌切，過松韻更幽。", "<span class=\"lianju-author\" title=\"联句作者\">左輔元</span>", "直散青蘋末，偏隨白浪頭。", "<span class=\"lianju-author\" title=\"联句作者\">陸士修</span>", "山山催雨過，浦浦發行舟。", "<span class=\"lianju-author\" title=\"联句作者\">權器</span>", "動樹蟬爭噪，開簾客罷愁。", "<span class=\"lianju-author\" title=\"联句作者\">陸羽</span>", "度弦方解慍，臨水已迎秋。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "涼為開襟至，清因作頌留。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "周回隨遠夢，騷屑滿離憂。", "<span class=\"lianju-author\" title=\"联句作者\">耿湋</span>", "豈獨銷繁暑，偏能入迥樓。", "——喬", "王風今若此，誰不荷明休。", "<span class=\"lianju-author\" title=\"联句作者\">陸涓</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-04", "next": "788-06"}, "p06": {"key": "788-06", "title": "又溪館聽蟬聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["高樹多涼吹，疏蟬足斷聲。", "<span class=\"lianju-author\" title=\"联句作者\">楊憑</span>", "已催居客感，更使別人驚。", "<span class=\"lianju-author\" title=\"联句作者\">楊凝</span>", "晚夏猶知急，新秋別有情。", "<span class=\"lianju-author\" title=\"联句作者\">權器</span>", "危湍和不似，細管學難成。", "<span class=\"lianju-author\" title=\"联句作者\">陸羽</span>", "當斅附金重，無貪曜火明。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "青松四面落，白髮一重生。", "<span class=\"lianju-author\" title=\"联句作者\">耿湋</span>", "向夕音彌厲，迎風翼更輕。", "——喬", "單嘶出迥樹，餘響思空城。", "<span class=\"lianju-author\" title=\"联句作者\">裴幼清</span>", "嘒唳松間坐，蕭寥竹裏行。", "<span class=\"lianju-author\" title=\"联句作者\">伯成</span>", "如何長飲露，高潔未能名。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-05", "next": "788-07"}, "p07": {"key": "788-07", "title": "送耿湋拾遺聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["堯舜逢明主，嚴徐得侍臣。", "分行接三事，高興柏梁新。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "<a class=\"ent ent-place\" href=\"../entities/place_%E6%A5%9A%E5%9B%BD.html\">楚國</a>千山道，秦城萬里人。", "鏡中看齒發，河上有煙塵。", "<span class=\"lianju-author\" title=\"联句作者\">耿湋</span>", "望闕飛青翰，朝天憶紫宸。", "喜來歡宴洽，愁去詠歌頻。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "顧盼情非一，睽攜處亦頻。", "吳興賢太守，臨水最殷勤。", "<span class=\"lianju-author\" title=\"联句作者\">耿湋</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-06", "next": "788-08"}, "p08": {"key": "788-08", "title": "五言月夜啜茶聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["泛花邀坐客，代飲引情言。", "<span class=\"lianju-author\" title=\"联句作者\">陸士修</span>", "醒酒宜華席，留僧想獨園。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>", "不須攀月桂，何假樹庭萱。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "禦史秋風勁，尚書北斗尊。", "<span class=\"lianju-author\" title=\"联句作者\">崔萬</span>", "流華淨肌骨，疏瀹滌心原。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "不似春醪醉，何辭綠菽繁。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "素瓷傳靜夜，芳氣清閒軒。", "<span class=\"lianju-author\" title=\"联句作者\">陸士修</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-07", "next": "788-09"}, "p09": {"key": "788-09", "title": "五言夜宴詠燈聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["桂酒牽詩興，蘭釭照客情。", "<span class=\"lianju-author\" title=\"联句作者\">陸士修</span>", "詎慚珠乘朗，不讓月輪明。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>", "破暗光初白，浮雲色轉清。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "帶花疑在樹，比燎欲分庭。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "顧己慚微照，開簾識近汀。", "<span class=\"lianju-author\" title=\"联句作者\">袁高</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-08", "next": "788-10"}, "p10": {"key": "788-10", "title": "三言喜皇甫曾侍禦見過南樓玩月", "author": "顏真卿", "canonical": "顏真卿", "lines": ["喜嘉客，辟前軒。", "天月淨，水雲昏。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "雁聲苦，蟾影寒。", "聞裛浥，滴檀欒。", "<span class=\"lianju-author\" title=\"联句作者\">陸羽</span>", "歡宴處，江湖間。", "<span class=\"lianju-author\" title=\"联句作者\">皇甫曾</span>", "卷翠幕，吟嘉句。", "恨清光，留不住。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "高駕動，清角催。", "惜歸去，重裴回。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "露欲晞，客將醉。", "猶宛轉，照深意。", "<span class=\"lianju-author\" title=\"联句作者\">陸士修</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-09", "next": "788-11"}, "p11": {"key": "788-11", "title": "七言重聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["頃持憲簡推高步，獨佔詩流橫素波。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "不是中情深惠好，誰能千里遠經過。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "詩書宛似陪康樂，少長還同宴永和。", "<span class=\"lianju-author\" title=\"联句作者\">皇甫曾</span>", "夜酌此時看碾玉，晨趨幾日重鳴珂。", "<span class=\"lianju-author\" title=\"联句作者\">皇甫曾</span>", "萬井更深空寂寞，千方霧起隱嵯峨。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "熒熒遠火分漁浦，歷歷寒枝露鳥窠。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "漢朝舊學君公隱，魯國今從弟子科。", "<span class=\"lianju-author\" title=\"联句作者\">陸羽</span>", "只自傾心慚煦濡，何曾將口恨蹉跎。", "<span class=\"lianju-author\" title=\"联句作者\">陸羽</span>", "獨賞謝吟山照耀，共知殷歎樹婆娑。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "華轂苦嫌雲路隔，衲衣長向雪峰何。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-10", "next": "788-12"}, "p12": {"key": "788-12", "title": "五言送李侍禦聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["吾友駐行輪，遲遲惜上春。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "東西出餞路，惆悵獨歸人。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "歡會期他日。", "驅馳恨此身。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>", "須知貢公望，從此願相因。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-11", "next": "788-13"}, "p13": {"key": "788-13", "title": "五言玩初月重遊聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["春溪與岸平，初月出溪明。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>", "璧彩寒仍潔，金波夜轉清。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "孤光遠近滿，練色往來輕。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "望望隨蘭棹，依依出柳城。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-12", "next": "788-14"}, "p14": {"key": "788-14", "title": "五言重送橫飛聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["春田草未齊，春水滿長溪。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "出餞風初暖，攀光日漸西。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "歸期江上遠，別思月中迷。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-13", "next": "788-15"}, "p15": {"key": "788-15", "title": "五言夜集聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["寒花護月色，墜葉占風音。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "茲夕無塵慮，高雲共片心。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-14", "next": "788-16"}, "p16": {"key": "788-16", "title": "三言擬五雜組聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["五雜組，盤上菹。", "往復還，頭懶梳。", "不得已，罾裏魚。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "五雜組，郊外蕪。", "往復還，櫪上駒。", "不得已，穀中愚。", "<span class=\"lianju-author\" title=\"联句作者\">殷佐明</span>", "五雜組，繡與錦。", "往復還，興又寢。", "不得已，病伏枕。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "五雜組，酒與肉。", "往復還，東籬菊。", "不得已，醉便宿。", "<span class=\"lianju-author\" title=\"联句作者\">袁高</span>", "五雜組，闤闠間。", "往復還，門上關。", "不得已，鬢毛斑。", "<span class=\"lianju-author\" title=\"联句作者\">陸士修</span>", "五雜組，繡紋線。", "往復還，春來燕。", "不得已，入征戰。", "<span class=\"lianju-author\" title=\"联句作者\">蔣志</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-15", "next": "788-17"}, "p17": {"key": "788-17", "title": "三言重擬五雜組聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["五雜組，四豪客。", "往復還，阡與陌。", "不得已，<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E6%B2%99.html\">長沙</a>謫。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>", "五雜組，五辛盤。", "往復還，馬上鞍。", "不得已，左降官。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "五雜組，甘鹹醋。", "往復還，烏與兔。", "不得已，韶光度。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "五雜組，五色絲。", "往復還，回文詩。", "不得已，失喜期。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-16", "next": "788-18"}, "p18": {"key": "788-18", "title": "七言大言聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["高歌閬風步瀛洲，<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "燂鵬爚鯤餐未休。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "四方上下無外頭，<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "一啜頓涸滄溟流。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-17", "next": "788-19"}, "p19": {"key": "788-19", "title": "七言小言聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["長路迢遙吞吐絲。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "蟭螟蚊睫察難知。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-18", "next": "788-20"}, "p20": {"key": "788-20", "title": "七言樂語聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["苦河既濟真僧喜，<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "新知滿座笑相視。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "戍客歸來見妻子，<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "學生放假偷向市。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-19", "next": "788-21"}, "p21": {"key": "788-21", "title": "七言嚵語聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["拈<span class=\"lacuna\" title=\"底本阙字\">□</span>舐指不知休，<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "欲炙侍立涎交流。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "過屠大嚼肯知羞，<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "食店門外強淹留。", "<span class=\"lianju-author\" title=\"联句作者\">張薦</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-20", "next": "788-22"}, "p22": {"key": "788-22", "title": "七言滑語聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["雨裏下山蹋榆皮，<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "莓苔石橋步難移。", "<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "蕪荑醬醋吃煮葵，<span class=\"lianju-author\" title=\"联句作者\">劉全白</span>", "縫靴蠟線油塗錐。", "<span class=\"lianju-author\" title=\"联句作者\">李崿</span>", "急逢龍背須且騎。", "<span class=\"lianju-author\" title=\"联句作者\">李益</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-21", "next": "788-23"}, "p23": {"key": "788-23", "title": "七言醉語聯句", "author": "顏真卿", "canonical": "顏真卿", "lines": ["逢糟遇曲便酩酊，<span class=\"lianju-author\" title=\"联句作者\">劉全白</span>", "覆車墜馬皆不醒。", "<span class=\"lianju-author\" title=\"联句作者\">顏真卿</span>", "倒著接㒿發垂領，<span class=\"lianju-author\" title=\"联句作者\">皎然</span>", "狂心亂語無人並。", "<span class=\"lianju-author\" title=\"联句作者\">陸羽</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "788-22", "next": null}}}