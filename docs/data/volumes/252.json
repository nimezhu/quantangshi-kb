{"vol_name": "卷二百五十二", "poems": {"p01": {"key": "252-01", "title": "宣州東峰亭各賦一物得古壁苔", "author": "劉太真", "canonical": "劉太真", "lines": ["苒苒溫寒泉，綿綿古危壁。", "光含孤翠動，色與暮雲寂。", "深淺松月間，幽人自登曆。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "252-02"}, "p02": {"key": "252-02", "title": "顧十二況左遷過韋蘇州房杭州韋睦州三使君皆有郡中燕集詩辭章高麗鄙夫之所仰慕顧生既至留連笑語因亦成篇以繼三君子之風焉", "author": "劉太真", "canonical": "劉太真", "lines": ["寵至乃不驚，罪及非無由。", "奔迸曆畏途，緬邈赴偏陬。", "牧此凋弊甿，屬當賦斂秋。", "夙興諒無補，旬暇焉敢休。", "前日懷友生，獨登城上樓。", "迢迢西北望，遠思不可收。", "今日車騎來，曠然銷人憂。", "晨迎東齋飯，晚度南溪遊。", "以我碧流水，泊君青翰舟。", "莫將遷客程，不為勝境留。", "飛劄謝三守，斯篇希見酬。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "252-01", "next": "252-03"}, "p03": {"key": "252-03", "title": "貢院寄前主司蕭尚書聽", "author": "劉太真", "canonical": "劉太真", "lines": ["獨坐貢闈裏，愁心芳草生。", "山公昨夜事，應見此時情。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "252-02", "next": "252-04"}, "p04": {"key": "252-04", "title": "東峰亭同劉太真各賦一物得垂澗藤", "author": "袁傪", "canonical": "袁傪", "lines": ["寒澗流不息，古藤終日垂。", "迎風仍未定，拂水更相宜。", "新花與舊葉，惟有幽人知。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "252-03", "next": "252-05"}, "p05": {"key": "252-05", "title": "喜陸侍禦破石埭草寇東峰亭賦詩", "author": "袁傪", "canonical": "袁傪", "lines": ["古詩東峰上，登臨興有餘。", "同觀白簡使，新報赤囊書。", "幾處閑烽堠，千方慶里閭。", "欣欣夏木長，寂寂晚煙徐。", "戰罷言歸馬，遠師賦出車。", "因知越<a class=\"ent ent-person\" href=\"../entities/person_%E8%8C%83%E8%A0%A1.html\">范蠡</a>，湖海意[何如]。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "252-04", "next": "252-06"}, "p06": {"key": "252-06", "title": "東峰亭各賦一物得嶺上雲", "author": "崔何", "canonical": "崔何", "lines": ["佇立增遠意，中峰見孤雲。", "溶溶傍危石，片片宜夕曛。", "漸向群木盡，殘飛更氤氳。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "252-05", "next": "252-07"}, "p07": {"key": "252-07", "title": "喜陸侍禦破石埭草寇東峰亭賦詩", "author": "崔何", "canonical": "崔何", "lines": ["絕景西溪寺，連延近郭山。", "高深清扃外，行止翠微間。", "江澈煙塵靜，川源草樹閑。", "中丞健步到，柱史捷書還。", "一戰清戎越，三吳變險艱。", "功名麟閣上，得詠入秦關。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "252-06", "next": "252-08"}, "p08": {"key": "252-08", "title": "東峰亭各賦一物得幽徑石", "author": "王緯", "canonical": "王緯", "lines": ["片石東溪上，陰崖剩阻修。", "雨餘青石靄，歲晚綠苔幽。", "從來不可轉，今日為人留。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "252-07", "next": "252-09"}, "p09": {"key": "252-09", "title": "喜陸侍禦破石埭草寇東峰亭賦詩", "author": "王緯", "canonical": "王緯", "lines": ["蜂蠆聚吳州，推賢奉聖憂。", "忠誠資上策，仁勇佐前籌。", "草木成鵝鸛，戈鋋複鬥牛。", "戎車一戰後，殘壘五兵收。", "野靜山戎險，江平水面流。", "更憐羈旅客，從此罷葵丘。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "252-08", "next": "252-10"}, "p10": {"key": "252-10", "title": "東峰亭各賦一物得臨軒桂", "author": "郭澹", "canonical": "郭澹", "lines": ["青青芳桂樹，幽陰在庭軒。", "向日陰還合，從風葉乍翻。", "共看霜雪後，終不變涼暄。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "252-09", "next": "252-11"}, "p11": {"key": "252-11", "title": "喜陸侍禦破石埭草寇東峰亭賦詩", "author": "郭澹", "canonical": "郭澹", "lines": ["介胄鷹揚出，山林蟻聚空。", "忽聞飛簡報，曾是坐籌功。", "迥夜昏氛滅，危亭眺望雄。", "茂勳推世上，餘興寄杯中。", "喜色煙霞改，歡忻裏巷同。", "幸茲尊俎末，飲至又從公。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "252-10", "next": "252-12"}, "p12": {"key": "252-12", "title": "東峰亭各賦一物得林中翠", "author": "高傪", "canonical": "高傪", "lines": ["杳靄無定狀，霏微常滿林。", "清風光不散，過雨色偏深。", "幽意賞難盡，終朝再招尋。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "252-11", "next": "252-13"}, "p13": {"key": "252-13", "title": "東峰亭各賦一物得棲煙鳥", "author": "李岑1", "canonical": "李岑", "lines": ["從來養毛羽，昔日曾飛遷。", "變轉對朝陽，差池棲夕煙。", "遇此枝葉覆，夙舉冀沖天。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "252-12", "next": "252-14"}, "p14": {"key": "252-14", "title": "東峰亭各賦一物得寒溪草", "author": "蘇", "canonical": "蘇", "lines": ["冪<span class=\"lacuna\" title=\"底本阙字\">□</span>溪邊草，遊人不厭看。", "餘芳幽處老，深色望中寒。", "幸得陪情興，青青賞未闌。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "252-13", "next": "252-15"}, "p15": {"key": "252-15", "title": "東峰亭各賦一物得陰崖竹", "author": "袁邕", "canonical": "袁邕", "lines": ["終歲寒苔色，寂寥幽思深。", "<a class=\"ent ent-place\" href=\"../entities/place_%E6%9C%9D%E6%AD%8C.html\">朝歌</a>猶夕嵐，日永流清陰。", "龍鍾負煙雪，自有淩雲心。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "252-14", "next": "252-16"}, "p16": {"key": "252-16", "title": "唐德明興聖廟樂章：迎神", "author": "李紓", "canonical": "李紓", "lines": ["元尊九德，佐堯光宅。", "烈祖太宗，方周作伯。", "響懷霜露，樂變金石。", "白雲清風，仿佛來格。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-15", "next": "252-17"}, "p17": {"key": "252-17", "title": "唐德明興聖廟樂章：登歌奠幣", "author": "李紓", "canonical": "李紓", "lines": ["四時有典，百事來祭。", "尊祖奉宗，嚴禋大帝。", "禮先蒼璧，奠備黝制。", "于萬期年，熙成帝系。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-16", "next": "252-18"}, "p18": {"key": "252-18", "title": "唐德明興聖廟樂章：迎俎", "author": "李紓", "canonical": "李紓", "lines": ["盛牲實俎，涓選休成。", "鼎煁陽燧，玉盥陰精。", "有飶嘉豆，既和大羹。", "侑以清樂，細<a class=\"ent ent-nation\" href=\"../entities/nation_%E9%BD%90%E4%BA%BA.html\">齊人</a>情。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-17", "next": "252-19"}, "p19": {"key": "252-19", "title": "唐德明興聖廟樂章：德明酌獻", "author": "李紓", "canonical": "李紓", "lines": ["清廟弈弈，和樂雍雍。", "器尊犧象，禮屬宗公。", "白水方[祼]，黃流在中。", "謨明之德，萬古清風。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "252-18", "next": "252-20"}, "p20": {"key": "252-20", "title": "唐德明興聖廟樂章：興聖酌獻", "author": "李紓", "canonical": "李紓", "lines": ["閟宮靜謐，合樂周張。", "泰尊始獻，百末重觴。", "震澹存誠，庶幾迪嘗。", "遙源之祚，天漢靈長。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-19", "next": "252-21"}, "p21": {"key": "252-21", "title": "唐德明興聖廟樂章：亞獻終獻", "author": "李紓", "canonical": "李紓", "lines": ["惟清惟肅，靡聞靡見。", "舉備九成，俯終三獻。", "慶彰曼壽，胙撤嘉薦。", "瘞玉埋牲，禮神斯遍。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-20", "next": "252-22"}, "p22": {"key": "252-22", "title": "唐德明興聖廟樂章：送神", "author": "李紓", "canonical": "李紓", "lines": ["元精回復，靈貺繁滋。", "風灑蘭路，雲搖桂旗。", "高丘緬邈，涼部逶遲。", "瞻望靡及，纏綿永思。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-21", "next": "252-23"}, "p23": {"key": "252-23", "title": "讓皇帝廟樂章：迎神", "author": "李紓", "canonical": "李紓", "lines": ["皇矣天宗，德先<a class=\"ent ent-person\" href=\"../entities/person_%E7%8E%8B%E5%AD%A3.html\">王季</a>。", "因心則友，克讓以位。", "爰命有司，式尊前志。", "神其降靈，昭饗祀事。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-22", "next": "252-24"}, "p24": {"key": "252-24", "title": "讓皇帝廟樂章：奠幣", "author": "李紓", "canonical": "李紓", "lines": ["惟帝時若，去而上仙。", "祀用商武，樂備宮懸。", "白璧加薦，玄纁告虔。", "子孫拜後，承茲吉蠲。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-23", "next": "252-25"}, "p25": {"key": "252-25", "title": "讓皇帝廟樂章：迎俎", "author": "李紓", "canonical": "李紓", "lines": ["祀盛體薦，禮協粢盛。", "方周假廟，用魯純牲。", "捧撤祗敬，擊拊和鳴。", "受厘歸胙，既戒而平。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-24", "next": "252-26"}, "p26": {"key": "252-26", "title": "讓皇帝廟樂章：酌獻", "author": "李紓", "canonical": "李紓", "lines": ["八音具舉，三壽既盥。", "潔茲宗彝，瑟彼圭瓚。", "蘭肴重錯，椒醑飄散。", "降祚維城，永為藩翰。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-25", "next": "252-27"}, "p27": {"key": "252-27", "title": "讓皇帝廟樂章：亞獻終獻", "author": "李紓", "canonical": "李紓", "lines": ["秩禮有序，和音既同。", "九儀不忒，三揖將終。", "孝感藩後，相維辟公。", "四時之典，永永無窮。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-26", "next": "252-28"}, "p28": {"key": "252-28", "title": "讓皇帝廟樂章：送神", "author": "李紓", "canonical": "李紓", "lines": ["奠獻已事，昏昕載分。", "風搖雨散，靈衛絪縕。", "龍駕帝服，已騰五雲。", "泮宮複閟，寂寞無聞。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-27", "next": "252-29"}, "p29": {"key": "252-29", "title": "釋奠武成王樂章：迎神", "author": "于邵", "canonical": "于邵", "lines": ["卜畋不從，兆發非熊。", "乃傾荒政，爰佐一戎。", "盛烈載垂，命祀維崇。", "日練上戊，宿嚴閟宮。", "迎奏嘉至，感而遂通。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "252-28", "next": "252-30"}, "p30": {"key": "252-30", "title": "釋奠武成王樂章：奠幣登歌", "author": "于邵", "canonical": "于邵", "lines": ["管磬升，壇薌集。", "上公進，嘉幣執。", "信以通，僾如及。", "恢帝功，錫後邑。", "四維張，百度立。", "綿億載，邈難挹。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-29", "next": "252-31"}, "p31": {"key": "252-31", "title": "釋奠武成王樂章：迎俎酌獻", "author": "于邵", "canonical": "于邵", "lines": ["五齊絜，九牢碩。", "梡橛循，罍斝滌。", "進具物，揚鴻績。", "和奏發，高靈寂。", "虔告終，繁祉錫。", "昭秩祀，永無易。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-30", "next": "252-32"}, "p32": {"key": "252-32", "title": "釋奠武成王樂章：亞獻終獻", "author": "于邵", "canonical": "于邵", "lines": ["貳觴以獻，三變其終。", "顧此非馨，尚達斯衷。", "茅縮可致，神歆載融。", "始神翊周，拯溺除凶。", "時維降祐，永絕興戎。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "252-31", "next": "252-33"}, "p33": {"key": "252-33", "title": "釋奠武成王樂章：送神", "author": "于邵", "canonical": "于邵", "lines": ["明祀方終，備樂斯闋。", "黝纁就瘞，豆籩告撤。", "肸蚃尚餘，光<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E4%BA%91.html\">景雲</a>滅。", "返歸虛極，神心則悅。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "252-32", "next": null}}}