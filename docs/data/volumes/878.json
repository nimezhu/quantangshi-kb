{"vol_name": "卷八百七十八", "poems": {"p01": {"key": "878-01", "title": "牛口謠", "author": "不詳", "canonical": "不詳", "lines": ["豆入牛口，勢不得久。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "878-02"}, "p02": {"key": "878-02", "title": "高昌童謠", "author": "不詳", "canonical": "不詳", "lines": ["高昌兵馬如霜雪，漢家兵馬如日月。", "日月照霜雪。", "回首自消滅。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-01", "next": "878-03"}, "p03": {"key": "878-03", "title": "咸亨後謠", "author": "不詳", "canonical": "不詳", "lines": ["莫浪語，阿婆嗔，三叔聞時笑殺人。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-02", "next": "878-04"}, "p04": {"key": "878-04", "title": "調露初京城民謠", "author": "不詳", "canonical": "不詳", "lines": ["側堂堂，撓堂堂。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-03", "next": "878-05"}, "p05": {"key": "878-05", "title": "嵩嶽童謠", "author": "不詳", "canonical": "不詳", "lines": ["嵩山凡幾層，不畏登不得，只畏不得登。", "三度徵兵馬，傍道打騰騰。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-04", "next": "878-06"}, "p06": {"key": "878-06", "title": "李敬玄謠", "author": "不詳", "canonical": "不詳", "lines": ["洮河李阿婆，鄯州王伯母。", "見賊不敢鬥，總由曹新婦。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-05", "next": "878-07"}, "p07": {"key": "878-07", "title": "永淳中童謠", "author": "不詳", "canonical": "不詳", "lines": ["新禾不入箱，新麥不入場。", "迨及八九月，狗吠空垣牆。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-06", "next": "878-08"}, "p08": {"key": "878-08", "title": "楊柳謠", "author": "不詳", "canonical": "不詳", "lines": ["楊柳楊柳漫頭駝。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-07", "next": "878-09"}, "p09": {"key": "878-09", "title": "裴炎謠", "author": "不詳", "canonical": "不詳", "lines": ["一片火，兩片火，緋衣小兒當殿坐。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-08", "next": "878-10"}, "p10": {"key": "878-10", "title": "武后長壽元年民間謠", "author": "不詳", "canonical": "不詳", "lines": ["補闕連車載，拾遺平鬥量。", "欔槌侍御史，碗脫侍中郎。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-09", "next": "878-11"}, "p11": {"key": "878-11", "title": "續謠", "author": "不詳", "canonical": "不詳", "lines": ["評事不讀律，博士不尋章。", "糊心宣撫使，眯目聖神皇。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-10", "next": "878-12"}, "p12": {"key": "878-12", "title": "天樞謠", "author": "不詳", "canonical": "不詳", "lines": ["一條麻索挽，天樞絕去也。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-11", "next": "878-13"}, "p13": {"key": "878-13", "title": "武后時謠", "author": "不詳", "canonical": "不詳", "lines": ["張公吃酒李公醉。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-12", "next": "878-14"}, "p14": {"key": "878-14", "title": "武后時童謠", "author": "不詳", "canonical": "不詳", "lines": ["紅綠複裙長，千里萬里猶香。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-13", "next": "878-15"}, "p15": {"key": "878-15", "title": "神龍後烏鵲窠謠", "author": "不詳", "canonical": "不詳", "lines": ["山南烏鵲窠，山北金駱駝。", "鐮柯不鑿孔，斧子不施柯。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-14", "next": "878-16"}, "p16": {"key": "878-16", "title": "吏部謠", "author": "不詳", "canonical": "不詳", "lines": ["岑愔獠子後，崔湜令公孫。", "三人相比校，莫賀咄骨渾。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-15", "next": "878-17"}, "p17": {"key": "878-17", "title": "黃犢子謠", "author": "不詳", "canonical": "不詳", "lines": ["黃<span class=\"lacuna\" title=\"底本阙字\">□</span>犢子挽紖斷，兩腳蹋地鞋𪎱斷。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-16", "next": "878-18"}, "p18": {"key": "878-18", "title": "安樂寺童謠", "author": "不詳", "canonical": "不詳", "lines": ["可憐安樂寺，了了樹頭懸。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-17", "next": "878-19"}, "p19": {"key": "878-19", "title": "鯉魚兒謠", "author": "不詳", "canonical": "不詳", "lines": ["可憐聖善寺，身著綠毛衣。", "牽來河裏飲，蹋殺鯉魚兒。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-18", "next": "878-20"}, "p20": {"key": "878-20", "title": "羊頭山謠", "author": "不詳", "canonical": "不詳", "lines": ["羊頭山北作朝堂。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-19", "next": "878-21"}, "p21": {"key": "878-21", "title": "金橋童謠", "author": "不詳", "canonical": "不詳", "lines": ["聖人執節度金橋。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-20", "next": "878-22"}, "p22": {"key": "878-22", "title": "天寶中京兆謠", "author": "不詳", "canonical": "不詳", "lines": ["欲得米麥賤，無過追李峴。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-21", "next": "878-23"}, "p23": {"key": "878-23", "title": "天寶初語", "author": "不詳", "canonical": "不詳", "lines": ["義髻拋河裏，黃裙逐水流。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-22", "next": "878-24"}, "p24": {"key": "878-24", "title": "楊氏謠", "author": "不詳", "canonical": "不詳", "lines": ["男不封侯女作妃，君看女卻是門楣。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-23", "next": "878-25"}, "p25": {"key": "878-25", "title": "神雞童謠", "author": "不詳", "canonical": "不詳", "lines": ["生兒不用識文字，鬬雞走馬勝讀書。", "賈家小兒年十三，富貴榮華代不如。", "能令金距期勝負，白羅繡衫隨軟輿。", "父死<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>千里外，差夫治道輓喪車。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "878-24", "next": "878-26"}, "p26": {"key": "878-26", "title": "燕燕謠", "author": "不詳", "canonical": "不詳", "lines": ["燕燕，飛上天。", "天上女兒鋪白氈，氈上有千錢。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-25", "next": "878-27"}, "p27": {"key": "878-27", "title": "幽州謠", "author": "不詳", "canonical": "不詳", "lines": ["舊來誇戴竿，今日不堪看。", "但看五月裏，清水河邊見契丹。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-26", "next": "878-28"}, "p28": {"key": "878-28", "title": "兩京童謠", "author": "不詳", "canonical": "不詳", "lines": ["不怕上蘭單，惟愁答辨難。", "無錢求案典，生死任都官。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-27", "next": "878-29"}, "p29": {"key": "878-29", "title": "兩頭朱童謠", "author": "不詳", "canonical": "不詳", "lines": ["一隻箸，兩頭朱，五六月化為膽。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-28", "next": "878-30"}, "p30": {"key": "878-30", "title": "打麥謠", "author": "不詳", "canonical": "不詳", "lines": ["打麥，麥打。", "三三三，舞了也。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-29", "next": "878-31"}, "p31": {"key": "878-31", "title": "張權輿作裴度偽謠", "author": "不詳", "canonical": "不詳", "lines": ["非衣小兒坦其腹，天上有口被驅逐。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-30", "next": "878-32"}, "p32": {"key": "878-32", "title": "馬僕射謠", "author": "不詳", "canonical": "不詳", "lines": ["齋鐘動也，和尚不上堂。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-31", "next": "878-33"}, "p33": {"key": "878-33", "title": "咸通七年童謠", "author": "不詳", "canonical": "不詳", "lines": ["草青青，被嚴霜。", "鵲始巢，複看顛狂。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-32", "next": "878-34"}, "p34": {"key": "878-34", "title": "咸通十四年成都謠", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-time\" href=\"../entities/time_%E5%92%B8%E9%80%9A.html\">咸通</a>癸巳，出無所之。", "蛇去馬來，道路稍開。", "頭無片瓦，地有殘灰。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-33", "next": "878-35"}, "p35": {"key": "878-35", "title": "幹符六年童謠", "author": "不詳", "canonical": "不詳", "lines": ["八月無霜塞草青，將軍騎馬出空城。", "漢家天子西巡狩，猶向<a class=\"ent ent-place\" href=\"../entities/place_%E6%B1%9F%E4%B8%9C.html\">江東</a>更索兵。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-34", "next": "878-36"}, "p36": {"key": "878-36", "title": "僖宗時童謠", "author": "不詳", "canonical": "不詳", "lines": ["金色蝦蟆爭努眼，翻卻曹州天下反。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-35", "next": "878-37"}, "p37": {"key": "878-37", "title": "黃巢軍中謠", "author": "不詳", "canonical": "不詳", "lines": ["逢儒則肉師必覆。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-36", "next": "878-38"}, "p38": {"key": "878-38", "title": "中和初童謠", "author": "不詳", "canonical": "不詳", "lines": ["黃巢走，<a class=\"ent ent-place\" href=\"../entities/place_%E6%B3%B0%E5%B1%B1.html\">泰山</a>東，死在翁家翁。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-37", "next": "878-39"}, "p39": {"key": "878-39", "title": "山陰老人偽謠", "author": "不詳", "canonical": "不詳", "lines": ["欲識聖人姓，千里草青青。", "欲識聖人名，日從日上生。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-38", "next": "878-40"}, "p40": {"key": "878-40", "title": "胡楚賓謠", "author": "不詳", "canonical": "不詳", "lines": ["胡楚賓，李翰林。", "詞同三峽水，字值雙南金。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-39", "next": "878-41"}, "p41": {"key": "878-41", "title": "後唐軍士謠", "author": "不詳", "canonical": "不詳", "lines": ["除去菩薩，扶立生鐵。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-40", "next": "878-42"}, "p42": {"key": "878-42", "title": "周顯德中齊州謠", "author": "不詳", "canonical": "不詳", "lines": ["蹋陽春人間二月雨和塵陽春蹋盡西風起腸斷人間白髮人。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "878-41", "next": "878-43"}, "p43": {"key": "878-43", "title": "天佑中江南童謠", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%9C%E6%B5%B7.html\">東海</a>鯉魚飛上天。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-42", "next": "878-44"}, "p44": {"key": "878-44", "title": "真人謠", "author": "不詳", "canonical": "不詳", "lines": ["有一真人在冀川，開口持弓向外邊。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-43", "next": "878-45"}, "p45": {"key": "878-45", "title": "李後主童謠", "author": "不詳", "canonical": "不詳", "lines": ["索得娘來忘卻家，後園桃李不生花。", "豬兒狗兒都死盡，養得貓兒患赤瘕。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-44", "next": "878-46"}, "p46": {"key": "878-46", "title": "秦人竹□謠", "author": "不詳", "canonical": "不詳", "lines": ["<span class=\"lacuna\" title=\"底本阙字\">□</span>々引黑牛，天差不自由。", "但看戊寅歲，揚在蜀江頭。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-45", "next": "878-47"}, "p47": {"key": "878-47", "title": "蜀人謠", "author": "不詳", "canonical": "不詳", "lines": ["黑牛無系絆，棕繩一時斷。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-46", "next": "878-48"}, "p48": {"key": "878-48", "title": "秦城芭蕉謠", "author": "不詳", "canonical": "不詳", "lines": ["花開來裏，花謝也裏。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-47", "next": "878-49"}, "p49": {"key": "878-49", "title": "蜀童謠", "author": "不詳", "canonical": "不詳", "lines": ["我有一帖藥，其名曰阿魏，賣與十八子。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-48", "next": "878-50"}, "p50": {"key": "878-50", "title": "蜀中掃地和尚", "author": "不詳", "canonical": "不詳", "lines": ["水行仙，怕秦川。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-49", "next": "878-51"}, "p51": {"key": "878-51", "title": "福州謠", "author": "不詳", "canonical": "不詳", "lines": ["騎馬來，騎馬去。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-50", "next": "878-52"}, "p52": {"key": "878-52", "title": "閩人謠", "author": "不詳", "canonical": "不詳", "lines": ["風吹楊菜鼓山下，不得錢郎戈不罷。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-51", "next": "878-53"}, "p53": {"key": "878-53", "title": "廣州童謠", "author": "不詳", "canonical": "不詳", "lines": ["羊頭二四，白天雨至。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-52", "next": "878-54"}, "p54": {"key": "878-54", "title": "桂管童謠", "author": "不詳", "canonical": "不詳", "lines": ["大蟲來。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-53", "next": "878-55"}, "p55": {"key": "878-55", "title": "湖南童謠", "author": "不詳", "canonical": "不詳", "lines": ["湖南城郭好長街，竟栽柳樹不栽槐。", "百姓奔竄無一事，只是椎芒織草鞋。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "878-54", "next": "878-56"}, "p56": {"key": "878-56", "title": "長沙童謠", "author": "不詳", "canonical": "不詳", "lines": ["鞭打馬，馬急走。", "三羊五馬，馬子離羣，羊子無舍。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "878-55", "next": "878-57"}, "p57": {"key": "878-57", "title": "湘中童謠", "author": "不詳", "canonical": "不詳", "lines": ["馬去不用鞭，咬牙過今年。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "878-56", "next": "878-58"}, "p58": {"key": "878-58", "title": "長沙童謠", "author": "不詳", "canonical": "不詳", "lines": ["鞭打馬，馬急走。", "三羊五馬，馬子離羣，羊子無舍。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "878-57", "next": "878-59"}, "p59": {"key": "878-59", "title": "丹陽語", "author": "不詳", "canonical": "不詳", "lines": ["待錢來，待錢來。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-58", "next": "878-60"}, "p60": {"key": "878-60", "title": "遼述律後謠", "author": "不詳", "canonical": "不詳", "lines": ["青牛嫗，曾避路。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "878-59", "next": null}}}