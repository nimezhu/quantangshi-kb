{"vol_name": "卷八百七十七", "poems": {"p01": {"key": "877-01", "title": "中宗引諺", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-time\" href=\"../entities/time_%E5%86%AC%E8%87%B3.html\">冬至</a>長於歲。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "877-02"}, "p02": {"key": "877-02", "title": "賈言忠引諺", "author": "不詳", "canonical": "不詳", "lines": ["軍無媒，中道回。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-01", "next": "877-03"}, "p03": {"key": "877-03", "title": "李績引諺別張文瓘", "author": "不詳", "canonical": "不詳", "lines": ["千里相送，終於一別。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-02", "next": "877-04"}, "p04": {"key": "877-04", "title": "路勵行引諺", "author": "不詳", "canonical": "不詳", "lines": ["一人在朝，百人緩帶。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-03", "next": "877-05"}, "p05": {"key": "877-05", "title": "郝南容引諺", "author": "不詳", "canonical": "不詳", "lines": ["三公後，出死狗。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-04", "next": "877-06"}, "p06": {"key": "877-06", "title": "員莊諺", "author": "不詳", "canonical": "不詳", "lines": ["上有天堂，下有員莊。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-05", "next": "877-07"}, "p07": {"key": "877-07", "title": "婁師德引諺", "author": "不詳", "canonical": "不詳", "lines": ["卒客無卒主人。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-06", "next": "877-08"}, "p08": {"key": "877-08", "title": "台中諺", "author": "不詳", "canonical": "不詳", "lines": ["免巡未推，只得自知。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-07", "next": "877-09"}, "p09": {"key": "877-09", "title": "宋守敬引諺", "author": "不詳", "canonical": "不詳", "lines": ["雙陸無休勢。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-08", "next": "877-10"}, "p10": {"key": "877-10", "title": "雒穀諺", "author": "不詳", "canonical": "不詳", "lines": ["謥洞入黃泉。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-09", "next": "877-11"}, "p11": {"key": "877-11", "title": "三門諺", "author": "不詳", "canonical": "不詳", "lines": ["古無門匠墓。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-10", "next": "877-12"}, "p12": {"key": "877-12", "title": "張果引諺", "author": "不詳", "canonical": "不詳", "lines": ["娶婦得公主，平地生公府。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-11", "next": "877-13"}, "p13": {"key": "877-13", "title": "哥舒翰引諺", "author": "不詳", "canonical": "不詳", "lines": ["狐向窟嗥不祥。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-12", "next": "877-14"}, "p14": {"key": "877-14", "title": "代宗引諺", "author": "不詳", "canonical": "不詳", "lines": ["不癡不聾，不作阿家阿翁。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-13", "next": "877-15"}, "p15": {"key": "877-15", "title": "鬼門關諺", "author": "不詳", "canonical": "不詳", "lines": ["鬼門關，十人去，九不還。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-14", "next": "877-16"}, "p16": {"key": "877-16", "title": "河北諺", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E5%B1%B1%E4%B8%9C.html\">山東</a>一條葛，無事莫撩撥。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-15", "next": "877-17"}, "p17": {"key": "877-17", "title": "李振引諺", "author": "不詳", "canonical": "不詳", "lines": ["百歲奴事三歲主。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-16", "next": "877-18"}, "p18": {"key": "877-18", "title": "王彥章引諺", "author": "不詳", "canonical": "不詳", "lines": ["人死留名，豹死留皮。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-17", "next": "877-19"}, "p19": {"key": "877-19", "title": "《孫光憲北夢瑣言》引諺", "author": "不詳", "canonical": "不詳", "lines": ["小舅小叔，相追相逐。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-18", "next": "877-20"}, "p20": {"key": "877-20", "title": "諺", "author": "不詳", "canonical": "不詳", "lines": ["棗子塞鼻孔，懸棲閣卻種。", "蟬鳴蛁蟟喚，黍種糕糜斷。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "877-19", "next": "877-21"}, "p21": {"key": "877-21", "title": "寧茵事諺", "author": "不詳", "canonical": "不詳", "lines": ["鵓鳩樹上鳴，意在麻子地。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-20", "next": "877-22"}, "p22": {"key": "877-22", "title": "鸕鷀諺", "author": "不詳", "canonical": "不詳", "lines": ["鸕鷀不打腳下塘。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-21", "next": "877-23"}, "p23": {"key": "877-23", "title": "鹽鐵諺", "author": "不詳", "canonical": "不詳", "lines": ["揚一益二。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-22", "next": "877-24"}, "p24": {"key": "877-24", "title": "馮翊諺", "author": "不詳", "canonical": "不詳", "lines": ["苦泉羊，洛水漿。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-23", "next": "877-25"}, "p25": {"key": "877-25", "title": "丹徒諺", "author": "不詳", "canonical": "不詳", "lines": ["生東吳，死丹徒。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-24", "next": "877-26"}, "p26": {"key": "877-26", "title": "湖州裏諺", "author": "不詳", "canonical": "不詳", "lines": ["放爾生，放爾命，放爾湖州做百姓。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-25", "next": "877-27"}, "p27": {"key": "877-27", "title": "益陽諺", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E6%B2%99.html\">長沙</a>益陽，一時相<span class=\"lacuna\" title=\"底本阙字\">□</span>。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-26", "next": "877-28"}, "p28": {"key": "877-28", "title": "昭潭諺", "author": "不詳", "canonical": "不詳", "lines": ["昭潭無底橘州浮。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-27", "next": "877-29"}, "p29": {"key": "877-29", "title": "江右四郡諺", "author": "不詳", "canonical": "不詳", "lines": ["筠袁贛吉，腦後插筆。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-28", "next": "877-30"}, "p30": {"key": "877-30", "title": "徐聞諺", "author": "不詳", "canonical": "不詳", "lines": ["欲拔貧，詣徐聞。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-29", "next": "877-31"}, "p31": {"key": "877-31", "title": "隴西諺", "author": "不詳", "canonical": "不詳", "lines": ["郎驅女驅，十馬九駒。", "安陽大角，十牛九犢。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-30", "next": "877-32"}, "p32": {"key": "877-32", "title": "荊棺峽諺", "author": "不詳", "canonical": "不詳", "lines": ["九子不葬父，一女打荊棺。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "877-31", "next": "877-33"}, "p33": {"key": "877-33", "title": "南中諺", "author": "不詳", "canonical": "不詳", "lines": ["秋收稻，夏收頭。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-32", "next": "877-34"}, "p34": {"key": "877-34", "title": "事狐神諺", "author": "不詳", "canonical": "不詳", "lines": ["無狐魅，不成村。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-33", "next": "877-35"}, "p35": {"key": "877-35", "title": "李哲家怪引諺", "author": "不詳", "canonical": "不詳", "lines": ["一雞死，一雞鳴。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-34", "next": "877-36"}, "p36": {"key": "877-36", "title": "俗諺", "author": "不詳", "canonical": "不詳", "lines": ["白日無談人，談人則害生。", "昏夜無說鬼，說鬼則怪至。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "877-35", "next": "877-37"}, "p37": {"key": "877-37", "title": "李白名許雲封謎", "author": "不詳", "canonical": "不詳", "lines": ["樹下彼何人，不語真吾好。", "語若及日中，煙霏謝成寶。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "877-36", "next": "877-38"}, "p38": {"key": "877-38", "title": "許氏碑陰謎", "author": "不詳", "canonical": "不詳", "lines": ["談馬礪畢，王田數七。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-37", "next": "877-39"}, "p39": {"key": "877-39", "title": "大明寺壁語", "author": "不詳", "canonical": "不詳", "lines": ["一人堂堂，二曜同光。", "泉深尺一，點去冰傍。", "二人相連，不欠一邊。", "三梁四柱烈火然，除却雙勾兩日全。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "877-38", "next": "877-40"}, "p40": {"key": "877-40", "title": "曹著與客謎", "author": "不詳", "canonical": "不詳", "lines": ["一物坐也坐，臥也坐，行也坐。", "一物坐也臥，立也臥，行也臥，走也臥，臥也臥"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-39", "next": "877-41"}, "p41": {"key": "877-41", "title": "客題青龍寺門", "author": "不詳", "canonical": "不詳", "lines": ["龕龍去<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%9C%E6%B5%B7.html\">東海</a>，時日隱西斜。", "敬文今不在，碎石入<a class=\"ent ent-place\" href=\"../entities/place_%E6%B5%81%E6%B2%99.html\">流沙</a>。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "877-40", "next": "877-42"}, "p42": {"key": "877-42", "title": "陶穀題南唐官舍壁", "author": "不詳", "canonical": "不詳", "lines": ["西川狗，百姓眼。", "馬包兒，禦廚飯。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-41", "next": "877-43"}, "p43": {"key": "877-43", "title": "謝小娥夢盜姓名", "author": "不詳", "canonical": "不詳", "lines": ["車中猴，門東草。", "禾中走，一日夫。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "877-42", "next": null}}}