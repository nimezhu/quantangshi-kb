{"vol_name": "卷六百四十七", "poems": {"p01": {"key": "647-01", "title": "草檄答南蠻有詠", "author": "胡曾", "canonical": "胡曾", "lines": ["辭天出塞陣雲空，霧捲霞開萬里通。", "親受虎符安宇宙，誓將龍劍定英雄。", "殘霜敢冒高懸日，秋葉爭禁大段風。", "爲報南蠻須屏跡，不同蜀將武侯功。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": null, "next": "647-02"}, "p02": {"key": "647-02", "title": "寒食都門作", "author": "胡曾", "canonical": "胡曾", "lines": ["二年<a class=\"ent ent-time\" href=\"../entities/time_%E5%AF%92%E9%A3%9F.html\">寒食</a>住京華，寓目春風萬萬家。", "金絡馬銜原上草，玉顏人折路傍花。", "軒車競出紅塵合，冠蓋爭回白日斜。", "誰念都門兩行淚，故園寥落在<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E6%B2%99.html\">長沙</a>。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-01", "next": "647-03"}, "p03": {"key": "647-03", "title": "薄命妾", "author": "胡曾", "canonical": "胡曾", "lines": ["阿嬌初失漢皇恩，舊賜羅衣亦罷薰。", "倚枕夜悲金屋雨，卷簾朝泣玉樓雲。", "宮前葉落鴛鴦瓦，架上塵生翡翠裙。", "龍騎不巡時漸久，長門空掩綠苔紋。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-02", "next": "647-04"}, "p04": {"key": "647-04", "title": "獨不見", "author": "胡曾", "canonical": "胡曾", "lines": ["玉關一自有氛埃，年少從軍竟未回。", "門外塵凝張樂榭，水邊香滅按歌臺。", "窗殘夜月人何處，簾卷春風燕復來。", "萬里寂寥音信絕，寸心爭忍不成灰。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-03", "next": "647-05"}, "p05": {"key": "647-05", "title": "交河塞下曲", "author": "胡曾", "canonical": "胡曾", "lines": ["交河冰薄日遲遲，漢將思家感別離。", "<a class=\"ent ent-place\" href=\"../entities/place_%E5%A1%9E%E5%8C%97.html\">塞北</a>草生蘇武泣，<a class=\"ent ent-place\" href=\"../entities/place_%E9%99%87%E8%A5%BF.html\">隴西</a>雲起李陵悲。", "曉侵雉堞烏先覺，春入關山雁獨知。", "何處疲兵心最苦，夕陽樓上笛聲時。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-04", "next": "647-06"}, "p06": {"key": "647-06", "title": "車遙遙", "author": "胡曾", "canonical": "胡曾", "lines": ["自從車馬出門朝，便入空房守寂寥。", "玉枕夜殘魚信絕，金鈿秋盡雁書遙。", "臉邊楚雨臨風落，頭上春雲向日銷。", "芳草又衰還不至，碧天霜冷轉無憀。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-05", "next": "647-07"}, "p07": {"key": "647-07", "title": "早發潛水驛謁郎中員外", "author": "胡曾", "canonical": "胡曾", "lines": ["半床秋月一聲雞，萬里行人費馬蹄。", "青野霧銷凝晉洞，碧山煙散避秦溪。", "樓臺稍辨烏城外，更漏微聞鶴柱西。", "已是大仙憐後進，不應來向武陵迷。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-06", "next": "647-08"}, "p08": {"key": "647-08", "title": "贈漁者", "author": "胡曾", "canonical": "胡曾", "lines": ["不媿人間萬戶侯，子孫相繼老扁舟。", "往來<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%8D%97%E8%B6%8A.html\">南越</a>諳鮫室，生長東吳識蜃樓。", "自爲釣竿能遣悶，不因萱草解銷憂。", "羨君獨得逃名趣，身外無機任白頭。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-07", "next": "647-09"}, "p09": {"key": "647-09", "title": "自嶺下泛鷁到清遠峽作", "author": "胡曾", "canonical": "胡曾", "lines": ["乘船浮鷁下韶水，絕境方知在<a class=\"ent ent-place\" href=\"../entities/place_%E5%B2%AD%E5%8D%97.html\">嶺南</a>。", "薜荔雨餘山自黛，蒹葭煙盡島如藍。", "旦遊蕭帝新松寺，夜宿嫦娥桂影潭。", "不爲篋中書未獻，便來茲地結茅庵。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-08", "next": "647-10"}, "p10": {"key": "647-10", "title": "題周瑜將軍廟", "author": "胡曾", "canonical": "胡曾", "lines": ["共說生前國步難，山川龍戰血漫漫。", "交鋒魏帝旌旂退，委任君王社稷安。", "庭際雨餘春草長，廟前風起晚光殘。", "功勳碑碣今何在，不得當時一字看。"], "form": "七律", "t300": null, "src": "poet.tang", "prev": "647-09", "next": "647-11"}, "p11": {"key": "647-11", "title": "詠史詩：烏江", "author": "胡曾", "canonical": "胡曾", "lines": ["爭帝圖王勢已傾，八千兵散楚歌聲。", "烏江不是無船渡，恥向東吳再起兵。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-10", "next": "647-12"}, "p12": {"key": "647-12", "title": "詠史詩：章華台", "author": "胡曾", "canonical": "胡曾", "lines": ["茫茫衰草沒章華，因笑<a class=\"ent ent-person\" href=\"../entities/person_%E7%81%B5%E7%8E%8B.html\">靈王</a>昔好奢。", "台土未幹簫管絕，可憐身死野人家。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-11", "next": "647-13"}, "p13": {"key": "647-13", "title": "詠史詩：細腰宮", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E6%A5%9A%E7%8E%8B.html\">楚王</a>辛苦戰無功，國破城荒霸業空。", "唯有青春花上露，至今猶泣細腰宮。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-12", "next": "647-14"}, "p14": {"key": "647-14", "title": "詠史詩：沙苑", "author": "胡曾", "canonical": "胡曾", "lines": ["馮翊南邊宿霧開，行人一步一裴回。", "誰知此地凋殘柳，儘是高歡敗後栽。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-13", "next": "647-15"}, "p15": {"key": "647-15", "title": "詠史詩：石城", "author": "胡曾", "canonical": "胡曾", "lines": ["古郢雲開白雪樓，漢江還繞石城流。", "何人知道寥天月，曾向朱門送莫愁。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-14", "next": "647-16"}, "p16": {"key": "647-16", "title": "詠史詩：荊山", "author": "胡曾", "canonical": "胡曾", "lines": ["抱玉岩前桂葉稠，碧溪寒水至今流。", "空山落日猿聲叫，疑是荊人哭未休。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-15", "next": "647-17"}, "p17": {"key": "647-17", "title": "詠史詩：陽臺", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E6%A5%9A%E5%9B%BD.html\">楚國</a>城池颯已空，陽臺雲雨過無蹤。", "何人更有<a class=\"ent ent-person\" href=\"../entities/person_%E8%A5%84%E7%8E%8B.html\">襄王</a>夢，寂寂巫山十二重。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-16", "next": "647-18"}, "p18": {"key": "647-18", "title": "詠史詩：居延", "author": "胡曾", "canonical": "胡曾", "lines": ["漠漠平沙際碧天，問人雲此是<a class=\"ent ent-place\" href=\"../entities/place_%E5%B1%85%E5%BB%B6.html\">居延</a>。", "停驂一顧猶魂斷，蘇武爭禁十九年。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-17", "next": "647-19"}, "p19": {"key": "647-19", "title": "詠史詩：沛宮", "author": "胡曾", "canonical": "胡曾", "lines": ["漢高辛苦事干戈，帝業興隆俊傑多。", "猶恨四方無壯士，還鄉悲唱大風歌。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-18", "next": "647-20"}, "p20": {"key": "647-20", "title": "詠史詩：金谷園", "author": "胡曾", "canonical": "胡曾", "lines": ["一自佳人墜玉樓，繁華東逐洛河流。", "唯餘金穀園中樹，殘日蟬聲送客愁。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-19", "next": "647-21"}, "p21": {"key": "647-21", "title": "詠史詩：湘川", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E8%99%9E%E8%88%9C.html\">虞舜</a>南捐萬乘君，靈妃揮涕竹成紋。", "不知精魄遊何處，落日<a class=\"ent ent-place\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>空白雲。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-20", "next": "647-22"}, "p22": {"key": "647-22", "title": "詠史詩：夷門", "author": "胡曾", "canonical": "胡曾", "lines": ["六龍冉冉驟朝昏，魏國賢才杳不存。", "唯有侯嬴在時月，夜來空自照夷門。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-21", "next": "647-23"}, "p23": {"key": "647-23", "title": "詠史詩：黃金台", "author": "胡曾", "canonical": "胡曾", "lines": ["北乘羸馬到燕然，此地何人複禮賢。", "若問<a class=\"ent ent-person\" href=\"../entities/person_%E6%98%AD%E7%8E%8B.html\">昭王</a>無處所，黃金臺上草連天。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-22", "next": "647-24"}, "p24": {"key": "647-24", "title": "詠史詩：夷陵", "author": "胡曾", "canonical": "胡曾", "lines": ["夷陵城闕倚朝雲，戰敗秦師縱火焚。", "何事三千珠履客，不能西禦武安君。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-23", "next": "647-25"}, "p25": {"key": "647-25", "title": "詠史詩：漢江", "author": "胡曾", "canonical": "胡曾", "lines": ["漢江一帶碧流長，兩岸春風起綠楊。", "借問膠船何處沒，欲停蘭棹祀<a class=\"ent ent-person\" href=\"../entities/person_%E6%98%AD%E7%8E%8B.html\">昭王</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-24", "next": "647-26"}, "p26": {"key": "647-26", "title": "詠史詩：蒼梧", "author": "胡曾", "canonical": "胡曾", "lines": ["有虞龍駕不西還，空委簫韶洞壑間。", "無計得知陵寢處，愁雲長滿九疑山。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-25", "next": "647-27"}, "p27": {"key": "647-27", "title": "詠史詩：陳宮", "author": "胡曾", "canonical": "胡曾", "lines": ["陳國機權未可涯，如何後主恣嬌奢。", "不知即入宮中井，猶自聽吹玉樹花。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-26", "next": "647-28"}, "p28": {"key": "647-28", "title": "詠史詩：南陽", "author": "胡曾", "canonical": "胡曾", "lines": ["世亂英雄百戰餘，孔明方此樂耕鋤。", "蜀王不自垂三顧，爭得先生出舊廬。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-27", "next": "647-29"}, "p29": {"key": "647-29", "title": "詠史詩：即墨", "author": "胡曾", "canonical": "胡曾", "lines": ["即墨門開縱火牛，燕師營裏血波流。", "固存不得<a class=\"ent ent-person\" href=\"../entities/person_%E7%94%B0%E5%8D%95.html\">田單</a>術，齊國尋成一土丘。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-28", "next": "647-30"}, "p30": {"key": "647-30", "title": "詠史詩：渭濱", "author": "胡曾", "canonical": "胡曾", "lines": ["岸草青青渭水流，子牙曾此獨垂釣。", "當時未入非熊兆，幾向斜陽歎白頭。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-29", "next": "647-31"}, "p31": {"key": "647-31", "title": "詠史詩：五湖", "author": "胡曾", "canonical": "胡曾", "lines": ["東上高山望<a class=\"ent ent-place\" href=\"../entities/place_%E4%BA%94%E6%B9%96.html\">五湖</a>，雪濤煙浪起天隅。", "不知<a class=\"ent ent-person\" href=\"../entities/person_%E8%8C%83%E8%A0%A1.html\">範蠡</a>乘舟後，更有功臣繼踵無。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-30", "next": "647-32"}, "p32": {"key": "647-32", "title": "詠史詩：易水", "author": "胡曾", "canonical": "胡曾", "lines": ["一旦秦皇馬角生，燕丹歸北送荊卿。", "行人欲識無窮恨，聽取東流<a class=\"ent ent-place\" href=\"../entities/place_%E6%98%93%E6%B0%B4.html\">易水</a>聲。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-31", "next": "647-33"}, "p33": {"key": "647-33", "title": "詠史詩：長平", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%B9%B3.html\">長平</a>瓦震武安初，趙卒俄成戲鼎魚。", "四十萬人俱下世，元戎何用讀兵書。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-32", "next": "647-34"}, "p34": {"key": "647-34", "title": "詠史詩：西園", "author": "胡曾", "canonical": "胡曾", "lines": ["月滿西園夜未央，金風不動鄴天涼。", "高情公子多秋興，更領詩人入醉鄉。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-33", "next": "647-35"}, "p35": {"key": "647-35", "title": "詠史詩：長沙", "author": "胡曾", "canonical": "胡曾", "lines": ["江上南風起白蘋，<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E6%B2%99.html\">長沙</a>城郭異咸秦。", "故鄉猶自嫌卑濕，何況當時賦鵩人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-34", "next": "647-36"}, "p36": {"key": "647-36", "title": "詠史詩：圯橋", "author": "胡曾", "canonical": "胡曾", "lines": ["廟算<a class=\"ent ent-person\" href=\"../entities/person_%E5%BC%A0%E8%89%AF.html\">張良</a>獨有餘，少年逃難<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%8B%E9%82%B3.html\">下邳</a>初。", "逡巡不進泥中履，爭得先生一卷書。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-35", "next": "647-37"}, "p37": {"key": "647-37", "title": "詠史詩：銅雀台", "author": "胡曾", "canonical": "胡曾", "lines": ["魏武龍輿逐逝波，高臺空按望陵歌。", "遏雲聲絕悲風起，翻向樽前泣翠娥。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-36", "next": "647-38"}, "p38": {"key": "647-38", "title": "詠史詩：東晉", "author": "胡曾", "canonical": "胡曾", "lines": ["石頭城下浪崔嵬，風起聲疑出地雷。", "何事苻堅太相小，欲投鞭策過江來。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-37", "next": "647-39"}, "p39": {"key": "647-39", "title": "詠史詩：吳江", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E5%AD%90%E8%83%A5.html\">子胥</a>今日委東流，吳國明朝亦古丘。", "大笑<a class=\"ent ent-person\" href=\"../entities/person_%E5%A4%AB%E5%B7%AE.html\">夫差</a>諸將相，更無人解守<a class=\"ent ent-place\" href=\"../entities/place_%E8%8B%8F%E5%B7%9E.html\">蘇州</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-38", "next": "647-40"}, "p40": {"key": "647-40", "title": "詠史詩：函谷關", "author": "胡曾", "canonical": "胡曾", "lines": ["寂寂函關鎖未開，田文車馬出秦來。", "朱門不養三千客，誰為雞鳴得放回。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-39", "next": "647-41"}, "p41": {"key": "647-41", "title": "詠史詩：武關", "author": "胡曾", "canonical": "胡曾", "lines": ["戰國相持竟不休，<a class=\"ent ent-place\" href=\"../entities/place_%E6%AD%A6%E5%85%B3.html\">武關</a>才掩<a class=\"ent ent-person\" href=\"../entities/person_%E6%A5%9A%E7%8E%8B.html\">楚王</a>憂。", "出門若取靈均語，豈作<a class=\"ent ent-place\" href=\"../entities/place_%E5%92%B8%E9%98%B3.html\">咸陽</a>一死囚。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-40", "next": "647-42"}, "p42": {"key": "647-42", "title": "詠史詩：垓下", "author": "胡曾", "canonical": "胡曾", "lines": ["拔山力盡霸圖隳，倚劍空歌不逝騅。", "明月滿營天似水，那堪回首別虞姬。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-41", "next": "647-43"}, "p43": {"key": "647-43", "title": "詠史詩：郴縣", "author": "胡曾", "canonical": "胡曾", "lines": ["義帝南遷路入郴，國亡身死亂山深。", "不知埋恨窮泉後，幾度西陵片月沉。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-42", "next": "647-44"}, "p44": {"key": "647-44", "title": "詠史詩：東海", "author": "胡曾", "canonical": "胡曾", "lines": ["東巡玉輦委泉台，徐福樓船尚未回。", "自是祖龍先下世，不關無路到蓬萊。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-43", "next": "647-45"}, "p45": {"key": "647-45", "title": "詠史詩：故宜城", "author": "胡曾", "canonical": "胡曾", "lines": ["武安南伐勒秦兵，疏鑿功將夏禹並。", "誰謂長渠千載後，水流猶入故宜城。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-44", "next": "647-46"}, "p46": {"key": "647-46", "title": "詠史詩：成都", "author": "胡曾", "canonical": "胡曾", "lines": ["杜宇曾為蜀帝王，化禽飛去舊城荒。", "年年來叫桃花月，似向春風訴國亡。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-45", "next": "647-47"}, "p47": {"key": "647-47", "title": "詠史詩：檀溪", "author": "胡曾", "canonical": "胡曾", "lines": ["三月襄陽綠草齊，王孫相引到檀溪。", "的盧何處埋龍骨，流水依前繞大堤。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-46", "next": "647-48"}, "p48": {"key": "647-48", "title": "詠史詩：青塚", "author": "胡曾", "canonical": "胡曾", "lines": ["玉貌元期漢帝招，誰知西嫁怨天驕。", "至今青塚愁雲起，疑是佳人恨未銷。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-47", "next": "647-49"}, "p49": {"key": "647-49", "title": "詠史詩：李陵台", "author": "胡曾", "canonical": "胡曾", "lines": ["北入<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%8D%95%E4%BA%8E.html\">單于</a>萬里疆，五千兵敗滯窮荒。", "英雄不伏<a class=\"ent ent-nation\" href=\"../entities/nation_%E8%9B%AE%E5%A4%B7.html\">蠻夷</a>死，更築高臺望故鄉。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-48", "next": "647-50"}, "p50": {"key": "647-50", "title": "詠史詩：河梁", "author": "胡曾", "canonical": "胡曾", "lines": ["漢家英傑出皇都，攜手河梁話入胡。", "不是子卿全大節，也應低首拜<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%8D%95%E4%BA%8E.html\">單于</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-49", "next": "647-51"}, "p51": {"key": "647-51", "title": "詠史詩：軹道", "author": "胡曾", "canonical": "胡曾", "lines": ["漢祖西來秉白旄，子嬰宗廟委波濤。", "誰憐君有翻身術，解向秦宮殺<a class=\"ent ent-person\" href=\"../entities/person_%E8%B5%B5%E9%AB%98.html\">趙高</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-50", "next": "647-52"}, "p52": {"key": "647-52", "title": "詠史詩：漢宮", "author": "胡曾", "canonical": "胡曾", "lines": ["明妃遠嫁泣西風，玉箸雙垂出漢宮。", "何事將軍封萬戶，卻令紅粉為和戎。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-51", "next": "647-53"}, "p53": {"key": "647-53", "title": "詠史詩：豫讓橋", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E8%B1%AB%E8%AE%A9.html\">豫讓</a>酬恩歲已深，高名不朽到如今。", "年年橋上行人過，誰有當時國士心。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-52", "next": "647-54"}, "p54": {"key": "647-54", "title": "詠史詩：華亭", "author": "胡曾", "canonical": "胡曾", "lines": ["陸機西沒<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9B%E9%98%B3.html\">洛陽</a>城，吳國春風草又青。", "惆悵月中千歲鶴，夜來猶為唳華亭。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-53", "next": "647-55"}, "p55": {"key": "647-55", "title": "詠史詩：東山", "author": "胡曾", "canonical": "胡曾", "lines": ["五馬南浮一化龍，謝安入相此山空。", "不知攜妓重來日，幾樹鶯啼<a class=\"ent ent-place\" href=\"../entities/place_%E8%B0%B7%E5%8F%A3.html\">穀口</a>風。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-54", "next": "647-56"}, "p56": {"key": "647-56", "title": "詠史詩：殺子谷", "author": "胡曾", "canonical": "胡曾", "lines": ["舉國賢良盡淚垂，<a class=\"ent ent-person\" href=\"../entities/person_%E6%89%B6%E8%8B%8F.html\">扶蘇</a>屈死樹邊時。", "至今<a class=\"ent ent-place\" href=\"../entities/place_%E8%B0%B7%E5%8F%A3.html\">穀口</a>泉嗚咽，猶似秦人恨<a class=\"ent ent-person\" href=\"../entities/person_%E6%9D%8E%E6%96%AF.html\">李斯</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-55", "next": "647-57"}, "p57": {"key": "647-57", "title": "詠史詩：馬陵", "author": "胡曾", "canonical": "胡曾", "lines": ["墜葉蕭蕭九月天，驅兵獨過馬陵前。", "路傍古木蟲書處，記得將軍破敵年。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-56", "next": "647-58"}, "p58": {"key": "647-58", "title": "詠史詩：玉門關", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-nation\" href=\"../entities/nation_%E8%A5%BF%E6%88%8E.html\">西戎</a>不敢過天山，定遠功成白馬閑。", "半夜帳中停燭坐，唯思生入<a class=\"ent ent-place\" href=\"../entities/place_%E7%8E%89%E9%97%A8%E5%85%B3.html\">玉門關</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-57", "next": "647-59"}, "p59": {"key": "647-59", "title": "詠史詩：滹沱河", "author": "胡曾", "canonical": "胡曾", "lines": ["光武經營業未興，王郎兵革正憑陵。", "須知後漢功臣力，不及滹沱一片冰。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-58", "next": "647-60"}, "p60": {"key": "647-60", "title": "詠史詩：黃河", "author": "胡曾", "canonical": "胡曾", "lines": ["博望沉埋不復旋，黃河依舊水茫然。", "沿流欲共牛郎語，只得靈槎送上天。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-59", "next": "647-61"}, "p61": {"key": "647-61", "title": "詠史詩：鳳凰台", "author": "胡曾", "canonical": "胡曾", "lines": ["秦娥一別鳳凰台，東入青冥更不回。", "空有玉簫千載後，遺聲時到世間來。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-60", "next": "647-62"}, "p62": {"key": "647-62", "title": "詠史詩：五丈原", "author": "胡曾", "canonical": "胡曾", "lines": ["蜀相西驅十萬來，秋風原下久裴回。", "長星不為英雄住，半夜流光落九垓。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-61", "next": "647-63"}, "p63": {"key": "647-63", "title": "詠史詩：平城", "author": "胡曾", "canonical": "胡曾", "lines": ["漢帝西征陷虜塵，一朝圍解議和親。", "當時已有吹毛劍，何事無人殺奉春。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-62", "next": "647-64"}, "p64": {"key": "647-64", "title": "詠史詩：汴水", "author": "胡曾", "canonical": "胡曾", "lines": ["千里長河一旦開，亡隋波浪九天來。", "錦帆未落干戈起，惆悵龍舟更不回。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-63", "next": "647-65"}, "p65": {"key": "647-65", "title": "詠史詩：蘭台宮", "author": "胡曾", "canonical": "胡曾", "lines": ["遲遲春日滿長空，亡國離宮蔓草中。", "宋玉不憂人事變，從游那賦大王風。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-64", "next": "647-66"}, "p66": {"key": "647-66", "title": "詠史詩：金牛驛", "author": "胡曾", "canonical": "胡曾", "lines": ["山嶺千重擁蜀門，成都別是一乾坤。", "五丁不鑿金牛路，秦惠何由得併吞。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-65", "next": "647-67"}, "p67": {"key": "647-67", "title": "詠史詩：望思台", "author": "胡曾", "canonical": "胡曾", "lines": ["太子銜冤去不回，臨皋從築望思台。", "至今漢武銷魂處，猶有悲風木上來。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-66", "next": "647-68"}, "p68": {"key": "647-68", "title": "詠史詩：邯鄲", "author": "胡曾", "canonical": "胡曾", "lines": ["曉入<a class=\"ent ent-place\" href=\"../entities/place_%E9%82%AF%E9%83%B8.html\">邯鄲</a>十裏春，東風吹下玉樓塵。", "青娥莫怪頻含笑，記得當年失步人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-67", "next": "647-69"}, "p69": {"key": "647-69", "title": "詠史詩：箕山", "author": "胡曾", "canonical": "胡曾", "lines": ["寂寂箕山春複秋，更無人到此溪頭。", "棄瓢岩畔中宵月，千古空聞屬<a class=\"ent ent-person\" href=\"../entities/person_%E8%AE%B8%E7%94%B1.html\">許由</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-68", "next": "647-70"}, "p70": {"key": "647-70", "title": "詠史詩：會稽山", "author": "胡曾", "canonical": "胡曾", "lines": ["越王兵敗已山棲，豈望全生出<a class=\"ent ent-place\" href=\"../entities/place_%E4%BC%9A%E7%A8%BD.html\">會稽</a>。", "何事<a class=\"ent ent-person\" href=\"../entities/person_%E5%A4%AB%E5%B7%AE.html\">夫差</a>無遠慮，更開羅網放鯨鯢。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-69", "next": "647-71"}, "p71": {"key": "647-71", "title": "詠史詩：不周山", "author": "胡曾", "canonical": "胡曾", "lines": ["共工爭帝力窮秋，因此捐生觸不周。", "遂使世間多感客，至今哀怨水東流。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-70", "next": "647-72"}, "p72": {"key": "647-72", "title": "詠史詩：虞阪", "author": "胡曾", "canonical": "胡曾", "lines": ["悠悠虞阪路欹斜，遲日和風簇野花。", "未省孫陽身沒後，幾多騏驥困鹽車。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-71", "next": "647-73"}, "p73": {"key": "647-73", "title": "詠史詩：秦庭", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E6%A5%9A%E5%9B%BD.html\">楚國</a>君臣草莽間，<a class=\"ent ent-person\" href=\"../entities/person_%E5%90%B4%E7%8E%8B.html\">吳王</a>戈甲未東還。", "包胥不動<a class=\"ent ent-place\" href=\"../entities/place_%E5%92%B8%E9%98%B3.html\">咸陽</a>哭，爭得秦兵出<a class=\"ent ent-place\" href=\"../entities/place_%E6%AD%A6%E5%85%B3.html\">武關</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-72", "next": "647-74"}, "p74": {"key": "647-74", "title": "詠史詩：延平津", "author": "胡曾", "canonical": "胡曾", "lines": ["延平津路水溶溶，峭壁巍岑一萬重。", "昨夜七星潭底見，分明神劍化為龍。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-73", "next": "647-75"}, "p75": {"key": "647-75", "title": "詠史詩：瑤池", "author": "胡曾", "canonical": "胡曾", "lines": ["阿母瑤池宴<a class=\"ent ent-person\" href=\"../entities/person_%E7%A9%86%E7%8E%8B.html\">穆王</a>，九天仙樂送瓊漿。", "漫矜八駿行如電，歸到人間國已亡。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-74", "next": "647-76"}, "p76": {"key": "647-76", "title": "詠史詩：銅柱", "author": "胡曾", "canonical": "胡曾", "lines": ["一柱高標險塞垣，南蠻不敢犯中原。", "功成自合分茅土，何事翻銜薏苡冤。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-75", "next": "647-77"}, "p77": {"key": "647-77", "title": "詠史詩：關西", "author": "胡曾", "canonical": "胡曾", "lines": ["楊震幽魂下北邙，關西蹤跡遂荒涼。", "四知美譽留人世，應與乾坤共久長。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-76", "next": "647-78"}, "p78": {"key": "647-78", "title": "詠史詩：高陽池", "author": "胡曾", "canonical": "胡曾", "lines": ["古人未遇即銜杯，所貴愁腸得酒開。", "何事山公持玉節，等閒深入醉鄉來。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-77", "next": "647-79"}, "p79": {"key": "647-79", "title": "詠史詩：瀘水", "author": "胡曾", "canonical": "胡曾", "lines": ["五月驅兵入不毛，月明瀘水瘴煙高。", "誓將雄略酬三顧，豈憚征蠻七縱勞。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-78", "next": "647-80"}, "p80": {"key": "647-80", "title": "詠史詩：細柳營", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E6%96%87%E5%B8%9D.html\">文帝</a>鑾輿勞北征，條侯此地整嚴兵。", "轅門不峻將軍令，今日爭知細柳營。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-79", "next": "647-81"}, "p81": {"key": "647-81", "title": "詠史詩：葉縣", "author": "胡曾", "canonical": "胡曾", "lines": ["葉公丘墓已塵埃，雲矗崇墉亦半摧。", "借問往年龍見日，幾多風雨送將來。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-80", "next": "647-82"}, "p82": {"key": "647-82", "title": "詠史詩：杜郵", "author": "胡曾", "canonical": "胡曾", "lines": ["自古功成禍亦侵，武安冤向杜郵深。", "<a class=\"ent ent-place\" href=\"../entities/place_%E4%BA%94%E6%B9%96.html\">五湖</a>煙月無窮水，何事遷延到陸沉。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-81", "next": "647-83"}, "p83": {"key": "647-83", "title": "詠史詩：柯亭", "author": "胡曾", "canonical": "胡曾", "lines": ["一宿柯亭月滿天，笛亡人沒事空傳。", "中郎在世無甄別，爭得名垂爾許年。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-82", "next": "647-84"}, "p84": {"key": "647-84", "title": "詠史詩：葛陂", "author": "胡曾", "canonical": "胡曾", "lines": ["長房回到葛陂中，人已登真竹化龍。", "莫道神仙難頓學，嵇生自是不遭逢。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-83", "next": "647-85"}, "p85": {"key": "647-85", "title": "詠史詩：博浪沙", "author": "胡曾", "canonical": "胡曾", "lines": ["嬴政鯨吞六合秋，削平天下虜諸侯。", "<a class=\"ent ent-place\" href=\"../entities/place_%E5%B1%B1%E4%B8%9C.html\">山東</a>不是無公子，何事<a class=\"ent ent-person\" href=\"../entities/person_%E5%BC%A0%E8%89%AF.html\">張良</a>獨報仇。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-84", "next": "647-86"}, "p86": {"key": "647-86", "title": "詠史詩：隴西", "author": "胡曾", "canonical": "胡曾", "lines": ["乘春來到隴山西，隗氏城荒碧草齊。", "好笑王元不量力，函關那受一丸泥。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-85", "next": "647-87"}, "p87": {"key": "647-87", "title": "詠史詩：白帝城", "author": "胡曾", "canonical": "胡曾", "lines": ["蜀江一帶向東傾，江上巍峨<a class=\"ent ent-place\" href=\"../entities/place_%E7%99%BD%E5%B8%9D%E5%9F%8E.html\">白帝城</a>。", "自古山河歸聖主，子陽虛共漢家爭。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-86", "next": "647-88"}, "p88": {"key": "647-88", "title": "詠史詩：牛渚", "author": "胡曾", "canonical": "胡曾", "lines": ["溫嶠南歸輟棹晨，燃犀牛渚照通津。", "誰知萬丈洪流下，更有朱衣躍馬人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-87", "next": "647-89"}, "p89": {"key": "647-89", "title": "詠史詩：朝歌", "author": "胡曾", "canonical": "胡曾", "lines": ["長嗟墨翟少風流，急管繁弦似寇仇。", "若解聞韶知肉味，<a class=\"ent ent-place\" href=\"../entities/place_%E6%9C%9D%E6%AD%8C.html\">朝歌</a>欲到肯回頭。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-88", "next": "647-90"}, "p90": {"key": "647-90", "title": "詠史詩：谷口", "author": "胡曾", "canonical": "胡曾", "lines": ["一旦天真逐水流，虎爭龍戰為諸侯。", "子真獨有煙霞趣，<a class=\"ent ent-place\" href=\"../entities/place_%E8%B0%B7%E5%8F%A3.html\">穀口</a>耕鋤到白頭。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-89", "next": "647-91"}, "p91": {"key": "647-91", "title": "詠史詩：武陵溪", "author": "胡曾", "canonical": "胡曾", "lines": ["一溪春水徹雲根，流出桃花片片新。", "若道長生是虛語，洞中爭得有秦人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-90", "next": "647-92"}, "p92": {"key": "647-92", "title": "詠史詩：大澤", "author": "胡曾", "canonical": "胡曾", "lines": ["白蛇初斷路人通，漢祖龍泉血刃紅。", "不是<a class=\"ent ent-place\" href=\"../entities/place_%E5%92%B8%E9%98%B3.html\">咸陽</a>將瓦解，素靈那哭月明中。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-91", "next": "647-93"}, "p93": {"key": "647-93", "title": "詠史詩：澠池", "author": "胡曾", "canonical": "胡曾", "lines": ["日照荒城芳草新，<a class=\"ent ent-person\" href=\"../entities/person_%E7%9B%B8%E5%A6%82.html\">相如</a>曾此挫強秦。", "能令百二山河主，便作樽前擊缶人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-92", "next": "647-94"}, "p94": {"key": "647-94", "title": "詠史詩：峴山", "author": "胡曾", "canonical": "胡曾", "lines": ["曉日登臨感晉臣，古碑零落峴山春。", "松間殘露頻頻滴，酷似當時墮淚人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-93", "next": "647-95"}, "p95": {"key": "647-95", "title": "詠史詩：滎陽", "author": "胡曾", "canonical": "胡曾", "lines": ["漢祖東征屈未伸，<a class=\"ent ent-place\" href=\"../entities/place_%E8%8D%A5%E9%98%B3.html\">滎陽</a>失律紀生焚。", "當時天下方龍戰，誰為將軍作誄文。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-94", "next": "647-96"}, "p96": {"key": "647-96", "title": "詠史詩：長城", "author": "胡曾", "canonical": "胡曾", "lines": ["祖舜宗堯自太平，秦皇何事苦蒼生。", "不知禍起蕭牆內，虛築防胡萬里城。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-95", "next": "647-97"}, "p97": {"key": "647-97", "title": "詠史詩：赤壁", "author": "胡曾", "canonical": "胡曾", "lines": ["烈火西焚魏帝旗，周郎開國虎爭時。", "交兵不假揮長劍，已挫英雄百萬師。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-96", "next": "647-98"}, "p98": {"key": "647-98", "title": "詠史詩：田橫墓", "author": "胡曾", "canonical": "胡曾", "lines": ["古墓崔巍約路岐，歌傳薤露到今時。", "也知不去朝黃屋，只為曾烹酈<a class=\"ent ent-person\" href=\"../entities/person_%E9%A3%9F%E5%85%B6.html\">食其</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-97", "next": "647-99"}, "p99": {"key": "647-99", "title": "詠史詩：青門", "author": "胡曾", "canonical": "胡曾", "lines": ["漢皇提劍滅咸秦，亡國諸侯儘是臣。", "唯有東陵守高節，青門甘作種瓜人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-98", "next": "647-100"}, "p100": {"key": "647-100", "title": "詠史詩：姑蘇台", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E5%90%B4%E7%8E%8B.html\">吳王</a>恃霸棄雄才，貪向<a class=\"ent ent-place\" href=\"../entities/place_%E5%A7%91%E8%8B%8F.html\">姑蘇</a>醉醁醅。", "不覺錢塘江上月，一宵西送越兵來。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-99", "next": "647-101"}, "p101": {"key": "647-101", "title": "詠史詩：息城", "author": "胡曾", "canonical": "胡曾", "lines": ["息亡身入<a class=\"ent ent-person\" href=\"../entities/person_%E6%A5%9A%E7%8E%8B.html\">楚王</a>家，回首春風一面花。", "感舊不言長掩淚，只應翻恨有容華。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-100", "next": "647-102"}, "p102": {"key": "647-102", "title": "詠史詩：上蔡", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%8A%E8%94%A1.html\">上蔡</a>東門狡兔肥，<a class=\"ent ent-person\" href=\"../entities/person_%E6%9D%8E%E6%96%AF.html\">李斯</a>何事忘南歸。", "功成不解謀身退，直待<a class=\"ent ent-place\" href=\"../entities/place_%E4%BA%91%E9%98%B3.html\">雲陽</a>血染衣。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-101", "next": "647-103"}, "p103": {"key": "647-103", "title": "詠史詩：武昌", "author": "胡曾", "canonical": "胡曾", "lines": ["王浚戈鋋發上流，武昌鴻業土崩秋。", "思量鐵鎖真兒戲，誰為<a class=\"ent ent-person\" href=\"../entities/person_%E5%90%B4%E7%8E%8B.html\">吳王</a>畫此籌。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-102", "next": "647-104"}, "p104": {"key": "647-104", "title": "詠史詩：鴻溝", "author": "胡曾", "canonical": "胡曾", "lines": ["虎倦龍疲白刃秋，兩分天下指<a class=\"ent ent-place\" href=\"../entities/place_%E9%B8%BF%E6%B2%9F.html\">鴻溝</a>。", "<a class=\"ent ent-person\" href=\"../entities/person_%E9%A1%B9%E7%8E%8B.html\">項王</a>不覺英雄挫，欲向彭門醉玉樓。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-103", "next": "647-105"}, "p105": {"key": "647-105", "title": "詠史詩：褒城", "author": "胡曾", "canonical": "胡曾", "lines": ["恃寵嬌多得自由，驪山舉火戲諸侯。", "只知一笑傾人國，不覺胡塵滿玉樓。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-104", "next": "647-106"}, "p106": {"key": "647-106", "title": "詠史詩：金陵", "author": "胡曾", "canonical": "胡曾", "lines": ["侯景長驅十萬人，可憐梁武坐蒙塵。", "生前不得空王力，徒向金田自捨身。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-105", "next": "647-107"}, "p107": {"key": "647-107", "title": "詠史詩：洛陽", "author": "胡曾", "canonical": "胡曾", "lines": ["石勒童年有戰機，<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9B%E9%98%B3.html\">洛陽</a>長嘯倚門時。", "晉朝不是王夷甫，大智何由得預知。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-106", "next": "647-108"}, "p108": {"key": "647-108", "title": "詠史詩：番禺", "author": "胡曾", "canonical": "胡曾", "lines": ["重岡複嶺勢崔巍，一卒當關萬卒回。", "不是大夫多辨說，尉他爭肯築朝台。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-107", "next": "647-109"}, "p109": {"key": "647-109", "title": "詠史詩：汨羅", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E8%A5%84%E7%8E%8B.html\">襄王</a>不用直臣籌，放逐南來澤國秋。", "自向波間葬魚腹，楚人徒倚濟川舟。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-108", "next": "647-110"}, "p110": {"key": "647-110", "title": "詠史詩：彭澤", "author": "胡曾", "canonical": "胡曾", "lines": ["英傑那堪屈下僚，便栽門柳事蕭條。", "鳳凰不共雞爭食，莫怪先生懶折腰。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-109", "next": "647-111"}, "p111": {"key": "647-111", "title": "詠史詩：涿鹿", "author": "胡曾", "canonical": "胡曾", "lines": ["涿鹿茫茫白草秋，軒轅曾此破<a class=\"ent ent-person\" href=\"../entities/person_%E8%9A%A9%E5%B0%A4.html\">蚩尤</a>。", "丹霞遙映祠前水，疑是成川血尚流。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-110", "next": "647-112"}, "p112": {"key": "647-112", "title": "詠史詩：洞庭", "author": "胡曾", "canonical": "胡曾", "lines": ["五月扁舟過<a class=\"ent ent-place\" href=\"../entities/place_%E6%B4%9E%E5%BA%AD.html\">洞庭</a>，魚龍吹浪水雲腥。", "軒轅<a class=\"ent ent-person\" href=\"../entities/person_%E9%BB%84%E5%B8%9D.html\">黃帝</a>今何在，回首巴山蘆葉青。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-111", "next": "647-113"}, "p113": {"key": "647-113", "title": "詠史詩：嶓塚", "author": "胡曾", "canonical": "胡曾", "lines": ["夏禹崩來一萬秋，水從嶓塚至今流。", "當時若訴胼胝苦，更使何人別九州。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-112", "next": "647-114"}, "p114": {"key": "647-114", "title": "詠史詩：塗山", "author": "胡曾", "canonical": "胡曾", "lines": ["大禹塗山御座開，諸侯玉帛走如雷。", "防風謾有專車骨，何事茲辰最後來。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-113", "next": "647-115"}, "p115": {"key": "647-115", "title": "詠史詩：商郊", "author": "胡曾", "canonical": "胡曾", "lines": ["鶯囀商郊百草新，殷湯遺跡在荒榛。", "誰知繼桀為天子，便是當初祝網人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-114", "next": "647-116"}, "p116": {"key": "647-116", "title": "詠史詩：傅岩", "author": "胡曾", "canonical": "胡曾", "lines": ["岩前版築不求伸，方寸那希據要津。", "自是武丁安寢夜，一宵宮裏夢賢人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-115", "next": "647-117"}, "p117": {"key": "647-117", "title": "詠史詩：鉅橋", "author": "胡曾", "canonical": "胡曾", "lines": ["積粟成塵竟不開，誰知拒諫剖賢才。", "<a class=\"ent ent-person\" href=\"../entities/person_%E6%AD%A6%E7%8E%8B.html\">武王</a>兵起無人敵，遂作商郊一聚灰。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-116", "next": "647-118"}, "p118": {"key": "647-118", "title": "詠史詩：首陽山", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E5%AD%A4%E7%AB%B9.html\">孤竹</a>夷齊恥戰爭，望塵遮道請休兵。", "首陽山倒為平地，應始無人說姓名。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-117", "next": "647-119"}, "p119": {"key": "647-119", "title": "詠史詩：孟津", "author": "胡曾", "canonical": "胡曾", "lines": ["秋風颯颯孟津頭，立馬沙邊看水流。", "見說<a class=\"ent ent-person\" href=\"../entities/person_%E6%AD%A6%E7%8E%8B.html\">武王</a>東渡日，戎衣曾此叱陽侯。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-118", "next": "647-120"}, "p120": {"key": "647-120", "title": "詠史詩：流沙", "author": "胡曾", "canonical": "胡曾", "lines": ["七雄戈戟亂如麻，四海無人得坐家。", "老氏卻思<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%A4%A9%E7%AB%BA.html\">天竺</a>住，便將徐甲去<a class=\"ent ent-place\" href=\"../entities/place_%E6%B5%81%E6%B2%99.html\">流沙</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-119", "next": "647-121"}, "p121": {"key": "647-121", "title": "詠史詩：鄧城", "author": "胡曾", "canonical": "胡曾", "lines": ["鄧侯城壘漢江幹，自謂深根百世安。", "不用三甥謀楚計，臨危方覺噬臍難。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-120", "next": "647-122"}, "p122": {"key": "647-122", "title": "詠史詩：召陵", "author": "胡曾", "canonical": "胡曾", "lines": ["小白匡周入楚郊，<a class=\"ent ent-person\" href=\"../entities/person_%E6%A5%9A%E7%8E%8B.html\">楚王</a>雄霸亦咆哮。", "不思<a class=\"ent ent-person\" href=\"../entities/person_%E7%AE%A1%E4%BB%B2.html\">管仲</a>為謀主，爭取言征縮酒茅。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-121", "next": "647-123"}, "p123": {"key": "647-123", "title": "詠史詩：綿山", "author": "胡曾", "canonical": "胡曾", "lines": ["親在要君召不來，亂山重疊使空回。", "如何堅執尤人意，甘向岩前作死灰。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-122", "next": "647-124"}, "p124": {"key": "647-124", "title": "詠史詩：魯城", "author": "胡曾", "canonical": "胡曾", "lines": ["魯公城闕已丘墟，荒草無由認玉除。", "因笑臧孫才智少，東門鐘鼓祀鶢鶋。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-123", "next": "647-125"}, "p125": {"key": "647-125", "title": "詠史詩：驌驦陂", "author": "胡曾", "canonical": "胡曾", "lines": ["行行西至一荒陂，因笑唐公不見機。", "莫惜驌驦輸令尹，漢東宮闕早時歸。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-124", "next": "647-126"}, "p126": {"key": "647-126", "title": "詠史詩：夾谷", "author": "胡曾", "canonical": "胡曾", "lines": ["夾穀鶯啼三月天，野花芳草整相鮮。", "來時不見侏儒死，空笑<a class=\"ent ent-nation\" href=\"../entities/nation_%E9%BD%90%E4%BA%BA.html\">齊人</a>失措年。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-125", "next": "647-127"}, "p127": {"key": "647-127", "title": "詠史詩：吳宮", "author": "胡曾", "canonical": "胡曾", "lines": ["草長<a class=\"ent ent-place\" href=\"../entities/place_%E9%BB%84%E6%B1%A0.html\">黃池</a>千里餘，歸來宗廟已丘墟。", "出師不聽忠臣諫，徒恥窮泉見<a class=\"ent ent-person\" href=\"../entities/person_%E5%AD%90%E8%83%A5.html\">子胥</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-126", "next": "647-128"}, "p128": {"key": "647-128", "title": "詠史詩：摩笄山", "author": "胡曾", "canonical": "胡曾", "lines": ["春草綿綿岱日低，山邊立馬看摩笄。", "黃鶯也解追前事，來向夫人死處啼。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-127", "next": "647-129"}, "p129": {"key": "647-129", "title": "詠史詩：房陵", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E8%B5%B5%E7%8E%8B.html\">趙王</a>一旦到房陵，國破家亡百恨增。", "魂斷叢台歸不得，夜來明月為誰升。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-128", "next": "647-130"}, "p130": {"key": "647-130", "title": "詠史詩：濮水", "author": "胡曾", "canonical": "胡曾", "lines": ["青春行役思悠悠，一曲汀蒲濮水流。", "正見塗中龜曳尾，令人特地感莊周。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-129", "next": "647-131"}, "p131": {"key": "647-131", "title": "詠史詩：柏舉", "author": "胡曾", "canonical": "胡曾", "lines": ["野田極目草茫茫，吳楚交兵此路傍。", "誰料<a class=\"ent ent-person\" href=\"../entities/person_%E4%BC%8D%E5%91%98.html\">伍員</a>入郢後，大開陵寢撻<a class=\"ent ent-person\" href=\"../entities/person_%E5%B9%B3%E7%8E%8B.html\">平王</a>。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-130", "next": "647-132"}, "p132": {"key": "647-132", "title": "詠史詩：望夫山", "author": "胡曾", "canonical": "胡曾", "lines": ["一上青山便化身，不知何代怨離人。", "古來節婦皆銷朽，獨爾不為泉下塵。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-131", "next": "647-133"}, "p133": {"key": "647-133", "title": "詠史詩：金義嶺", "author": "胡曾", "canonical": "胡曾", "lines": ["鑿開山嶺引湘波，上去昭回不較多。", "無限鵲臨橋畔立，適來天道過天河。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-132", "next": "647-134"}, "p134": {"key": "647-134", "title": "詠史詩：云云亭", "author": "胡曾", "canonical": "胡曾", "lines": ["一上高亭日正晡，青山重疊片雲無。", "萬年松樹不知數，若個虯枝是大夫。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-133", "next": "647-135"}, "p135": {"key": "647-135", "title": "詠史詩：阿房宮", "author": "胡曾", "canonical": "胡曾", "lines": ["新建<a class=\"ent ent-place\" href=\"../entities/place_%E9%98%BF%E6%88%BF.html\">阿房</a>壁未幹，<a class=\"ent ent-person\" href=\"../entities/person_%E6%B2%9B%E5%85%AC.html\">沛公</a>兵已入<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>。", "帝王苦竭生靈力，大業沙崩固不難。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-134", "next": "647-136"}, "p136": {"key": "647-136", "title": "詠史詩：沙丘", "author": "胡曾", "canonical": "胡曾", "lines": ["年年遊覽不曾停，天下山川欲遍經。", "堪笑<a class=\"ent ent-place\" href=\"../entities/place_%E6%B2%99%E4%B8%98.html\">沙丘</a>才過處，鑾輿風過鮑魚腥。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-135", "next": "647-137"}, "p137": {"key": "647-137", "title": "詠史詩：咸陽", "author": "胡曾", "canonical": "胡曾", "lines": ["一朝閻樂統群凶，二世朝廷掃地空。", "唯有渭川流不盡，至今猶繞望夷宮。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-136", "next": "647-138"}, "p138": {"key": "647-138", "title": "詠史詩：廢丘山", "author": "胡曾", "canonical": "胡曾", "lines": ["此水雖非禹鑿開，廢丘山下重縈回。", "莫言只解東流去，曾使章邯自殺來。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-137", "next": "647-139"}, "p139": {"key": "647-139", "title": "詠史詩：廣武山", "author": "胡曾", "canonical": "胡曾", "lines": ["數罪楚師應奪氣，底須多論破深艱。", "倉皇鬥智成何語，遺笑當時<a class=\"ent ent-place\" href=\"../entities/place_%E5%B9%BF%E6%AD%A6.html\">廣武</a>山。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-138", "next": "647-140"}, "p140": {"key": "647-140", "title": "詠史詩：長安", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E5%85%B3%E4%B8%9C.html\">關東</a>新破<a class=\"ent ent-person\" href=\"../entities/person_%E9%A1%B9%E7%8E%8B.html\">項王</a>歸，赤幟悠揚日月旗。", "從此漢家無敵國，爭教彭越受誅夷。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-139", "next": "647-141"}, "p141": {"key": "647-141", "title": "詠史詩：鴻門", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E9%A1%B9%E7%B1%8D.html\">項籍</a>鷹揚六合晨，<a class=\"ent ent-place\" href=\"../entities/place_%E9%B8%BF%E9%97%A8.html\">鴻門</a>開宴賀亡秦。", "樽前若取謀臣計，豈作陰陵失路人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-140", "next": "647-142"}, "p142": {"key": "647-142", "title": "詠史詩：漢中", "author": "胡曾", "canonical": "胡曾", "lines": ["荊棘蒼蒼漢水湄，將壇煙草覆餘基。", "適來投石空江上，猶似龍顏納諫時。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-141", "next": "647-143"}, "p143": {"key": "647-143", "title": "詠史詩：泜水", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-person\" href=\"../entities/person_%E9%9F%A9%E4%BF%A1.html\">韓信</a>經營按鏌鋣，臨戎叱吒有誰加。", "猶疑轉戰逢勍敵，更向軍中問左車。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-142", "next": "647-144"}, "p144": {"key": "647-144", "title": "詠史詩：雲夢", "author": "胡曾", "canonical": "胡曾", "lines": ["漢祖聽讒不可防，偽游<a class=\"ent ent-person\" href=\"../entities/person_%E9%9F%A9%E4%BF%A1.html\">韓信</a>果罹殃。", "十處辛苦平天下，何事生擒入帝鄉。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-143", "next": "647-145"}, "p145": {"key": "647-145", "title": "詠史詩：高陽", "author": "胡曾", "canonical": "胡曾", "lines": ["路入<a class=\"ent ent-place\" href=\"../entities/place_%E9%AB%98%E9%98%B3.html\">高陽</a>感酈生，逢時長揖便論兵。", "最憐伏軾東遊日，下盡<a class=\"ent ent-person\" href=\"../entities/person_%E9%BD%90%E7%8E%8B.html\">齊王</a>七十城。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-144", "next": "647-146"}, "p146": {"key": "647-146", "title": "詠史詩：四皓廟", "author": "胡曾", "canonical": "胡曾", "lines": ["四皓忘機飲碧松，石岩雲殿隱高蹤。", "不知俱出龍樓後，多在商山第幾重。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-145", "next": "647-147"}, "p147": {"key": "647-147", "title": "詠史詩：霸陵", "author": "胡曾", "canonical": "胡曾", "lines": ["原頭日落雪邊雲，猶放韓盧逐兔群。", "況是四方無事日，<a class=\"ent ent-place\" href=\"../entities/place_%E9%9C%B8%E9%99%B5.html\">霸陵</a>誰識舊將軍。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-146", "next": "647-148"}, "p148": {"key": "647-148", "title": "詠史詩：昆明池", "author": "胡曾", "canonical": "胡曾", "lines": ["欲出<a class=\"ent ent-nation\" href=\"../entities/nation_%E6%98%86%E6%98%8E.html\">昆明</a>萬里師，漢皇習戰此穿池。", "如何一面圖攻取，不念生靈氣力疲。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-147", "next": "647-149"}, "p149": {"key": "647-149", "title": "詠史詩：回中", "author": "胡曾", "canonical": "胡曾", "lines": ["武皇無路及昆丘，青鳥西沈隴樹秋。", "欲問生前躬祀日，幾煩龍駕到涇州。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-148", "next": "647-150"}, "p150": {"key": "647-150", "title": "詠史詩：東門", "author": "胡曾", "canonical": "胡曾", "lines": ["何人知足反田廬，玉管東門餞二疏。", "豈是不榮天子祿，後賢那使久閒居。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-149", "next": "647-151"}, "p151": {"key": "647-151", "title": "詠史詩：射熊館", "author": "胡曾", "canonical": "胡曾", "lines": ["漢帝荒唐不解憂，大誇田獵廢農收。", "子雲徒獻長楊賦，肯念高皇沐雨秋。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-150", "next": "647-152"}, "p152": {"key": "647-152", "title": "詠史詩：昆陽", "author": "胡曾", "canonical": "胡曾", "lines": ["師克由來在協和，蕭王兵馬固無多。", "誰知大敵昆陽敗，卻笑前朝困楚歌。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-151", "next": "647-153"}, "p153": {"key": "647-153", "title": "詠史詩：七裏灘", "author": "胡曾", "canonical": "胡曾", "lines": ["七裏青灘映碧層，九天星象感嚴陵。", "釣魚臺上無絲竹，不是高人誰解登。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-152", "next": "647-154"}, "p154": {"key": "647-154", "title": "詠史詩：潁川", "author": "胡曾", "canonical": "胡曾", "lines": ["古賢高尚不爭名，行止由來動杳冥。", "今日浪為千里客，看花慚上德星亭。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-153", "next": "647-155"}, "p155": {"key": "647-155", "title": "詠史詩：江夏", "author": "胡曾", "canonical": "胡曾", "lines": ["黃祖才非長者儔，禰衡珠碎此江頭。", "今來<a class=\"ent ent-place\" href=\"../entities/place_%E9%B9%A6%E9%B9%89%E6%B4%B2.html\">鸚鵡洲</a>邊過，惟有無情碧水流。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-154", "next": "647-156"}, "p156": {"key": "647-156", "title": "詠史詩：官渡", "author": "胡曾", "canonical": "胡曾", "lines": ["本初屈指定中華，官渡相持勒虎牙。", "若使許攸財用足，山河爭得屬曹家。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-155", "next": "647-157"}, "p157": {"key": "647-157", "title": "詠史詩：灞岸", "author": "胡曾", "canonical": "胡曾", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>城外白雲秋，蕭索悲風灞水流。", "因想漢朝離亂日，仲宣從此向荊州。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-156", "next": "647-158"}, "p158": {"key": "647-158", "title": "詠史詩：濡須橋", "author": "胡曾", "canonical": "胡曾", "lines": ["徒向濡須欲受降，英雄才略獨無雙。", "天心不與<a class=\"ent ent-place\" href=\"../entities/place_%E9%87%91%E9%99%B5.html\">金陵</a>便，高步何由得渡江。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-157", "next": "647-159"}, "p159": {"key": "647-159", "title": "詠史詩：豫州", "author": "胡曾", "canonical": "胡曾", "lines": ["策馬行行到豫州，祖生寂寞水空流。", "當時更有三年壽，石勒尋為關下囚。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-158", "next": "647-160"}, "p160": {"key": "647-160", "title": "詠史詩：八公山", "author": "胡曾", "canonical": "胡曾", "lines": ["苻堅舉國出西秦，東晉危如累卵晨。", "誰料此山諸草木，盡能排難化為人。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-159", "next": "647-161"}, "p161": {"key": "647-161", "title": "詠史詩：下第", "author": "胡曾", "canonical": "胡曾", "lines": ["翰苑何時休嫁女，文昌早晚罷生兒。", "<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%8A%E6%9E%97.html\">上林</a>新桂年年發，不許平人折一枝。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-160", "next": "647-162"}, "p162": {"key": "647-162", "title": "詠史詩：贈薛濤", "author": "胡曾", "canonical": "胡曾", "lines": ["萬里橋邊女校書，枇杷花下閉門居。", "掃眉才子知多少，管領春風總不如。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "647-161", "next": null}}}