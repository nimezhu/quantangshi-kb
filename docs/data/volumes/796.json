{"vol_name": "卷七百九十六", "poems": {"p01": {"key": "796-01", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["都來消帝力，全不用兵防。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": null, "next": "796-02"}, "p02": {"key": "796-02", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["道遠擎空缽，深山踏落花。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-01", "next": "796-03"}, "p03": {"key": "796-03", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["船中江上景，晚泊早行時。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-02", "next": "796-04"}, "p04": {"key": "796-04", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["山寺鐘樓月，江城鼓角風。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-03", "next": "796-05"}, "p05": {"key": "796-05", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["雨過花爭出，雲空月半生。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-04", "next": "796-06"}, "p06": {"key": "796-06", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["鳥正啼隋柳，人須入楚山。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-05", "next": "796-07"}, "p07": {"key": "796-07", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["高松飄雨雪，一室掩香燈。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-06", "next": "796-08"}, "p08": {"key": "796-08", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["遂有冥心者，還尋此境來。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-07", "next": "796-09"}, "p09": {"key": "796-09", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["又因風雨夜，重到古松門。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-08", "next": "796-10"}, "p10": {"key": "796-10", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["道晦金雞伏，時來木馬鳴。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-09", "next": "796-11"}, "p11": {"key": "796-11", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["誰來看山寺，自去掃松門。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-10", "next": "796-12"}, "p12": {"key": "796-12", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["此生還自喜，餘事不相侵。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-11", "next": "796-13"}, "p13": {"key": "796-13", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["白鬢無心鑷，青山得意多。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-12", "next": "796-14"}, "p14": {"key": "796-14", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["一春能幾日，無雨亦多風。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-13", "next": "796-15"}, "p15": {"key": "796-15", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["苦雨秋濤漲，狂風野燒翻。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-14", "next": "796-16"}, "p16": {"key": "796-16", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["須知三尺劍，只為不平磨。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-15", "next": "796-17"}, "p17": {"key": "796-17", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["要路爭先進，閑門肯暫過。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-16", "next": "796-18"}, "p18": {"key": "796-18", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["已難消永夜，況複聽秋霖。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-17", "next": "796-19"}, "p19": {"key": "796-19", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["大雪路亦宿，深山水也吞。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-18", "next": "796-20"}, "p20": {"key": "796-20", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["捲簾黃葉落，鎖印子規啼。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-19", "next": "796-21"}, "p21": {"key": "796-21", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["亡國空流水，孤祠掩落花。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-20", "next": "796-22"}, "p22": {"key": "796-22", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["山魅隔窗舞，鵩鳥入簾飛。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-21", "next": "796-23"}, "p23": {"key": "796-23", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["萬里八九月，一身西北風。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-22", "next": "796-24"}, "p24": {"key": "796-24", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["磴危攀薜荔，石滑疏莓苔。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-23", "next": "796-25"}, "p25": {"key": "796-25", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["日落無行客，天寒有去鴻。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-24", "next": "796-26"}, "p26": {"key": "796-26", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["正思浮世事，又到古城邊。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-25", "next": "796-27"}, "p27": {"key": "796-27", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["尋常風雨夜，應有鬼神看。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-26", "next": "796-28"}, "p28": {"key": "796-28", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["寄宿山中寺，相辭海上僧。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-27", "next": "796-29"}, "p29": {"key": "796-29", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["風吹榆莢葉，雨打木瓜花。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-28", "next": "796-30"}, "p30": {"key": "796-30", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["是星皆拱北，無水不朝東。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-29", "next": "796-31"}, "p31": {"key": "796-31", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["西風起邊雁，一一向<a class=\"ent ent-place\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-30", "next": "796-32"}, "p32": {"key": "796-32", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["那堪懷遠路，猶自上高樓。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-31", "next": "796-33"}, "p33": {"key": "796-33", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["白雲風散盡，紅葉水流來。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-32", "next": "796-34"}, "p34": {"key": "796-34", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["妾如無異意，君棄也甘心。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-33", "next": "796-35"}, "p35": {"key": "796-35", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["野過雲根闊，山高樹影長。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-34", "next": "796-36"}, "p36": {"key": "796-36", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["古跡應重別，生緣不暫停。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-35", "next": "796-37"}, "p37": {"key": "796-37", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["一個字未穩，數宵心不閑。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-36", "next": "796-38"}, "p38": {"key": "796-38", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["別地葉頻落，去程山已寒。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-37", "next": "796-39"}, "p39": {"key": "796-39", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["但取詩名得，何論下第頻。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-38", "next": "796-40"}, "p40": {"key": "796-40", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["早起赴前程，鄰雞尚未鳴。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-39", "next": "796-41"}, "p41": {"key": "796-41", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["白地一回雨，兒孫拾得金。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-40", "next": "796-42"}, "p42": {"key": "796-42", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["軒車在何處，雨雪滿前山。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-41", "next": "796-43"}, "p43": {"key": "796-43", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["燈微山館雨，角咽海城秋。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-42", "next": "796-44"}, "p44": {"key": "796-44", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["去帆看已遠，臨水立多時。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-43", "next": "796-45"}, "p45": {"key": "796-45", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["家貧為客早，路遠得書稀。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-44", "next": "796-46"}, "p46": {"key": "796-46", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["瀑布五千仞，草堂瀑布邊。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-45", "next": "796-47"}, "p47": {"key": "796-47", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["我憶雲門寺，門前千萬峰。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-46", "next": "796-48"}, "p48": {"key": "796-48", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["一瓶居無外，萬木老禪中。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-47", "next": "796-49"}, "p49": {"key": "796-49", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["秋江洗一缽，寒日曬三衣。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-48", "next": "796-50"}, "p50": {"key": "796-50", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["空山行客少，獨樹晚蟬多。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-49", "next": "796-51"}, "p51": {"key": "796-51", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["一片月生海，幾家人上樓。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-50", "next": "796-52"}, "p52": {"key": "796-52", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["窗寒風漸緊，燈落夜將深。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-51", "next": "796-53"}, "p53": {"key": "796-53", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E4%BA%91%E6%A2%A6.html\">雲夢</a>幾行去，<a class=\"ent ent-place\" href=\"../entities/place_%E6%BD%87%E6%B9%98.html\">瀟湘</a>一夜空。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-52", "next": "796-54"}, "p54": {"key": "796-54", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["無風來竹院，有月在莎庭。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-53", "next": "796-55"}, "p55": {"key": "796-55", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["故園從小別，夜雨近秋聞。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-54", "next": "796-56"}, "p56": {"key": "796-56", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["書劍別南州，炎荒萬里遊。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-55", "next": "796-57"}, "p57": {"key": "796-57", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["山盤樵徑上，人到雪房遲。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-56", "next": "796-58"}, "p58": {"key": "796-58", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["路經秋雨後，人入亂峰來。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-57", "next": "796-59"}, "p59": {"key": "796-59", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["獨樹知秋早，孤舟覺夜寒。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-58", "next": "796-60"}, "p60": {"key": "796-60", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["馬饑餐落葉，鶴宿曬殘陽。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-59", "next": "796-61"}, "p61": {"key": "796-61", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["路遠春行盡，家貧愁到時。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-60", "next": "796-62"}, "p62": {"key": "796-62", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["臨水通宵坐，知君此興同。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-61", "next": "796-63"}, "p63": {"key": "796-63", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["江聲兼小雨，暝色入啼猿。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-62", "next": "796-64"}, "p64": {"key": "796-64", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["藕隱玲瓏玉，花藏縹緲容。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-63", "next": "796-65"}, "p65": {"key": "796-65", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["紅樹醉秋色，碧溪彈夜弦。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-64", "next": "796-66"}, "p66": {"key": "796-66", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["網斷蛛猶織，梁空燕不歸。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-65", "next": "796-67"}, "p67": {"key": "796-67", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["倒身無著處，呵手不成溫。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-66", "next": "796-68"}, "p68": {"key": "796-68", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["幾多詩弟子，無限酒知聞。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-67", "next": "796-69"}, "p69": {"key": "796-69", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["床上小熏籠，韶州新退紅。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-68", "next": "796-70"}, "p70": {"key": "796-70", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["看時人步澀，展處蝶爭來。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-69", "next": "796-71"}, "p71": {"key": "796-71", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["兢字德源，<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>人，梁宰相也。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "796-70", "next": "796-72"}, "p72": {"key": "796-72", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["酒味雜蓮氣，香冷勝於冰。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "796-71", "next": "796-73"}, "p73": {"key": "796-73", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["太宗皇帝真長策，賺得英雄盡白頭。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-72", "next": "796-74"}, "p74": {"key": "796-74", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["曾題名處添前字，送出城人乞舊衣。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-73", "next": "796-75"}, "p75": {"key": "796-75", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E5%8D%8E%E9%98%B3.html\">華陽</a>觀裏鐘聲集，建福門前鼓動期。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-74", "next": "796-76"}, "p76": {"key": "796-76", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["隴右諸侯供語鳥，日南太守送名花。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-75", "next": "796-77"}, "p77": {"key": "796-77", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["八百孤寒齊下淚，一時回首望崖州。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-76", "next": "796-78"}, "p78": {"key": "796-78", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["讓劫已令多士伏，沽名還得世人聞。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-77", "next": "796-79"}, "p79": {"key": "796-79", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["人為子推初禁火，花愁青女再飛霜。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-78", "next": "796-80"}, "p80": {"key": "796-80", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["楝花開後風光好，梅子黃時雨意濃。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-79", "next": "796-81"}, "p81": {"key": "796-81", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["蘭湯備浴傳荊俗，水馬浮江吊屈魂。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-80", "next": "796-82"}, "p82": {"key": "796-82", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["城頭椎鼓傳花枝，席上摶拳握松子。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-81", "next": "796-83"}, "p83": {"key": "796-83", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["鳥向不香花裏宿，人從無影月中歸。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-82", "next": "796-84"}, "p84": {"key": "796-84", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["輕著凍痕銷水面，密隨和氣入花根。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-83", "next": "796-85"}, "p85": {"key": "796-85", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["萬木盡如花落候，四簷鳴<span class=\"lacuna\" title=\"底本阙字\">□</span>雨來時。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-84", "next": "796-86"}, "p86": {"key": "796-86", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["濃綠萬枝紅一點，動人春色不須多。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-85", "next": "796-87"}, "p87": {"key": "796-87", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["晚菘細切肥牛肚，新筍初嘗嫩馬蹄。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-86", "next": "796-88"}, "p88": {"key": "796-88", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["蟬離楚樹鳴猶少，葉到嵩山落更多。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-87", "next": "796-89"}, "p89": {"key": "796-89", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["風和日暖方開眼，雨潤煙濃不舉頭。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-88", "next": "796-90"}, "p90": {"key": "796-90", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["窗前閑詠鴛鴦句，壁上時觀獬廌圖。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-89", "next": "796-91"}, "p91": {"key": "796-91", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["可能有事關心後，得似無人識面時。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-90", "next": "796-92"}, "p92": {"key": "796-92", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["一點孤燈人夢覺，萬重寒葉雨聲多。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-91", "next": "796-93"}, "p93": {"key": "796-93", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["此心只待相逢說，時複登樓看遠山。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-92", "next": "796-94"}, "p94": {"key": "796-94", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E4%B9%9D%E6%B1%9F.html\">九江</a>有浪船難濟，三峽無猿客有愁。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-93", "next": "796-95"}, "p95": {"key": "796-95", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["四海魚龍精魄冷，五山鸞鳳骨毛寒。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-94", "next": "796-96"}, "p96": {"key": "796-96", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["誰家綠酒歡留客，何處紅樓睡失明。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-95", "next": "796-97"}, "p97": {"key": "796-97", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["雨露施恩無厚薄，蓬蒿隨分有枯榮。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-96", "next": "796-98"}, "p98": {"key": "796-98", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["去年花下留連飲，暖日夭桃鶯亂啼。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-97", "next": "796-99"}, "p99": {"key": "796-99", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["今日江邊容易別，淡煙衰草馬頻嘶。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-98", "next": "796-100"}, "p100": {"key": "796-100", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["蛇蠍性靈生便毒，蕙蘭根異死猶香。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-99", "next": "796-101"}, "p101": {"key": "796-101", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["三間茅屋無人到，十裏松門獨自遊。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-100", "next": "796-102"}, "p102": {"key": "796-102", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["翻憶舊山青碧裏，繞庵閑伴野僧禪。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-101", "next": "796-103"}, "p103": {"key": "796-103", "title": "句", "author": "無名氏", "canonical": "無名氏", "lines": ["不甘五等諸侯薦，直肯九重天子知。"], "form": "七言古體", "t300": null, "src": "yuding", "prev": "796-102", "next": null}}}