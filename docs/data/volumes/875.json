{"vol_name": "卷八百七十五", "poems": {"p01": {"key": "875-01", "title": "唐受命讖", "author": "不詳", "canonical": "不詳", "lines": ["法律存，道德在，白旗天子出<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%9C%E6%B5%B7.html\">東海</a>。", "桃李子，莫浪語。", "黃鵠繞山飛，宛轉花園裏。", "桃花園，宛轉屬旌幡。", "桃李子，鴻鵠繞陽山，宛轉花林裏。", "莫浪語，誰道許。", "桃李子，洪水繞楊山。", "<a class=\"ent ent-place\" href=\"../entities/place_%E6%B1%9F%E5%8D%97.html\">江南</a>楊柳樹，江北李花榮。", "楊柳飛緜何處去，李花結果自然成。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": null, "next": "875-02"}, "p02": {"key": "875-02", "title": "勸進疏引讖", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%9C%E6%B5%B7.html\">東海</a>十八子，八井喚三軍。", "手持雙白雀，頭上戴紫雲。", "丁丑語甲子，深藏八堂裏。", "何意坐堂裏，中央有天子。", "西北天火照，龍山昭童子，赤光連北斗。", "童子木上懸白幡，胡兵紛紛滿前後。", "拍手唱堂堂，驅羊向南走。", "胡兵未濟漢不整，治<a class=\"ent ent-place\" href=\"../entities/place_%E4%B8%AD%E9%83%BD.html\">中都</a>護有八井。", "興伍伍，仁義行武。", "得九九，得聲名。", "童子木底百丈水，東家井裏五色星。", "我語不可信，問取衛先生。", "戌亥君臣亂，子丑破城隍。", "寅卯如欲定，龍蛇伏四方。", "十八成男子，洪水主刀傍。", "市朝義歸政，人寧俱不荒。", "人言有恆性，也復道非常。", "爲君好思量，何<span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span>禹湯。", "桃源花<span class=\"lacuna\" title=\"底本阙字\">□</span><span class=\"lacuna\" title=\"底本阙字\">□</span>，李樹起堂堂。", "只看寅卯歲，深水沒黃楊。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-01", "next": "875-03"}, "p03": {"key": "875-03", "title": "符鳳引讖", "author": "不詳", "canonical": "不詳", "lines": ["黑衣神孫披天裳。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-02", "next": "875-04"}, "p04": {"key": "875-04", "title": "安祿山古讖", "author": "不詳", "canonical": "不詳", "lines": ["兩角女子綠衣裳，端坐太行邀君王，一止之月必消亡。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-03", "next": "875-05"}, "p05": {"key": "875-05", "title": "普滿題潞州佛舍", "author": "不詳", "canonical": "不詳", "lines": ["此水連涇水，雙珠血滿川。", "青牛將赤虎，還號太平年。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-04", "next": "875-06"}, "p06": {"key": "875-06", "title": "南省北街人吟", "author": "不詳", "canonical": "不詳", "lines": ["放榜只應三月暮，登科又校一年遲。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-05", "next": "875-07"}, "p07": {"key": "875-07", "title": "盧求榜讖", "author": "不詳", "canonical": "不詳", "lines": ["裴頭黃尾，三求六李。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-06", "next": "875-08"}, "p08": {"key": "875-08", "title": "清僧示趙宗儒", "author": "不詳", "canonical": "不詳", "lines": ["梨花發後杏花初，甸邑南來慶有餘。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-07", "next": "875-09"}, "p09": {"key": "875-09", "title": "又示段文昌", "author": "不詳", "canonical": "不詳", "lines": ["去日既逢梅蕊綻，來時應見杏花開。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-08", "next": "875-10"}, "p10": {"key": "875-10", "title": "洛城五鳳樓中歌", "author": "不詳", "canonical": "不詳", "lines": ["天津橋畔火光起，<a class=\"ent ent-person\" href=\"../entities/person_%E9%AD%8F%E7%8E%8B.html\">魏王</a>堤上看洪水。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-09", "next": "875-11"}, "p11": {"key": "875-11", "title": "延和閣詩", "author": "不詳", "canonical": "不詳", "lines": ["延和高閣上幹雲，小語猶疑太乙聞。", "燒盡降真無一事，開門迎得畢將軍。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-10", "next": "875-12"}, "p12": {"key": "875-12", "title": "唐舊讖", "author": "不詳", "canonical": "不詳", "lines": ["兔子上金床。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-11", "next": "875-13"}, "p13": {"key": "875-13", "title": "越中狂生題旗亭", "author": "不詳", "canonical": "不詳", "lines": ["日日草重生，悠悠傍素城。", "諸侯逐兔白，夏滿鏡湖平。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-12", "next": "875-14"}, "p14": {"key": "875-14", "title": "清泰三年歌", "author": "不詳", "canonical": "不詳", "lines": ["丙申年，數在五樓前。", "但看八九月，胡虜亂中原。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-13", "next": "875-15"}, "p15": {"key": "875-15", "title": "蜀王氏讖文", "author": "不詳", "canonical": "不詳", "lines": ["李祜西王逢吉昌，上德兌興丹莫當。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-14", "next": "875-16"}, "p16": {"key": "875-16", "title": "黃萬祜題蜀宮壁", "author": "不詳", "canonical": "不詳", "lines": ["莫交牽動青豬足，動即炎炎不可撲。", "鷙獸不欲兩頭黃，黃即其年天下哭。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-15", "next": "875-17"}, "p17": {"key": "875-17", "title": "孟蜀丐者語", "author": "不詳", "canonical": "不詳", "lines": ["不得登，登便倒。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-16", "next": "875-18"}, "p18": {"key": "875-18", "title": "孟蜀桃符詩", "author": "不詳", "canonical": "不詳", "lines": ["新年納餘慶，嘉節號長春。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-17", "next": "875-19"}, "p19": {"key": "875-19", "title": "上藍和尚晉漢二代讖", "author": "不詳", "canonical": "不詳", "lines": ["石榴花發石榴開。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-18", "next": "875-20"}, "p20": {"key": "875-20", "title": "又遺鐘傳偈", "author": "不詳", "canonical": "不詳", "lines": ["但看來年二三月，柳條堪作打鐘槌。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-19", "next": "875-21"}, "p21": {"key": "875-21", "title": "又報王審知十字讖", "author": "不詳", "canonical": "不詳", "lines": ["不怕羊入屋，只怕錢入腹。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-20", "next": "875-22"}, "p22": {"key": "875-22", "title": "錢處士李氏讖", "author": "不詳", "canonical": "不詳", "lines": ["仿佛之間一倍楊。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-21", "next": "875-23"}, "p23": {"key": "875-23", "title": "孫咸題廬山神廟詩", "author": "不詳", "canonical": "不詳", "lines": ["獨入玄宮禮至真，焚香不爲賤貧身。", "秦淮兩岸沙埋骨，湓浦千家血染塵。", "廬阜煙霞誰是主，虎溪風月屬何人。", "<a class=\"ent ent-place\" href=\"../entities/place_%E4%B9%9D%E6%B1%9F.html\">九江</a>太守勤王室，好放天兵渡要津。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-22", "next": "875-24"}, "p24": {"key": "875-24", "title": "南唐江州風墜詩", "author": "不詳", "canonical": "不詳", "lines": ["由來秉節世無雙，獨守孤城死不降。", "何似知機早回首，免教流血滿長江。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-23", "next": "875-25"}, "p25": {"key": "875-25", "title": "杭州還鄉和尚唱", "author": "不詳", "canonical": "不詳", "lines": ["還鄉寂寂杳無蹤，不掛征帆水陸通。", "蹋得故鄉回地穩，更無南北與西東。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-24", "next": "875-26"}, "p26": {"key": "875-26", "title": "福州記", "author": "不詳", "canonical": "不詳", "lines": ["潮水來，岩頭沒。", "潮水去，矢口出。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-25", "next": "875-27"}, "p27": {"key": "875-27", "title": "黃涅盤讖", "author": "不詳", "canonical": "不詳", "lines": ["先打南，後打北，留取清源作佛國。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-26", "next": "875-28"}, "p28": {"key": "875-28", "title": "陳智廣讖", "author": "不詳", "canonical": "不詳", "lines": ["騎馬來，騎馬去。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-27", "next": "875-29"}, "p29": {"key": "875-29", "title": "又讖", "author": "不詳", "canonical": "不詳", "lines": ["功下田，力交連。", "井底坐，二十年。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-28", "next": "875-30"}, "p30": {"key": "875-30", "title": "僧緘示王處厚", "author": "不詳", "canonical": "不詳", "lines": ["周士同成，二王殊名。", "王居一焉，百日為程。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-29", "next": "875-31"}, "p31": {"key": "875-31", "title": "任叟書授劉生", "author": "不詳", "canonical": "不詳", "lines": ["承欲往梁宋，梁宋災方重，旦夕為人訟。", "承欲訪鄭生，鄭生將有厄。", "即為千里客，兼亦變衫色。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-30", "next": "875-32"}, "p32": {"key": "875-32", "title": "昌明裏中讖", "author": "不詳", "canonical": "不詳", "lines": ["欲知修續者，腳下是生毛。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-31", "next": "875-33"}, "p33": {"key": "875-33", "title": "宋善威詩", "author": "不詳", "canonical": "不詳", "lines": ["月落三株樹，日映九重天。", "良夜歡宴罷，暫別庚申年。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-32", "next": "875-34"}, "p34": {"key": "875-34", "title": "田承嗣誑李寶臣偽讖", "author": "不詳", "canonical": "不詳", "lines": ["二帝同功勢萬全，將田作伴入幽燕。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-33", "next": "875-35"}, "p35": {"key": "875-35", "title": "皮日休造黃巢讖", "author": "不詳", "canonical": "不詳", "lines": ["欲知聖人姓，田八二十一。", "欲知聖人名，果頭三屈律。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-34", "next": "875-36"}, "p36": {"key": "875-36", "title": "附：上元初嵩山石記", "author": "不詳", "canonical": "不詳", "lines": ["木子當天下。", "止戈龍。", "李代代不移宗。", "中鼎顯真容。", "基千萬歲。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-35", "next": "875-37"}, "p37": {"key": "875-37", "title": "上陽銅器篆", "author": "不詳", "canonical": "不詳", "lines": ["長宜子孫。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-36", "next": "875-38"}, "p38": {"key": "875-38", "title": "永安渠石銘", "author": "不詳", "canonical": "不詳", "lines": ["百年為市後為池。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-37", "next": "875-39"}, "p39": {"key": "875-39", "title": "漳泉分地神篆", "author": "不詳", "canonical": "不詳", "lines": ["漳泉兩州，分地太平。", "永安龍溪，山高氣清。", "千年不惑，萬古作程。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-38", "next": "875-40"}, "p40": {"key": "875-40", "title": "含元殿丹石隱語", "author": "不詳", "canonical": "不詳", "lines": ["天漢二年，赤光生栗。", "木下有子，傷心遇酷。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-39", "next": "875-41"}, "p41": {"key": "875-41", "title": "長安空宅銘篆", "author": "不詳", "canonical": "不詳", "lines": ["夏天子紫金三十斤，賜有德者。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-40", "next": "875-42"}, "p42": {"key": "875-42", "title": "莆田石記", "author": "不詳", "canonical": "不詳", "lines": ["石敢當，鎮百鬼，壓災殃。", "官吏福，百姓康。", "風教盛，禮樂昌。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-41", "next": "875-43"}, "p43": {"key": "875-43", "title": "符離樹穴中石篆", "author": "不詳", "canonical": "不詳", "lines": ["旁有水，上有道，八百年中逢栲栳。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-42", "next": "875-44"}, "p44": {"key": "875-44", "title": "淮西池濠石銘", "author": "不詳", "canonical": "不詳", "lines": ["井底一竿竹，竹色深綠綠。", "雞未肥，酒未熟，障車兒郎且須縮。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-43", "next": "875-45"}, "p45": {"key": "875-45", "title": "羅池石刻", "author": "不詳", "canonical": "不詳", "lines": ["龍城柳，神所守。", "驅厲鬼，山左首。", "福土氓，制九醜。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-44", "next": "875-46"}, "p46": {"key": "875-46", "title": "道者遺記", "author": "不詳", "canonical": "不詳", "lines": ["武之在卯，堯王八季。", "我棄其寢，我去其扆。", "深深然，高高然。", "人不吾知，又不吾謂。", "由今之後，二百餘祀。", "燄燄其光，和和其始。", "東方有兔，小首元尾。", "經過吾道，來至吾里。", "飲吾泉以醉，登吾榻而寐。", "刻乎其壁，奧乎其義。", "人誰以辨，其東平子。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-45", "next": "875-47"}, "p47": {"key": "875-47", "title": "王璠石銘", "author": "不詳", "canonical": "不詳", "lines": ["山有石，石有玉。", "玉有瑕，即休也。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-46", "next": "875-48"}, "p48": {"key": "875-48", "title": "玄元觀棟桁記", "author": "不詳", "canonical": "不詳", "lines": ["山水誰無言，元年有福重修。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-47", "next": "875-49"}, "p49": {"key": "875-49", "title": "天臺觀石簡記", "author": "不詳", "canonical": "不詳", "lines": ["海水竭，臺山缺，皇家寶祚無休歇。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-48", "next": "875-50"}, "p50": {"key": "875-50", "title": "成都羅城北門石記", "author": "不詳", "canonical": "不詳", "lines": ["五五複五五，五五逾重數。", "浮世若浮雲，金石一如故。", "與君相見時，杳杳非今土。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-49", "next": "875-51"}, "p51": {"key": "875-51", "title": "青羊宮磚記", "author": "不詳", "canonical": "不詳", "lines": ["太平平<a class=\"ent ent-time\" href=\"../entities/time_%E4%B8%AD%E5%85%83.html\">中元</a>災。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-50", "next": "875-52"}, "p52": {"key": "875-52", "title": "銅雀台玉板篆", "author": "不詳", "canonical": "不詳", "lines": ["上土巴灰除虛除，<a class=\"ent ent-person\" href=\"../entities/person_%E4%BC%8A%E5%B0%B9.html\">伊尹</a>東北八九餘。", "秦趙多應分五玉，絲竹木子世世居。", "但看六六百中外，世主難留如國如。"], "form": "七言古體", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-51", "next": "875-53"}, "p53": {"key": "875-53", "title": "顯德道宮石記", "author": "不詳", "canonical": "不詳", "lines": ["瑞雲靈跡鎮梁東，他日多應與古同。", "歲月遷移人事改，再來閑處又興功。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-52", "next": "875-54"}, "p54": {"key": "875-54", "title": "南唐升元殿基下石記", "author": "不詳", "canonical": "不詳", "lines": ["莫問<a class=\"ent ent-place\" href=\"../entities/place_%E6%B1%9F%E5%8D%97.html\">江南</a>事，<a class=\"ent ent-place\" href=\"../entities/place_%E6%B1%9F%E5%8D%97.html\">江南</a>事可憑。", "抱雞升寶位，跨犬出<a class=\"ent ent-place\" href=\"../entities/place_%E9%87%91%E9%99%B5.html\">金陵</a>。", "子建司南位，安仁秉夜燈。", "東鄰嬌小女，騎虎渡河冰。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "875-53", "next": "875-55"}, "p55": {"key": "875-55", "title": "馬殷浚城石碣篆", "author": "不詳", "canonical": "不詳", "lines": ["龍舉頭，猳掉尾。", "羊為兄，猴作弟。", "羊歸穴，猴離次。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-54", "next": "875-56"}, "p56": {"key": "875-56", "title": "王霸仙壇磚刻", "author": "不詳", "canonical": "不詳", "lines": ["樹枯不用伐，壇壞不須結。", "未滿一千歲，自有系孫列。", "後來是三皇，潮水蕩禍殃。", "岩逢二乍間，未免有消亡。", "子孫依吾道，代代封閩疆。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "875-55", "next": "875-57"}, "p57": {"key": "875-57", "title": "劉龑石讖", "author": "不詳", "canonical": "不詳", "lines": ["人人有一，山山值牛。", "兔絲吞骨，蓋海承劉。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-56", "next": "875-58"}, "p58": {"key": "875-58", "title": "南漢羅浮古劍篆文", "author": "不詳", "canonical": "不詳", "lines": ["丁與水同宮，王將耳口同。", "尹來居口上，山岫獲重重。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-57", "next": "875-59"}, "p59": {"key": "875-59", "title": "司馬承禎含象鑒文", "author": "不詳", "canonical": "不詳", "lines": ["天地含象，日月貞明。", "寫規萬物，洞鑒百靈。", "龜自卜，鏡自照。", "吉可募，光不曜。", "青蓋作鏡大吉昌，巧工刊之成文章。", "左龍右虎辟不祥，朱鳥玄武順於旁，子孫富貴居中央。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-58", "next": "875-60"}, "p60": {"key": "875-60", "title": "景震劍文", "author": "不詳", "canonical": "不詳", "lines": ["撝雷電，運玄星。", "摧兇惡，亨利貞。", "幹降精，坤應靈。", "日月象，嶽瀆形。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-59", "next": "875-61"}, "p61": {"key": "875-61", "title": "高麗鏡文", "author": "不詳", "canonical": "不詳", "lines": ["三水中，四維下，上帝降子于辰馬。", "先操雞，後搏鴨。", "己年中，二龍見。", "一則藏身青木中，一則見形黑金東。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-60", "next": "875-62"}, "p62": {"key": "875-62", "title": "京西市放生池墓銘", "author": "不詳", "canonical": "不詳", "lines": ["龜言市，蓍言水。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-61", "next": "875-63"}, "p63": {"key": "875-63", "title": "古墓蔔地詞", "author": "不詳", "canonical": "不詳", "lines": ["爾後一千歲，此地化為泉。", "賴逢鄔侍禦，移我向高原。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-62", "next": "875-64"}, "p64": {"key": "875-64", "title": "衛先生墓銘", "author": "不詳", "canonical": "不詳", "lines": ["姜師度，更移向南三五步。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-63", "next": "875-65"}, "p65": {"key": "875-65", "title": "隱者瘞男銘", "author": "不詳", "canonical": "不詳", "lines": ["神真煉形年未足，化為我子功相續。", "丞相瘞之刻玄玉，仙路何長死何促。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-64", "next": "875-66"}, "p66": {"key": "875-66", "title": "烏氏葬碑", "author": "不詳", "canonical": "不詳", "lines": ["牛領岡頭，紅簫籠下。", "葬用兩日，手板相亞。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-65", "next": "875-67"}, "p67": {"key": "875-67", "title": "岩腹棺銘", "author": "不詳", "canonical": "不詳", "lines": ["欲墮不墮逢王果，五百年中重收我。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-66", "next": "875-68"}, "p68": {"key": "875-68", "title": "古棺石銘", "author": "不詳", "canonical": "不詳", "lines": ["欲陷不陷被藤縛，欲落不落被沙閣，五百年後遇熊博。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "875-67", "next": "875-69"}, "p69": {"key": "875-69", "title": "漣水古塚瓶文", "author": "不詳", "canonical": "不詳", "lines": ["一雙青烏子，飛來五兩頭。", "借問船輕重，寄信到<a class=\"ent ent-place\" href=\"../entities/place_%E6%89%AC%E5%B7%9E.html\">揚州</a>。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-68", "next": "875-70"}, "p70": {"key": "875-70", "title": "沈彬壙篆", "author": "不詳", "canonical": "不詳", "lines": ["佳城今已開，雖開不葬埋。", "漆燈猶未滅，留待沈彬來。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "875-69", "next": "875-71"}, "p71": {"key": "875-71", "title": "廣陵古塚石刻", "author": "不詳", "canonical": "不詳", "lines": ["日爲箭兮月爲弓，四時躬人兮無窮。", "但得天將明月死，不覺人隨流水空。", "山川秀兮碧穹窿，崇夫人墓兮直其中。", "猨啼鳥嘯煙濛濛，千年萬年松柏風。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-70", "next": "875-72"}, "p72": {"key": "875-72", "title": "王承檢掘得墓銘", "author": "不詳", "canonical": "不詳", "lines": ["車道之北，邽山之陽。", "深深葬玉，鬱鬱埋香。", "刻斯貞石，煥乎遺芳。", "地變陵谷，嶮列城隍。", "乾德丙年，壞者合郎。"], "form": "四言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "875-71", "next": "875-73"}, "p73": {"key": "875-73", "title": "馬希振葬地碣", "author": "不詳", "canonical": "不詳", "lines": ["亂石之壤，絕世之岡。", "谷變庚戌，馬氏無王。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "875-72", "next": null}}}