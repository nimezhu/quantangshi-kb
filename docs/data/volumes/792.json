{"vol_name": "卷七百九十二", "poems": {"p01": {"key": "792-01", "title": "妓席與杜牧之同詠", "author": "張祜", "canonical": "張祜", "lines": ["骰子逡巡裹手拈，無因得見玉纖纖。", "<span class=\"lianju-author\" title=\"联句作者\">杜牧</span>", "但知報導金釵落，仿佛還應露指尖。", "<span class=\"lianju-author\" title=\"联句作者\">張祜</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": null, "next": "792-02"}, "p02": {"key": "792-02", "title": "同趙二十二訪張明府郊居聯句", "author": "杜牧", "canonical": "杜牧", "lines": ["陶潛官罷酒瓶空，門掩楊花一夜風。", "<span class=\"lianju-author\" title=\"联句作者\">杜牧</span>", "古調詩吟山色裏，無弦琴在月明中。", "<span class=\"lianju-author\" title=\"联句作者\">趙嘏</span>", "遠簷高樹宜幽鳥，出岫孤雲逐晚虹。", "<span class=\"lianju-author\" title=\"联句作者\">杜牧</span>", "別後東籬數枝菊，不知閑醉與誰同。", "<span class=\"lianju-author\" title=\"联句作者\">趙嘏</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-01", "next": "792-03"}, "p03": {"key": "792-03", "title": "游長安諸寺聯句：靖恭坊大興善寺：老松青桐聯二…絕句", "author": "段成式", "canonical": "段成式", "lines": ["有松堪系馬，遇缽更投針。", "記得湯師句，高禪助朗吟。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "乘晴入精舍，語默想東林。", "儘是忘機侶，誰驚息影禽。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "一雨微塵盡，支郎許數過。", "方同嗅薝蔔，不用算多羅。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-02", "next": "792-04"}, "p04": {"key": "792-04", "title": "游長安諸寺聯句：靖恭坊大興善寺：蛤像聯二十字絕句", "author": "段成式", "canonical": "段成式", "lines": ["相好全如梵，端倪只為隋。", "寧同蚌頑惡，但與鷸相持。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "雖因雀變化，不逐月虧盈。", "縱有天中匠，神工詎可成。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-03", "next": "792-05"}, "p05": {"key": "792-05", "title": "游長安諸寺聯句：靖恭坊大興善寺：聖柱聯句", "author": "段成式", "canonical": "段成式", "lines": ["天心惟助善，聖跡此開陽。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "載恐雷輪重，縆疑電索長。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "上沖挾螮蝀，不動束鋃鐺。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "饑鳥未曾啄，乖龍甯敢藏。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-04", "next": "792-06"}, "p06": {"key": "792-06", "title": "游長安諸寺聯句：長樂坊安國寺：紅樓聯句", "author": "段成式", "canonical": "段成式", "lines": ["重疊碎晴空，餘霞更照紅。", "蟬蹤近鳷鵲，鳥道接相風。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "苔靜金輪路，雲輕白日宮。", "壁詩傳謝客，門榜占休公。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-05", "next": "792-07"}, "p07": {"key": "792-07", "title": "游長安諸寺聯句：長樂坊安國寺：穗柏聯句", "author": "段成式", "canonical": "段成式", "lines": ["一院暑難侵，莓苔共影深。", "標枝爭息鳥，餘吹正開襟。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "宿雨香添色，殘陽石在陰。", "乘閑動詩意，助靜入禪心。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-06", "next": "792-08"}, "p08": {"key": "792-08", "title": "游長安諸寺聯句：長樂坊安國寺：題璘公院", "author": "段成式", "canonical": "段成式", "lines": ["靜，虛。", "熱際，安居。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "龕燈斂，印香除。", "東林賓客，西澗圖書。", "簷外垂青豆，<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "經中發白蕖。", "縱辯宗因袞袞，忘言理事如如。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "泉台定將入流否，鄰笛足疑清梵餘。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-07", "next": "792-09"}, "p09": {"key": "792-09", "title": "游長安諸寺聯句：常樂坊趙景公寺：吳畫聯句", "author": "段成式", "canonical": "段成式", "lines": ["慘澹十堵內，吳生縱狂跡。", "風雲將逼人，神鬼如脫壁。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "其中龍最怪，張甲方汗栗。", "黑雲夜窸窣，焉知不霹靂。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "此際忽仙子，獵獵衣舄奕。", "妙瞬乍疑生，參差奪人魄。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "往往乘猛虎，沖梁聳奇石。", "蒼峭束高泉，角膝驚欹側。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "冥獄不可視，毛戴腋流液。", "苟能水成河，刹那沈火宅。", "<span class=\"lianju-author\" title=\"联句作者\">升上人</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-08", "next": "792-10"}, "p10": {"key": "792-10", "title": "游長安諸寺聯句：常樂坊趙景公寺：題約公院", "author": "段成式", "canonical": "段成式", "lines": ["印火熒熒，燈續焰青。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "七俱胝咒，四阿含經。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "各錄佳語，聊事素屏。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "丈室安居，延賓不扃。", "<span class=\"lianju-author\" title=\"联句作者\">升上人</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-09", "next": "792-11"}, "p11": {"key": "792-11", "title": "游長安諸寺聯句：大同坊雲華寺：偶聯句", "author": "段成式", "canonical": "段成式", "lines": ["共入夕陽寺，因窺甘露門。", "<span class=\"lianju-author\" title=\"联句作者\">升上人</span>", "清香惹苔蘚，忍草雜蘭蓀。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "捷偈飛鉗答，新詩倚仗論。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "壞幡標古刹，聖畫煥崇垣。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "豈慕穿籠鳥，難防在牖猿。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "一音唯一性，三語更三幡。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-10", "next": "792-12"}, "p12": {"key": "792-12", "title": "游長安諸寺聯句：道政坊寶應寺：僧房聯句", "author": "段成式", "canonical": "段成式", "lines": ["古畫思匡嶺，上方疑傅岩。", "蝶閑移忍草，蟬曉揭高杉。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "香字消芝印，金經發茝函。", "井通松底脈，書坼洞中緘。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-11", "next": "792-13"}, "p13": {"key": "792-13", "title": "游長安諸寺聯句：道政坊寶應寺：小小寫真聯句", "author": "段成式", "canonical": "段成式", "lines": ["如生小小真，猶自未棲塵。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "褕袂將離座，斜柯欲近人。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "昔時知出眾，情寵占橫陳。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "不遣游張巷，豈教窺宋鄰。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "庾樓吹笛裂，弘閣賞歌新。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "蟬怯纖腰步，蛾驚半額嚬。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "圖形誰有術，買笑詎辭貧。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "複隴迷村徑，重泉隔漢津。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "同心知作羽，比目定為鱗。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "殘月巫山夕，餘霞洛浦晨。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-12", "next": "792-14"}, "p14": {"key": "792-14", "title": "游長安諸寺聯句：平康坊菩薩寺：書事聯句", "author": "段成式", "canonical": "段成式", "lines": ["悉為無事者，任被俗流憎。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "客異幹時客，僧非出院僧。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "遠聞疏牖磬，曉辨密龕燈。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "步觸珠幡響，吟窺缽水澄。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "句饒方外趣，遊愜社中朋。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "靜裏已馴鴿，齋中亦好鷹。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "金塗筆是褧，彩溜紙非繒。", "<span class=\"lianju-author\" title=\"联句作者\">升上人</span>", "錫杖已克鍛，田衣從懷塍。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "占床暫一脅，卷箔賴長肱。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "佛日初開照，魔天破幾層。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "咒中陳秘計，論處正先登。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "勇帶綻針石，危防丘井藤。", "<span class=\"lianju-author\" title=\"联句作者\">升上人</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-13", "next": "792-15"}, "p15": {"key": "792-15", "title": "游長安諸寺聯句：光宅坊光宅寺：中禪師影堂聯句", "author": "段成式", "canonical": "段成式", "lines": ["名下固無虛，敖曹貌嚴毅。", "洞達見空王，圓融入佛地。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "一言當要害，忽忽醒諸醉。", "不動須彌山，多方辯無匱。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "坦率對萬乘，偈答無所避。", "爾如毗沙門，外形如脫履。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "但以理為量，不語怪力事。", "木石摧貢高，慈悲引貪恚。", "<span class=\"lianju-author\" title=\"联句作者\">升上人</span>", "當時乏支許，何人契深致。", "隨宜詎說三，直下開不二。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-14", "next": "792-16"}, "p16": {"key": "792-16", "title": "游長安諸寺聯句：翊善坊保壽寺：光天幀贊聯句", "author": "段成式", "canonical": "段成式", "lines": ["觀音化身，厥形孔怪。", "胣腦淫厲，眾魔膜拜。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "指夢鴻紛，榜列區界。", "其事明張，何不可解。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "閻阿德川，大士<a class=\"ent ent-time\" href=\"../entities/time_%E5%85%88%E5%A4%A9.html\">先天</a>。", "眾象參羅，福源田田。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "百億花發，百千燈然。", "膠如絡繹，浩汗連綿。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "焰摩界戚，洛迦苦霽。", "正念皈依，眾青如彗。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "戾宰可汰，癡膜可蛻。", "稽首如空，睟容若睇。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "闡提墨師，睹而面之。", "寸念不生，未遇乎而。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-15", "next": "792-17"}, "p17": {"key": "792-17", "title": "游長安諸寺聯句：宣陽坊靜域寺：三階院聯句", "author": "段成式", "canonical": "段成式", "lines": ["密密助堂堂，隋人歌檿桑。", "雙弧摧孔雀，一矢隕貪狼。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "百步望雲立，九規看月張。", "獲蛟徒破浪，中乙漫如牆。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "還似貫金鼓，更疑穿石樑。", "因添挽河力，為滅射天狂。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "絕藝卻南牧，英聲來鬼方。", "麗龜何足敵，殪豕未為長。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "龍臂勝猿臂，星芒超箭芒。", "虛誇絕高鳥，<a class=\"ent ent-time\" href=\"../entities/time_%E5%9E%82%E6%8B%B1.html\">垂拱</a>議明堂。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-16", "next": "792-18"}, "p18": {"key": "792-18", "title": "游長安諸寺聯句：崇義坊招福院：贈諸上人聯句", "author": "段成式", "canonical": "段成式", "lines": ["翻了西天偈，燒餘梵宇香。", "撚眉愁俗客，支頰背殘陽。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "洲號惟思沃，山名只記匡。", "辨中摧世智，定裏破魔強。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "許睿禪心徹，湯休詩思長。", "朗吟疏磬斷，久語貫珠妨。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "乘興書芭葉，閑來入豆房。", "漫題存古壁，怪畫匝長廊。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-17", "next": "792-19"}, "p19": {"key": "792-19", "title": "游長安諸寺聯句：招國坊崇濟寺：奇松聯二十字絕句", "author": "段成式", "canonical": "段成式", "lines": ["杉松何相疏，榆柳方迥屑。", "無人擅談柄，一枝不敢折。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "中庭苔蘚深，吹餘鳴佛禽。", "至於摧折枝，凡草猶避陰。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "僻徑根從露，閒房枝任侵。", "一株風正好，來助碧雲吟。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "時時掃窗聲，重露滴寒砌。", "風颭一枝遒，閑窺別生勢。", "<span class=\"lianju-author\" title=\"联句作者\">升上人</span>", "偃蓋入樓妨，盤根侵井窄。", "高僧獨惆悵，為與澄嵐隔。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-18", "next": "792-20"}, "p20": {"key": "792-20", "title": "游長安諸寺聯句：永安坊永壽寺：閑中好", "author": "段成式", "canonical": "段成式", "lines": ["閑中好，盡日松為侶。", "此趣人不知，輕風度僧語。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "閑中好，塵務不縈心。", "坐對當窗木，看移三面陰。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "閑中好，幽磬度聲遲。", "卷上論題肇，畫中僧姓支。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-19", "next": "792-21"}, "p21": {"key": "792-21", "title": "游長安諸寺聯句：崇仁坊資聖寺：諸畫聯句", "author": "段成式", "canonical": "段成式", "lines": ["吳生畫勇矛戟攢，<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "出變奇勢千萬端。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "蒼蒼鬼怪層壁寬，<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "睹之忽忽毛髮寒。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "棱伽之力所疲殫，<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "李真周昉優劣難。", "<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "活禽生卉推邊鸞，<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "花房嫩彩猶未幹。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>", "韓幹變態如激湍，<span class=\"lianju-author\" title=\"联句作者\">鄭符</span>", "惜哉壁畫世未殫。", "<span class=\"lianju-author\" title=\"联句作者\">段成式</span>", "後人新畫何汗漫。", "<span class=\"lianju-author\" title=\"联句作者\">張希複</span>"], "form": "雜言", "t300": null, "src": "yuding", "prev": "792-20", "next": null}}}