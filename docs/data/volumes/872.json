{"vol_name": "卷八百七十二", "poems": {"p01": {"key": "872-01", "title": "廣州三樵歌", "author": "無名氏", "canonical": "無名氏", "lines": ["奉敕追三樵，隨侯傍道走。", "回頭語李郎，喚取爾朱九。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "872-02"}, "p02": {"key": "872-02", "title": "三禦史詠", "author": "無名氏", "canonical": "無名氏", "lines": ["韋子凝而密，任生直且狂。", "可憐元福慶，也學坐凝床。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-01", "next": "872-03"}, "p03": {"key": "872-03", "title": "台中裏行詠", "author": "無名氏", "canonical": "無名氏", "lines": ["柱下雖為史，台中未是官。", "何時聞必也，早晚見任端。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-02", "next": "872-04"}, "p04": {"key": "872-04", "title": "譏裴休", "author": "無名氏", "canonical": "無名氏", "lines": ["趙氏兒皆尼氏女，師翁兒即晉公兒。", "卻教術士難推算，胎月分張與阿誰。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-03", "next": "872-05"}, "p05": {"key": "872-05", "title": "嘲四相", "author": "無名氏", "canonical": "無名氏", "lines": ["確確無餘事，錢財總被收。", "商人都不管，貨賂幾時休。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-04", "next": "872-06"}, "p06": {"key": "872-06", "title": "放榜詩", "author": "無名氏", "canonical": "無名氏", "lines": ["乞兒還有大通年，三十三人碗杖全。", "薛庶准前騎瘦馬，范酂依舊蓋番氈。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-05", "next": "872-07"}, "p07": {"key": "872-07", "title": "改魏扶詩", "author": "無名氏", "canonical": "無名氏", "lines": ["葉落滿庭陰，朱門試院深。", "昔年辛苦地，今日負前心。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-06", "next": "872-08"}, "p08": {"key": "872-08", "title": "嘲舉子騎驢", "author": "無名氏", "canonical": "無名氏", "lines": ["今年敕下盡騎驢，短軸長秋滿九衢。", "清瘦兒郎猶自可，就中愁殺鄭昌圖。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-07", "next": "872-09"}, "p09": {"key": "872-09", "title": "嘲崔垂休", "author": "無名氏", "canonical": "無名氏", "lines": ["慈恩塔下親泥壁，滑膩光華玉不如。", "何事博陵崔四十，<a class=\"ent ent-place\" href=\"../entities/place_%E9%87%91%E9%99%B5.html\">金陵</a>腿上逞歐書。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-08", "next": "872-10"}, "p10": {"key": "872-10", "title": "嘲主司崔澹", "author": "無名氏", "canonical": "無名氏", "lines": ["主司何事厭吾王，解把黃巢比<a class=\"ent ent-person\" href=\"../entities/person_%E6%AD%A6%E7%8E%8B.html\">武王</a>。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-09", "next": "872-11"}, "p11": {"key": "872-11", "title": "朝士戲任轂", "author": "無名氏", "canonical": "無名氏", "lines": ["雲林應訝鶴書遲，自入京來探事宜。", "從此見山須合眼，被山相賺已多時。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-10", "next": "872-12"}, "p12": {"key": "872-12", "title": "題房魯題名後", "author": "無名氏", "canonical": "無名氏", "lines": ["姚家新婿是房郎，未解芳顏意欲狂。", "見說正調穿羽箭，莫教射破寺家牆。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-11", "next": "872-13"}, "p13": {"key": "872-13", "title": "洛陽人嘲跋異", "author": "無名氏", "canonical": "無名氏", "lines": ["赫赫洛下，唯說異畫。", "張氏出頭，跋異無價。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "872-12", "next": "872-14"}, "p14": {"key": "872-14", "title": "又嘲", "author": "無名氏", "canonical": "無名氏", "lines": ["李生來，跋君怕。", "不意今日卻增價，不畫羅漢畫駝馬。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "872-13", "next": "872-15"}, "p15": {"key": "872-15", "title": "蜀選人嘲韓昭", "author": "無名氏", "canonical": "無名氏", "lines": ["嘉眉邛蜀，侍郎骨肉。", "導江青城，侍郎情親。", "果閬二州，侍郎自留。", "巴蓬集壁，侍郎不識。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "872-14", "next": "872-16"}, "p16": {"key": "872-16", "title": "嘲傴僂人", "author": "無名氏", "canonical": "無名氏", "lines": ["拄杖欲似乃，播笏還似及。", "逆風蕩雨行，面幹頂額濕。", "著衣床上坐，肚緩脊皮急。", "城門爾許高，故自匍匐入。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "872-15", "next": "872-17"}, "p17": {"key": "872-17", "title": "曲中唱語", "author": "無名氏", "canonical": "無名氏", "lines": ["張公吃酒李公顛，盛六生兒鄭九憐。", "捨下雄雞傷一德，南頭小鳳納三千。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-16", "next": "872-18"}, "p18": {"key": "872-18", "title": "改唱", "author": "無名氏", "canonical": "無名氏", "lines": ["張公吃酒李公顛，盛六生兒鄭九憐。", "捨下雄雞失一足，街頭小福拉三拳。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-17", "next": "872-19"}, "p19": {"key": "872-19", "title": "街中又唱", "author": "無名氏", "canonical": "無名氏", "lines": ["莫將龐大作荍團，龐大皮中的不幹。", "不怕鳳凰當額打，更將雞腳用筋纏。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "872-18", "next": "872-20"}, "p20": {"key": "872-20", "title": "吹火詩", "author": "無名氏", "canonical": "無名氏", "lines": ["吹火朱唇動，添薪玉腕斜。", "遙看煙裏面，大似霧中花。", "吹火青唇動，添薪黑腕斜。", "遙看煙裏面，恰似鳩盤荼。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "872-19", "next": "872-21"}, "p21": {"key": "872-21", "title": "劉黑闥解嘲人語", "author": "無名氏", "canonical": "無名氏", "lines": ["水惡，頭如鐮杓尾如鑿，河裏搦魚無僻錯。", "駱駝，項曲綠蹄，被他負物多。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "872-20", "next": "872-22"}, "p22": {"key": "872-22", "title": "村人學解嘲人語", "author": "無名氏", "canonical": "無名氏", "lines": ["綿絹，割兩耳，只有面。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "872-21", "next": "872-23"}, "p23": {"key": "872-23", "title": "嘲劉師老", "author": "無名氏", "canonical": "無名氏", "lines": ["大府朝天升穆老，尚書倒地落劉郎。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-22", "next": "872-24"}, "p24": {"key": "872-24", "title": "嘲鄭熏", "author": "無名氏", "canonical": "無名氏", "lines": ["主司頭腦太冬烘，錯認顏標作魯公。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-23", "next": "872-25"}, "p25": {"key": "872-25", "title": "嘲蔣蟠金丹", "author": "無名氏", "canonical": "無名氏", "lines": ["張鵠只消千馱絹，蔣蟠惟用一丸丹。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-24", "next": "872-26"}, "p26": {"key": "872-26", "title": "注苗張二進士題名", "author": "無名氏", "canonical": "無名氏", "lines": ["一雙前進士，兩個阿孩兒。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-25", "next": "872-27"}, "p27": {"key": "872-27", "title": "袁州人謔彭伉", "author": "無名氏", "canonical": "無名氏", "lines": ["湛賁及第，彭伉落驢。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "872-26", "next": "872-28"}, "p28": {"key": "872-28", "title": "洛中人語", "author": "無名氏", "canonical": "無名氏", "lines": ["昔婁師德園，今袁德師樓。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-27", "next": "872-29"}, "p29": {"key": "872-29", "title": "嘲毛炳、彭會", "author": "無名氏", "canonical": "無名氏", "lines": ["彭生作賦茶三片，毛氏傳詩酒半升。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-28", "next": "872-30"}, "p30": {"key": "872-30", "title": "右威衛嘲語", "author": "無名氏", "canonical": "無名氏", "lines": ["門緣禦史塞，廳被校書侵。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-29", "next": "872-31"}, "p31": {"key": "872-31", "title": "南唐伶人獻先主詞", "author": "無名氏", "canonical": "無名氏", "lines": ["惟願普天多瑞慶，柳條結絮鵝雙生。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-30", "next": "872-32"}, "p32": {"key": "872-32", "title": "閩伶官戲主延政語", "author": "無名氏", "canonical": "無名氏", "lines": ["只聞有泗州和尚，不見有五縣天子。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-31", "next": "872-33"}, "p33": {"key": "872-33", "title": "言志", "author": "無名氏", "canonical": "無名氏", "lines": ["腰纏十萬貫，騎鶴上<a class=\"ent ent-place\" href=\"../entities/place_%E6%89%AC%E5%B7%9E.html\">揚州</a>。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "872-32", "next": null}}}