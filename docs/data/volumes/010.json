{"vol_name": "卷一十", "poems": {"p01": {"key": "010-01", "title": "郊廟歌辭：祀圜丘樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["上靈眷命膺<a class=\"ent ent-time\" href=\"../entities/time_%E4%BC%9A%E6%98%8C.html\">會昌</a>，盛德殷薦葉辰良。", "<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E7%A6%8F.html\">景福</a>降兮聖德遠，玄化穆兮天曆長。"], "form": "七絕", "t300": null, "src": "yuding", "prev": null, "next": "010-02"}, "p02": {"key": "010-02", "title": "郊廟歌辭：祀圜丘樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["穆穆我後，道應千齡。", "登三處大，得一居貞。", "禮惟崇德，樂以和聲。", "百神仰止，天下文明。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-01", "next": "010-03"}, "p03": {"key": "010-03", "title": "郊廟歌辭：祀圜丘樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["闓陽播氣，甄曜垂明。", "有赫圜宰，深仁曲成。", "日麗蒼璧，煙開紫營。", "聿遵幹享，式降鴻禎。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-02", "next": "010-04"}, "p04": {"key": "010-04", "title": "郊廟歌辭：祀圜丘樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["欽惟大帝，載仰皇穹。", "始命田燭，爰啟郊宮。", "雲門駭聽，雷鼓鳴空。", "神其介祀，景祚斯融。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-03", "next": "010-05"}, "p05": {"key": "010-05", "title": "郊廟歌辭：祀圜丘樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["八音斯奏，三獻畢陳。", "寶祚惟永，暉光日新。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-04", "next": "010-06"}, "p06": {"key": "010-06", "title": "郊廟歌辭：祀圜丘樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["疊璧凝影皇壇路，編珠流彩帝郊前。", "已奏黃鐘歌大呂，還符<a class=\"ent ent-time\" href=\"../entities/time_%E5%AE%9D%E5%8E%86.html\">寶曆</a>祚昌年。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-05", "next": "010-07"}, "p07": {"key": "010-07", "title": "郊廟歌辭：祀圜丘樂章：凱安", "author": "不詳", "canonical": "不詳", "lines": ["昔在炎運終，中華亂無象。", "酆郊赤烏見，邙山黑雲上。", "大賚下周車，禁暴開殷網。", "幽明同葉贊，鼎祚齊天壤。"], "form": "五律", "t300": null, "src": "yuding", "prev": "010-06", "next": "010-08"}, "p08": {"key": "010-08", "title": "郊廟歌辭：祀圜丘樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["歌奏畢兮禮獻終，六龍馭兮神將升。", "明德感兮非黍稷，降福簡兮祚休征。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-07", "next": "010-09"}, "p09": {"key": "010-09", "title": "郊廟歌辭：郊天舊樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["蘋蘩禮著，黍稷誠微。", "音盈鳳管，彩駐龍旗。", "洪歆式就，介福攸歸。", "送樂有闋，靈馭遄飛。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-08", "next": "010-10"}, "p10": {"key": "010-10", "title": "郊廟歌辭：武后大享昊天樂章", "author": "不詳", "canonical": "不詳", "lines": ["大陰凝至化，真耀蘊軒儀。", "德邁娥臺敞，仁高姒幄披。", "捫天遂啓極，夢日乃昇曦。", "瞻紫極，望玄穹。", "翹至懇，罄深衷。", "聽雖遠，誠必通。", "垂厚澤，降雲宮。", "乾儀混成沖邃，天道下濟高明。", "闓陽晨披紫闕，太一曉降黃庭。", "圓壇敢[申]昭報，方璧冀展虔情。", "丹禁式敷衷懇，玄鑒庶察微誠。", "巍巍睿業廣，赫赫聖基隆。", "菲德承先顧，禎符萃眇躬。", "銘開武巖側，圖薦洛川中。", "微誠詎幽感，景命忽昭融。", "有懷慙紫極，無以謝玄穹。", "朝壇霧卷，曙嶺煙沈。", "爰設筐幣，式表誠心。", "筵輝麗璧，樂暢和音。", "仰惟靈鑒，俯察翹襟。", "昭昭上帝，穆穆下臨。", "禮崇備物，樂奏鏘金。", "蘭羞委薦，桂醑盈斟。", "敢希[明]德，聿罄莊心。", "樽浮九醞，禮備三周。", "陳誠菲奠，契福神猷。", "奠璧郊壇昭大禮，鏘金拊石表虔誠。", "始奏承雲娛帝賞，復歌調露暢韶英。", "荷恩承顧託，執契恭臨撫。", "廟畧靜邊荒，天兵耀神武。", "有截資先化，無爲遵舊矩。", "禎符降昊穹，大業光寰宇。", "肅肅祀典，邕邕禮秩。", "三獻已周，九成斯畢。", "爰撤其俎，載遷其實。", "或升或降，唯誠唯質。", "禮終肆類，樂闋九成。", "仰惟明德，敢薦非馨。", "顧慙菲奠，久駐雲軿。", "瞻荷靈澤，悚戀兼盈。", "式乾路，闢天扉。", "迴日馭，動雲衣。", "登金闕，入紫微。", "望仙駕，仰恩徽。"], "form": "雜言", "t300": null, "src": "poet.tang", "prev": "010-09", "next": "010-11"}, "p11": {"key": "010-11", "title": "中宗祀昊天樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["天之歷數歸睿唐，顧惟菲德欽昊蒼。", "撰吉日兮表殷薦，冀神鑒兮降闓陽。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-10", "next": "010-12"}, "p12": {"key": "010-12", "title": "中宗祀昊天樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["恭臨寶位，肅奉瑤圖。", "恒思解網，每軫泣辜。", "德慚巢燧，化劣唐虞。", "期我良弼，式贊嘉謨。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-11", "next": "010-13"}, "p13": {"key": "010-13", "title": "中宗祀昊天樂章：告謝", "author": "不詳", "canonical": "不詳", "lines": ["得一流玄澤，通三禦紫宸。", "遠葉千齡運，遐銷九域塵。", "絕瑞駢闐集，殊祥絡繹臻。", "登年慶棲畝，稔歲賀盈囷。"], "form": "五律", "t300": null, "src": "yuding", "prev": "010-12", "next": "010-14"}, "p14": {"key": "010-14", "title": "中宗祀昊天樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["悠哉廣覆，大矣曲成。", "九玄著象，七曜貞明。", "珪璧是奠，醞酎斯盈。", "作樂崇德，爰暢咸英。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-13", "next": "010-15"}, "p15": {"key": "010-15", "title": "中宗祀昊天樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["郊壇展敬，嚴配因心。", "<a class=\"ent ent-place\" href=\"../entities/place_%E5%AD%A4%E7%AB%B9.html\">孤竹</a>簫管，空桑瑟琴。", "肅穆大禮，鏗鏘八音。", "恭惟上帝，希降靈歆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-14", "next": "010-16"}, "p16": {"key": "010-16", "title": "中宗祀昊天樂章：福和", "author": "不詳", "canonical": "不詳", "lines": ["九成爰奏，三獻式陳。", "欽承<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E7%A6%8F.html\">景福</a>，恭托明禋。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-15", "next": "010-17"}, "p17": {"key": "010-17", "title": "中宗祀昊天樂章：中宮助祭升壇", "author": "不詳", "canonical": "不詳", "lines": ["坤元光<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>，柔訓闡皇風。", "芣苡芳聲遠，螽斯美化隆。", "睿範超千載，嘉猷備六宮。", "肅恭陪盛典，欽若薦禋宗。"], "form": "五律", "t300": null, "src": "yuding", "prev": "010-16", "next": "010-18"}, "p18": {"key": "010-18", "title": "中宗祀昊天樂章：亞獻", "author": "不詳", "canonical": "不詳", "lines": ["三靈降饗，三後配神。", "虔敷藻奠，敬展郊禋。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-17", "next": "010-19"}, "p19": {"key": "010-19", "title": "中宗祀昊天樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["已陳粢盛敷嚴祀，更奏笙鏞協雅聲。", "璿圖<a class=\"ent ent-time\" href=\"../entities/time_%E5%AE%9D%E5%8E%86.html\">寶曆</a>欣甯謐，晏俗淳風樂太平。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-18", "next": "010-20"}, "p20": {"key": "010-20", "title": "中宗祀昊天樂章：凱安", "author": "不詳", "canonical": "不詳", "lines": ["堂堂聖祖興，赫赫昌基泰。", "戎車<a class=\"ent ent-place\" href=\"../entities/place_%E7%9B%9F%E6%B4%A5.html\">盟津</a>偃，玉帛塗山會。", "舜日啟祥暉，堯雲卷征旆。", "風猷被有截，聲教覃無外。"], "form": "五律", "t300": null, "src": "yuding", "prev": "010-19", "next": "010-21"}, "p21": {"key": "010-21", "title": "明皇祀圜丘樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["至矣丕構，烝哉太平。", "授犧膺籙，複禹繼明。", "草木仁化，鳧鷖頌聲。", "祀宗陳德，無愧斯誠。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-20", "next": "010-22"}, "p22": {"key": "010-22", "title": "明皇祀圜丘樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["郊壇齋帝，禮樂祀天。", "丹青寰宇，宮征山川。", "神祇畢降，行止重旋。", "融融穆穆，納祉洪延。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-21", "next": "010-23"}, "p23": {"key": "010-23", "title": "明皇祀圜丘樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["止奏潛聆，登儀宿囀。", "太玉躬奉，參鐘首奠。", "簠簋聿升，犧牲遞薦。", "昭事顒若，存存以伣。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-22", "next": "010-24"}, "p24": {"key": "010-24", "title": "明皇祀圜丘樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["爛雲普洽，律風無外。", "千品其凝，九賓斯會。", "禋尊晉燭，純犧滌汰。", "玄覆攸廣，鴻休汪濊。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-23", "next": "010-25"}, "p25": {"key": "010-25", "title": "明皇祀圜丘樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["六變爰闋，八階載虔。", "佑我皇祚，于萬斯年。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-24", "next": "010-26"}, "p26": {"key": "010-26", "title": "明皇祀圜丘樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["于赫聖祖，龍飛<a class=\"ent ent-place\" href=\"../entities/place_%E6%99%8B%E9%98%B3.html\">晉陽</a>。", "底定萬國，奄有四方。", "功格上下，道冠農黃。", "郊天配享，德合無疆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-25", "next": "010-27"}, "p27": {"key": "010-27", "title": "明皇祀圜丘樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["崇崇泰畤，肅肅嚴禋。", "粢盛既潔，金石畢陳。", "上帝來享，介福爰臻。", "受厘合祉，寶祚維新。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-26", "next": "010-28"}, "p28": {"key": "010-28", "title": "明皇祀圜丘樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["祝史正辭，人神葉慶。", "福以德招，享以誠應。", "六變雲備，百禮斯浹。", "祀事孔明。", "祚流萬葉。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-27", "next": "010-29"}, "p29": {"key": "010-29", "title": "明皇祀圜丘樂章：凱安", "author": "不詳", "canonical": "不詳", "lines": ["馨香惟後德，明命光天保。", "肅和崇聖靈，陳信表皇道。", "玉戚初蹈厲，金匏既靜好。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "010-28", "next": "010-30"}, "p30": {"key": "010-30", "title": "明皇祀圜丘樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["大號成命，思文配天。", "神光肸蚃，龍駕言旋。", "眇眇閶闔，昭昭上玄。", "俾昌而大。", "於斯萬年。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-29", "next": "010-31"}, "p31": {"key": "010-31", "title": "明皇祀圜丘樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["六成既闋，三薦雲終。", "神心具醉，聖敬愈崇。", "受厘皇邸，回蹕帷宮。", "穰穰之福，永永無窮。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-30", "next": "010-32"}, "p32": {"key": "010-32", "title": "封泰山樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["款泰壇，柴泰清。", "受天命，報天成。", "竦皇心，薦樂聲。", "志上達，歌下迎。", "億上帝，臨下庭。", "騎日月，陪列星。", "嘉祝信，大糦馨。", "澹神心，醉皇靈。", "相百辟，貢八荒。", "九歌敘，萬舞翔。", "肅振振，鏗皇皇。", "帝欣欣，福穰穰。", "高在上，道光明。", "物資始，德難名。", "承眷命，牧蒼生。", "寰宇謐，太階平。", "天道無親，至誠與鄰。", "山川遍禮，宮征維新。", "玉帛非盛，聰明會真。", "正斯一德，通乎百神。", "饗帝饗親，維孝維聖。", "緝熙懿德，敷揚成命。", "華夷志同，笙鏞禮盛。", "明靈降止，感此誠敬。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "010-31", "next": "010-33"}, "p33": {"key": "010-33", "title": "封泰山樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["孝敬中發，和容外彰。", "騰華照宇，如升太陽。", "貞璧就奠，玄靈垂光。", "禮樂具舉，濟濟洋洋。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-32", "next": "010-34"}, "p34": {"key": "010-34", "title": "封泰山樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["奠祖配天，承天享帝。", "百靈咸秩，四海來祭。", "植我蒼璧，布我玄制。", "華日裴回，神煙容裔。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-33", "next": "010-35"}, "p35": {"key": "010-35", "title": "封泰山樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["俎豆有馥，粢盛潔豐。", "亦有和羹，既戒既平。", "鐘鼓管磬，肅唱和鳴。", "皇皇後祖，來我思成。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-34", "next": "010-36"}, "p36": {"key": "010-36", "title": "封泰山樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["烝烝我後，享獻惟夤。", "躬酌鬱鬯，跪奠明神。", "孝莫孝乎，配上帝親。", "敬莫敬乎，教天下臣。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-35", "next": "010-37"}, "p37": {"key": "010-37", "title": "封泰山樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["皇祖嚴配，配享皇天。", "皇皇降嘏，天子萬年。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-36", "next": "010-38"}, "p38": {"key": "010-38", "title": "封泰山樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["六鐘翕協六變成，八佾倘佯八風生。", "樂九韶兮人神感，美七德兮天地清。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-37", "next": "010-39"}, "p39": {"key": "010-39", "title": "封泰山樂章：凱安", "author": "不詳", "canonical": "不詳", "lines": ["烈祖順三靈，文宗威四海。", "黃鉞誅群盜，朱旗掃多罪。", "戢兵天下安，約法人心改。", "大哉幹羽意，長見風雲在。"], "form": "五律", "t300": null, "src": "yuding", "prev": "010-38", "next": "010-40"}, "p40": {"key": "010-40", "title": "封泰山樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["樂已終，煙燎上。", "懷靈惠，結皇想。", "歸風疾，回風爽。", "百福來，眾神往。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "010-39", "next": "010-41"}, "p41": {"key": "010-41", "title": "祈谷樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["履艮斯繩，居中體正。", "龍運垂祉，昭符啟聖。", "式事嚴禋，聿懷嘉慶。", "惟帝永錫，時皇休命。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-40", "next": "010-42"}, "p42": {"key": "010-42", "title": "祈谷樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["殷薦乘春，太壇臨曙。", "八簋盈和，六瑚登禦。", "嘉稷匪歆，德馨斯飫。", "祝嘏無易，靈心有豫。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-41", "next": "010-43"}, "p43": {"key": "010-43", "title": "祈谷樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["玉帛犧牲申敬享，金絲戚羽盛音容。", "庶俾億齡禔<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E7%A6%8F.html\">景福</a>，長欣萬宇洽時邕。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-42", "next": "010-44"}, "p44": {"key": "010-44", "title": "明堂樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["象天禦宇，乘時布政。", "嚴配申虔，宗禋展敬。", "樽罍盈列，樹羽交映。", "玉幣通誠，祚隆皇聖。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-43", "next": "010-45"}, "p45": {"key": "010-45", "title": "明堂樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["八牖晨披，五精朝奠。", "霧凝璿篚，風清金縣。", "神滌備全，明粢豐衍。", "載絜彝俎，陳誠以薦。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-44", "next": "010-46"}, "p46": {"key": "010-46", "title": "明堂樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["禦扆合宮承<a class=\"ent ent-time\" href=\"../entities/time_%E5%AE%9D%E5%8E%86.html\">寶曆</a>，席圖重館奉明靈。", "偃武修文九圍泰，沉烽靜柝八荒寧。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-45", "next": "010-47"}, "p47": {"key": "010-47", "title": "武后明堂樂章：外辦將出", "author": "不詳", "canonical": "不詳", "lines": ["總章陳昔典，衢室禮惟神。", "巨集規則天地，神用葉陶鈞。", "負扆三春旦，充庭萬宇賓。", "顧己誠虛薄，空慚億兆人。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "010-46", "next": "010-48"}, "p48": {"key": "010-48", "title": "武后明堂樂章：皇帝行", "author": "不詳", "canonical": "不詳", "lines": ["仰膺歷數，俯順謳歌。", "遠安邇肅，俗阜時和。", "化光玉鏡，訟息金科。", "方興典禮，永戢干戈。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-47", "next": "010-49"}, "p49": {"key": "010-49", "title": "武后明堂樂章：皇嗣出入升降", "author": "不詳", "canonical": "不詳", "lines": ["至人光俗，大孝通神。", "謙以表性，恭惟立身。", "洪規載啟，茂典方陳。", "譽隆三善，祥開萬春。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-48", "next": "010-50"}, "p50": {"key": "010-50", "title": "武后明堂樂章：迎送王公", "author": "不詳", "canonical": "不詳", "lines": ["千官肅事，萬國朝宗。", "載延百辟，爰集三宮。", "君臣德合，魚水斯同。", "睿圖方永，周曆長隆。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-49", "next": "010-51"}, "p51": {"key": "010-51", "title": "武后明堂樂章：登歌", "author": "不詳", "canonical": "不詳", "lines": ["禮崇宗祀，志表嚴禋。", "笙鏞合奏，文物維新。", "敬遵茂典，敢擇良辰。", "絜誠斯著，奠謁方申。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-50", "next": "010-52"}, "p52": {"key": "010-52", "title": "武后明堂樂章：配饗", "author": "不詳", "canonical": "不詳", "lines": ["笙鏞間玉宇，文物昭清暉。", "睟影臨芳奠，休光下太微。", "孝思期有感，明絜庶無違。"], "form": "五言古體", "t300": null, "src": "yuding", "prev": "010-51", "next": "010-53"}, "p53": {"key": "010-53", "title": "武后明堂樂章：宮音", "author": "不詳", "canonical": "不詳", "lines": ["履艮包群望，居中冠百靈。", "萬方資廣運，庶品荷財成。", "神功諒匪測，盛德實難名。", "藻奠申誠敬，恭祀表惟馨。"], "form": "五律", "t300": null, "src": "yuding", "prev": "010-52", "next": "010-54"}, "p54": {"key": "010-54", "title": "武后明堂樂章：角音", "author": "不詳", "canonical": "不詳", "lines": ["出震位，開平秩。", "扇條風，乘甲乙。", "龍德盛，鳥星出。", "薦珪篚，陳誠實。"], "form": "雜言", "t300": null, "src": "yuding", "prev": "010-53", "next": "010-55"}, "p55": {"key": "010-55", "title": "武后明堂樂章：征音", "author": "不詳", "canonical": "不詳", "lines": ["赫赫離精禦炎陸，滔滔熾景開隆暑。", "冀延神鑒俯蘭樽，式表虔襟陳桂俎。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-54", "next": "010-56"}, "p56": {"key": "010-56", "title": "武后明堂樂章：商音", "author": "不詳", "canonical": "不詳", "lines": ["律中夷則，序應收成。", "功宣建武，義表惟明。", "爰申禮奠，庶展翹誠。", "九秋是式，百穀斯盈。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-55", "next": "010-57"}, "p57": {"key": "010-57", "title": "武后明堂樂章：羽音", "author": "不詳", "canonical": "不詳", "lines": ["葭律肇啟隆冬，蘋藻攸陳饗祭。", "黃鐘既陳玉燭，紅粒方殷稔歲。"], "form": "六言", "t300": null, "src": "yuding", "prev": "010-56", "next": "010-58"}, "p58": {"key": "010-58", "title": "雩祀樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["朱鳥開辰，蒼龍啟映。", "大帝昭饗，群生展敬。", "禮備懷柔，功宣舞詠。", "旬液應序，年祥協慶。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-57", "next": "010-59"}, "p59": {"key": "010-59", "title": "雩祀樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["紺筵分彩，寶圖吐絢。", "風管晨凝，雲歌曉囀。", "肅事蘭羞，虔申桂奠。", "百谷斯登，萬箱攸薦。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-58", "next": "010-60"}, "p60": {"key": "010-60", "title": "雩祀樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["鳳曲登歌調令序，龍雩集舞泛祥風。", "彩旞雲回昭睿德，朱幹電發表神功。"], "form": "七絕", "t300": null, "src": "yuding", "prev": "010-59", "next": "010-61"}, "p61": {"key": "010-61", "title": "雩祀樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["鳥緯遷序，龍星見辰。", "純陽在律，明德崇禋。", "五方降帝，萬宇安人。", "恭以致享，肅以迎神。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-60", "next": "010-62"}, "p62": {"key": "010-62", "title": "雩祀樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["祀遵經設，享緣誠舉。", "獻畢於樽，徹臨於俎。", "舞止幹戚，樂停柷敔。", "歌以送神，神還其所。"], "form": "四言", "t300": null, "src": "yuding", "prev": "010-61", "next": null}}}