{"vol_name": "卷一十六", "poems": {"p01": {"key": "016-01", "title": "郊廟歌辭：梁郊祀樂章：慶和", "author": "趙光逢", "canonical": "趙光逢", "lines": ["就陽位，升圓丘。", "佩雙玉，禦大裘。", "膺天命，擁神休。", "萬靈感，百祿遒。", "秉黃鉞，建朱旗。", "震八表，清二儀。", "帝業顯，王道夷。", "受景命，啟皇基。", "開九門，懷百神。", "通肸蚃，接氤氳。", "明粢薦，廣樂陳。", "奠嘉璧，燎芳薪。", "膺寶圖，執左契。", "德應天，聖饗帝。", "薦表衷，荷靈惠。", "壽萬年，祚百世。", "惟德動天，有感必通。", "秉茲一德，禋于六宗。", "欽夤寶命，恭肅禮容。", "來顧來享，永穆皇風。", "天惟佑德，辟乃奉天。", "交感斯在，昭事罔愆。", "歲功已就，王道無偏。", "於焉報本，是用告虔。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "016-02"}, "p02": {"key": "016-02", "title": "郊廟歌辭：梁郊祀樂章：慶順", "author": "不詳", "canonical": "不詳", "lines": ["聖皇戾止，天步舒遲。", "幹幹睿相，穆穆皇儀。", "進退必肅，陟降是祗。", "六變克協，萬靈協隨。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-01", "next": "016-03"}, "p03": {"key": "016-03", "title": "郊廟歌辭：梁郊祀樂章：慶平", "author": "不詳", "canonical": "不詳", "lines": ["天命降鑒，帝德惟馨。", "享祀不忒，禮容孔明。", "奠璧布幣，薦神獻精。", "神佑以答，敷錫永寧。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-02", "next": "016-04"}, "p04": {"key": "016-04", "title": "郊廟歌辭：梁郊祀樂章：慶肅", "author": "張袞", "canonical": "張袞", "lines": ["籩豆簠簋，黍稷非馨。", "懿茲彝器，厥德惟明。", "金石匏革，以和以平。", "繇此無體，期乎永寧。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-03", "next": "016-05"}, "p05": {"key": "016-05", "title": "郊廟歌辭：梁郊祀樂章：慶熙", "author": "不詳", "canonical": "不詳", "lines": ["哲後躬享，旨酒斯陳。", "王恭無斁，嚴祀維夤。", "皇祖以配，大孝以振。", "宜錫<a class=\"ent ent-time\" href=\"../entities/time_%E6%99%AF%E7%A6%8F.html\">景福</a>，永休下民。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-04", "next": "016-06"}, "p06": {"key": "016-06", "title": "郊廟歌辭：梁郊祀樂章：慶隆", "author": "不詳", "canonical": "不詳", "lines": ["恭祀上帝，于國之陽。", "爵醴是荷，鴻基永昌。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-05", "next": "016-07"}, "p07": {"key": "016-07", "title": "郊廟歌辭：梁郊祀樂章：慶融", "author": "不詳", "canonical": "不詳", "lines": ["道和氣兮襲氤氳，宣皇規兮彰聖神。", "服遐裔兮敷質文，格苗扈兮息煙塵。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "016-06", "next": "016-08"}, "p08": {"key": "016-08", "title": "郊廟歌辭：梁郊祀樂章：慶休", "author": "不詳", "canonical": "不詳", "lines": ["大業來<a class=\"ent ent-nation\" href=\"../entities/nation_%E5%9B%9B%E5%A4%B7.html\">四夷</a>，仁風和萬國。", "白日體無私，皇天輔有德。", "七旬罪已服，六月師方克。", "偉哉帝道隆，終始常作則。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "016-07", "next": "016-09"}, "p09": {"key": "016-09", "title": "郊廟歌辭：梁郊祀樂章：慶和", "author": "不詳", "canonical": "不詳", "lines": ["煙燎升，禮容徹。", "誠感達，人神悅。", "靈貺彰，聖情結。", "玉座寂，金爐歇。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-08", "next": "016-10"}, "p10": {"key": "016-10", "title": "郊廟歌辭：周郊祀樂章：昭順樂", "author": "不詳", "canonical": "不詳", "lines": ["五兵勿用，萬國咸安。", "告功圓蓋，受命雲壇。", "樂鳴鳳律，禮備雞竿。", "神光欲降，眾目遐觀。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-09", "next": "016-11"}, "p11": {"key": "016-11", "title": "郊廟歌辭：周郊祀樂章：治順樂", "author": "不詳", "canonical": "不詳", "lines": ["羽衛離丹闕，金軒赴泰壇。", "珠旗明月色，玉佩曉霜寒。", "黼黻龍衣備，琮璜寶器完。", "百神將受職，宗社保<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "016-10", "next": "016-12"}, "p12": {"key": "016-12", "title": "郊廟歌辭：周郊祀樂章：感順樂", "author": "不詳", "canonical": "不詳", "lines": ["明君陳大禮，展幣祀圓丘。", "雅樂聲齊發，祥雲色正浮。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "016-11", "next": "016-13"}, "p13": {"key": "016-13", "title": "郊廟歌辭：周郊祀樂章：禋順樂", "author": "不詳", "canonical": "不詳", "lines": ["黃彝將獻，特牲預迎。", "既修昭事，潛達明誠。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-12", "next": "016-14"}, "p14": {"key": "016-14", "title": "郊廟歌辭：周郊祀樂章：福順樂", "author": "不詳", "canonical": "不詳", "lines": ["相承五運，取法三才。", "大禮爰展，率土咸來。", "卿雲秘室，<a class=\"ent ent-place\" href=\"../entities/place_%E7%94%98%E6%B3%89.html\">甘泉</a>寶台。", "象樽初酌，受福不回。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-13", "next": "016-15"}, "p15": {"key": "016-15", "title": "郊廟歌辭：周郊祀樂章：福順樂", "author": "不詳", "canonical": "不詳", "lines": ["昊天成命，邦國盛儀。", "多士齊列，六龍載馳。", "壇升泰一，樂奏咸池。", "高明祚德，永致昌期。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-14", "next": "016-16"}, "p16": {"key": "016-16", "title": "郊廟歌辭：周郊祀樂章：福順樂", "author": "不詳", "canonical": "不詳", "lines": ["上天垂景貺，哲後舉鸞觴。", "明德今方祚，邦家萬世昌。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "016-15", "next": "016-17"}, "p17": {"key": "016-17", "title": "郊廟歌辭：周郊祀樂章：忠順樂", "author": "不詳", "canonical": "不詳", "lines": ["木鐸敷音文德昌，朱幹成列武功彰。", "雷鞀鷺羽今休用，玉戚相參正發揚。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "016-16", "next": "016-18"}, "p18": {"key": "016-18", "title": "郊廟歌辭：周郊祀樂章：武舞樂", "author": "不詳", "canonical": "不詳", "lines": ["圭瓚方陳禮，幹旄乃象功。", "成文非羽鑰，猛勢若羆熊。"], "form": "五絕", "t300": null, "src": "yuding", "pilot": false, "prev": "016-17", "next": "016-19"}, "p19": {"key": "016-19", "title": "郊廟歌辭：周郊祀樂章：昭順樂", "author": "不詳", "canonical": "不詳", "lines": ["雲門<a class=\"ent ent-place\" href=\"../entities/place_%E5%AD%A4%E7%AB%B9.html\">孤竹</a>，蒼璧黃琮。", "既祀天地，克配祖宗。", "虔修盛禮，仰答玄功。", "神歸碧落，神降無窮。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-18", "next": "016-20"}, "p20": {"key": "016-20", "title": "郊廟歌辭：梁太廟樂舞辭：開平舞", "author": "不詳", "canonical": "不詳", "lines": ["黍稷馨，醴𨣧清。", "牲牷潔，金石鏗。", "恭祀事，結皇情。", "神來格，歌頌聲。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-19", "next": "016-21"}, "p21": {"key": "016-21", "title": "郊廟歌辭：梁太廟樂舞辭：皇帝行", "author": "不詳", "canonical": "不詳", "lines": ["莫高者天，攀躋弗克。", "隮天有方，累仁積德。", "祖宗隆之，子孫履之。", "配天明祀，永永孝思。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-20", "next": "016-22"}, "p22": {"key": "016-22", "title": "郊廟歌辭：梁太廟樂舞辭：帝盥", "author": "不詳", "canonical": "不詳", "lines": ["莊肅蒞事，周旋禮容。", "祼鬯嚴潔，穆穆雍雍。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-21", "next": "016-23"}, "p23": {"key": "016-23", "title": "郊廟歌辭：梁太廟樂舞辭：登歌", "author": "不詳", "canonical": "不詳", "lines": ["於赫我皇，<a class=\"ent ent-time\" href=\"../entities/time_%E5%BB%BA%E4%B8%AD.html\">建中</a>立極。", "動以武功，靜以文德。", "昭事上帝，歡心萬國。", "大報嚴禋，四海述職。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-22", "next": "016-24"}, "p24": {"key": "016-24", "title": "郊廟歌辭：梁太廟樂舞辭：大合舞", "author": "不詳", "canonical": "不詳", "lines": ["于穆皇祖，浚哲雍熙。", "美溢中夏，化被南陲。", "<a class=\"ent ent-person\" href=\"../entities/person_%E5%90%8E%E7%A8%B7.html\">後稷</a>累德，公劉創基。", "肇興九廟，樂合來儀。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-23", "next": "016-25"}, "p25": {"key": "016-25", "title": "郊廟歌辭：梁太廟樂舞辭：象功舞", "author": "不詳", "canonical": "不詳", "lines": ["天地合德，睿聖昭彰。", "累贈太傅，俄登<a class=\"ent ent-person\" href=\"../entities/person_%E9%AD%8F%E7%8E%8B.html\">魏王</a>。", "雄名不朽，奕葉而光。", "建國之兆，君臨萬方。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-24", "next": "016-26"}, "p26": {"key": "016-26", "title": "郊廟歌辭：梁太廟樂舞辭：來儀舞", "author": "不詳", "canonical": "不詳", "lines": ["於赫帝命，應天順人。", "亭育品匯，賓禮百神。", "洪基永固，景命惟新。", "肅恭孝享，祚我生民。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-25", "next": "016-27"}, "p27": {"key": "016-27", "title": "郊廟歌辭：梁太廟樂舞辭：昭德舞", "author": "不詳", "canonical": "不詳", "lines": ["肅肅文考，源浚派長。", "漢稱誕季，周實生昌。", "奄有四海，超彼百王。", "笙鏞迭奏，禮物熒煌。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-26", "next": "016-28"}, "p28": {"key": "016-28", "title": "郊廟歌辭：梁太廟樂舞辭：飲福", "author": "不詳", "canonical": "不詳", "lines": ["戛玉摐金永頌聲，檿絲<a class=\"ent ent-place\" href=\"../entities/place_%E5%AD%A4%E7%AB%B9.html\">孤竹</a>和且清。", "靈歆醉止犧象盈，自天降福千萬齡。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "016-27", "next": "016-29"}, "p29": {"key": "016-29", "title": "郊廟歌辭：梁太廟樂舞辭：撤豆", "author": "不詳", "canonical": "不詳", "lines": ["笙鏞洋洋，庭燎煌煌。", "明星有爛，祝史下堂。", "[籩]豆斯撤，禮容有章。", "克勤克儉，無怠無荒。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "016-28", "next": "016-30"}, "p30": {"key": "016-30", "title": "郊廟歌辭：梁太廟樂舞辭：送神", "author": "不詳", "canonical": "不詳", "lines": ["其降無從，其往無蹤。", "黍稷非馨，有感必通。", "赫奕令德，仿佛睟容。", "再拜慌忽，遐想昊穹。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-29", "next": "016-31"}, "p31": {"key": "016-31", "title": "郊廟歌辭：後唐宗廟樂舞辭：昭德舞", "author": "不詳", "canonical": "不詳", "lines": ["懿彼明德，赫赫煌煌。", "名高閫域，功著旗常。", "道符休泰，運葉祺祥。", "慶傳萬祀，以播耿光。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-30", "next": "016-32"}, "p32": {"key": "016-32", "title": "郊廟歌辭：後唐宗廟樂舞辭：文明舞", "author": "不詳", "canonical": "不詳", "lines": ["帝業光揚，皇圖翕赫。", "聖德孔彰，神功不測。", "信及豚魚，恩沾動植。", "懿範鴻名，傳之萬億。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-31", "next": "016-33"}, "p33": {"key": "016-33", "title": "郊廟歌辭：後唐宗廟樂舞辭：應天舞", "author": "不詳", "canonical": "不詳", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E6%99%8B%E5%9B%BD.html\">晉國</a>肇興，雄圖再固。", "黼黻帝道，金玉王度。", "皇天無親，惟德是輔。", "載誕英明，永光聖祚。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-32", "next": "016-34"}, "p34": {"key": "016-34", "title": "郊廟歌辭：後唐宗廟樂舞辭：永平舞", "author": "不詳", "canonical": "不詳", "lines": ["慶傳瓚祚，位正瑤圖。", "功宣四海，化被八區。", "靜彰帝道，動合<a class=\"ent ent-time\" href=\"../entities/time_%E5%B9%B2%E7%AC%A6.html\">幹符</a>。", "千秋萬祀，永荷昭蘇。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-33", "next": "016-35"}, "p35": {"key": "016-35", "title": "郊廟歌辭：後唐宗廟樂舞辭：武成舞", "author": "不詳", "canonical": "不詳", "lines": ["艱難王業，返正皇唐。", "<a class=\"ent ent-time\" href=\"../entities/time_%E5%85%88%E5%A4%A9.html\">先天</a>再造，卻日重光。", "漢紹世祖，夏資少康。", "功成德茂，率祀無疆。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-34", "next": "016-36"}, "p36": {"key": "016-36", "title": "郊廟歌辭：後唐宗廟樂舞辭：雍熙舞", "author": "不詳", "canonical": "不詳", "lines": ["仁君禦宇，寰海謐清。", "運符<a class=\"ent ent-time\" href=\"../entities/time_%E6%AD%A6%E5%BE%B7.html\">武德</a>，道協文明。", "九成式敘，百度惟貞。", "金門積慶，玉葉傳榮。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-35", "next": "016-37"}, "p37": {"key": "016-37", "title": "郊廟歌辭：漢宗廟樂舞辭：武德舞", "author": "不詳", "canonical": "不詳", "lines": ["明明我祖，天集休明。", "神母夜哭，彤雲晝興。", "籩豆有踐，管鑰斯登。", "孝孫致告，神其降靈。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-36", "next": "016-38"}, "p38": {"key": "016-38", "title": "郊廟歌辭：漢宗廟樂舞辭：靈長舞", "author": "不詳", "canonical": "不詳", "lines": ["天降祥，漢祚昌。", "火炎上，水靈長。", "建廟社，潔蒸嘗。", "羅鐘石，儼珩璜。", "陳玉豆，酌金觴。", "氣昭感，德馨香。", "祗洛汭，瞻<a class=\"ent ent-place\" href=\"../entities/place_%E6%99%8B%E9%98%B3.html\">晉陽</a>。", "降吾祖，福穰穰。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-37", "next": "016-39"}, "p39": {"key": "016-39", "title": "郊廟歌辭：漢宗廟樂舞辭：積善舞", "author": "不詳", "canonical": "不詳", "lines": ["黍稷斯馨，祖德惟明。", "蛇告赤帝，龜謀大橫。", "雲行雨施，天成地平。", "造我家邦，斡我璿衡。", "陶匏在禦，醍盎惟精。", "或戛或擊，載炮載烹。", "飲福受胙，舞降歌迎。", "滔滔不竭，洪惟水行。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-38", "next": "016-40"}, "p40": {"key": "016-40", "title": "郊廟歌辭：漢宗廟樂舞辭：顯仁舞", "author": "不詳", "canonical": "不詳", "lines": ["運極金行謝，天資水德隆。", "禮神<a class=\"ent ent-place\" href=\"../entities/place_%E9%84%9C%E7%95%A4.html\">鄜畤</a>館，布政<a class=\"ent ent-place\" href=\"../entities/place_%E6%9C%AA%E5%A4%AE%E5%AE%AB.html\">未央宮</a>。", "詰旦備明祀，登歌答茂功。", "雲軒臨降久，星俎薦陳豐。", "靄靄沉檀霧，鏘鏘環佩風。", "熒煌升藻藉，肸蚃轉珠櫳。", "尊祖咸韶備，貽孫書軌同。", "京坻長有積，宗社享無窮。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "016-39", "next": "016-41"}, "p41": {"key": "016-41", "title": "郊廟歌辭：漢宗廟樂舞辭：章慶舞", "author": "不詳", "canonical": "不詳", "lines": ["罘罳曉唱雞人，三牲八簋斯陳。", "霧集瑤階瑣闥，", "酌鬯既終三獻，凝旒何止千春。", "阿閣長棲彩鳳，", "玉斝犧樽瀲灩，龍旗鳳轄逡巡。", "瞻望月遊冠冕，猶疑蒼野回輪。"], "form": "六言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-40", "next": "016-42"}, "p42": {"key": "016-42", "title": "郊廟歌辭：漢宗廟樂舞辭：觀德舞", "author": "張昭", "canonical": "張昭", "lines": ["<a class=\"ent ent-place\" href=\"../entities/place_%E9%AB%98%E5%BA%99.html\">高廟</a>明靈再啓圖，金根玉輅幸神都。", "巢阿丹凰銜書命，入昴飛星獻寶符。", "正換熏弦娛赤子，忽登仙駕泣<a class=\"ent ent-place\" href=\"../entities/place_%E8%8B%8D%E6%A2%A7.html\">蒼梧</a>。", "薦櫻鶴館笳簫咽，酌鬯金楹劒佩趨。", "星俎雲罍兼魯禮，朱干象箾雜巴渝。", "氤氳龍麝交青瑣，髣髴[錫]鑾下蘂珠。", "薦豆奉觴親玉几，配天合祖耀璿樞。", "受釐飲酒皇歡洽，仰俟餘靈泰九區。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "016-41", "next": "016-43"}, "p43": {"key": "016-43", "title": "郊廟歌辭：周宗廟樂舞辭：肅順", "author": "不詳", "canonical": "不詳", "lines": ["我後至孝，祗謁祖先。", "仰瞻廟貌，夙設宮懸。", "朱弦疏越，羽舞迴旋。", "神其來格，明祀惟虔。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-42", "next": "016-44"}, "p44": {"key": "016-44", "title": "郊廟歌辭：周宗廟樂舞辭：治順", "author": "不詳", "canonical": "不詳", "lines": ["清廟將入，袞服是依。", "載行載止，令色令儀。", "永終就養，空極孝思。", "瞻望如在，顧複長違。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-43", "next": "016-45"}, "p45": {"key": "016-45", "title": "郊廟歌辭：周宗廟樂舞辭：肅雍舞", "author": "不詳", "canonical": "不詳", "lines": ["周道載興，象日之明。", "萬邦咸慶，百谷用成。", "于穆聖祖，祗薦鴻名。", "祀于廟社，陳其犧牲。", "進旅退旅，皇武之形。", "一倡三歎，朱弦之聲。", "以妥以侑，既和且平。", "至誠潛達，介福攸寧。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-44", "next": "016-46"}, "p46": {"key": "016-46", "title": "郊廟歌辭：周宗廟樂舞辭：章德舞", "author": "不詳", "canonical": "不詳", "lines": ["清廟新，展嚴禋。", "恭祖德，厚人倫。", "雅樂薦，禮器陳。", "儼皇屍，列虞賓。", "神如在，聲不聞。", "享必信，貌惟夤。", "想龍服，奠犧樽。", "禮既備，慶來臻。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-45", "next": "016-47"}, "p47": {"key": "016-47", "title": "郊廟歌辭：周宗廟樂舞辭：善慶舞", "author": "不詳", "canonical": "不詳", "lines": ["蔔世長，帝祚昌。", "定中國，服四方。", "修明祀，從舊章。", "奏激楚，轉清商。", "羅俎豆，列簪裳。", "歌累累，容皇皇。", "望來格，降休祥。", "祝敢告，壽無疆。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-46", "next": "016-48"}, "p48": {"key": "016-48", "title": "郊廟歌辭：周宗廟樂舞辭：觀成舞", "author": "不詳", "canonical": "不詳", "lines": ["穆<a class=\"ent ent-person\" href=\"../entities/person_%E7%A9%86%E7%8E%8B.html\">穆王</a>國，奕奕神功。", "毖祀載展，明德有融。", "彝樽斯滿，簠簋斯豐。", "紛絺旄羽，鏘洋磬鐘。", "或升或降，克和克同。", "孔惠之禮，必肅之容。", "錫以純嘏，祚其允恭。", "神保是饗，萬世無窮。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-47", "next": "016-49"}, "p49": {"key": "016-49", "title": "郊廟歌辭：周宗廟樂舞辭：明德舞", "author": "不詳", "canonical": "不詳", "lines": ["惟彼岐陽，德大流光。", "載造周室，澤及遐荒。", "于鑠聖祖，上帝是皇。", "乃聖乃神，知微知彰。", "新廟奕奕，豐年穰穰。", "取彼血膋，以往蒸嘗。", "黍稷惟馨，籩豆大房。", "工祝致告，受福無疆。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-48", "next": "016-50"}, "p50": {"key": "016-50", "title": "郊廟歌辭：周宗廟樂舞辭：咸順", "author": "不詳", "canonical": "不詳", "lines": ["萬舞咸列，三階克清。", "貫珠一倡，擊石九成。", "盈觴雖酌，靈坐無形。", "永懷我祖，達其孝誠。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-49", "next": "016-51"}, "p51": {"key": "016-51", "title": "郊廟歌辭：周宗廟樂舞辭：禋順", "author": "不詳", "canonical": "不詳", "lines": ["旨酒既獻，嘉殽乃迎。", "振其鞀鼓，潔以鉶羹。", "肇禋肇祀，或炮或烹。", "皇屍儼若，保饗是明。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-50", "next": "016-52"}, "p52": {"key": "016-52", "title": "郊廟歌辭：周宗廟樂舞辭：福順", "author": "不詳", "canonical": "不詳", "lines": ["新廟奕奕，金奏洋洋。", "享于祖考，循彼典章。", "清酤特滿，嘉玉騰光。", "神醉既告，帝祉無疆。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-51", "next": "016-53"}, "p53": {"key": "016-53", "title": "郊廟歌辭：周宗廟樂舞辭：忠順", "author": "不詳", "canonical": "不詳", "lines": ["稱文既表溫柔德，示武須成蹈厲容。", "綴兆疾舒皆應節，明明我祖樂無窮。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "016-52", "next": "016-54"}, "p54": {"key": "016-54", "title": "郊廟歌辭：善勝舞", "author": "不詳", "canonical": "不詳", "lines": ["聖祖累功，福鐘來裔。", "持羽執幹。", "舞文不廢。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-53", "next": "016-55"}, "p55": {"key": "016-55", "title": "郊廟歌辭：善勝舞：禋順", "author": "不詳", "canonical": "不詳", "lines": ["禮畢祀先，香散幾筵。", "罷舞幹戚，收撤豆籩。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-54", "next": "016-56"}, "p56": {"key": "016-56", "title": "郊廟歌辭：善勝舞：肅順", "author": "不詳", "canonical": "不詳", "lines": ["樂奏四順，福受萬年。", "神歸碧天，庭餘瑞煙。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-55", "next": "016-57"}, "p57": {"key": "016-57", "title": "郊廟歌辭：晉朝饗樂章：初舉酒文同樂", "author": "不詳", "canonical": "不詳", "lines": ["赫矣昌運，明哉聖王。", "文興墜典，禮復舊章。", "鴛鸞濟濟，鳥獸蹌蹌。", "一人有慶，萬福無疆。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-56", "next": "016-58"}, "p58": {"key": "016-58", "title": "郊廟歌辭：晉朝饗樂章：舉酒", "author": "不詳", "canonical": "不詳", "lines": ["大明禦宇，<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>動天。", "君臣慶會，禮樂昭宣。", "劍佩成列，金石在懸。", "椒觴再獻，<a class=\"ent ent-time\" href=\"../entities/time_%E5%AE%9D%E5%8E%86.html\">寶曆</a>萬年。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-57", "next": "016-59"}, "p59": {"key": "016-59", "title": "郊廟歌辭：晉朝饗樂章：再舉酒", "author": "不詳", "canonical": "不詳", "lines": ["朝野無事，寰瀛大康。", "聖人有作，盛禮重光。", "萬國執玉，千官奉觴。", "<a class=\"ent ent-place\" href=\"../entities/place_%E5%8D%97%E5%B1%B1.html\">南山</a>永固，地久天長。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-58", "next": "016-60"}, "p60": {"key": "016-60", "title": "郊廟歌辭：晉朝饗樂章：四舉酒", "author": "不詳", "canonical": "不詳", "lines": ["八表歡無事，三秋賀有成。", "照臨同日遠，渥澤並雲行。", "河變千年色，山呼萬歲聲。", "願修封岱禮，方以稱文明。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "016-59", "next": "016-61"}, "p61": {"key": "016-61", "title": "郊廟歌辭：晉朝饗樂章：群臣酒行歌", "author": "不詳", "canonical": "不詳", "lines": ["劍佩儼如林，齊傾拱北心。", "渥恩頒美祿，咸濩聽和音。", "一德君臣合，重瞳日月臨。", "歌時兼樂聖，唯待贊泥金。", "萬國咸歸禹，千官共祝堯。", "拜恩瞻鳳扆，傾耳聽雲韶。", "運啟金行遠，時和玉燭調。", "酒酣齊抃舞，同賀聖明朝。", "令節陳高會，群臣侍禦筵。", "玉墀留愛景，金殿靄祥煙。", "振鷺涵天澤，靈禽下樂懸。", "聖明無一事，何處讓堯年。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "016-60", "next": "016-62"}, "p62": {"key": "016-62", "title": "郊廟歌辭：周朝饗樂章：忠順", "author": "不詳", "canonical": "不詳", "lines": ["歲迎更始，節及朝元。", "冕旒仰止，冠劍相連。", "八音合奏，萬物齊宣。", "常陳盛禮，願永千年。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-61", "next": "016-63"}, "p63": {"key": "016-63", "title": "郊廟歌辭：周朝饗樂章：忠順", "author": "不詳", "canonical": "不詳", "lines": ["明君當寧，列辟奉觴。", "雲容表瑞，日影初長。", "衣冠濟濟，鐘磬洋洋。", "令儀克盛，嘉會有章。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-62", "next": "016-64"}, "p64": {"key": "016-64", "title": "郊廟歌辭：周朝饗樂章：治順", "author": "不詳", "canonical": "不詳", "lines": ["庭陳大樂，坐當太微。", "凝旒負扆，端拱垂衣。", "鴛鸞成列，簪組相輝。", "禦爐香散，鬱鬱霏霏。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-63", "next": "016-65"}, "p65": {"key": "016-65", "title": "郊廟歌辭：周朝饗樂章：福順", "author": "不詳", "canonical": "不詳", "lines": ["聖皇端拱，多士輸忠。", "蠻觴共獻，臣心畢同。", "聲齊嵩岳，祝比華封。", "千齡萬祀，常保時雍。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-64", "next": "016-66"}, "p66": {"key": "016-66", "title": "郊廟歌辭：周朝饗樂章：康順", "author": "不詳", "canonical": "不詳", "lines": ["鴻鈞廣運，嘉節良辰。", "列辟在位，萬國來賓。", "幹旌屢舞，金石咸陳。", "禮容既備，帝履長春。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-65", "next": "016-67"}, "p67": {"key": "016-67", "title": "郊廟歌辭：周朝饗樂章：忠順", "author": "不詳", "canonical": "不詳", "lines": ["禮成三爵，樂畢九成。", "共離金戺，複列彤庭。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-66", "next": "016-68"}, "p68": {"key": "016-68", "title": "郊廟歌辭：周朝饗樂章：忠順", "author": "不詳", "canonical": "不詳", "lines": ["明庭展禮，為龍為光。", "咸韶息韻，鵷鷺歸行。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "016-67", "next": "016-69"}, "p69": {"key": "016-69", "title": "郊廟歌辭：晉昭德成功舞歌：昭德舞歌二首", "author": "不詳", "canonical": "不詳", "lines": ["聖代修文德，明庭舉舊章。", "兩階陳羽鑰，萬舞合宮商。", "劍佩森鴛鷺，簫韶下鳳凰。", "我朝青史上，千古有輝光。", "淮海干戈戢，朝廷禮樂施。", "白駒皆就縶，丹鳳複來儀。", "德備<a class=\"ent ent-nation\" href=\"../entities/nation_%E4%B8%89%E8%8B%97.html\">三苗</a>格，風行萬國隨。", "小臣同百獸，率舞賀昌期。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "016-68", "next": "016-70"}, "p70": {"key": "016-70", "title": "郊廟歌辭：晉昭德成功舞歌：武功舞歌二首", "author": "不詳", "canonical": "不詳", "lines": ["撥亂資英主，開基自<a class=\"ent ent-place\" href=\"../entities/place_%E6%99%8B%E9%98%B3.html\">晉陽</a>。", "一戎成大業，七德煥前王。", "炎漢提封遠，姬周世祚長。", "朱幹將玉戚，全象武功揚。", "睿算超前古，神功格上圓。", "百川留禹跡，萬國戴堯天。", "既已櫜弓矢，誠宜播管弦。", "蹌蹌隨鳥獸，共樂太平年。"], "form": "五言排律", "t300": null, "src": "yuding", "pilot": false, "prev": "016-69", "next": null}}}