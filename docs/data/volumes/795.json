{"vol_name": "卷七百九十五", "poems": {"p01": {"key": "795-01", "title": "句", "author": "李日知", "canonical": "李日知", "lines": ["所願暫知居者樂，無使時稱主者勞。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "795-02"}, "p02": {"key": "795-02", "title": "句", "author": "趙仁奬", "canonical": "趙仁奬", "lines": ["令乘驄馬去，丞脫繡衣來。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-01", "next": "795-03"}, "p03": {"key": "795-03", "title": "句", "author": "郭廷謂", "canonical": "郭廷謂", "lines": ["魂逐東流水，墳依獨坐山。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-02", "next": "795-04"}, "p04": {"key": "795-04", "title": "句", "author": "韋青", "canonical": "韋青", "lines": ["三代掌綸誥，一身能唱歌。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-03", "next": "795-05"}, "p05": {"key": "795-05", "title": "句", "author": "尉遲匡", "canonical": "尉遲匡", "lines": ["明月飛出海，黃河流上天。", "芙蓉初出水，桃李忽無言。", "夜夜月爲青塚鏡，年年雪作黑山花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-04", "next": "795-06"}, "p06": {"key": "795-06", "title": "句", "author": "尉遲匡", "canonical": "尉遲匡", "lines": ["明月飛出海，黃河流上天。", "芙蓉初出水，桃李忽無言。", "夜夜月爲青塚鏡，年年雪作黑山花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-05", "next": "795-07"}, "p07": {"key": "795-07", "title": "句", "author": "尉遲匡", "canonical": "尉遲匡", "lines": ["明月飛出海，黃河流上天。", "芙蓉初出水，桃李忽無言。", "夜夜月爲青塚鏡，年年雪作黑山花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-06", "next": "795-08"}, "p08": {"key": "795-08", "title": "句", "author": "何涓", "canonical": "何涓", "lines": ["雁影數行秋半逢，漁歌一聲夜深發。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-07", "next": "795-09"}, "p09": {"key": "795-09", "title": "句", "author": "杜偉", "canonical": "杜偉", "lines": ["忽睹邢武辭，泠其金石備。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-08", "next": "795-10"}, "p10": {"key": "795-10", "title": "句", "author": "申堂構", "canonical": "申堂構", "lines": ["霜添柏樹冷，氣拂<a class=\"ent ent-place\" href=\"../entities/place_%E6%A1%82%E6%9E%97.html\">桂林</a>寒。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-09", "next": "795-11"}, "p11": {"key": "795-11", "title": "句", "author": "周愿", "canonical": "周愿", "lines": ["八十年前棠樹陰，竟陵太守公先人。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-10", "next": "795-12"}, "p12": {"key": "795-12", "title": "句", "author": "苐五琦", "canonical": "苐五琦", "lines": ["陰天聞斷雁，夜浦送歸人。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-11", "next": "795-13"}, "p13": {"key": "795-13", "title": "句", "author": "顏允南", "canonical": "顏允南", "lines": ["誰言百人會，兄弟也沾陪。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-12", "next": "795-14"}, "p14": {"key": "795-14", "title": "句", "author": "季廣琛", "canonical": "季廣琛", "lines": ["刻舟尋已化，彈鋏未酬恩。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-13", "next": "795-15"}, "p15": {"key": "795-15", "title": "句", "author": "陳蛻", "canonical": "陳蛻", "lines": ["夢裏換春秋。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-14", "next": "795-16"}, "p16": {"key": "795-16", "title": "句", "author": "衛準", "canonical": "衛准", "lines": ["莫言閑話是閑話，往往事從閑話來。", "何必剃頭爲弟子，無家便是出家人。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-15", "next": "795-17"}, "p17": {"key": "795-17", "title": "句", "author": "衛準", "canonical": "衛准", "lines": ["莫言閑話是閑話，往往事從閑話來。", "何必剃頭爲弟子，無家便是出家人。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-16", "next": "795-18"}, "p18": {"key": "795-18", "title": "句", "author": "杜鴻漸", "canonical": "杜鴻漸", "lines": ["常願追禪理，安能挹化源。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-17", "next": "795-19"}, "p19": {"key": "795-19", "title": "句", "author": "李摯", "canonical": "李摯", "lines": ["因緣三紀異，契分四般同。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-18", "next": "795-20"}, "p20": {"key": "795-20", "title": "句", "author": "韋綬", "canonical": "韋綬", "lines": ["在室愧屋漏。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-19", "next": "795-21"}, "p21": {"key": "795-21", "title": "句", "author": "馮戡", "canonical": "馮戡", "lines": ["桃花浪裏成龍去，竹葉山頭退鷁飛。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-20", "next": "795-22"}, "p22": {"key": "795-22", "title": "句", "author": "韓泰", "canonical": "韓泰", "lines": ["庾嶺東邊吏隱州，溪山竹樹亦清幽。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-21", "next": "795-23"}, "p23": {"key": "795-23", "title": "句", "author": "盧並", "canonical": "盧並", "lines": ["地靈無俗草，岩靜有仙禽。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-22", "next": "795-24"}, "p24": {"key": "795-24", "title": "句", "author": "繆島雲", "canonical": "繆島雲", "lines": ["白鳥遠行樹，玉虹孤飲潭。", "四五片霞生絕壁，兩三行雁過疎松。", "拋芥子降顛狒狒，折楊枝灑醉猩猩。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-23", "next": "795-25"}, "p25": {"key": "795-25", "title": "句", "author": "繆島雲", "canonical": "繆島雲", "lines": ["白鳥遠行樹，玉虹孤飲潭。", "四五片霞生絕壁，兩三行雁過疎松。", "拋芥子降顛狒狒，折楊枝灑醉猩猩。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-24", "next": "795-26"}, "p26": {"key": "795-26", "title": "句", "author": "繆島雲", "canonical": "繆島雲", "lines": ["白鳥遠行樹，玉虹孤飲潭。", "四五片霞生絕壁，兩三行雁過疎松。", "拋芥子降顛狒狒，折楊枝灑醉猩猩。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-25", "next": "795-27"}, "p27": {"key": "795-27", "title": "句", "author": "劉敬之", "canonical": "劉敬之", "lines": ["山近衡陽雖少雁，水連<a class=\"ent ent-place\" href=\"../entities/place_%E5%B7%B4%E8%9C%80.html\">巴蜀</a>豈無魚。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-26", "next": "795-28"}, "p28": {"key": "795-28", "title": "句", "author": "李濤", "canonical": "李濤", "lines": ["水聲長在耳，山色不離門。", "掃地樹留影，拂牀琴有聲。", "落日<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>道，秋槐滿地花。"], "form": "五言古體", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-27", "next": "795-29"}, "p29": {"key": "795-29", "title": "句", "author": "李濤", "canonical": "李濤", "lines": ["溪聲長在耳，山色不離門。", "掃地樹留影，拂妝琴有聲。", "一言寤主寧復聽，三諫不從歸去來。", "水聲長在耳，山色不離門。", "掃地樹留影，拂牀琴有聲。", "落日<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>道，秋槐滿地花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-28", "next": "795-30"}, "p30": {"key": "795-30", "title": "句", "author": "李濤", "canonical": "李濤", "lines": ["溪聲長在耳，山色不離門。", "掃地樹留影，拂妝琴有聲。", "一言寤主寧復聽，三諫不從歸去來。", "水聲長在耳，山色不離門。", "掃地樹留影，拂牀琴有聲。", "落日<a class=\"ent ent-place\" href=\"../entities/place_%E9%95%BF%E5%AE%89.html\">長安</a>道，秋槐滿地花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-29", "next": "795-31"}, "p31": {"key": "795-31", "title": "句", "author": "高元裕", "canonical": "高元裕", "lines": ["中丞為國拔賢才，寒俊欣逢藻鑒開。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-30", "next": "795-32"}, "p32": {"key": "795-32", "title": "句", "author": "韋澳", "canonical": "韋澳", "lines": ["莫將韋監同殷監，錯認容身是保身。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-31", "next": "795-33"}, "p33": {"key": "795-33", "title": "句", "author": "王龜", "canonical": "王龜", "lines": ["珠箔卷繁星，金樽瀉月明。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-32", "next": "795-34"}, "p34": {"key": "795-34", "title": "句", "author": "李郁", "canonical": "李郁", "lines": ["身死為修劉稹表，名高因讓陸洿書。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-33", "next": "795-35"}, "p35": {"key": "795-35", "title": "句", "author": "詹雄", "canonical": "詹雄", "lines": ["塵飛遺恨盡，花落古宮平。", "紅粉笙歌人代遠，月明陵樹水東流。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-34", "next": "795-36"}, "p36": {"key": "795-36", "title": "句", "author": "詹雄", "canonical": "詹雄", "lines": ["塵飛遺恨盡，花落古宮平。", "紅粉笙歌人代遠，月明陵樹水東流。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-35", "next": "795-37"}, "p37": {"key": "795-37", "title": "句", "author": "任濤", "canonical": "任濤", "lines": ["露團沙鶴起，人臥釣船流。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-36", "next": "795-38"}, "p38": {"key": "795-38", "title": "句", "author": "劇燕", "canonical": "劇燕", "lines": ["只向國門安四海，不離鄉井拜三公。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-37", "next": "795-39"}, "p39": {"key": "795-39", "title": "句", "author": "王璘", "canonical": "王璘", "lines": ["芍藥花開菩薩面，棕閭葉散野人頭。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-38", "next": "795-40"}, "p40": {"key": "795-40", "title": "句", "author": "李蔚", "canonical": "李蔚", "lines": ["虛心纖質雁銜餘，鳳吹龍吟定不如。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-39", "next": "795-41"}, "p41": {"key": "795-41", "title": "句", "author": "王枳", "canonical": "王枳", "lines": ["今朝拜貢盈襟淚，不進新芽是進心。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-40", "next": "795-42"}, "p42": {"key": "795-42", "title": "句", "author": "鄭賨", "canonical": "鄭賨", "lines": ["萬蘊千牌次碧牙，縹箋金字間明霞。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-41", "next": "795-43"}, "p43": {"key": "795-43", "title": "句", "author": "張塋", "canonical": "張塋", "lines": ["一箭不中鵠，<a class=\"ent ent-place\" href=\"../entities/place_%E4%BA%94%E6%B9%96.html\">五湖</a>歸釣魚。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-42", "next": "795-44"}, "p44": {"key": "795-44", "title": "句", "author": "吳靄", "canonical": "吳靄", "lines": ["煙隨紅焰斷，化作白雲飛。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-43", "next": "795-45"}, "p45": {"key": "795-45", "title": "句", "author": "陳詠", "canonical": "陳詠", "lines": ["隔岸水牛浮鼻渡，傍溪沙鳥點頭行。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-44", "next": "795-46"}, "p46": {"key": "795-46", "title": "句", "author": "蔣密", "canonical": "蔣密", "lines": ["綺羅因片葉，桃李謾同時。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-45", "next": "795-47"}, "p47": {"key": "795-47", "title": "句", "author": "符蒙", "canonical": "符蒙", "lines": ["都緣心似水，故以缽為舟。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-46", "next": "795-48"}, "p48": {"key": "795-48", "title": "句", "author": "李景遂", "canonical": "李景遂", "lines": ["路指丹陽分虎節，心存雙闕戀龍顏。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-47", "next": "795-49"}, "p49": {"key": "795-49", "title": "句", "author": "李弘茂", "canonical": "李弘茂", "lines": ["甜於泉水茶須信，狂似楊花蝶未知。", "半窗月在猶煎藥，幾夜燈閑不照書。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-48", "next": "795-50"}, "p50": {"key": "795-50", "title": "句", "author": "李弘茂", "canonical": "李弘茂", "lines": ["甜於泉水茶須信，狂似楊花蝶未知。", "半窗月在猶煎藥，幾夜燈閑不照書。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-49", "next": "795-51"}, "p51": {"key": "795-51", "title": "句", "author": "李平", "canonical": "李平", "lines": ["至人無夢夢不到，天道惡盈盈有餘。", "龍髯已斷嬪嬙老，豹尾不來岐路長。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-50", "next": "795-52"}, "p52": {"key": "795-52", "title": "句", "author": "李平", "canonical": "李平", "lines": ["至人無夢夢不到，天道惡盈盈有餘。", "龍髯已斷嬪嬙老，豹尾不來岐路長。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-51", "next": "795-53"}, "p53": {"key": "795-53", "title": "句", "author": "胡元龜", "canonical": "胡元龜", "lines": ["翻身騰白浪，探爪擢明珠。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-52", "next": "795-54"}, "p54": {"key": "795-54", "title": "句", "author": "蔣鉤", "canonical": "蔣鉤", "lines": ["因借夢書過竹寺，學耕秋粟繞茆原。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-53", "next": "795-55"}, "p55": {"key": "795-55", "title": "句", "author": "蔣鉤", "canonical": "蔣鉤", "lines": ["芭蕉葉上無愁雨，自是多情聽斷腸。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-54", "next": "795-56"}, "p56": {"key": "795-56", "title": "句", "author": "史虛白", "canonical": "史虛白", "lines": ["風雨揭卻屋，全家醉不知。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-55", "next": "795-57"}, "p57": {"key": "795-57", "title": "句", "author": "夏寶松", "canonical": "夏寶松", "lines": ["孤猨叫落中巖月，野客吟殘半夜燈。", "雁飛南浦砧初斷，月滿西樓酒半醒。", "曉來羸駟依前去，目斷遙山數點青。"], "form": "七言古體", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-56", "next": "795-58"}, "p58": {"key": "795-58", "title": "句", "author": "夏寶松", "canonical": "夏寶松", "lines": ["孤猨叫落中巖月，野客吟殘半夜燈。", "雁飛南浦砧初斷，月滿西樓酒半醒。", "曉來羸駟依前去，目斷遙山數點青。"], "form": "七言古體", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-57", "next": "795-59"}, "p59": {"key": "795-59", "title": "句", "author": "夏寶松", "canonical": "夏寶松", "lines": ["孤猨叫落中巖月，野客吟殘半夜燈。", "雁飛南浦砧初斷，月滿西樓酒半醒。", "曉來羸駟依前去，目斷遙山數點青。"], "form": "七言古體", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-58", "next": "795-60"}, "p60": {"key": "795-60", "title": "句", "author": "趙慶", "canonical": "趙慶", "lines": ["邁古文章金鸑鷟，出群行止玉麒麟。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-59", "next": "795-61"}, "p61": {"key": "795-61", "title": "句", "author": "潘天錫", "canonical": "潘天錫", "lines": ["風便磬聲遠，日斜樓影長。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-60", "next": "795-62"}, "p62": {"key": "795-62", "title": "句", "author": "朱勰", "canonical": "朱勰", "lines": ["好是晚來香雨裏，擔簦親送綺羅人。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-61", "next": "795-63"}, "p63": {"key": "795-63", "title": "句", "author": "齊鎬", "canonical": "齊鎬", "lines": ["蓮中花更好，雲裏月常新。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-62", "next": "795-64"}, "p64": {"key": "795-64", "title": "句", "author": "黃可", "canonical": "黃可", "lines": ["天下傳將舞馬賦，門前迎得跨驢賓。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-63", "next": "795-65"}, "p65": {"key": "795-65", "title": "句", "author": "高元矩", "canonical": "高元矩", "lines": ["硯貯寒泉碧，庭堆敗葉紅。", "燕掠琴弦穿靜院，吏收詩草下閑庭。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-64", "next": "795-66"}, "p66": {"key": "795-66", "title": "句", "author": "高元矩", "canonical": "高元矩", "lines": ["硯貯寒泉碧，庭堆敗葉紅。", "燕掠琴弦穿靜院，吏收詩草下閑庭。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-65", "next": "795-67"}, "p67": {"key": "795-67", "title": "句", "author": "陳貺", "canonical": "陳貺", "lines": ["年年聞爾者，未有不傷情。", "出得風塵者，合知岐路人。", "拂榻燈未來，開門月先入。", "忽生雲是匣，高以月爲臺。", "入夜雖無傷物意，向明還有動人心。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-66", "next": "795-68"}, "p68": {"key": "795-68", "title": "句", "author": "陳貺", "canonical": "陳貺", "lines": ["年年聞爾者，未有不傷情。", "出得風塵者，合知岐路人。", "拂榻燈未來，開門月先入。", "忽生雲是匣，高以月爲臺。", "入夜雖無傷物意，向明還有動人心。", "醒眼看諸峰，白雲開又集。", "（見《能改齋漫錄》卷八。", "）（按：中華上編本《能改齋漫錄》引此作「五代時陳况詩」，「况」爲「貺」之誤，鄭方坤《五代詩話》卷三所引不誤。", "）。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-67", "next": "795-69"}, "p69": {"key": "795-69", "title": "句", "author": "陳貺", "canonical": "陳貺", "lines": ["年年聞爾者，未有不傷情。", "出得風塵者，合知岐路人。", "拂榻燈未來，開門月先入。", "忽生雲是匣，高以月爲臺。", "入夜雖無傷物意，向明還有動人心。", "醒眼看諸峰，白雲開又集。", "（見《能改齋漫錄》卷八。", "）（按：中華上編本《能改齋漫錄》引此作「五代時陳况詩」，「况」爲「貺」之誤，鄭方坤《五代詩話》卷三所引不誤。", "）。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-68", "next": "795-70"}, "p70": {"key": "795-70", "title": "句", "author": "陳貺", "canonical": "陳貺", "lines": ["年年聞爾者，未有不傷情。", "出得風塵者，合知岐路人。", "拂榻燈未來，開門月先入。", "忽生雲是匣，高以月爲臺。", "入夜雖無傷物意，向明還有動人心。", "醒眼看諸峰，白雲開又集。", "（見《能改齋漫錄》卷八。", "）（按：中華上編本《能改齋漫錄》引此作「五代時陳况詩」，「况」爲「貺」之誤，鄭方坤《五代詩話》卷三所引不誤。", "）。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-69", "next": "795-71"}, "p71": {"key": "795-71", "title": "句", "author": "陳貺", "canonical": "陳貺", "lines": ["年年聞爾者，未有不傷情。", "出得風塵者，合知岐路人。", "拂榻燈未來，開門月先入。", "忽生雲是匣，高以月爲臺。", "入夜雖無傷物意，向明還有動人心。", "醒眼看諸峰，白雲開又集。", "（見《能改齋漫錄》卷八。", "）（按：中華上編本《能改齋漫錄》引此作「五代時陳况詩」，「况」爲「貺」之誤，鄭方坤《五代詩話》卷三所引不誤。", "）。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-70", "next": "795-72"}, "p72": {"key": "795-72", "title": "句", "author": "趙休", "canonical": "趙休", "lines": ["金莖來白露，玉宇起清風。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-71", "next": "795-73"}, "p73": {"key": "795-73", "title": "句", "author": "庸仁傑", "canonical": "庸仁傑", "lines": ["紅斾渡江霞蘸水，青蛇出匣雪侵衣。", "雲散便凝千里望，日斜長占半城陰。", "只住此山寧有意，向來求佛本無心。"], "form": "七言古體", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-72", "next": "795-74"}, "p74": {"key": "795-74", "title": "句", "author": "庸仁傑", "canonical": "庸仁傑", "lines": ["紅斾渡江霞蘸水，青蛇出匣雪侵衣。", "雲散便凝千里望，日斜長占半城陰。", "只住此山寧有意，向來求佛本無心。"], "form": "七言古體", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-73", "next": "795-75"}, "p75": {"key": "795-75", "title": "句", "author": "庸仁傑", "canonical": "庸仁傑", "lines": ["紅斾渡江霞蘸水，青蛇出匣雪侵衣。", "雲散便凝千里望，日斜長占半城陰。", "只住此山寧有意，向來求佛本無心。"], "form": "七言古體", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-74", "next": "795-76"}, "p76": {"key": "795-76", "title": "句", "author": "邵拙", "canonical": "邵拙", "lines": ["萬國不得雨，孤雲猶在山。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-75", "next": "795-77"}, "p77": {"key": "795-77", "title": "句", "author": "毛炳", "canonical": "毛炳", "lines": ["先生不在此，千載只空山。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-76", "next": "795-78"}, "p78": {"key": "795-78", "title": "句", "author": "陳德誠", "canonical": "陳德誠", "lines": ["建水舊傳劉夜坐，螺川新有夏江城。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-77", "next": "795-79"}, "p79": {"key": "795-79", "title": "句", "author": "陳甫", "canonical": "陳甫", "lines": ["一雨洗殘暑，萬家生早涼。", "暮鳥歸巢急，寒牛下隴遲。", "算吟千百首，方得兩三聯。", "清時不作登龍客，綠鬢閑梳傍草堂。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-78", "next": "795-80"}, "p80": {"key": "795-80", "title": "句", "author": "陳甫", "canonical": "陳甫", "lines": ["一雨洗殘暑，萬家生早涼。", "暮鳥歸巢急，寒牛下隴遲。", "算吟千百首，方得兩三聯。", "清時不作登龍客，綠鬢閑梳傍草堂。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-79", "next": "795-81"}, "p81": {"key": "795-81", "title": "句", "author": "陳甫", "canonical": "陳甫", "lines": ["一雨洗殘暑，萬家生早涼。", "暮鳥歸巢急，寒牛下隴遲。", "算吟千百首，方得兩三聯。", "清時不作登龍客，綠鬢閑梳傍草堂。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-80", "next": "795-82"}, "p82": {"key": "795-82", "title": "句", "author": "陳甫", "canonical": "陳甫", "lines": ["一雨洗殘暑，萬家生早涼。", "暮鳥歸巢急，寒牛下隴遲。", "算吟千百首，方得兩三聯。", "清時不作登龍客，綠鬢閑梳傍草堂。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-81", "next": "795-83"}, "p83": {"key": "795-83", "title": "句", "author": "徐融", "canonical": "徐融", "lines": ["淮船分蟻隊，江市聚蠅聲。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-82", "next": "795-84"}, "p84": {"key": "795-84", "title": "句", "author": "高若拙", "canonical": "高若拙", "lines": ["人間不見月，天外自分明。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-83", "next": "795-85"}, "p85": {"key": "795-85", "title": "句", "author": "皮光業", "canonical": "皮光業", "lines": ["燒平樵路出，潮落海山高。", "行人折柳[和輕]絮，飛燕銜泥帶落花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-84", "next": "795-86"}, "p86": {"key": "795-86", "title": "句", "author": "皮光業", "canonical": "皮光業", "lines": ["燒平樵路出，潮落海山高。", "行人折柳[和輕]絮，飛燕銜泥帶落花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-85", "next": "795-87"}, "p87": {"key": "795-87", "title": "句", "author": "屠瓌智", "canonical": "屠瓌智", "lines": ["輕身都是義，殉主始為忠。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-86", "next": "795-88"}, "p88": {"key": "795-88", "title": "句", "author": "元德昭", "canonical": "元德昭", "lines": ["滿堂羅綺兼朱紫，四代兒孫奉老翁。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-87", "next": "795-89"}, "p89": {"key": "795-89", "title": "句", "author": "林無隱", "canonical": "林無隱", "lines": ["雪消二月江湖闊，花發千山道路香。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-88", "next": "795-90"}, "p90": {"key": "795-90", "title": "句", "author": "楊義方", "canonical": "楊義方", "lines": ["海邊紅日半離水，天外暖風輕到花。", "雨聲鞭自禁門出，一簇人從天上來。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-89", "next": "795-91"}, "p91": {"key": "795-91", "title": "句", "author": "楊義方", "canonical": "楊義方", "lines": ["海邊紅日半離水，天外暖風輕到花。", "雨聲鞭自禁門出，一簇人從天上來。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-90", "next": "795-92"}, "p92": {"key": "795-92", "title": "句", "author": "王廷珪", "canonical": "王廷珪", "lines": ["十字水中分島嶼，數重花外見樓臺。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-91", "next": "795-93"}, "p93": {"key": "795-93", "title": "句", "author": "歐陽彬", "canonical": "歐陽彬", "lines": ["無錢將乞樊知客，名紙生毛不爲通。", "桑柘殘陽裏，兒孫落葉中。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-92", "next": "795-94"}, "p94": {"key": "795-94", "title": "句", "author": "歐陽彬", "canonical": "歐陽彬", "lines": ["無錢將乞樊知客，名紙生毛不爲通。", "桑柘殘陽裏，兒孫落葉中。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-93", "next": "795-95"}, "p95": {"key": "795-95", "title": "句", "author": "李堯夫", "canonical": "李堯夫", "lines": ["向外疑無地，其中別有天。", "方外共推爲道友，<a class=\"ent ent-place\" href=\"../entities/place_%E5%85%B3%E4%B8%AD.html\">關中</a>獨自占詩家。", "炎暑鬱蒸無處避，涼風消息幾時來。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-94", "next": "795-96"}, "p96": {"key": "795-96", "title": "句", "author": "李堯夫", "canonical": "李堯夫", "lines": ["向外疑無地，其中別有天。", "方外共推爲道友，<a class=\"ent ent-place\" href=\"../entities/place_%E5%85%B3%E4%B8%AD.html\">關中</a>獨自占詩家。", "炎暑鬱蒸無處避，涼風消息幾時來。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-95", "next": "795-97"}, "p97": {"key": "795-97", "title": "句", "author": "李堯夫", "canonical": "李堯夫", "lines": ["向外疑無地，其中別有天。", "方外共推爲道友，<a class=\"ent ent-place\" href=\"../entities/place_%E5%85%B3%E4%B8%AD.html\">關中</a>獨自占詩家。", "炎暑鬱蒸無處避，涼風消息幾時來。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-96", "next": "795-98"}, "p98": {"key": "795-98", "title": "句", "author": "石文德", "canonical": "石文德", "lines": ["月沈湘浦冷，花謝漢宮秋。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-97", "next": "795-99"}, "p99": {"key": "795-99", "title": "句", "author": "戴偃", "canonical": "戴偃", "lines": ["須把咽喉吞世界，蓋因奢侈致危亡。", "若須拋却便拋却，莫待風高更亦深。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-98", "next": "795-100"}, "p100": {"key": "795-100", "title": "句", "author": "戴偃", "canonical": "戴偃", "lines": ["須把咽喉吞世界，蓋因奢侈致危亡。", "若須拋却便拋却，莫待風高更亦深。"], "form": "七絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-99", "next": "795-101"}, "p101": {"key": "795-101", "title": "句", "author": "張迥", "canonical": "張迥", "lines": ["夜長燈影滅，天繞鶴聲孤。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-100", "next": "795-102"}, "p102": {"key": "795-102", "title": "句", "author": "鍾元章", "canonical": "鍾元章", "lines": ["金筈離弦三尺電，星髇破的一聲雷。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-101", "next": "795-103"}, "p103": {"key": "795-103", "title": "句", "author": "楊鳧", "canonical": "楊鳧", "lines": ["背日流泉生凍早，逆風歸鳥入巢遲。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-102", "next": "795-104"}, "p104": {"key": "795-104", "title": "句", "author": "王俊", "canonical": "王俊", "lines": ["勝日登樓望，山川一半春。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-103", "next": "795-105"}, "p105": {"key": "795-105", "title": "句", "author": "薛沆", "canonical": "薛沆", "lines": ["也知別有風光主，花蕾枝枝似去年。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-104", "next": "795-106"}, "p106": {"key": "795-106", "title": "句", "author": "張顗", "canonical": "張顗", "lines": ["金殿聖人看縱筆，玉堂詞客盡裁詩。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-105", "next": "795-107"}, "p107": {"key": "795-107", "title": "句", "author": "張林", "canonical": "張林", "lines": ["菱葉乍翻人采後，芰荷初沒舸行時。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-106", "next": "795-108"}, "p108": {"key": "795-108", "title": "句", "author": "盧休", "canonical": "盧休", "lines": ["春寒酒力遲，冉冉生微紅。", "自然草木姓，誰祝元化功。", "湓浦風生破膽愁，血染劍花明帳幕。", "三千車馬出<a class=\"ent ent-place\" href=\"../entities/place_%E6%B8%94%E9%98%B3.html\">漁陽</a>，入門堪笑復堪憐。", "三逕苔荒一釣船。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-107", "next": "795-109"}, "p109": {"key": "795-109", "title": "句", "author": "盧休", "canonical": "盧休", "lines": ["春寒酒力遲，冉冉生微紅。", "自然草木姓，誰祝元化功。", "湓浦風生破膽愁，血染劍花明帳幕。", "三千車馬出<a class=\"ent ent-place\" href=\"../entities/place_%E6%B8%94%E9%98%B3.html\">漁陽</a>，入門堪笑復堪憐。", "三逕苔荒一釣船。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-108", "next": "795-110"}, "p110": {"key": "795-110", "title": "句", "author": "盧休", "canonical": "盧休", "lines": ["湓浦風生破膽愁。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-109", "next": "795-111"}, "p111": {"key": "795-111", "title": "句", "author": "盧休", "canonical": "盧休", "lines": ["春寒酒力遲，冉冉生微紅。", "自然草木姓，誰祝元化功。", "湓浦風生破膽愁，血染劍花明帳幕。", "三千車馬出<a class=\"ent ent-place\" href=\"../entities/place_%E6%B8%94%E9%98%B3.html\">漁陽</a>，入門堪笑復堪憐。", "三逕苔荒一釣船。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-110", "next": "795-112"}, "p112": {"key": "795-112", "title": "句", "author": "盧休", "canonical": "盧休", "lines": ["春寒酒力遲，冉冉生微紅。", "自然草木姓，誰祝元化功。", "湓浦風生破膽愁，血染劍花明帳幕。", "三千車馬出<a class=\"ent ent-place\" href=\"../entities/place_%E6%B8%94%E9%98%B3.html\">漁陽</a>，入門堪笑復堪憐。", "三逕苔荒一釣船。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-111", "next": "795-113"}, "p113": {"key": "795-113", "title": "句", "author": "陳嶠", "canonical": "陳嶠", "lines": ["小橋風月年年事，爭奈潘郎去<span class=\"lacuna\" title=\"底本阙字\">□</span>何。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-112", "next": "795-114"}, "p114": {"key": "795-114", "title": "句", "author": "李範", "canonical": "李範", "lines": ["清猨啼遠木，白鳥下前灘。", "鶴歸秋漢遠，人去草堂空。", "雖當南北路，不礙往來人。", "釣叟無機沙鳥睡，禪師入定白牛閑。", "天涯故友無來信，窗外拒霜空落花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-113", "next": "795-115"}, "p115": {"key": "795-115", "title": "句", "author": "李範", "canonical": "李範", "lines": ["清猨啼遠木，白鳥下前灘。", "鶴歸秋漢遠，人去草堂空。", "雖當南北路，不礙往來人。", "釣叟無機沙鳥睡，禪師入定白牛閑。", "天涯故友無來信，窗外拒霜空落花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-114", "next": "795-116"}, "p116": {"key": "795-116", "title": "句", "author": "李範", "canonical": "李範", "lines": ["清猨啼遠木，白鳥下前灘。", "鶴歸秋漢遠，人去草堂空。", "雖當南北路，不礙往來人。", "釣叟無機沙鳥睡，禪師入定白牛閑。", "天涯故友無來信，窗外拒霜空落花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-115", "next": "795-117"}, "p117": {"key": "795-117", "title": "句", "author": "李範", "canonical": "李範", "lines": ["清猨啼遠木，白鳥下前灘。", "鶴歸秋漢遠，人去草堂空。", "雖當南北路，不礙往來人。", "釣叟無機沙鳥睡，禪師入定白牛閑。", "天涯故友無來信，窗外拒霜空落花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-116", "next": "795-118"}, "p118": {"key": "795-118", "title": "句", "author": "李範", "canonical": "李範", "lines": ["清猨啼遠木，白鳥下前灘。", "鶴歸秋漢遠，人去草堂空。", "雖當南北路，不礙往來人。", "釣叟無機沙鳥睡，禪師入定白牛閑。", "天涯故友無來信，窗外拒霜空落花。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-117", "next": "795-119"}, "p119": {"key": 