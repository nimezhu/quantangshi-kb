l, "src": "yuding", "pilot": false, "prev": "795-126", "next": "795-128"}, "p128": {"key": "795-128", "title": "句", "author": "鄭翱", "canonical": "鄭翱", "lines": ["花燒落第眼，雨破到家程。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-127", "next": "795-129"}, "p129": {"key": "795-129", "title": "句", "author": "鄭說", "canonical": "鄭說", "lines": ["架上紫衣閑不著，案頭金字坐長看。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-128", "next": "795-130"}, "p130": {"key": "795-130", "title": "句", "author": "史瑜", "canonical": "史瑜", "lines": ["溪從沮水流嶓塚，嶺接青泥入劍天。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-129", "next": "795-131"}, "p131": {"key": "795-131", "title": "句", "author": "賀公", "canonical": "賀公", "lines": ["但存方寸地，留與子孫耕。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-130", "next": "795-132"}, "p132": {"key": "795-132", "title": "句", "author": "米都知", "canonical": "米都知", "lines": ["小旗村店酒，微雨野塘花。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-131", "next": "795-133"}, "p133": {"key": "795-133", "title": "句", "author": "陳秀才", "canonical": "陳秀才", "lines": ["地偏雲自去，日暮山更深。"], "form": "五言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-132", "next": "795-134"}, "p134": {"key": "795-134", "title": "句", "author": "崔李二生", "canonical": "崔李二生", "lines": ["恰似傳花人飲散，空拋床下最繁枝。", "--崔", "豔魄香魂如有在，還應羞見墮樓人。", "--李"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "795-133", "next": "795-135"}, "p135": {"key": "795-135", "title": "句", "author": "范氏子", "canonical": "范氏子", "lines": ["掃葉隨風便，澆花趁日陰。", "閑雲生不雨，病葉落非秋。"], "form": "五絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-134", "next": "795-136"}, "p136": {"key": "795-136", "title": "句", "author": "范氏子", "canonical": "范氏子", "lines": ["掃葉隨風便，澆花趁日陰。", "閑雲生不雨，病葉落非秋。"], "form": "五絕", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-135", "next": "795-137"}, "p137": {"key": "795-137", "title": "句", "author": "臨川小吏", "canonical": "臨川小吏", "lines": ["三月能辭千日醉，一生能得幾回看。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-136", "next": "795-138"}, "p138": {"key": "795-138", "title": "句", "author": "韓熙載客", "canonical": "韓熙載客", "lines": ["最是五更留不住，向人枕畔著衣裳。"], "form": "七言古體", "t300": null, "src": "yuding", "pilot": false, "prev": "795-137", "next": "795-139"}, "p139": {"key": "795-139", "title": "句", "author": "段義宗", "canonical": "段義宗", "lines": ["懸心秋夜月，萬里照鄉關。", "玉排複道珊瑚殿，金錯危椆翡翠樓。", "此花不與衆花同，爲感高僧護法功。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-138", "next": "795-140"}, "p140": {"key": "795-140", "title": "句", "author": "段義宗", "canonical": "段義宗", "lines": ["懸心秋夜月，萬里照鄉關。", "玉排複道珊瑚殿，金錯危椆翡翠樓。", "此花不與衆花同，爲感高僧護法功。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-139", "next": "795-141"}, "p141": {"key": "795-141", "title": "句", "author": "段義宗", "canonical": "段義宗", "lines": ["懸心秋夜月，萬里照鄉關。", "玉排複道珊瑚殿，金錯危椆翡翠樓。", "此花不與衆花同，爲感高僧護法功。"], "form": "雜言", "t300": null, "src": "poet.tang", "pilot": false, "prev": "795-140", "next": null}}}