{"vol_name": "卷一十一", "poems": {"p01": {"key": "011-01", "title": "郊廟歌辭：五郊樂章：黃帝宮音", "author": "不詳", "canonical": "不詳", "lines": ["黃中正位，含章居貞。", "既長六律，兼和五聲。", "畢陳萬舞，乃薦斯牲。", "神其下降，永祚休平。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": null, "next": "011-02"}, "p02": {"key": "011-02", "title": "郊廟歌辭：五郊樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["眇眇方輿，蒼蒼圜蓋。", "至哉樞紐，宅中圖大。", "氣調四序，風和萬籟。", "祚我明德，時雍道泰。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-01", "next": "011-03"}, "p03": {"key": "011-03", "title": "郊廟歌辭：五郊樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["金縣夕肆，玉俎朝陳。", "饗薦黃道，芬流紫宸。", "乃誠乃敬，載享載禋。", "崇薦斯在，惟皇是賓。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-02", "next": "011-04"}, "p04": {"key": "011-04", "title": "郊廟歌辭：五郊樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["禦征乘宮出郊甸，安歌率舞遞將迎。", "自有雲門符帝賞，猶持雷鼓答天成。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "011-03", "next": "011-05"}, "p05": {"key": "011-05", "title": "郊廟歌辭：五郊樂章：青帝角音", "author": "不詳", "canonical": "不詳", "lines": ["鶴雲旦起，鳥星昏集。", "律候新風，陽開初蟄。", "<a class=\"ent ent-time\" href=\"../entities/time_%E8%87%B3%E5%BE%B7.html\">至德</a>可饗，行潦斯挹。", "錫以無疆，蒸人乃粒。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-04", "next": "011-06"}, "p06": {"key": "011-06", "title": "郊廟歌辭：五郊樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["玄鳥司春，蒼龍登歲。", "節物變柳，光風轉蕙。", "瑤席降神，朱弦饗帝。", "誠備祝嘏，禮殫珪幣。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-05", "next": "011-07"}, "p07": {"key": "011-07", "title": "郊廟歌辭：五郊樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["大樂稀音，至誠簡禮。", "文物棣棣，聲明濟濟。", "六變有成，三登無體。", "乃眷豐潔，恩覃愷悌。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-06", "next": "011-08"}, "p08": {"key": "011-08", "title": "郊廟歌辭：五郊樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["笙歌鑰舞屬年韶，鷺鼓鳧鐘展時豫。", "調露初迎綺春節，承雲遽踐蒼霄馭。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "011-07", "next": "011-09"}, "p09": {"key": "011-09", "title": "郊廟歌辭：五郊樂章：赤帝征音", "author": "不詳", "canonical": "不詳", "lines": ["青陽告謝，朱明戒序。", "延長是祈，敬陳椒醑。", "博碩斯薦，笙鏞備舉。", "庶盡肅恭，非馨稷黍。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-08", "next": "011-10"}, "p10": {"key": "011-10", "title": "郊廟歌辭：五郊樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["離位克明，火中宵見。", "峰雲暮起，景風晨扇。", "木槿初榮，含桃可薦。", "芬馥百品，鏗鏘三變。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-09", "next": "011-11"}, "p11": {"key": "011-11", "title": "郊廟歌辭：五郊樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["昭昭丹陸，奕奕炎方。", "禮陳牲幣，樂備篪簧。", "瓊羞溢俎，玉醑浮觴。", "恭惟正直，歆此馨香。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-10", "next": "011-12"}, "p12": {"key": "011-12", "title": "郊廟歌辭：五郊樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["千里溫風飄絳羽，十枝炎景剩朱幹。", "陳觴薦俎歌三獻，拊石摐金會七盤。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "011-11", "next": "011-13"}, "p13": {"key": "011-13", "title": "郊廟歌辭：五郊樂章：白帝商音", "author": "不詳", "canonical": "不詳", "lines": ["白藏應節，天高氣清。", "歲功既阜，庶類收成。", "萬方靜謐，九土和平。", "馨香是薦，受祚聰明。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-12", "next": "011-14"}, "p14": {"key": "011-14", "title": "郊廟歌辭：五郊樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["金行在節，素靈居正。", "氣肅霜嚴，林凋草勁。", "豺祭隼擊，潦收川鏡。", "九谷已登，萬箱流詠。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-13", "next": "011-15"}, "p15": {"key": "011-15", "title": "郊廟歌辭：五郊樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["律應西成，氣躔南呂。", "珪幣咸列，笙竽備舉。", "苾苾蘭羞，芬芬桂醑。", "式資宴貺，用調霜序。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-14", "next": "011-16"}, "p16": {"key": "011-16", "title": "郊廟歌辭：五郊樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["璿儀氣爽驚緹鑰，玉呂灰飛含素商。", "鳴鞞奏管芳羞薦，會舞安歌葆眊揚。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "011-15", "next": "011-17"}, "p17": {"key": "011-17", "title": "郊廟歌辭：五郊樂章：黑帝羽音", "author": "不詳", "canonical": "不詳", "lines": ["嚴冬季月，星回風厲。", "享祀報功，方祚來歲。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-16", "next": "011-18"}, "p18": {"key": "011-18", "title": "郊廟歌辭：五郊樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["律回玉管，星周金度。", "次極陽烏，紀窮陰兔。", "火林霰雪，陽泉凝冱。", "八蠟已登，三農息務。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-17", "next": "011-19"}, "p19": {"key": "011-19", "title": "郊廟歌辭：五郊樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["陽月斯紀，應鐘在候。", "載潔牲牷，爰登俎豆。", "既高既遠，無聲無臭。", "靜言格思，惟神保佑。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-18", "next": "011-20"}, "p20": {"key": "011-20", "title": "郊廟歌辭：五郊樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["執鑰持羽初終曲，朱幹玉戚始分行。", "七德九功咸已暢，明靈降福具穰穰。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "011-19", "next": "011-21"}, "p21": {"key": "011-21", "title": "郊廟歌辭：五郊樂章：黃郊迎神", "author": "不詳", "canonical": "不詳", "lines": ["朱明季序，黃郊王辰。", "厚以載物，甘以養人。", "毓金為體，稟火成身。", "宮音式奏，奏以迎神。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-20", "next": "011-22"}, "p22": {"key": "011-22", "title": "郊廟歌辭：五郊樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["春末冬暮，徂夏杪秋。", "土王四月，時季一周。", "黍稷已享，籩豆宜收。", "送神有樂，神其賜休。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-21", "next": "011-23"}, "p23": {"key": "011-23", "title": "郊廟歌辭：五郊樂章：青郊迎神", "author": "不詳", "canonical": "不詳", "lines": ["緹幕移候，青郊啟蟄。", "淑景遲遲，和風習習。", "璧玉宵備，旌旄曙立。", "張樂以迎，帝神其入。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-22", "next": "011-24"}, "p24": {"key": "011-24", "title": "郊廟歌辭：五郊樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["文物流彩，聲明動色。", "人竭其恭，靈昭其飭。", "歆薦不已，垂禎無極。", "送禮有章，惟神還軾。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-23", "next": "011-25"}, "p25": {"key": "011-25", "title": "郊廟歌辭：五郊樂章：赤郊迎神", "author": "不詳", "canonical": "不詳", "lines": ["青陽節謝，朱明候改。", "靡草凋華，含桃流彩。", "簴列鐘磬，筵陳脯醢。", "樂以迎神，神其如在。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-24", "next": "011-26"}, "p26": {"key": "011-26", "title": "郊廟歌辭：五郊樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["炎精式降，蒼生攸仰。", "羞列豆籩，酒陳犧象。", "昭祀有應，冥期不爽。", "送樂張音，惟靈之往。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-25", "next": "011-27"}, "p27": {"key": "011-27", "title": "郊廟歌辭：五郊樂章：白郊迎神", "author": "不詳", "canonical": "不詳", "lines": ["序移玉律，節應金商。", "天嚴殺氣，吹警秋方。", "槱燎既積，稷奠並芳。", "樂以迎奏，庶降神光。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-26", "next": "011-28"}, "p28": {"key": "011-28", "title": "郊廟歌辭：五郊樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["祀遵五禮，時屬三秋。", "人懷肅敬，靈降禎休。", "奠歆旨酒，薦享珍羞。", "載張送樂，神其上游。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-27", "next": "011-29"}, "p29": {"key": "011-29", "title": "郊廟歌辭：五郊樂章：黑郊迎神", "author": "不詳", "canonical": "不詳", "lines": ["玄英戒序，黑郊臨候。", "掌禮陳彝，司筵執豆。", "寒氛斂色，冱泉凝漏。", "樂以迎神，八音斯奏。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-28", "next": "011-30"}, "p30": {"key": "011-30", "title": "郊廟歌辭：五郊樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["北郊時冽，南陸輝處。", "奠本虔誠，獻彌恭慮。", "上延祉福，下承歡豫。", "廣樂送神，神其整馭。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-29", "next": "011-31"}, "p31": {"key": "011-31", "title": "郊廟歌辭：朝日樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["惟聖格天，惟明饗日。", "帝郊肆類，王宮戒吉。", "珪奠春舒，鐘歌曉溢。", "禮雲克備，斯文有秩。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-30", "next": "011-32"}, "p32": {"key": "011-32", "title": "郊廟歌辭：朝日樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["晨儀式薦，明祀惟光。", "神物爰止，靈暉載揚。", "玄端肅事，紫幄興祥。", "福履攸假，于昭允王。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-31", "next": "011-33"}, "p33": {"key": "011-33", "title": "郊廟歌辭：朝日樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["崇牙樹羽延調露，旋宮扣律掩承雲。", "誕敷懿德昭神武，載集豐功表睿文。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "011-32", "next": "011-34"}, "p34": {"key": "011-34", "title": "郊廟歌辭：朝日樂章：迎神", "author": "不詳", "canonical": "不詳", "lines": ["太陽朝序，王宮有儀。", "蟠桃彩駕，細柳光馳。", "軒祥表合，漢曆彰奇。", "禮和樂備，神其降斯。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-33", "next": "011-35"}, "p35": {"key": "011-35", "title": "郊廟歌辭：朝日樂章：送神", "author": "不詳", "canonical": "不詳", "lines": ["五齊兼酌，百羞具陳。", "樂終廣奏，禮畢崇禋。", "明鑒萬宇，照臨兆人。", "永流洪慶，式動曦輪。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-34", "next": "011-36"}, "p36": {"key": "011-36", "title": "郊廟歌辭：夕月樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["測妙為神，通微曰聖。", "坎祀貽則，郊禋展敬。", "璧薦登光，金歌動映。", "以載嘉德，以流曾慶。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-35", "next": "011-37"}, "p37": {"key": "011-37", "title": "郊廟歌辭：夕月樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["朏晨爭舉，天宗禮辟。", "夜典涼秋，陰明湛夕。", "有𨣧斯旨，有牲斯碩。", "穆穆其暉，穰穰是積。", "卷<span class=\"lacuna\" title=\"底本阙字\">□</span>_<span class=\"lacuna\" title=\"底本阙字\">□</span>《郊廟歌辭。", "夕月樂章。", "舒和》", "合吹八風金奏動，分容萬舞玉鞘驚。", "詞昭茂典光前列，夕曜乘功表盛明。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-36", "next": "011-38"}, "p38": {"key": "011-38", "title": "郊廟歌辭：祀九宮貴神樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["於昭上穹，臨下有光。", "羽翼五佐，周流八荒。", "誰其饗之，時文對揚。", "虞經夏典，茲禮未遑。", "黑帝旋馭，青躔導日。", "金籙上玄，玉堂初吉。", "鉤陳夕次，鑾和先蹕。", "藹藹群靈，昭昭咸秩。", "帝臨中壇，受厘元神。", "皇靈萃止，羽旄肅陳。", "攝提運衡，招搖移輪。", "光光宇宙，電耀雷震。", "夜如何其，明星煌煌。", "天清容衛，露結壇場。", "樹羽幢幢，佩玉鏘鏘。", "凝精駐目，瞻望神光。", "九位既肅，萬靈畢會。", "天門啟扃，日馭飛蓋。", "煥兮棽離，儐兮暗靄。", "如山之福，惟聖時對。", "崇崇泰壇，靈具臨兮。", "鏗鍠大樂，振動心兮。", "神之降矣，卿雲鬱兮。", "神之至止，清風肅兮。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-37", "next": "011-39"}, "p39": {"key": "011-39", "title": "郊廟歌辭：祀九宮貴神樂章：太和", "author": "不詳", "canonical": "不詳", "lines": ["帝在靈壇，大明登光。", "天回雲粹，穆穆皇皇。", "金奏九夏，圭陳八薌。", "曠哉動植，如熙春陽。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-38", "next": "011-40"}, "p40": {"key": "011-40", "title": "郊廟歌辭：祀九宮貴神樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["歌工既奏，神位既秩。", "天符眾星，運行太一。", "聲和十管，氣應中律。", "肅肅明廷，介茲元吉。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-39", "next": "011-41"}, "p41": {"key": "011-41", "title": "郊廟歌辭：祀九宮貴神樂章：雍和", "author": "不詳", "canonical": "不詳", "lines": ["俎豆有踐，黃流在尊。", "九宮之祀，三代莫存。", "樂變六宮，壇開八門。", "聖皇昭對，佑我黎元。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-40", "next": "011-42"}, "p42": {"key": "011-42", "title": "郊廟歌辭：祀九宮貴神樂章：壽和", "author": "不詳", "canonical": "不詳", "lines": ["時文哲後，肅事嚴禋。", "馨我明德，享於貴神。", "大庖載盈，旨酒斯醇。", "精意所屬，期於利人。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-41", "next": "011-43"}, "p43": {"key": "011-43", "title": "郊廟歌辭：祀九宮貴神樂章：福和", "author": "不詳", "canonical": "不詳", "lines": ["祀既雲畢，明靈告旋。", "禮洽和應，神歆福延。", "動植咸若，陰陽不愆。", "錫茲純嘏，天子萬年。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-42", "next": "011-44"}, "p44": {"key": "011-44", "title": "郊廟歌辭：祀九宮貴神樂章：舒和", "author": "不詳", "canonical": "不詳", "lines": ["羽鑰既闋幹戚陳，八音克諧六變新。", "愉貴神兮般以樂，保皇祚兮萬斯春。"], "form": "七絕", "t300": null, "src": "yuding", "pilot": false, "prev": "011-43", "next": "011-45"}, "p45": {"key": "011-45", "title": "郊廟歌辭：祀九宮貴神樂章：凱安", "author": "不詳", "canonical": "不詳", "lines": ["盛德陳萬舞，威棱暢九垓。", "風雲交律候，日月麗昭回。", "行慶休祥發，乘和春氣來。", "百神肅臨享，蕩蕩天門開。"], "form": "五律", "t300": null, "src": "yuding", "pilot": false, "prev": "011-44", "next": "011-46"}, "p46": {"key": "011-46", "title": "郊廟歌辭：祀九宮貴神樂章：肅和", "author": "不詳", "canonical": "不詳", "lines": ["精意嚴恭，明祠豐潔。", "獻酬既備，俎豆斯撤。", "日麗天儀，風和樂節。", "事光祀典，福覃有截。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-45", "next": "011-47"}, "p47": {"key": "011-47", "title": "郊廟歌辭：祀九宮貴神樂章：豫和", "author": "不詳", "canonical": "不詳", "lines": ["享申百禮，慶洽百靈。", "上排閶闔，洞入杳冥。", "奠玉高壇，燔柴廣庭。", "神之降福，萬國咸寧。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-46", "next": "011-48"}, "p48": {"key": "011-48", "title": "郊廟歌辭：祀風師樂章：迎神", "author": "包佶", "canonical": "包佶", "lines": ["太皞禦氣，句芒肇功。", "蒼龍青旗，爰候祥風。", "律以和應，神以感通。", "鼎俎修蚃，時惟禮崇。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-47", "next": "011-49"}, "p49": {"key": "011-49", "title": "郊廟歌辭：祀風師樂章：奠幣登歌", "author": "包佶", "canonical": "包佶", "lines": ["旨酒告絜，青蘋應候。", "禮陳瑤幣，樂獻金奏。", "彈弦自昔，解凍惟舊。", "仰瞻肸蚃，群祥來湊。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-48", "next": "011-50"}, "p50": {"key": "011-50", "title": "郊廟歌辭：祀風師樂章：迎俎酌獻", "author": "包佶", "canonical": "包佶", "lines": ["德盛昭臨，迎拜巽方。", "爰候發生，式薦馨香。", "酌醴具舉，工歌載揚。", "神歆六律，恩降百祥。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-49", "next": "011-51"}, "p51": {"key": "011-51", "title": "郊廟歌辭：祀風師樂章：亞獻終獻", "author": "包佶", "canonical": "包佶", "lines": ["膋薌備，玉帛陳。", "風動物，樂感神。", "三獻終，百神臻。", "草木榮，天下春。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-50", "next": "011-52"}, "p52": {"key": "011-52", "title": "郊廟歌辭：祀風師樂章：送神", "author": "包佶", "canonical": "包佶", "lines": ["微穆敷華能應節，飄揚發彩宜行慶。", "送迎靈駕神心享，跪拜靈壇禮容盛。", "氣和草木發萌芽，德暢禽魚遂翔泳。", "永望翠蓋逐流雲，自茲率土調春令。"], "form": "七律", "t300": null, "src": "poet.tang", "pilot": false, "prev": "011-51", "next": "011-53"}, "p53": {"key": "011-53", "title": "郊廟歌辭：祀雨師樂章：迎神", "author": "包佶", "canonical": "包佶", "lines": ["陟降左右，誠達幽圜。", "作解之功，樂惟有年。", "雲輧戾止，灑霧飄煙。", "惟馨展禮，爰列豆籩。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-52", "next": "011-54"}, "p54": {"key": "011-54", "title": "郊廟歌辭：祀雨師樂章：奠幣登歌", "author": "包佶", "canonical": "包佶", "lines": ["歲正朱明，禮布元制。", "惟樂能感，與神合契。", "陰霧離披，靈馭搖裔。", "膏澤之慶，期於稔歲。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-53", "next": "011-55"}, "p55": {"key": "011-55", "title": "郊廟歌辭：祀雨師樂章：迎俎酌獻", "author": "包佶", "canonical": "包佶", "lines": ["陽開幽蟄，躬奉鬱鬯。", "禮備節應，震來靈降。", "動植求聲，飛沉允望。", "時康氣茂，惟神之貺。"], "form": "四言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-54", "next": "011-56"}, "p56": {"key": "011-56", "title": "郊廟歌辭：祀雨師樂章：亞獻終獻", "author": "包佶", "canonical": "包佶", "lines": ["奠既備，獻將終。", "神行令，瑞飛空。", "迎幹德，祈歲功。", "乘煙燎，儼從風。"], "form": "雜言", "t300": null, "src": "yuding", "pilot": false, "prev": "011-55", "next": "011-57"}, "p57": {"key": "011-57", "title": "郊廟歌辭：祀雨師樂章：送神", "author": "包佶", "canonical": "包佶", "lines": ["整駕升車望寥廓，垂陰薦祉蕩昏氛。", "饗時靈貺僾如在。", "樂罷餘聲遙可聞。", "飲福陳誠禮容備，撤俎終獻曙光分。", "跪拜臨壇結空想，年年應節候油雲。"], "form": "七律", "t300": null, "src": "yuding", "pilot": false, "prev": "011-56", "next": null}}}